<Window x:Class="QuickCalc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickCalc"
        Height="130"
        Width="470"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="18"
                          ShadowDepth="3"
                          Direction="270"
                          Opacity="0.55"
                          Color="#000000"/>
    </Window.Resources>

    <Grid Margin="10">
        <Border Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,12"
                Effect="{StaticResource WindowShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Expression Input + Close Button -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Input container with placeholder -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="PlaceholderTextBlock"
                                   Text="Type a math expression, e.g. 2 * (15 + 7)..."
                                   FontSize="20"
                                   FontFamily="Segoe UI"
                                   Foreground="#666666"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0"
                                   IsHitTestVisible="False"/>
                        <TextBox x:Name="InputTextBox"
                                 FontSize="22"
                                 FontFamily="Segoe UI Semibold, Segoe UI, sans-serif"
                                 Foreground="#FFFFFF"
                                 Background="Transparent"
                                 CaretBrush="#007ACC"
                                 BorderThickness="0"
                                 FocusVisualStyle="{x:Null}"
                                 VerticalAlignment="Center"
                                 TextChanged="InputTextBox_TextChanged"/>
                    </Grid>

                    <!-- Minimalist Close Button -->
                    <Button Grid.Column="1"
                            Content="✕"
                            FontSize="13"
                            FontFamily="Segoe UI, sans-serif"
                            Style="{StaticResource CloseButtonStyle}"
                            Width="26"
                            Height="26"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="Close (Esc)"
                            Click="CloseButton_Click"/>
                </Grid>

                <!-- Row 1: Evaluation Result + Hotkey Hints -->
                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ResultTextBlock"
                               Grid.Column="0"
                               Text="= 0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#999999"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="Enter to copy &amp; close | Esc to close"
                               FontSize="11"
                               Foreground="#777777"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
