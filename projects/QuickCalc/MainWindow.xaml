<Window x:Class="QuickCalc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickCalc"
        Height="170"
        Width="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="18"
                          ShadowDepth="3"
                          Direction="270"
                          Opacity="0.55"
                          Color="#000000"/>

        <!-- Calculator Operator Button Style -->
        <Style x:Key="CalcButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#454548"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Semibold, sans-serif"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007ACC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1C97EA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#004C87"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clear Button Style (Red Accent) -->
        <Style x:Key="ClearButtonStyle" TargetType="Button" BasedOn="{StaticResource CalcButtonStyle}">
            <Setter Property="Foreground" Value="#FF7B7B"/>
            <Setter Property="BorderBrush" Value="#4C3A3A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C42B1C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A82315"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#A82315"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Border Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,12"
                Effect="{StaticResource WindowShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Expression Input + Close Button -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Input container with placeholder -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="PlaceholderTextBlock"
                                   Text="Введите выражение..."
                                   FontSize="20"
                                   FontFamily="Segoe UI"
                                   Foreground="#666666"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0"
                                   IsHitTestVisible="False"/>
                        <TextBox x:Name="InputTextBox"
                                 FontSize="22"
                                 FontFamily="Segoe UI Semibold, Segoe UI, sans-serif"
                                 Foreground="#FFFFFF"
                                 Background="Transparent"
                                 CaretBrush="#007ACC"
                                 BorderThickness="0"
                                 FocusVisualStyle="{x:Null}"
                                 VerticalAlignment="Center"
                                 TextChanged="InputTextBox_TextChanged"/>
                    </Grid>

                    <!-- Minimalist Close Button -->
                    <Button Grid.Column="1"
                            Content="✕"
                            FontSize="13"
                            FontFamily="Segoe UI, sans-serif"
                            Style="{StaticResource CloseButtonStyle}"
                            Width="26"
                            Height="26"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="Закрыть (Esc)"
                            Click="CloseButton_Click"/>
                </Grid>

                <!-- Row 1: Quick Math Operator Buttons -->
                <UniformGrid Grid.Row="1" Rows="1" Columns="8" Margin="0,0,0,10">
                    <Button Content="+" Style="{StaticResource CalcButtonStyle}" Tag=" + " ToolTip="Сложение (+)" Click="OperatorButton_Click"/>
                    <Button Content="-" Style="{StaticResource CalcButtonStyle}" Tag=" - " ToolTip="Вычитание (-)" Click="OperatorButton_Click"/>
                    <Button Content="×" Style="{StaticResource CalcButtonStyle}" Tag=" * " ToolTip="Умножение (×)" Click="OperatorButton_Click"/>
                    <Button Content="÷" Style="{StaticResource CalcButtonStyle}" Tag=" / " ToolTip="Деление (÷)" Click="OperatorButton_Click"/>
                    <Button Content="%" Style="{StaticResource CalcButtonStyle}" Tag="%" ToolTip="Процент (%)" Click="OperatorButton_Click"/>
                    <Button Content="^" Style="{StaticResource CalcButtonStyle}" Tag="^" ToolTip="Возведение в степень (^)" Click="OperatorButton_Click"/>
                    <Button Content="( )" Style="{StaticResource CalcButtonStyle}" Tag="()" ToolTip="Скобки ()" Click="OperatorButton_Click"/>
                    <Button Content="C" Style="{StaticResource ClearButtonStyle}" Tag="CLEAR" ToolTip="Очистить (C)" Click="OperatorButton_Click"/>
                </UniformGrid>

                <!-- Row 2: Evaluation Result + Hotkey Hints -->
                <Grid Grid.Row="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ResultTextBlock"
                               Grid.Column="0"
                               Text="= 0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#999999"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="Enter — скопировать | Esc — закрыть"
                               FontSize="11"
                               Foreground="#777777"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>