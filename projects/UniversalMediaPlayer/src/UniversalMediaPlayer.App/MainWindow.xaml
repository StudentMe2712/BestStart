<Window
    x:Class="UniversalMediaPlayer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:UniversalMediaPlayer.App.Helpers"
    Title="Universal Media Player">

    <Grid x:Name="RootGrid" 
          Background="#0C0C0E" 
          AllowDrop="True" 
          DragOver="RootGrid_DragOver" 
          Drop="RootGrid_Drop"
          PointerMoved="RootGrid_PointerMoved"
          PointerWheelChanged="RootGrid_PointerWheelChanged"
          KeyDown="RootGrid_KeyDown">

        <Grid.Resources>
            <helpers:TimecodeValueConverter x:Key="TimecodeConverter" />

            <!-- Sleek Dark Transport Button Style -->
            <Style x:Key="PlayerTransportButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#D4D4D8" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- Prominent Play/Pause Button Style -->
            <Style x:Key="PlayerPlayPauseButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="#222228" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#33333C" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- Text/Icon Action Button Style (e.g. Tracks, Open) -->
            <Style x:Key="PlayerTextActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Background" Value="#1A1A1E" />
                <Setter Property="Foreground" Value="#EDEDED" />
                <Setter Property="BorderBrush" Value="#2A2A30" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- Top Open File Button Style -->
            <Style x:Key="PlayerOpenButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Background" Value="#16222F" />
                <Setter Property="Foreground" Value="#4CC2FF" />
                <Setter Property="BorderBrush" Value="#204060" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        
        <Grid.RowDefinitions>
            <!-- Row 0: Header & Secondary Info Area -->
            <RowDefinition x:Name="TopRow" Height="Auto" />
            <!-- Row 1: Primary Video Canvas Host -->
            <RowDefinition x:Name="VideoRow" Height="*" />
            <!-- Row 2: Ergonomic Playback Control Bar -->
            <RowDefinition x:Name="ControlsRow" Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header & Secondary Info Area -->
        <Border x:Name="TopBarBorder" 
                Grid.Row="0" 
                Background="#101012" 
                BorderBrush="#1E1E22" 
                BorderThickness="0,0,0,1" 
                Padding="14,6,14,6"
                PointerEntered="TopBarBorder_PointerEntered"
                PointerExited="TopBarBorder_PointerExited">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Technical Specs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                              Glyph="&#xE714;" 
                              FontSize="13" 
                              Foreground="#4CC2FF" 
                              VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleTextBlock"
                               Text="Universal Media Player"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#EDEDED"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="550" />
                    <TextBlock x:Name="TechnicalMetadataTextBlock"
                               FontSize="11"
                               Foreground="#787880"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="400" />
                </StackPanel>

                <!-- Center: Floating / Header OSD Notification Pill -->
                <Border x:Name="OsdBorder"
                        Grid.Column="1"
                        Margin="12,0"
                        Background="#1E293B"
                        BorderBrush="#38BDF8"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,3"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="OsdTextBlock"
                               Foreground="#38BDF8"
                               FontSize="12"
                               FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- Right: Quick Open File Button -->
                <Button x:Name="TopOpenFileButton" 
                        Grid.Column="2" 
                        Style="{StaticResource PlayerOpenButtonStyle}" 
                        ToolTipService.ToolTip="Открыть файл (Ctrl+O)" 
                        Click="OpenFileButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xED25;" FontSize="12" Foreground="#4CC2FF" />
                        <TextBlock Text="Открыть" FontSize="11" FontWeight="Medium" Foreground="#4CC2FF" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Row 1: Primary Video Canvas Area -->
        <Grid Grid.Row="1" Background="#0C0C0E">
            <!-- Empty state placeholder when no video is loaded -->
            <StackPanel x:Name="EmptyStatePanel" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        Spacing="16">
                <Border Width="72" Height="72" Background="#141418" BorderBrush="#26262E" BorderThickness="1" CornerRadius="36" HorizontalAlignment="Center">
                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                              Glyph="&#xE714;" 
                              FontSize="32" 
                              Foreground="#4CC2FF" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center" />
                </Border>
                <StackPanel Spacing="4">
                    <TextBlock Text="Universal Media Player" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="#F4F4F5" 
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Перетащите видеофайл сюда или нажмите «Открыть»" 
                               FontSize="13" 
                               Foreground="#71717A" 
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Continue Watching Card -->
                <Border x:Name="ContinueWatchingBorder"
                        Background="#16161A"
                        BorderBrush="#2A2A32"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,16"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        MaxWidth="440"
                        Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE823;" FontSize="12" Foreground="#4CC2FF" VerticalAlignment="Center" />
                            <TextBlock Text="ПРОДОЛЖИТЬ ПРОСМОТР" FontSize="11" FontWeight="Bold" Foreground="#4CC2FF" CharacterSpacing="60" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="ContinueWatchingTitleTextBlock" FontSize="14" FontWeight="SemiBold" Foreground="#EDEDED" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ContinueWatchingDetailsTextBlock" FontSize="12" Foreground="#A1A1AA" />
                        <Button x:Name="ContinueWatchingButton"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="0,4,0,0"
                                Click="ContinueWatchingButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="12" />
                                <TextBlock Text="Продолжить просмотр" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border x:Name="VideoHostBorder" 
                    Background="Transparent" 
                    SizeChanged="VideoHostBorder_SizeChanged"
                    DoubleTapped="VideoHostBorder_DoubleTapped" />

            <!-- Error InfoBar -->
            <InfoBar x:Name="ErrorNotificationBar"
                     VerticalAlignment="Top"
                     Margin="16,16,16,0"
                     Severity="Error"
                     IsOpen="False"
                     IsIconVisible="True"
                     IsClosable="True" />
        </Grid>

        <!-- Row 2: Ergonomic Micro Control Bar -->
        <Border x:Name="ControlBarBorder" 
                Grid.Row="2" 
                Background="#121214" 
                BorderBrush="#1E1E22" 
                BorderThickness="0,1,0,0" 
                Padding="16,6,16,10"
                PointerEntered="ControlBarBorder_PointerEntered"
                PointerExited="ControlBarBorder_PointerExited">
            <StackPanel Spacing="4">

                    <!-- Resume Playback Prompt -->
                    <Border x:Name="ResumePromptBorder" 
                            Background="#1A1A20" 
                            CornerRadius="6" 
                            Padding="14,8" 
                            BorderBrush="#2C2C36" 
                            BorderThickness="1"
                            Margin="0,0,0,4"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE823;" FontSize="14" Foreground="#4CC2FF" VerticalAlignment="Center" />
                                <TextBlock x:Name="ResumePromptTextBlock" 
                                           Text="Продолжить просмотр с 23:14?" 
                                           FontSize="12" 
                                           FontWeight="Medium" 
                                           Foreground="#EDEDED" 
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Name="ResumePromptStartBeginningButton" 
                                        Content="Начать сначала" 
                                        FontSize="11" 
                                        Height="28"
                                        Padding="10,0"
                                        Click="ResumePromptStartBeginningButton_Click" />
                                <Button x:Name="ResumePromptResumeButton" 
                                        Content="Продолжить" 
                                        Style="{StaticResource AccentButtonStyle}" 
                                        FontSize="11" 
                                        Height="28"
                                        Padding="10,0"
                                        Click="ResumePromptResumeButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Auto-Next Episode Prompt -->
                    <Border x:Name="AutoNextPromptBorder" 
                            Background="#1A1A20" 
                            CornerRadius="6" 
                            Padding="14,8" 
                            BorderBrush="#2C2C36" 
                            BorderThickness="1"
                            Margin="0,0,0,4"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE893;" FontSize="14" Foreground="#4CC2FF" VerticalAlignment="Center" />
                                <TextBlock x:Name="AutoNextTitleTextBlock" 
                                           Text="Следующая серия: ..." 
                                           FontSize="12" 
                                           FontWeight="Medium" 
                                           Foreground="#EDEDED" 
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="AutoNextCountdownTextBlock" 
                                           Text="Воспроизведение через 5 сек..." 
                                           FontSize="11" 
                                           Foreground="#4CC2FF" 
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Name="AutoNextCancelButton" 
                                        Content="Отмена" 
                                        FontSize="11" 
                                        Height="28"
                                        Padding="10,0"
                                        Click="AutoNextCancelButton_Click" />
                                <Button x:Name="AutoNextPlayNowButton" 
                                        Content="Смотреть сейчас" 
                                        Style="{StaticResource AccentButtonStyle}" 
                                        FontSize="11" 
                                        Height="28"
                                        Padding="10,0"
                                        Click="AutoNextPlayNowButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Full-Width Timeline Scrubber -->
                    <Slider x:Name="TimelineSlider" 
                            Minimum="0" 
                            Maximum="100" 
                            Value="0" 
                            Margin="0,-2,0,0"
                            VerticalAlignment="Center"
                            ThumbToolTipValueConverter="{StaticResource TimecodeConverter}"
                            PointerPressed="TimelineSlider_PointerPressed"
                            PointerReleased="TimelineSlider_PointerReleased"
                            PointerCaptureLost="TimelineSlider_PointerCaptureLost"
                            ValueChanged="TimelineSlider_ValueChanged" />

                    <!-- Transport & Primary Controls Row -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <!-- 0: Transport controls (Prev, Play/Pause, Next, Timecode) -->
                            <ColumnDefinition Width="Auto" />
                            <!-- 1: Center flexible spacer -->
                            <ColumnDefinition Width="*" />
                            <!-- 2: Secondary / Media controls (Volume, Tracks, Open, Fullscreen) -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Transport Buttons & Timecode -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="PrevEpisodeButton" 
                                    Style="{StaticResource PlayerTransportButtonStyle}"
                                    ToolTipService.ToolTip="Предыдущая серия (PageUp)" 
                                    Click="PrevEpisodeButton_Click">
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE892;" FontSize="13" />
                            </Button>

                            <Button x:Name="PlayPauseButton" 
                                    Style="{StaticResource PlayerPlayPauseButtonStyle}"
                                    ToolTipService.ToolTip="Воспроизведение / Пауза (Space)" 
                                    Click="PlayPauseButton_Click">
                                <FontIcon x:Name="PlayPauseIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="14" />
                            </Button>

                            <Button x:Name="NextEpisodeButton" 
                                    Style="{StaticResource PlayerTransportButtonStyle}"
                                    ToolTipService.ToolTip="Следующая серия (PageDown)" 
                                    Click="NextEpisodeButton_Click">
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE893;" FontSize="13" />
                            </Button>

                            <!-- Monospace Timecode -->
                            <TextBlock x:Name="TimecodeTextBlock" 
                                       Text="00:00 / 00:00" 
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center" 
                                       Foreground="#A1A1AA" 
                                       FontFamily="Consolas, Segoe UI Variable" 
                                       FontSize="12" />
                        </StackPanel>

                        <!-- Right: Volume, Track Selection, Open, Fullscreen -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Volume Section -->
                            <Button x:Name="MuteButton" 
                                    Style="{StaticResource PlayerTransportButtonStyle}"
                                    ToolTipService.ToolTip="Громкость (M - без звука)" 
                                    Click="MuteButton_Click">
                                <FontIcon x:Name="VolumeIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE767;" FontSize="14" />
                            </Button>
                            <Slider x:Name="VolumeSlider" 
                                    Width="80" 
                                    Minimum="0" 
                                    Maximum="150" 
                                    Value="100" 
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    PointerPressed="VolumeSlider_PointerPressed"
                                    PointerReleased="VolumeSlider_PointerReleased"
                                    PointerCaptureLost="VolumeSlider_PointerCaptureLost"
                                    ValueChanged="VolumeSlider_ValueChanged" />

                            <!-- Tracks Flyout Button -->
                            <Button x:Name="TracksButton" 
                                    Style="{StaticResource PlayerTextActionButtonStyle}"
                                    ToolTipService.ToolTip="Аудиодорожки и субтитры">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE7F0;" FontSize="12" Foreground="#4CC2FF" />
                                    <TextBlock Text="Треки" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="TracksMenuFlyout">
                                        <MenuFlyoutSubItem x:Name="AudioTracksSubItem" Text="Аудиодорожки" />
                                        <MenuFlyoutSubItem x:Name="SubtitleTracksSubItem" Text="Субтитры" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <!-- Bottom Open File Button (mirrored for convenience) -->
                            <Button x:Name="OpenFileButton" 
                                    Style="{StaticResource PlayerTextActionButtonStyle}"
                                    ToolTipService.ToolTip="Открыть файл (Ctrl+O)" 
                                    Click="OpenFileButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xED25;" FontSize="12" />
                                    <TextBlock Text="Открыть" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Fullscreen Toggle -->
                            <Button x:Name="FullscreenButton" 
                                    Style="{StaticResource PlayerTransportButtonStyle}"
                                    ToolTipService.ToolTip="Полный экран (F / Alt+Enter)" 
                                    Click="FullscreenButton_Click">
                                <FontIcon x:Name="FullscreenIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE740;" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
        </Border>
    </Grid>
</Window>
