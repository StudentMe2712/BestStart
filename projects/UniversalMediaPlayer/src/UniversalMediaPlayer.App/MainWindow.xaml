<Window
    x:Class="UniversalMediaPlayer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Universal Media Player">

    <Grid x:Name="RootGrid" 
          Background="#121214" 
          AllowDrop="True" 
          DragOver="RootGrid_DragOver" 
          Drop="RootGrid_Drop"
          PointerMoved="RootGrid_PointerMoved"
          KeyDown="RootGrid_KeyDown">
        
        <Grid.RowDefinitions>
            <!-- Row 0: Sleek Top Bar (Title & Technical Metadata & OSD) -->
            <RowDefinition x:Name="TopBarRow" Height="Auto" />
            <!-- Row 1: Video Surface Host -->
            <RowDefinition x:Name="VideoRow" Height="*" />
            <!-- Row 2: Micro Control Bar -->
            <RowDefinition x:Name="ControlsRow" Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Top Bar -->
        <Border x:Name="TopBarBorder"
                Grid.Row="0"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="0,0,0,1"
                Padding="16,8"
                Visibility="Visible">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Clean Title & Metadata -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleTextBlock"
                               Text="Universal Media Player"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#EDEDED"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="550" />
                    <TextBlock x:Name="TechnicalMetadataTextBlock"
                               FontSize="12"
                               Foreground="#A1A1AA"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="450" />
                </StackPanel>

                <!-- Compact OSD Notification Badge -->
                <Border x:Name="OsdBorder"
                        Grid.Column="1"
                        Background="#27272A"
                        CornerRadius="4"
                        Padding="10,4"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="OsdTextBlock"
                               Foreground="#4CC2FF"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Border>

        <!-- Row 1: Video Hosting Area -->
        <Border x:Name="VideoHostBorder" 
                Grid.Row="1" 
                Background="Transparent" 
                SizeChanged="VideoHostBorder_SizeChanged"
                DoubleTapped="VideoHostBorder_DoubleTapped">
            
            <!-- Empty state placeholder when no video is loaded -->
            <StackPanel x:Name="EmptyStatePanel" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        Spacing="14">
                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                          Glyph="&#xE714;" 
                          FontSize="48" 
                          Foreground="#52525B" 
                          HorizontalAlignment="Center" />
                <TextBlock Text="Universal Media Player" 
                           FontSize="20" 
                           FontWeight="SemiBold" 
                           Foreground="#F4F4F5" 
                           HorizontalAlignment="Center" />
                <TextBlock Text="Перетащите видеофайл сюда или нажмите «Открыть»" 
                           FontSize="13" 
                           Foreground="#71717A" 
                           HorizontalAlignment="Center" />

                <!-- Continue Watching Card -->
                <Border x:Name="ContinueWatchingBorder"
                        Background="#18181B"
                        BorderBrush="#27272A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,16"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        MaxWidth="420"
                        Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE823;" FontSize="12" Foreground="#4CC2FF" VerticalAlignment="Center" />
                            <TextBlock Text="ПРОДОЛЖИТЬ ПРОСМОТР" FontSize="11" FontWeight="Bold" Foreground="#4CC2FF" CharacterSpacing="60" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="ContinueWatchingTitleTextBlock" FontSize="14" FontWeight="SemiBold" Foreground="#EDEDED" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ContinueWatchingDetailsTextBlock" FontSize="12" Foreground="#A1A1AA" />
                        <Button x:Name="ContinueWatchingButton"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="0,4,0,0"
                                Click="ContinueWatchingButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="12" />
                                <TextBlock Text="Продолжить просмотр" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Error InfoBar (anchored at top of Row 1) -->
        <InfoBar x:Name="ErrorNotificationBar"
                 Grid.Row="1"
                 VerticalAlignment="Top"
                 Margin="16,16,16,0"
                 Severity="Error"
                 IsOpen="False"
                 IsIconVisible="True"
                 IsClosable="True" />

        <!-- Row 2: Micro Control Bar Area -->
        <Border x:Name="ControlBarBorder" 
                Grid.Row="2" 
                Background="#18181B" 
                Padding="16,8,16,12" 
                BorderBrush="#27272A" 
                BorderThickness="0,1,0,0">
            <StackPanel Spacing="8">

                <!-- Prompts Container (above timeline) -->
                <!-- Resume Playback Prompt -->
                <Border x:Name="ResumePromptBorder" 
                        Background="#202024" 
                        CornerRadius="6" 
                        Padding="14,10" 
                        BorderBrush="#2E2E33" 
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE823;" FontSize="14" Foreground="#4CC2FF" VerticalAlignment="Center" />
                            <TextBlock x:Name="ResumePromptTextBlock" 
                                       Text="Продолжить просмотр с 23:14?" 
                                       FontSize="13" 
                                       FontWeight="Medium" 
                                       Foreground="#EDEDED" 
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button x:Name="ResumePromptStartBeginningButton" 
                                    Content="Начать сначала" 
                                    FontSize="12" 
                                    Click="ResumePromptStartBeginningButton_Click" />
                            <Button x:Name="ResumePromptResumeButton" 
                                    Content="Продолжить" 
                                    Style="{StaticResource AccentButtonStyle}" 
                                    FontSize="12" 
                                    Click="ResumePromptResumeButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Auto-Next Episode Prompt -->
                <Border x:Name="AutoNextPromptBorder" 
                        Background="#202024" 
                        CornerRadius="6" 
                        Padding="14,10" 
                        BorderBrush="#2E2E33" 
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE893;" FontSize="14" Foreground="#4CC2FF" VerticalAlignment="Center" />
                            <TextBlock x:Name="AutoNextTitleTextBlock" 
                                       Text="Следующая серия: ..." 
                                       FontSize="13" 
                                       FontWeight="Medium" 
                                       Foreground="#EDEDED" 
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="AutoNextCountdownTextBlock" 
                                       Text="Воспроизведение через 5 сек..." 
                                       FontSize="12" 
                                       Foreground="#4CC2FF" 
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button x:Name="AutoNextCancelButton" 
                                    Content="Отмена" 
                                    FontSize="12" 
                                    Click="AutoNextCancelButton_Click" />
                            <Button x:Name="AutoNextPlayNowButton" 
                                    Content="Смотреть сейчас" 
                                    Style="{StaticResource AccentButtonStyle}" 
                                    FontSize="12" 
                                    Click="AutoNextPlayNowButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Timeline Scrubber -->
                <Slider x:Name="TimelineSlider" 
                        Minimum="0" 
                        Maximum="100" 
                        Value="0" 
                        VerticalAlignment="Center"
                        PointerCaptureLost="TimelineSlider_PointerCaptureLost"
                        ValueChanged="TimelineSlider_ValueChanged" />

                <!-- Transport & Control Elements -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Transport Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="PrevEpisodeButton" Width="36" Height="36" ToolTipService.ToolTip="Предыдущая серия (PageUp)" Click="PrevEpisodeButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE892;" FontSize="13" />
                        </Button>
                        <Button x:Name="PlayPauseButton" Width="40" Height="36" ToolTipService.ToolTip="Воспроизведение / Пауза (Space)" Click="PlayPauseButton_Click">
                            <FontIcon x:Name="PlayPauseIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="14" />
                        </Button>
                        <Button x:Name="NextEpisodeButton" Width="36" Height="36" ToolTipService.ToolTip="Следующая серия (PageDown)" Click="NextEpisodeButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE893;" FontSize="13" />
                        </Button>
                    </StackPanel>

                    <!-- Timecode Display -->
                    <TextBlock x:Name="TimecodeTextBlock" 
                               Grid.Column="1" 
                               Text="00:00 / 00:00" 
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" 
                               Foreground="#A1A1AA" 
                               FontFamily="Consolas, Segoe UI Variable" 
                               FontSize="13" />

                    <!-- Spacer -->
                    <Grid Grid.Column="2" />

                    <!-- Volume Section -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="0,0,12,0">
                        <Button x:Name="MuteButton" Width="36" Height="36" ToolTipService.ToolTip="Громкость (M - без звука)" Click="MuteButton_Click">
                            <FontIcon x:Name="VolumeIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE767;" FontSize="14" />
                        </Button>
                        <Slider x:Name="VolumeSlider" Width="85" Minimum="0" Maximum="150" Value="100" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                    </StackPanel>

                    <!-- Track Selector & Open Button -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" Margin="0,0,8,0">
                        <Button x:Name="TracksButton" Height="36" ToolTipService.ToolTip="Аудиодорожки и субтитры">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE7F0;" FontSize="13" />
                                <TextBlock Text="Треки" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="TracksMenuFlyout">
                                    <MenuFlyoutSubItem x:Name="AudioTracksSubItem" Text="Аудиодорожки" />
                                    <MenuFlyoutSubItem x:Name="SubtitleTracksSubItem" Text="Субтитры" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="OpenFileButton" Height="36" ToolTipService.ToolTip="Открыть файл (Ctrl+O)" Click="OpenFileButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xED25;" FontSize="13" />
                                <TextBlock Text="Открыть" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Fullscreen Toggle -->
                    <Button x:Name="FullscreenButton" 
                            Grid.Column="5" 
                            Width="36" 
                            Height="36" 
                            ToolTipService.ToolTip="Полный экран (F / Alt+Enter)" 
                            Click="FullscreenButton_Click">
                        <FontIcon x:Name="FullscreenIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE740;" FontSize="13" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
