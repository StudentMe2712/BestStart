<Window x:Class="PersonalProvocateur.App.UI.TextSpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotlight Reminder"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Width="640"
        MinHeight="88"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Inter, Segoe UI Variable Display, Segoe UI, sans-serif"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Icons.xaml" />
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer margin for smooth shadow rendering -->
    <Grid Margin="16">
        <Border Background="#E60D0F18"
                BorderBrush="#808B5CF6"
                BorderThickness="1.5"
                CornerRadius="16"
                Padding="24,18"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#8B5CF6" BlurRadius="28" ShadowDepth="0" Opacity="0.45" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate" Y="0" />
            </Border.RenderTransform>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Neon Brand Prism Icon -->
                <Path Grid.Column="0"
                      Data="{StaticResource IconBrandPrism}"
                      Fill="#8B5CF6"
                      Width="22" Height="22"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      Margin="0,0,16,0" />

                <!-- Spotlight Message / Reminder Text -->
                <TextBlock x:Name="MessageTextBlock"
                           Grid.Column="1"
                           Text="Напоминание"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#F8FAFC"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />

                <!-- Done / Complete Action Button -->
                <Button x:Name="DoneButton"
                        Grid.Column="2"
                        Content="✓ Готово"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="18,8"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"
                        Click="DoneButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
