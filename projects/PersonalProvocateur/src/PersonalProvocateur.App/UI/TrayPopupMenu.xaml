<Window x:Class="PersonalProvocateur.App.UI.TrayPopupMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Provocateur Menu"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Inter, Segoe UI Variable Display, Segoe UI, sans-serif">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Icons.xaml" />
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#13151F"
            BorderBrush="#232738"
            BorderThickness="1"
            CornerRadius="14"
            Margin="10"
            Padding="10"
            Width="260"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.65" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="MenuTranslate" Y="0" />
        </Border.RenderTransform>

        <StackPanel>
            <!-- App Header & Status Indicator -->
            <Border Background="#0B0C10" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#232738" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Personal Provocateur"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="#F8FAFC"
                                   VerticalAlignment="Center" />
                        <Ellipse x:Name="StatusDot"
                                 Grid.Column="1"
                                 Width="8"
                                 Height="8"
                                 Fill="#8B5CF6"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock x:Name="NextTriggerTextBlock"
                               Text="Следующий: --:--"
                               FontSize="11"
                               Foreground="#94A3B8"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Menu Actions with Vector Icons -->
            <Button x:Name="TriggerNowButton"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Click="TriggerNowButton_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconBolt}"
                          Fill="{StaticResource AccentBrush}"
                          Stroke="{StaticResource AccentBrush}"
                          StrokeThickness="1"
                          Stretch="Uniform"
                          Width="14" Height="14"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center" />
                    <TextBlock Text="Вызвать провокатора сейчас"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button x:Name="PauseResumeButton"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Click="PauseResumeButton_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path x:Name="PauseResumeIcon"
                          Data="{StaticResource IconPause}"
                          Fill="{StaticResource TextSecondaryBrush}"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1"
                          Stretch="Uniform"
                          Width="14" Height="14"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center" />
                    <TextBlock x:Name="PauseResumeText"
                               Text="Приостановить"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button x:Name="SettingsButton"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Click="SettingsButton_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconSettings}"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="2"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="14" Height="14"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center" />
                    <TextBlock Text="Настройки..."
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button x:Name="DismissOverlayButton"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Click="DismissOverlayButton_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconEyeOff}"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform"
                          Width="14" Height="14"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center" />
                    <TextBlock Text="Скрыть оверлей"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Separator -->
            <Rectangle Height="1" Fill="#232738" Margin="4,6" SnapsToDevicePixels="True" />

            <Button x:Name="ExitButton"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Foreground="{StaticResource DangerBrush}"
                    Click="ExitButton_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconLogOut}"
                          Stroke="{StaticResource DangerBrush}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="14" Height="14"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center" />
                    <TextBlock Text="Выход"
                               Foreground="{StaticResource DangerBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
