<Window x:Class="PersonalProvocateur.App.UI.TrayPopupMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Provocateur Menu"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Inter, Segoe UI Variable Display, Segoe UI, sans-serif">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Icons.xaml" />
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#13151F"
            BorderBrush="#232738"
            BorderThickness="1"
            CornerRadius="14"
            Margin="10"
            Padding="10"
            Width="260"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.65" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="MenuTranslate" Y="0" />
        </Border.RenderTransform>

        <StackPanel>
            <!-- App Header & Status Indicator with macOS Squircle Badge (ADR-011) -->
            <Border Background="#0B0C10" CornerRadius="10" Padding="10,10" Margin="0,0,0,8" BorderBrush="#232738" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- macOS Squircle Badge (ADR-011) -->
                    <Border Grid.Column="0"
                            Width="28" Height="28"
                            CornerRadius="7"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1E1B4B" Offset="0.0" />
                                <GradientStop Color="#6D28D9" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <!-- Fallback IconBrandPrism Vector -->
                            <Path Data="{StaticResource IconBrandPrism}"
                                  Fill="#A78BFA"
                                  Stroke="#C4B5FD"
                                  StrokeThickness="0.5"
                                  Stretch="Uniform"
                                  Margin="5"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center" />
                            <!-- Brand Logo Image (ADR-011) -->
                            <Image Source="pack://application:,,,/Assets/logo.png"
                                   Stretch="Uniform"
                                   Margin="3"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Personal Provocateur"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="#F8FAFC"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="NextTriggerTextBlock"
                                   Text="Следующий: --:--"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Ellipse x:Name="StatusDot"
                             Grid.Column="2"
                             Width="8"
                             Height="8"
                             Fill="#8B5CF6"
                             VerticalAlignment="Center"
                             Margin="4,0,0,0" />
                </Grid>
            </Border>

            <!-- Menu Actions with Vector Icons -->
            <Button x:Name="TriggerNowButton"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Click="TriggerNowButton_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconBolt}"
                          Fill="{StaticResource AccentBrush}"
                          Stroke="{StaticResource AccentBrush}"
                          StrokeThickness="1"
                          Stretch="Uniform"
                          Width="14" Height="14"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center" />
                    <TextBlock Text="Вызвать провокатора сейчас"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button x:Name="PauseResumeButton"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Click="PauseResumeButton_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path x:Name="PauseResumeIcon"
                          Data="{StaticResource IconPause}"
                          Fill="{StaticResource TextSecondaryBrush}"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="1"
                          Stretch="Uniform"
                          Width="14" Height="14"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center" />
                    <TextBlock x:Name="PauseResumeText"
                               Text="Приостановить"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button x:Name="SettingsButton"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Click="SettingsButton_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconSettings}"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="2"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="14" Height="14"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center" />
                    <TextBlock Text="Настройки..."
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button x:Name="DismissOverlayButton"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Click="DismissOverlayButton_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconEyeOff}"
                          Stroke="{StaticResource TextSecondaryBrush}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform"
                          Width="14" Height="14"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center" />
                    <TextBlock Text="Скрыть оверлей"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Separator -->
            <Rectangle Height="1" Fill="#232738" Margin="4,6" SnapsToDevicePixels="True" />

            <Button x:Name="ExitButton"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Foreground="{StaticResource DangerBrush}"
                    Click="ExitButton_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconLogOut}"
                          Stroke="{StaticResource DangerBrush}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="14" Height="14"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center" />
                    <TextBlock Text="Выход"
                               Foreground="{StaticResource DangerBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
