<Window x:Class="PersonalProvocateur.App.UI.TrayPopupMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Provocateur Menu"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="#1C1D26"
            BorderBrush="#2E303E"
            BorderThickness="1"
            CornerRadius="12"
            Padding="10"
            Width="260"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.5" />
        </Border.Effect>
        <StackPanel>
            <!-- App Header & Status Indicator -->
            <Border Background="#12131A" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Personal Provocateur"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="#F8FAFC"
                                   VerticalAlignment="Center" />
                        <Ellipse x:Name="StatusDot"
                                 Grid.Column="1"
                                 Width="8"
                                 Height="8"
                                 Fill="#8B5CF6"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock x:Name="NextTriggerTextBlock"
                               Text="Следующий: --:--"
                               FontSize="11"
                               Foreground="#94A3B8"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Menu Actions -->
            <Button x:Name="TriggerNowButton"
                    Content="⚡ Вызвать провокатора сейчас"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Click="TriggerNowButton_Click" />

            <Button x:Name="PauseResumeButton"
                    Content="⏸ Приостановить"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Click="PauseResumeButton_Click" />

            <Button x:Name="SettingsButton"
                    Content="⚙ Настройки..."
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Click="SettingsButton_Click" />

            <Button x:Name="DismissOverlayButton"
                    Content="✕ Скрыть оверлей"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Click="DismissOverlayButton_Click" />

            <!-- Separator -->
            <Rectangle Height="1" Fill="#2E303E" Margin="4,6" SnapsToDevicePixels="True" />

            <Button x:Name="ExitButton"
                    Content="🚪 Выход"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Foreground="#EF4444"
                    Click="ExitButton_Click" />
        </StackPanel>
    </Border>
</Window>
