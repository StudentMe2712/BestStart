<UserControl x:Class="PersonalProvocateur.App.UI.Controls.MascotControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="260" Height="260"
             RenderTransformOrigin="0.5, 0.85"
             Cursor="Hand"
             Focusable="False"
             IsTabStop="False"
             KeyboardNavigation.IsTabStop="False"
             Background="Transparent">
    <Grid Focusable="False" KeyboardNavigation.IsTabStop="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Speech Bubble over mascot -->
        <Border x:Name="SpeechBubbleBorder"
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#1E1B2E"
                BorderBrush="#8B5CF6"
                BorderThickness="1.5"
                CornerRadius="14"
                Padding="12,6"
                Margin="0,0,0,4"
                Focusable="False"
                KeyboardNavigation.IsTabStop="False">
            <Border.Effect>
                <DropShadowEffect Color="#8B5CF6" BlurRadius="12" ShadowDepth="0" Opacity="0.5" />
            </Border.Effect>
            <TextBlock x:Name="SpeechBubbleText"
                       Text="Ну давай, кликни!"
                       Foreground="#F8FAFC"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="230"
                       Focusable="False"
                       KeyboardNavigation.IsTabStop="False" />
        </Border>

        <!-- Mascot Character Container with Transforms -->
        <Grid Grid.Row="1"
              x:Name="MascotContainer"
              RenderTransformOrigin="0.5, 0.85"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Focusable="False"
              KeyboardNavigation.IsTabStop="False">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="MascotScale" ScaleX="1.0" ScaleY="1.0" />
                    <RotateTransform x:Name="MascotRotate" Angle="0" />
                    <TranslateTransform x:Name="MascotTranslate" X="0" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Image x:Name="MascotImage"
                   Width="190"
                   Height="190"
                   Stretch="Uniform"
                   Focusable="False"
                   KeyboardNavigation.IsTabStop="False" />
        </Grid>
    </Grid>
</UserControl>
