<Window x:Class="PersonalProvocateur.App.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PersonalProvocateur.App.UI.Controls"
        Title="Personal Provocateur Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Focusable="False"
        KeyboardNavigation.TabNavigation="None"
        Left="0" Top="0">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="RootGrid" Focusable="False">
        <!-- Dimming Background Layer -->
        <Rectangle x:Name="DimmingRectangle"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Fill="#99000000"
                   Focusable="False" />

        <!-- Interactive 2D Mascot Provocateur (Clickable Canvas) -->
        <Canvas x:Name="MascotCanvas"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Focusable="False">
            <controls:MascotControl x:Name="Mascot"
                                    Focusable="False"
                                    MouseLeftButtonUp="Mascot_MouseLeftButtonUp" />
        </Canvas>

        <!-- Empty Library Notification Overlay (Shown if video library is empty) -->
        <Border x:Name="EmptyLibraryNotice"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1C1D26"
                BorderBrush="#EF4444"
                BorderThickness="2"
                CornerRadius="16"
                Padding="32,24"
                Visibility="Collapsed"
                Focusable="False">
            <Border.Effect>
                <DropShadowEffect Color="#EF4444" BlurRadius="25" ShadowDepth="0" Opacity="0.5" />
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center" Focusable="False">
                <TextBlock Text="⚠️ Внимание"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#EF4444"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"
                           Focusable="False" />

                <TextBlock Text="Библиотека видео пуста или файлы недоступны."
                           FontSize="15"
                           Foreground="#F8FAFC"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"
                           Focusable="False" />

                <TextBlock Text="Добавьте видеофайлы (.mp4) в настройках приложения."
                           FontSize="13"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"
                           Focusable="False" />

                <Button Content="Закрыть оверлей"
                        Style="{StaticResource DangerButtonStyle}"
                        HorizontalAlignment="Center"
                        Focusable="False"
                        IsTabStop="False"
                        Click="CloseNoticeButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
