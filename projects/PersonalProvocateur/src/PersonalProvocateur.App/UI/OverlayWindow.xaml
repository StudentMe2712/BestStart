<Window x:Class="PersonalProvocateur.App.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Provocateur Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Focusable="False"
        KeyboardNavigation.TabNavigation="None"
        Left="0" Top="0">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="RootGrid" Focusable="False">
        <!-- Dimming Background Layer -->
        <Rectangle x:Name="DimmingRectangle"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Fill="#99000000"
                   Focusable="False" />

        <!-- Interactive Mascot Provocateur (Clickable) -->
        <Border x:Name="MascotContainer"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1C1D26"
                BorderBrush="#8B5CF6"
                BorderThickness="2"
                CornerRadius="24"
                Padding="32,24"
                Cursor="Hand"
                Focusable="False"
                MouseLeftButtonUp="MascotContainer_MouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect Color="#8B5CF6" BlurRadius="30" ShadowDepth="0" Opacity="0.6" />
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False">
                <!-- Mascot Visual Badge -->
                <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,16" Focusable="False">
                    <Ellipse Fill="#8B5CF6" />
                    <!-- Eyes / Face Expression -->
                    <Canvas Width="96" Height="96" Focusable="False">
                        <Ellipse Canvas.Left="26" Canvas.Top="34" Width="14" Height="14" Fill="#F8FAFC" />
                        <Ellipse Canvas.Left="56" Canvas.Top="34" Width="14" Height="14" Fill="#F8FAFC" />
                        <Ellipse Canvas.Left="30" Canvas.Top="38" Width="7" Height="7" Fill="#12131A" />
                        <Ellipse Canvas.Left="60" Canvas.Top="38" Width="7" Height="7" Fill="#12131A" />
                        <!-- Provocative smile -->
                        <Path Stroke="#F8FAFC" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 32,60 Q 48,72 64,60" />
                    </Canvas>
                </Grid>

                <TextBlock Text="Провокатор"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#F8FAFC"
                           HorizontalAlignment="Center"
                           Focusable="False" />

                <TextBlock Text="нажми меня!"
                           FontSize="15"
                           FontWeight="Medium"
                           Foreground="#8B5CF6"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           Focusable="False" />

                <TextBlock Text="(кликните мышью для воспроизведения видео)"
                           FontSize="12"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           Focusable="False" />
            </StackPanel>
        </Border>

        <!-- Empty Library Notification Overlay (Shown if video library is empty) -->
        <Border x:Name="EmptyLibraryNotice"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1C1D26"
                BorderBrush="#EF4444"
                BorderThickness="2"
                CornerRadius="16"
                Padding="32,24"
                Visibility="Collapsed"
                Focusable="False">
            <Border.Effect>
                <DropShadowEffect Color="#EF4444" BlurRadius="25" ShadowDepth="0" Opacity="0.5" />
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center" Focusable="False">
                <TextBlock Text="⚠️ Внимание"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#EF4444"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"
                           Focusable="False" />

                <TextBlock Text="Библиотека видео пуста или файлы недоступны."
                           FontSize="15"
                           Foreground="#F8FAFC"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"
                           Focusable="False" />

                <TextBlock Text="Добавьте видеофайлы (.mp4) в настройках приложения."
                           FontSize="13"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"
                           Focusable="False" />

                <Button Content="Закрыть оверлей"
                        Style="{StaticResource DangerButtonStyle}"
                        HorizontalAlignment="Center"
                        Focusable="False"
                        IsTabStop="False"
                        Click="CloseNoticeButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
