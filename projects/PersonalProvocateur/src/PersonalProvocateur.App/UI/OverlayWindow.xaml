<Window x:Class="PersonalProvocateur.App.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PersonalProvocateur.App.UI.Controls"
        Title="Personal Provocateur Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Focusable="False"
        KeyboardNavigation.TabNavigation="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        Left="0" Top="0">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Icons.xaml" />
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="RootGrid" Focusable="False" MouseLeftButtonDown="DimmingLayer_MouseLeftButtonDown">
        <!-- Dimming Background Layer (Smoothly fades in on Loaded) -->
        <Rectangle x:Name="DimmingRectangle"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Fill="#000000"
                   Opacity="0.0"
                   Focusable="False"
                   MouseLeftButtonDown="DimmingLayer_MouseLeftButtonDown" />

        <!-- Interactive 2D Mascot Provocateur (Top-Center Notch Companion) -->
        <controls:MascotControl x:Name="Mascot"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,0,0,0"
                                Focusable="False"
                                MouseLeftButtonUp="Mascot_MouseLeftButtonUp" />

        <!-- macOS Spotlight / Raycast Style Text Card (ADR-014) -->
        <Border x:Name="SpotlightContainer"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="640"
                MinHeight="88"
                Padding="28,22"
                CornerRadius="22"
                Background="#A80D0F18"
                BorderBrush="#808B5CF6"
                BorderThickness="1.5"
                Visibility="Collapsed"
                Focusable="False"
                MouseLeftButtonDown="SpotlightContainer_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.6" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Spark icon -->
                <Path Grid.Column="0" Data="{StaticResource IconBolt}" Fill="#A78BFA" Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,16,0" />
                <!-- Text Content -->
                <TextBlock x:Name="SpotlightTextBlock" Grid.Column="1" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" VerticalAlignment="Center" />
                <!-- Done Button -->
                <Button x:Name="SpotlightDoneButton" Grid.Column="2" Content="✓ Готово" Padding="18,8" FontSize="14" FontWeight="SemiBold" Background="#8B5CF6" Foreground="#FFFFFF" BorderThickness="0" Margin="16,0,0,0" VerticalAlignment="Center" Cursor="Hand" Click="SpotlightDoneButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Empty Library Notification Overlay (Shown if video library is empty) -->
        <Border x:Name="EmptyLibraryNotice"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1C1D26"
                BorderBrush="#EF4444"
                BorderThickness="2"
                CornerRadius="16"
                Padding="32,24"
                Visibility="Collapsed"
                Focusable="False">
            <Border.Effect>
                <DropShadowEffect Color="#EF4444" BlurRadius="25" ShadowDepth="0" Opacity="0.5" />
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center" Focusable="False">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12" Focusable="False">
                    <Path Data="{StaticResource IconAlert}"
                          Stroke="{StaticResource DangerBrush}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="20" Height="20"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center" />
                    <TextBlock Text="Внимание"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}"
                               VerticalAlignment="Center"
                               Focusable="False" />
                </StackPanel>

                <TextBlock Text="Библиотека видео пуста или файлы недоступны."
                           FontSize="15"
                           Foreground="#F8FAFC"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"
                           Focusable="False" />

                <TextBlock Text="Добавьте видеофайлы (.mp4) в настройках приложения."
                           FontSize="13"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"
                           Focusable="False" />

                <Button Content="Закрыть оверлей"
                        Style="{StaticResource DangerButtonStyle}"
                        HorizontalAlignment="Center"
                        Focusable="False"
                        IsTabStop="False"
                        Click="CloseNoticeButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
