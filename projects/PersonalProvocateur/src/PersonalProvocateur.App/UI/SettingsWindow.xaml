<Window x:Class="PersonalProvocateur.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Provocateur"
        Width="860"
        Height="600"
        MinWidth="800"
        MinHeight="540"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Inter, Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Icons.xaml" />
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SkinCardButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#13151F" />
                <Setter Property="BorderBrush" Value="#25293A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Height" Value="40" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#171A28" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer margin creates space so DropShadowEffect is never clipped -->
    <Grid Margin="16">
        <!-- Root Frameless Window Container (Two-Column macOS Dark Aesthetic) -->
        <Border Background="#0B0D14"
                BorderBrush="#1E2231"
                BorderThickness="1"
                CornerRadius="16"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.65" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ========================================================= -->
                <!-- COLUMN 0: LEFT SIDEBAR                                    -->
                <!-- ========================================================= -->
                <Border Grid.Column="0"
                        Background="#0B0D14"
                        CornerRadius="16,0,0,16"
                        BorderBrush="#1E2231"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Brand header -->
                            <RowDefinition Height="*" />    <!-- Navigation buttons -->
                            <RowDefinition Height="Auto" /> <!-- Status & quick actions -->
                        </Grid.RowDefinitions>

                        <!-- Brand Header -->
                        <Border Grid.Row="0" Padding="18,18,18,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconBrandPrism}"
                                      Fill="#8B5CF6"
                                      Width="20" Height="20"
                                      Stretch="Uniform"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Provocateur"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <Border Background="#1C2033"
                                        CornerRadius="4"
                                        Padding="4,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="v1.0"
                                               Foreground="#9CA3AF"
                                               FontSize="11"
                                               FontWeight="Medium" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Navigation buttons -->
                        <StackPanel Grid.Row="1" Margin="10,6,10,0">
                            <!-- Nav 1: Content -->
                            <Button x:Name="NavContentButton"
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Click="NavContentButton_Click">
                                <Grid Margin="4,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="NavContentAccent"
                                            Grid.Column="0"
                                            Width="3"
                                            Height="18"
                                            CornerRadius="1.5"
                                            Background="#8B5CF6"
                                            Margin="0,0,10,0" />
                                    <Path Grid.Column="1"
                                          Data="{StaticResource IconVideo}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="Контент"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Nav 2: Schedule & Mascot -->
                            <Button x:Name="NavScheduleButton"
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Click="NavScheduleButton_Click">
                                <Grid Margin="4,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="NavScheduleAccent"
                                            Grid.Column="0"
                                            Width="3"
                                            Height="18"
                                            CornerRadius="1.5"
                                            Background="#8B5CF6"
                                            Visibility="Collapsed"
                                            Margin="0,0,10,0" />
                                    <Path Grid.Column="1"
                                          Data="{StaticResource IconClock}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="Образ и таймер"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Nav 3: System -->
                            <Button x:Name="NavSystemButton"
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Click="NavSystemButton_Click">
                                <Grid Margin="4,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="NavSystemAccent"
                                            Grid.Column="0"
                                            Width="3"
                                            Height="18"
                                            CornerRadius="1.5"
                                            Background="#8B5CF6"
                                            Visibility="Collapsed"
                                            Margin="0,0,10,0" />
                                    <Path Grid.Column="1"
                                          Data="{StaticResource IconSettings}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeLineJoin="Round"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="Система"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- Sidebar Bottom: Status Widget & Quick Buttons -->
                        <Border Grid.Row="2"
                                Margin="12,0,12,14"
                                Background="#10131E"
                                BorderBrush="#1E2231"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,10">
                            <StackPanel>
                                <!-- Status Row -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border x:Name="StatusBadgeBorder"
                                            Style="{StaticResource SuccessBadgeStyle}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="StatusBadgeDot"
                                                     Width="6" Height="6"
                                                     Fill="{StaticResource SuccessBrush}"
                                                     Margin="0,0,4,0"
                                                     VerticalAlignment="Center" />
                                            <TextBlock x:Name="StatusBadgeText"
                                                       Text="Активен"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Next Trigger Text -->
                                <TextBlock x:Name="NextTriggerTextBlock"
                                           Text="Следующее появление: рассчитывается..."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,10" />

                                <!-- Action Buttons Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="QuickTestButton"
                                            Grid.Column="0"
                                            ToolTip="Мгновенно запустить оверлей с персонажем"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="0,6"
                                            FontSize="12"
                                            Click="QuickTestButton_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconBolt}"
                                                  Fill="#FFFFFF"
                                                  Stroke="#FFFFFF"
                                                  StrokeThickness="1"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Margin="0,0,4,0"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="Тест" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="QuickPauseButton"
                                            Grid.Column="2"
                                            ToolTip="Приостановить или возобновить случайные напоминания"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="0,6"
                                            FontSize="12"
                                            Click="QuickPauseButton_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path x:Name="QuickPauseIcon"
                                                  Data="{StaticResource IconPause}"
                                                  Fill="{StaticResource TextPrimaryBrush}"
                                                  Stroke="{StaticResource TextPrimaryBrush}"
                                                  StrokeThickness="1"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Margin="0,0,4,0"
                                                  VerticalAlignment="Center" />
                                            <TextBlock x:Name="QuickPauseText"
                                                       Text="Пауза"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ========================================================= -->
                <!-- COLUMN 1: RIGHT WORK AREA                                 -->
                <!-- ========================================================= -->
                <Border Grid.Column="1"
                        Background="#10131D"
                        CornerRadius="0,16,16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" /> <!-- Top Title Bar -->
                            <RowDefinition Height="*" />  <!-- Main Content Area -->
                            <RowDefinition Height="60" /> <!-- Bottom Footer Bar -->
                        </Grid.RowDefinitions>

                        <!-- Top Title Bar (Draggable) -->
                        <Border Grid.Row="0"
                                Background="Transparent"
                                Padding="24,0,12,0"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Auto-Save Badge (ADR-013) -->
                                <Border x:Name="AutoSaveBadge"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0"
                                        CornerRadius="10"
                                        Background="#1A10B981"
                                        BorderBrush="#10B981"
                                        BorderThickness="1"
                                        Padding="8,3"
                                        Opacity="0"
                                        SnapsToDevicePixels="True">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCheck}"
                                              Stroke="#10B981"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Width="10" Height="10"
                                              Stretch="Uniform"
                                              Margin="0,0,5,0"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="Сохранено"
                                                   Foreground="#10B981"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Window Controls (Minimize & Close) -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="TitleBarMinimizeButton"
                                            Width="30" Height="26"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="0,0,4,0"
                                            Click="WindowMinimizeButton_Click"
                                            ToolTip="Свернуть">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <Path Data="{StaticResource IconMinimize}"
                                                          Stroke="{StaticResource TextSecondaryBrush}"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Width="12" Height="12"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#2D3248" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#13151F" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button x:Name="TitleBarCloseButton"
                                            Width="30" Height="26"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="WindowCloseButton_Click"
                                            ToolTip="Закрыть">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <Path x:Name="btnIcon"
                                                          Data="{StaticResource IconClose}"
                                                          Stroke="{StaticResource TextSecondaryBrush}"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Width="11" Height="11"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#EF4444" />
                                                        <Setter TargetName="btnIcon" Property="Stroke" Value="#FFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#DC2626" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Main Content Area -->
                        <Border Grid.Row="1" Padding="32,16,32,16">
                            <Grid>
                                <!-- TAB 0: CONTENT -->
                                <Border x:Name="TabVideosContent" Visibility="Visible">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Header Row: Title, Count + Single Add Button -->
                                        <Grid Grid.Row="0" Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Контент ротации"
                                                           Style="{StaticResource HeaderTextStyle}"
                                                           FontSize="18"
                                                           FontWeight="Bold" />
                                                <TextBlock x:Name="VideoCountTextBlock"
                                                           Text="Всего элементов: 0 (активно: 0)"
                                                           Style="{StaticResource SubheaderTextStyle}"
                                                           FontSize="12"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>

                                            <!-- STRICTLY SINGLE ADD BUTTON -->
                                            <Button x:Name="OpenAddModalButton"
                                                    Grid.Column="1"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Padding="16,8"
                                                    FontSize="13"
                                                    VerticalAlignment="Center"
                                                    Click="OpenAddModalButton_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconPlus}"
                                                          Stroke="#FFFFFF"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Width="12" Height="12"
                                                          Stretch="Uniform"
                                                          Margin="0,0,6,0"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock Text="+ Добавить" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Content Items List -->
                                        <ListBox x:Name="VideosListBox"
                                                 Grid.Row="1"
                                                 Background="{StaticResource CardBrush}"
                                                 BorderBrush="{StaticResource CardBorderBrush}"
                                                 BorderThickness="1"
                                                 Padding="4"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1A1C28"
                                                            BorderBrush="{StaticResource CardBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="10,8"
                                                            Margin="2,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- macOS Toggle Switch IsEnabled -->
                                                            <CheckBox IsChecked="{Binding IsEnabled}"
                                                                      Style="{StaticResource MacOsToggleSwitchStyle}"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,10,0"
                                                                      ToolTip="Включить / исключить из ротации"
                                                                      Click="VideoCheckBox_Click" />

                                                            <!-- Title, Type Badge, Secondary Text & Status Badge -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <!-- Content Type Badge (ВИДЕО / ТЕКСТ) -->
                                                                    <Border CornerRadius="6"
                                                                            Padding="5,1"
                                                                            Margin="0,0,8,0"
                                                                            Background="{Binding ContentTypeBadgeBackground}"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ContentTypeBadgeText}"
                                                                                   Foreground="{Binding ContentTypeBadgeForeground}"
                                                                                   FontSize="9"
                                                                                   FontWeight="Bold" />
                                                                    </Border>

                                                                    <TextBlock Text="{Binding Title}"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="12"
                                                                               VerticalAlignment="Center" />

                                                                    <!-- Availability Badge Tag -->
                                                                    <Border CornerRadius="8"
                                                                            Padding="6,1"
                                                                            Margin="8,0,0,0"
                                                                            Background="{Binding AvailabilityBackground}"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding AvailabilityText}"
                                                                                   Foreground="{Binding AvailabilityForeground}"
                                                                                   FontSize="10"
                                                                                   FontWeight="SemiBold" />
                                                                    </Border>
                                                                </StackPanel>

                                                                <TextBlock Text="{Binding SecondaryText}"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding SecondaryText}"
                                                                           Margin="0,2,0,0" />
                                                            </StackPanel>

                                                            <!-- Test Single Item Button -->
                                                            <Button Grid.Column="2"
                                                                    ToolTip="Проверить показ прямо сейчас"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Padding="8,4"
                                                                    FontSize="11"
                                                                    Margin="0,0,6,0"
                                                                    VerticalAlignment="Center"
                                                                    Click="TestSingleVideo_Click">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{DynamicResource IconPlay}"
                                                                          Fill="{StaticResource TextPrimaryBrush}"
                                                                          Stroke="{StaticResource TextPrimaryBrush}"
                                                                          StrokeThickness="1"
                                                                          Width="9" Height="9"
                                                                          Stretch="Uniform"
                                                                          Margin="0,0,4,0"
                                                                          VerticalAlignment="Center" />
                                                                    <TextBlock Text="Тест" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>

                                                            <!-- Remove Item Button -->
                                                            <Button Grid.Column="3"
                                                                    ToolTip="Удалить из библиотеки"
                                                                    Padding="7,5"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Cursor="Hand"
                                                                    VerticalAlignment="Center"
                                                                    Click="RemoveVideoButton_Click">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="delBorder"
                                                                                Background="{TemplateBinding Background}"
                                                                                CornerRadius="6"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <Path x:Name="delIcon"
                                                                                  Data="{DynamicResource IconTrash}"
                                                                                  Stroke="{StaticResource TextSecondaryBrush}"
                                                                                  StrokeThickness="1.8"
                                                                                  StrokeStartLineCap="Round"
                                                                                  StrokeEndLineCap="Round"
                                                                                  StrokeLineJoin="Round"
                                                                                  Width="12" Height="12"
                                                                                  Stretch="Uniform"
                                                                                  VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="delBorder" Property="Background" Value="#EF4444" />
                                                                                <Setter TargetName="delIcon" Property="Stroke" Value="#FFFFFF" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                <Setter TargetName="delBorder" Property="Background" Value="#DC2626" />
                                                                                <Setter TargetName="delIcon" Property="Stroke" Value="#FFFFFF" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Empty State Notice (shown when 0 items) -->
                                        <Border x:Name="EmptyVideosBorder"
                                                Grid.Row="1"
                                                Background="{StaticResource CardBrush}"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="24,20"
                                                Visibility="Collapsed">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconVideo}"
                                                      Stroke="{StaticResource CardBorderBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="32" Height="32"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,0,0,10" />
                                                <TextBlock Text="В библиотеке пока нет контента"
                                                           Style="{StaticResource HeaderTextStyle}"
                                                           FontSize="14"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,4" />
                                                <TextBlock Text="Добавьте видео MP4 или текстовые напоминания для ротации!"
                                                           Style="{StaticResource SubheaderTextStyle}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           Margin="0,0,0,14" />
                                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                                        Padding="16,8"
                                                        FontSize="12"
                                                        HorizontalAlignment="Center"
                                                        Click="OpenAddModalButton_Click">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconPlus}"
                                                              Stroke="#FFFFFF"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              Width="11" Height="11"
                                                              Stretch="Uniform"
                                                              Margin="0,0,6,0"
                                                              VerticalAlignment="Center" />
                                                        <TextBlock Text="+ Добавить в ротацию" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- TAB 1: APPEARANCE & SCHEDULE -->
                                <Border x:Name="TabAppearanceContent" Visibility="Collapsed">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="0,0,4,0">
                                            <!-- БЛОК «ОБРАЗ ПРОВОКАТОРА» -->
                                            <TextBlock Text="ОБРАЗ ПРОВОКАТОРА"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,10" />

                                            <Grid Margin="0,0,0,18">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Card 1: Dynamic Orb -->
                                                <Button x:Name="SkinDynamicOrbButton"
                                                        Grid.Column="0"
                                                        Style="{StaticResource SkinCardButtonStyle}"
                                                        BorderBrush="#8B5CF6"
                                                        BorderThickness="1.5"
                                                        Click="SkinDynamicOrbButton_Click">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,0,6"
                                                                BorderBrush="#A78BFA" BorderThickness="1">
                                                            <Border.Background>
                                                                <RadialGradientBrush GradientOrigin="0.4,0.4">
                                                                    <GradientStop Color="#C4B5FD" Offset="0.0"/>
                                                                    <GradientStop Color="#8B5CF6" Offset="0.5"/>
                                                                    <GradientStop Color="#1E1B4B" Offset="1.0"/>
                                                                </RadialGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <TextBlock Text="AI Ядро"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock Text="Dynamic Island"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="10"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Card 2: Cyber Visor -->
                                                <Button x:Name="SkinCyberVisorButton"
                                                        Grid.Column="2"
                                                        Style="{StaticResource SkinCardButtonStyle}"
                                                        Click="SkinCyberVisorButton_Click">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border Width="32" Height="22" CornerRadius="5" Background="#050508" BorderBrush="#00F0FF" BorderThickness="1" Margin="0,3,0,6">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Rectangle Width="7" Height="2" Fill="#00F0FF" RadiusX="1" RadiusY="1" Margin="0,0,3,0"/>
                                                                <Rectangle Width="7" Height="2" Fill="#00F0FF" RadiusX="1" RadiusY="1"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="Кибер-Визор"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock Text="Светящиеся глаза"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="10"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Card 3: Custom PNG -->
                                                <Button x:Name="SkinCustomImageButton"
                                                        Grid.Column="4"
                                                        Style="{StaticResource SkinCardButtonStyle}"
                                                        Click="SkinCustomImageButton_Click">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border Width="28" Height="28" CornerRadius="6" Background="#1C1F2E" BorderBrush="#374151" BorderThickness="1" Margin="0,0,0,6">
                                                            <Path Data="{StaticResource IconPlus}"
                                                                  Stroke="{StaticResource TextSecondaryBrush}"
                                                                  StrokeThickness="1.8"
                                                                  Width="12" Height="12"
                                                                  Stretch="Uniform"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="Свой PNG..."
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock x:Name="CustomSkinSubtitleText"
                                                                   Text="Выбрать файл"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="10"
                                                                   HorizontalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="100"
                                                                   Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- БЛОК «РАСПИСАНИЕ И ЭКРАН» -->
                                            <TextBlock Text="РАСПИСАНИЕ И ЭКРАН"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,10" />

                                            <Border Background="#141724"
                                                    BorderBrush="#1E2232"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="16,6">
                                                <StackPanel>
                                                    <!-- Row 1: Min Interval -->
                                                    <Grid Height="48">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Минимальный интервал появления"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="Medium" />
                                                            <TextBlock Text="Минимальное время между случайными провокациями"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBox x:Name="MinIntervalTextBox"
                                                                     Width="84"
                                                                     Height="38"
                                                                     VerticalContentAlignment="Center"
                                                                     HorizontalContentAlignment="Center"
                                                                     FontSize="14"
                                                                     FontWeight="SemiBold"
                                                                     Text="5"
                                                                     TextChanged="IntervalTextBox_TextChanged"
                                                                     LostFocus="IntervalTextBox_LostFocus"
                                                                     PreviewKeyDown="NumericTextBox_PreviewKeyDown" />
                                                            <TextBlock Text="мин"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0,0,0" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Separator -->
                                                    <Border Height="1" Background="#1E2232" />

                                                    <!-- Row 2: Max Interval -->
                                                    <Grid Height="48">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Максимальный интервал появления"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="Medium" />
                                                            <TextBlock Text="Максимальное время между случайными провокациями"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBox x:Name="MaxIntervalTextBox"
                                                                     Width="84"
                                                                     Height="38"
                                                                     VerticalContentAlignment="Center"
                                                                     HorizontalContentAlignment="Center"
                                                                     FontSize="14"
                                                                     FontWeight="SemiBold"
                                                                     Text="20"
                                                                     TextChanged="IntervalTextBox_TextChanged"
                                                                     LostFocus="IntervalTextBox_LostFocus"
                                                                     PreviewKeyDown="NumericTextBox_PreviewKeyDown" />
                                                            <TextBlock Text="мин"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0,0,0" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Separator -->
                                                    <Border Height="1" Background="#1E2232" />

                                                    <!-- Row 3: Target Monitor -->
                                                    <Grid Height="48">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Целевой монитор отображения"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="Medium" />
                                                            <TextBlock Text="Экран для воспроизведения видеороликов и персонажа"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <ComboBox x:Name="TargetMonitorComboBox"
                                                                  Grid.Column="1"
                                                                  Width="280"
                                                                  Height="38"
                                                                  VerticalAlignment="Center"
                                                                  SelectionChanged="TargetMonitorComboBox_SelectionChanged" />
                                                    </Grid>

                                                    <!-- Separator -->
                                                    <Border Height="1" Background="#1E2232" />

                                                    <!-- Row 4: Dimming Opacity Slider -->
                                                    <Grid Height="48">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="190" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="50" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Затемнение экранов"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="Medium" />
                                                            <TextBlock Text="Прозрачность фона оверлея"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Slider x:Name="OpacitySlider"
                                                                Grid.Column="1"
                                                                Minimum="10"
                                                                Maximum="95"
                                                                SmallChange="1"
                                                                LargeChange="5"
                                                                TickFrequency="5"
                                                                IsSnapToTickEnabled="True"
                                                                VerticalAlignment="Center"
                                                                Margin="16,0"
                                                                ValueChanged="Slider_ValueChanged" />
                                                        <TextBlock x:Name="OpacityText"
                                                                   Grid.Column="2"
                                                                   Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat='{}{0:0}%'}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>

                                                    <!-- Separator -->
                                                    <Border Height="1" Background="#1E2232" />

                                                    <!-- Row 5: Volume Slider -->
                                                    <Grid Height="48">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="190" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="50" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Громкость видеоплеера"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="Medium" />
                                                            <TextBlock Text="Уровень звука при воспроизведении"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Slider x:Name="VolumeSlider"
                                                                Grid.Column="1"
                                                                Minimum="0"
                                                                Maximum="100"
                                                                SmallChange="1"
                                                                LargeChange="5"
                                                                TickFrequency="5"
                                                                IsSnapToTickEnabled="True"
                                                                VerticalAlignment="Center"
                                                                Margin="16,0"
                                                                ValueChanged="Slider_ValueChanged" />
                                                        <TextBlock x:Name="VolumeText"
                                                                   Grid.Column="2"
                                                                   Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat='{}{0:0}%'}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <!-- TAB 2: SYSTEM -->
                                <Border x:Name="TabSystemContent" Visibility="Collapsed">
                                    <StackPanel>
                                        <!-- Hotkeys Card -->
                                        <Border Style="{StaticResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                                                    <Path Data="{StaticResource IconSettings}"
                                                          Stroke="{StaticResource AccentBrush}"
                                                          StrokeThickness="2"
                                                          StrokeLineJoin="Round"
                                                          Width="15" Height="15"
                                                          Stretch="Uniform"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock Text="Горячие клавиши"
                                                               Style="{StaticResource HeaderTextStyle}"
                                                               FontSize="14"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Trigger Hotkey -->
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Хоткей вызова:"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBox x:Name="TriggerHotkeyTextBox"
                                                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                                                 TextChanged="HotkeyTextBox_TextChanged"
                                                                 FontSize="13"
                                                                 Height="38" />
                                                        <TextBlock x:Name="TriggerHotkeyStatusText"
                                                                   Text="Сочетание доступно"
                                                                   Foreground="{StaticResource SuccessBrush}"
                                                                   FontSize="11"
                                                                   Margin="2,4,0,0" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Panic Hotkey -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Хоткей паники (сброс):"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBox x:Name="PanicHotkeyTextBox"
                                                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                                                 TextChanged="HotkeyTextBox_TextChanged"
                                                                 FontSize="13"
                                                                 Height="38" />
                                                        <TextBlock x:Name="PanicHotkeyStatusText"
                                                                   Text="Сочетание доступно"
                                                                   Foreground="{StaticResource SuccessBrush}"
                                                                   FontSize="11"
                                                                   Margin="2,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Windows Startup Card -->
                                        <Border Style="{StaticResource CardBorderStyle}" Padding="16,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="Запускать вместе с Windows"
                                                               Style="{StaticResource HeaderTextStyle}"
                                                               FontSize="13" />
                                                    <TextBlock Text="Запуск в фоновом режиме при старте системы"
                                                               Style="{StaticResource SubheaderTextStyle}"
                                                               FontSize="11"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                                <CheckBox x:Name="RunOnStartupCheckBox"
                                                          Grid.Column="1"
                                                          Style="{StaticResource MacOsToggleSwitchStyle}"
                                                          VerticalAlignment="Center"
                                                          Click="RunOnStartupCheckBox_Click" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Bottom Footer Bar -->
                        <Border Grid.Row="2"
                                Height="60"
                                BorderBrush="#1E2231"
                                BorderThickness="0,1,0,0"
                                Padding="32,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Настройки сохраняются автоматически или по кнопке"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />

                                <Button x:Name="SaveButton"
                                        Grid.Column="1"
                                        Content="✓ Сохранить"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="20,8"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        Click="SaveButton_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ========================================================= -->
                <!-- MODAL OVERLAY: ADD CONTENT (VIDEOS / TEXT REMINDERS)      -->
                <!-- ========================================================= -->
                <Grid x:Name="AddContentModalOverlay"
                      Grid.ColumnSpan="2"
                      Background="#B007080C"
                      Visibility="Collapsed">
                    <Border Width="480"
                            Background="#161926"
                            BorderBrush="#2E344B"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.8" />
                        </Border.Effect>
                        <StackPanel>
                            <!-- Modal Header -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Добавить в ротацию"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <Button x:Name="CloseAddModalButton"
                                        Grid.Column="1"
                                        Width="28" Height="28"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="CloseAddModalButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBdr" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <Path Data="{StaticResource IconClose}"
                                                      Stroke="{StaticResource TextSecondaryBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Width="11" Height="11"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBdr" Property="Background" Value="#2D3248" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- 1. Selection View -->
                            <StackPanel x:Name="ModalSelectionView" Visibility="Visible">
                                <TextBlock Text="Выберите формат контента для библиотеки провокатора:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,16" />

                                <!-- Card 1: Video File -->
                                <Button x:Name="AddVideoModalCardButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="16,14"
                                        Margin="0,0,0,10"
                                        Click="AddVideoModalCardButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40"
                                                CornerRadius="8"
                                                Background="#228B5CF6"
                                                Margin="0,0,14,0"
                                                VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconVideo}"
                                                  Stroke="#8B5CF6"
                                                  StrokeThickness="1.8"
                                                  Width="18" Height="18"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="🎬 Видеофайл (MP4)"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Локальный видеоролик формата MP4, WMV или AVI"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Card 2: Text Prompt -->
                                <Button x:Name="AddTextModalCardButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="16,14"
                                        Click="AddTextModalCardButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40"
                                                CornerRadius="8"
                                                Background="#2206B6D4"
                                                Margin="0,0,14,0"
                                                VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconPlus}"
                                                  Stroke="#06B6D4"
                                                  StrokeThickness="2"
                                                  Width="18" Height="18"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="✦ Текст / Задача"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Мотивирующая цитата, вызов или напоминание о разминке"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <!-- 2. Text Input View -->
                            <StackPanel x:Name="ModalTextInputView" Visibility="Collapsed">
                                <TextBlock Text="Новое текстовое напоминание:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,8" />
                                <TextBox x:Name="InlineAddTextBox"
                                         Height="80"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"
                                         Padding="12,8"
                                         FontSize="13"
                                         Margin="0,0,0,16" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="CancelAddTextButton"
                                            Content="Назад"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="16,7"
                                            FontSize="12"
                                            Margin="0,0,8,0"
                                            Click="CancelAddTextButton_Click" />
                                    <Button x:Name="ConfirmAddTextButton"
                                            Content="✓ Добавить в список"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="18,7"
                                            FontSize="12"
                                            Click="ConfirmAddTextButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ========================================================= -->
                <!-- FLOATING TOAST HUD (SUCCESS & WARNING NOTIFICATIONS)      -->
                <!-- ========================================================= -->
                <Border x:Name="ToastHudBorder"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,24"
                        Background="#161925"
                        BorderBrush="{StaticResource SuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="16,8"
                        Opacity="0"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.7" />
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ToastTransform" Y="16" />
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="ToastIcon"
                              Data="{StaticResource IconCheck}"
                              Stroke="{StaticResource SuccessBrush}"
                              StrokeThickness="2.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center" />
                        <TextBlock x:Name="ToastMessageTextBlock"
                                   Text="Настройки сохранены"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
