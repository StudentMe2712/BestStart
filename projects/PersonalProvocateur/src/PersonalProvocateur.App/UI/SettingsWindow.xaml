<Window x:Class="PersonalProvocateur.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — Personal Provocateur"
        Width="780"
        Height="720"
        MinWidth="640"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Inter, Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Icons.xaml" />
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer margin creates space so DropShadowEffect is never clipped -->
    <Grid Margin="18">
        <!-- Root Frameless Window Container (macOS Dark Obsidian Aesthetic) -->
        <Border Background="#0B0C10"
                BorderBrush="#25293A"
                BorderThickness="1"
                CornerRadius="16"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.65" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 0: Custom TitleBar -->
                    <RowDefinition Height="Auto" /> <!-- 1: Status Bar -->
                    <RowDefinition Height="*" />    <!-- 2: Scrollable Content -->
                    <RowDefinition Height="Auto" /> <!-- 3: Bottom Action Bar -->
                </Grid.RowDefinitions>

                <!-- 0. Custom macOS-Style TitleBar (Draggable) -->
                <Border Grid.Row="0"
                        Background="#12131C"
                        CornerRadius="16,16,0,0"
                        BorderBrush="#25293A"
                        BorderThickness="0,0,0,1"
                        Padding="16,10,12,10"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: App Icon Badge & Header -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- App Badge (Purple circle with 'P') -->
                            <Border Width="26" Height="26"
                                    CornerRadius="13"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="P"
                                           Foreground="#FFFFFF"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-1,0,0" />
                            </Border>

                            <TextBlock Text="Personal Provocateur"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center" />

                            <Border Background="#25293A"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Настройки"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           FontWeight="Medium" />
                            </Border>
                        </StackPanel>

                        <!-- Right: Window Controls (Minimize & Close) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="WindowMinimizeButton"
                                    Width="30" Height="26"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,0,4,0"
                                    Click="WindowMinimizeButton_Click"
                                    ToolTip="Свернуть">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <Path Data="{StaticResource IconMinimize}"
                                                  Stroke="{StaticResource TextSecondaryBrush}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="12" Height="12"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#2D3248" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#13151F" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="WindowCloseButton"
                                    Width="30" Height="26"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="WindowCloseButton_Click"
                                    ToolTip="Закрыть">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <Path x:Name="btnIcon"
                                                  Data="{StaticResource IconClose}"
                                                  Stroke="{StaticResource TextSecondaryBrush}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#EF4444" />
                                                <Setter TargetName="btnIcon" Property="Stroke" Value="#FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#DC2626" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1. Window Header & Quick Status / Actions Bar -->
                <Border Grid.Row="1" Margin="20,16,20,12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Title & Status -->
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Состояние провокатора"
                                           Style="{StaticResource HeaderTextStyle}"
                                           FontSize="17"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center" />

                                <!-- Status Badge -->
                                <Border x:Name="StatusBadgeBorder"
                                        Style="{StaticResource SuccessBadgeStyle}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="StatusBadgeDot"
                                                 Width="6" Height="6"
                                                 Fill="{StaticResource SuccessBrush}"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="StatusBadgeText"
                                                   Text="Активен"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Next Trigger Info -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconClock}"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="13" Height="13"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center" />
                                <TextBlock x:Name="NextTriggerTextBlock"
                                           Text="Следующее появление: рассчитывается..."
                                           Style="{StaticResource SubheaderTextStyle}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Quick Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="QuickTestButton"
                                    ToolTip="Мгновенно запустить оверлей с персонажем"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="12,7"
                                    FontSize="12"
                                    Margin="0,0,8,0"
                                    Click="QuickTestButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconBolt}"
                                          Fill="#FFFFFF"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="1"
                                          Width="13" Height="13"
                                          Stretch="Uniform"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Проверить сейчас" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="QuickPauseButton"
                                    ToolTip="Приостановить или возобновить случайные напоминания"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,7"
                                    FontSize="12"
                                    Click="QuickPauseButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="QuickPauseIcon"
                                          Data="{StaticResource IconPause}"
                                          Fill="{StaticResource TextPrimaryBrush}"
                                          Stroke="{StaticResource TextPrimaryBrush}"
                                          StrokeThickness="1"
                                          Width="13" Height="13"
                                          Stretch="Uniform"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock x:Name="QuickPauseText"
                                               Text="Пауза"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Scrollable Settings Content -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="20,0,20,12">
                    <StackPanel Margin="0,0,4,0">

                        <!-- SECTION 1: Video Library -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconVideo}"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Width="16" Height="16"
                                                  Stretch="Uniform"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="Библиотека видео"
                                                       Style="{StaticResource HeaderTextStyle}"
                                                       FontSize="15"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Случайные ролики воспроизводятся после клика по персонажу"
                                                   Style="{StaticResource SubheaderTextStyle}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <Button x:Name="AddVideoButton"
                                            Grid.Column="1"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="14,7"
                                            FontSize="12"
                                            Click="AddVideoButton_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconPlus}"
                                                  Stroke="#FFFFFF"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="12" Height="12"
                                                  Stretch="Uniform"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="Добавить MP4..." VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Empty State Notice (shown when 0 videos) -->
                                <Border x:Name="EmptyVideosBorder"
                                        Background="{StaticResource BackgroundBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="24,20"
                                        Margin="0,0,0,10"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{StaticResource IconVideo}"
                                              Stroke="{StaticResource CardBorderBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="36" Height="36"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,0,10" />
                                        <TextBlock Text="В библиотеке пока нет видео"
                                                   Style="{StaticResource HeaderTextStyle}"
                                                   FontSize="15"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="Добавьте .mp4 файлы, чтобы провокатор воспроизводил их после клика!"
                                                   Style="{StaticResource SubheaderTextStyle}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Margin="0,0,0,14" />
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                HorizontalAlignment="Center"
                                                Padding="14,7"
                                                FontSize="12"
                                                Click="AddVideoButton_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconPlus}"
                                                      Stroke="#FFFFFF"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Width="12" Height="12"
                                                      Stretch="Uniform"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center" />
                                                <TextBlock Text="Выбрать .mp4 файлы" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Video Items List -->
                                <ListBox x:Name="VideosListBox"
                                         MinHeight="120"
                                         MaxHeight="240"
                                         Background="{StaticResource BackgroundBrush}"
                                         BorderBrush="{StaticResource CardBorderBrush}"
                                         BorderThickness="1"
                                         Padding="4">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBrush}"
                                                    BorderBrush="{StaticResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    Margin="2,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- macOS Toggle Switch IsEnabled -->
                                                    <CheckBox IsChecked="{Binding IsEnabled}"
                                                              Style="{StaticResource MacOsToggleSwitchStyle}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,10,0"
                                                              ToolTip="Включить / исключить ролик из ротации"
                                                              Click="VideoCheckBox_Click" />

                                                    <!-- Title, Path & Status Badge -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center" />

                                                            <!-- Availability Badge Tag -->
                                                            <Border CornerRadius="10"
                                                                    Padding="8,2"
                                                                    Margin="8,0,0,0"
                                                                    Background="{Binding AvailabilityBackground}"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding AvailabilityText}"
                                                                           Foreground="{Binding AvailabilityForeground}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding FilePath}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding FilePath}"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>

                                                    <!-- Test Single Video Button -->
                                                    <Button Grid.Column="2"
                                                            ToolTip="Воспроизвести этот ролик прямо сейчас"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="10,4"
                                                            FontSize="12"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center"
                                                            Click="TestSingleVideo_Click">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Data="{DynamicResource IconPlay}"
                                                                  Fill="{StaticResource TextPrimaryBrush}"
                                                                  Stroke="{StaticResource TextPrimaryBrush}"
                                                                  StrokeThickness="1"
                                                                  Width="10" Height="10"
                                                                  Stretch="Uniform"
                                                                  Margin="0,0,5,0"
                                                                  VerticalAlignment="Center" />
                                                            <TextBlock Text="Тест" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Remove Video Button -->
                                                    <Button Grid.Column="3"
                                                            ToolTip="Удалить из библиотеки"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Padding="8,5"
                                                            FontSize="12"
                                                            VerticalAlignment="Center"
                                                            Click="RemoveVideoButton_Click">
                                                        <Path Data="{DynamicResource IconTrash}"
                                                              Stroke="#FFFFFF"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Width="12" Height="12"
                                                              Stretch="Uniform"
                                                              VerticalAlignment="Center" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock x:Name="VideoCountTextBlock"
                                           Text="Всего роликов: 0 (активно: 0)"
                                           Style="{StaticResource SubheaderTextStyle}"
                                           FontSize="12"
                                           Margin="2,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- SECTION 2: Schedule & Screen -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                                    <Path Data="{StaticResource IconClock}"
                                          Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Расписание и экран"
                                               Style="{StaticResource HeaderTextStyle}"
                                               FontSize="15"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Min Interval Slider -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Мин. интервал появления:"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Slider x:Name="MinIntervalSlider"
                                            Grid.Column="1"
                                            Minimum="1"
                                            Maximum="120"
                                            SmallChange="1"
                                            LargeChange="5"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Margin="12,0"
                                            ValueChanged="IntervalSliders_ValueChanged" />
                                    <TextBlock x:Name="MinIntervalValueText"
                                               Grid.Column="2"
                                               Text="{Binding ElementName=MinIntervalSlider, Path=Value, StringFormat='{}{0:0} мин'}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Max Interval Slider -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Макс. интервал появления:"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Slider x:Name="MaxIntervalSlider"
                                            Grid.Column="1"
                                            Minimum="1"
                                            Maximum="480"
                                            SmallChange="1"
                                            LargeChange="5"
                                            TickFrequency="10"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Margin="12,0"
                                            ValueChanged="IntervalSliders_ValueChanged" />
                                    <TextBlock x:Name="MaxIntervalValueText"
                                               Grid.Column="2"
                                               Text="{Binding ElementName=MaxIntervalSlider, Path=Value, StringFormat='{}{0:0} мин'}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Dimming Opacity Slider -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Затемнение экрана:"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Slider x:Name="OpacitySlider"
                                            Grid.Column="1"
                                            Minimum="10"
                                            Maximum="95"
                                            SmallChange="1"
                                            LargeChange="5"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Margin="12,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat='{}{0:0}%'}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Video Volume Slider -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Громкость видеоплеера:"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Slider x:Name="VolumeSlider"
                                            Grid.Column="1"
                                            Minimum="0"
                                            Maximum="100"
                                            SmallChange="1"
                                            LargeChange="5"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Margin="12,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat='{}{0:0}%'}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 3: Hotkeys & System -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                                    <Path Data="{StaticResource IconSettings}"
                                          Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="2"
                                          StrokeLineJoin="Round"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Горячие клавиши и система"
                                               Style="{StaticResource HeaderTextStyle}"
                                               FontSize="15"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Trigger Hotkey -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Хоткей вызова:"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBox x:Name="TriggerHotkeyTextBox"
                                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                                 TextChanged="HotkeyTextBox_TextChanged" />
                                        <TextBlock x:Name="TriggerHotkeyStatusText"
                                                   Text="Сочетание доступно"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   FontSize="11"
                                                   Margin="2,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Panic Hotkey -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Хоткей сброса (паника):"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBox x:Name="PanicHotkeyTextBox"
                                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                                 TextChanged="HotkeyTextBox_TextChanged" />
                                        <TextBlock x:Name="PanicHotkeyStatusText"
                                                   Text="Сочетание доступно"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   FontSize="11"
                                                   Margin="2,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Startup with Windows CheckBox -->
                                <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                    <CheckBox x:Name="RunOnStartupCheckBox"
                                              Style="{StaticResource MacOsToggleSwitchStyle}"
                                              Content="Запускать приложение вместе с Windows" />
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Bottom Action Bar (Clean: No duplicate overlay test button) -->
                <Border Grid.Row="3"
                        Background="#12131C"
                        CornerRadius="0,0,16,16"
                        BorderBrush="#25293A"
                        BorderThickness="0,1,0,0"
                        Padding="20,14">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="SaveButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SaveButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCheck}"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="2.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="13" Height="13"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Сохранить настройки" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CloseButton"
                                Content="Закрыть"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="10,0,0,0"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Border>

                <!-- Floating macOS Toast HUD (Success & Error notifications) -->
                <Border x:Name="ToastHudBorder"
                        Grid.RowSpan="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,40"
                        Background="#161925"
                        BorderBrush="{StaticResource SuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="18,10"
                        Opacity="0"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.75" />
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ToastTransform" Y="20" />
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="ToastIcon"
                              Data="{StaticResource IconCheck}"
                              Stroke="{StaticResource SuccessBrush}"
                              StrokeThickness="2.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                        <TextBlock x:Name="ToastMessageTextBlock"
                                   Text="Настройки сохранены"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
