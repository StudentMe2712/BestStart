<Window x:Class="PersonalProvocateur.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — Personal Provocateur"
        Width="640"
        Height="520"
        MinWidth="640"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Inter, Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Icons.xaml" />
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SkinCardButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#13151F" />
                <Setter Property="BorderBrush" Value="#25293A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer margin creates space so DropShadowEffect is never clipped -->
    <Grid Margin="16">
        <!-- Root Frameless Window Container (macOS Dark Obsidian Aesthetic) -->
        <Border Background="#0B0C10"
                BorderBrush="#25293A"
                BorderThickness="1"
                CornerRadius="16"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.65" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 0: Custom TitleBar -->
                    <RowDefinition Height="Auto" /> <!-- 1: Compact Status / Header Bar -->
                    <RowDefinition Height="Auto" /> <!-- 2: macOS Segmented Control -->
                    <RowDefinition Height="*" />    <!-- 3: Tab Content (Videos / Appearance / System) -->
                </Grid.RowDefinitions>

                <!-- 0. Custom macOS-Style TitleBar (Draggable) -->
                <Border Grid.Row="0"
                        Background="#12131C"
                        CornerRadius="16,16,0,0"
                        BorderBrush="#25293A"
                        BorderThickness="0,0,0,1"
                        Padding="14,8,10,8"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: App Icon Badge & Header -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- macOS Squircle Badge (ADR-011) -->
                            <Border Width="28" Height="28"
                                    CornerRadius="7"
                                    BorderBrush="#40FFFFFF"
                                    BorderThickness="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1E1B4B" Offset="0.0" />
                                        <GradientStop Color="#6D28D9" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Path Data="{StaticResource IconBrandPrism}"
                                          Fill="#A78BFA"
                                          Stroke="#C4B5FD"
                                          StrokeThickness="0.5"
                                          Stretch="Uniform"
                                          Margin="5"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                                    <Image Source="pack://application:,,,/Assets/logo.png"
                                           Stretch="Uniform"
                                           Margin="3"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>

                            <TextBlock Text="Personal Provocateur"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center" />

                            <Border Background="#25293A"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Настройки"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           FontWeight="Medium" />
                            </Border>
                        </StackPanel>

                        <!-- Center/Right: Auto-Save Badge (ADR-013) -->
                        <Border x:Name="AutoSaveBadge"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"
                                CornerRadius="10"
                                Background="#1A10B981"
                                BorderBrush="#10B981"
                                BorderThickness="1"
                                Padding="8,3"
                                Opacity="0"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCheck}"
                                      Stroke="#10B981"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="10" Height="10"
                                      Stretch="Uniform"
                                      Margin="0,0,5,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Сохранено"
                                           Foreground="#10B981"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Right: Window Controls (Minimize & Close) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="TitleBarMinimizeButton"
                                    Width="30" Height="26"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,0,4,0"
                                    Click="WindowMinimizeButton_Click"
                                    ToolTip="Свернуть">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <Path Data="{StaticResource IconMinimize}"
                                                  Stroke="{StaticResource TextSecondaryBrush}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="12" Height="12"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#2D3248" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#13151F" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="TitleBarCloseButton"
                                    Width="30" Height="26"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="WindowCloseButton_Click"
                                    ToolTip="Закрыть">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <Path x:Name="btnIcon"
                                                  Data="{StaticResource IconClose}"
                                                  Stroke="{StaticResource TextSecondaryBrush}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#EF4444" />
                                                <Setter TargetName="btnIcon" Property="Stroke" Value="#FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#DC2626" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1. Compact Status / Header Bar -->
                <Border Grid.Row="1"
                        Margin="18,10,18,8"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Status Capsule & Next Trigger -->
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Status Badge -->
                                <Border x:Name="StatusBadgeBorder"
                                        Style="{StaticResource SuccessBadgeStyle}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="StatusBadgeDot"
                                                 Width="6" Height="6"
                                                 Fill="{StaticResource SuccessBrush}"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="StatusBadgeText"
                                                   Text="Активен"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Next Trigger Info -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconClock}"
                                          Stroke="{StaticResource TextSecondaryBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Margin="0,0,5,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock x:Name="NextTriggerTextBlock"
                                               Text="Следующее появление: рассчитывается..."
                                               Style="{StaticResource SubheaderTextStyle}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Quick Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="QuickTestButton"
                                    ToolTip="Мгновенно запустить оверлей с персонажем"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="10,6"
                                    FontSize="12"
                                    Margin="0,0,8,0"
                                    Click="QuickTestButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconBolt}"
                                          Fill="#FFFFFF"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="1"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Margin="0,0,5,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Тест" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="QuickPauseButton"
                                    ToolTip="Приостановить или возобновить случайные напоминания"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,6"
                                    FontSize="12"
                                    Click="QuickPauseButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="QuickPauseIcon"
                                          Data="{StaticResource IconPause}"
                                          Fill="{StaticResource TextPrimaryBrush}"
                                          Stroke="{StaticResource TextPrimaryBrush}"
                                          StrokeThickness="1"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Margin="0,0,5,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock x:Name="QuickPauseText"
                                               Text="Пауза"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. macOS Segmented Control (Tabs Switcher) -->
                <Border Grid.Row="2"
                        Background="#13151F"
                        BorderBrush="#25293A"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="3"
                        Margin="18,0,18,10"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <!-- Tab 1: Video -->
                        <Button x:Name="TabVideosButton"
                                Click="TabVideos_Click"
                                Cursor="Hand"
                                Padding="16,6"
                                Background="#25293A"
                                BorderThickness="0"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                FontWeight="SemiBold"
                                FontSize="12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconVideo}"
                                                  Stroke="{TemplateBinding Foreground}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Width="13" Height="13"
                                                  Stretch="Uniform"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="Видео"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontSize="12"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Tab 2: Appearance & Timer -->
                        <Button x:Name="TabAppearanceButton"
                                Click="TabAppearance_Click"
                                Cursor="Hand"
                                Padding="16,6"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontWeight="Medium"
                                FontSize="12"
                                Margin="4,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconClock}"
                                                  Stroke="{TemplateBinding Foreground}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="13" Height="13"
                                                  Stretch="Uniform"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="Образ и таймер"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontSize="12"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Tab 3: System -->
                        <Button x:Name="TabSystemButton"
                                Click="TabSystem_Click"
                                Cursor="Hand"
                                Padding="16,6"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontWeight="Medium"
                                FontSize="12"
                                Margin="4,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconSettings}"
                                                  Stroke="{TemplateBinding Foreground}"
                                                  StrokeThickness="1.8"
                                                  StrokeLineJoin="Round"
                                                  Width="13" Height="13"
                                                  Stretch="Uniform"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="Система"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontSize="12"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 3. TAB 1: VIDEOS CONTENT -->
                <Border x:Name="TabVideosContent"
                        Grid.Row="3"
                        Margin="18,0,18,14"
                        Visibility="Visible">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Subheader: Count + Add Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="VideoCountTextBlock"
                                       Text="Всего роликов: 0 (активно: 0)"
                                       Style="{StaticResource SubheaderTextStyle}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />

                            <Button x:Name="AddVideoButton"
                                    Grid.Column="1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="12,6"
                                    FontSize="12"
                                    Click="AddVideoButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconPlus}"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="11" Height="11"
                                          Stretch="Uniform"
                                          Margin="0,0,5,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Добавить MP4..." VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Video Items List -->
                        <ListBox x:Name="VideosListBox"
                                 Grid.Row="1"
                                 Background="{StaticResource CardBrush}"
                                 BorderBrush="{StaticResource CardBorderBrush}"
                                 BorderThickness="1"
                                 Padding="4"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1C28"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Margin="2,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- macOS Toggle Switch IsEnabled -->
                                            <CheckBox IsChecked="{Binding IsEnabled}"
                                                      Style="{StaticResource MacOsToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      ToolTip="Включить / исключить ролик из ротации"
                                                      Click="VideoCheckBox_Click" />

                                            <!-- Title, Path & Status Badge -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               VerticalAlignment="Center" />

                                                    <!-- Availability Badge Tag -->
                                                    <Border CornerRadius="8"
                                                            Padding="6,1"
                                                            Margin="8,0,0,0"
                                                            Background="{Binding AvailabilityBackground}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AvailabilityText}"
                                                                   Foreground="{Binding AvailabilityForeground}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding FilePath}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FilePath}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Test Single Video Button -->
                                            <Button Grid.Column="2"
                                                    ToolTip="Воспроизвести этот ролик прямо сейчас"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="8,4"
                                                    FontSize="11"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Click="TestSingleVideo_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{DynamicResource IconPlay}"
                                                          Fill="{StaticResource TextPrimaryBrush}"
                                                          Stroke="{StaticResource TextPrimaryBrush}"
                                                          StrokeThickness="1"
                                                          Width="9" Height="9"
                                                          Stretch="Uniform"
                                                          Margin="0,0,4,0"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock Text="Тест" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Remove Video Button (turning red on hover) -->
                                            <Button Grid.Column="3"
                                                    ToolTip="Удалить из библиотеки"
                                                    Padding="7,5"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center"
                                                    Click="RemoveVideoButton_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="delBorder"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="6"
                                                                Padding="{TemplateBinding Padding}">
                                                            <Path x:Name="delIcon"
                                                                  Data="{DynamicResource IconTrash}"
                                                                  Stroke="{StaticResource TextSecondaryBrush}"
                                                                  StrokeThickness="1.8"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  Width="12" Height="12"
                                                                  Stretch="Uniform"
                                                                  VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="delBorder" Property="Background" Value="#EF4444" />
                                                                <Setter TargetName="delIcon" Property="Stroke" Value="#FFFFFF" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="delBorder" Property="Background" Value="#DC2626" />
                                                                <Setter TargetName="delIcon" Property="Stroke" Value="#FFFFFF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty State Notice (shown when 0 videos) -->
                        <Border x:Name="EmptyVideosBorder"
                                Grid.Row="1"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="24,20"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconVideo}"
                                      Stroke="{StaticResource CardBorderBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="32" Height="32"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10" />
                                <TextBlock Text="В библиотеке пока нет видео"
                                           Style="{StaticResource HeaderTextStyle}"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Добавьте .mp4 файлы, чтобы провокатор воспроизводил их после клика!"
                                           Style="{StaticResource SubheaderTextStyle}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,0,0,12" />
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Padding="12,6"
                                        FontSize="12"
                                        Click="AddVideoButton_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconPlus}"
                                              Stroke="#FFFFFF"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Width="11" Height="11"
                                              Stretch="Uniform"
                                              Margin="0,0,5,0"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="Выбрать .mp4 файлы" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 3. TAB 2: APPEARANCE & TIMER CONTENT -->
                <Border x:Name="TabAppearanceContent"
                        Grid.Row="3"
                        Margin="18,0,18,14"
                        Visibility="Collapsed">
                    <StackPanel>
                        <!-- Mascot Skin Selection Cards (ADR-012) -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Dynamic Orb -->
                            <Button x:Name="SkinDynamicOrbButton"
                                    Grid.Column="0"
                                    Style="{StaticResource SkinCardButtonStyle}"
                                    BorderBrush="#8B5CF6"
                                    BorderThickness="1.5"
                                    Click="SkinDynamicOrbButton_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,0,5"
                                            BorderBrush="#A78BFA" BorderThickness="1">
                                        <Border.Background>
                                            <RadialGradientBrush GradientOrigin="0.4,0.4">
                                                <GradientStop Color="#C4B5FD" Offset="0.0"/>
                                                <GradientStop Color="#8B5CF6" Offset="0.5"/>
                                                <GradientStop Color="#1E1B4B" Offset="1.0"/>
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="AI Ядро"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Dynamic Island"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                            </Button>

                            <!-- Card 2: Cyber Visor -->
                            <Button x:Name="SkinCyberVisorButton"
                                    Grid.Column="2"
                                    Style="{StaticResource SkinCardButtonStyle}"
                                    Click="SkinCyberVisorButton_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="28" Height="20" CornerRadius="5" Background="#050508" BorderBrush="#00F0FF" BorderThickness="1" Margin="0,2,0,5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Rectangle Width="6" Height="2" Fill="#00F0FF" RadiusX="1" RadiusY="1" Margin="0,0,3,0"/>
                                            <Rectangle Width="6" Height="2" Fill="#00F0FF" RadiusX="1" RadiusY="1"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Кибер-Визор"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Светящиеся глаза"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                            </Button>

                            <!-- Card 3: Custom PNG -->
                            <Button x:Name="SkinCustomImageButton"
                                    Grid.Column="4"
                                    Style="{StaticResource SkinCardButtonStyle}"
                                    Click="SkinCustomImageButton_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="24" Height="24" CornerRadius="5" Background="#1C1F2E" BorderBrush="#374151" BorderThickness="1" Margin="0,0,0,5">
                                        <Path Data="{StaticResource IconPlus}"
                                              Stroke="{StaticResource TextSecondaryBrush}"
                                              StrokeThickness="1.8"
                                              Width="11" Height="11"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Свой PNG..."
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="CustomSkinSubtitleText"
                                               Text="Выбрать файл"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="100"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Sliders Card -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="16,12">
                            <StackPanel>
                                <!-- Min Interval Slider -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="65" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Мин. интервал появления:"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <Slider x:Name="MinIntervalSlider"
                                            Grid.Column="1"
                                            Minimum="1"
                                            Maximum="120"
                                            SmallChange="1"
                                            LargeChange="5"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Margin="10,0"
                                            ValueChanged="IntervalSliders_ValueChanged" />
                                    <TextBlock x:Name="MinIntervalText"
                                               Grid.Column="2"
                                               Text="{Binding ElementName=MinIntervalSlider, Path=Value, StringFormat='{}{0:0} мин'}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Max Interval Slider -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="65" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Макс. интервал появления:"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <Slider x:Name="MaxIntervalSlider"
                                            Grid.Column="1"
                                            Minimum="1"
                                            Maximum="480"
                                            SmallChange="1"
                                            LargeChange="5"
                                            TickFrequency="10"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Margin="10,0"
                                            ValueChanged="IntervalSliders_ValueChanged" />
                                    <TextBlock x:Name="MaxIntervalText"
                                               Grid.Column="2"
                                               Text="{Binding ElementName=MaxIntervalSlider, Path=Value, StringFormat='{}{0:0} мин'}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Dimming Opacity Slider -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="65" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Затемнение экрана:"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <Slider x:Name="OpacitySlider"
                                            Grid.Column="1"
                                            Minimum="10"
                                            Maximum="95"
                                            SmallChange="1"
                                            LargeChange="5"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Margin="10,0"
                                            ValueChanged="Slider_ValueChanged" />
                                    <TextBlock x:Name="OpacityText"
                                               Grid.Column="2"
                                               Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat='{}{0:0}%'}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Video Volume Slider -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="65" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Громкость видеоплеера:"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <Slider x:Name="VolumeSlider"
                                            Grid.Column="1"
                                            Minimum="0"
                                            Maximum="100"
                                            SmallChange="1"
                                            LargeChange="5"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Margin="10,0"
                                            ValueChanged="Slider_ValueChanged" />
                                    <TextBlock x:Name="VolumeText"
                                               Grid.Column="2"
                                               Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat='{}{0:0}%'}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. TAB 3: SYSTEM CONTENT -->
                <Border x:Name="TabSystemContent"
                        Grid.Row="3"
                        Margin="18,0,18,14"
                        Visibility="Collapsed">
                    <StackPanel>
                        <!-- Hotkeys Card -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                    <Path Data="{StaticResource IconSettings}"
                                          Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="2"
                                          StrokeLineJoin="Round"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Горячие клавиши"
                                               Style="{StaticResource HeaderTextStyle}"
                                               FontSize="14"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Trigger Hotkey -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Хоткей вызова:"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBox x:Name="TriggerHotkeyTextBox"
                                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                                 TextChanged="HotkeyTextBox_TextChanged"
                                                 FontSize="12"
                                                 Padding="8,5" />
                                        <TextBlock x:Name="TriggerHotkeyStatusText"
                                                   Text="Сочетание доступно"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   FontSize="11"
                                                   Margin="2,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Panic Hotkey -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Хоткей паники (сброс):"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBox x:Name="PanicHotkeyTextBox"
                                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                                 TextChanged="HotkeyTextBox_TextChanged"
                                                 FontSize="12"
                                                 Padding="8,5" />
                                        <TextBlock x:Name="PanicHotkeyStatusText"
                                                   Text="Сочетание доступно"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   FontSize="11"
                                                   Margin="2,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Windows Startup Card -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Запускать вместе с Windows"
                                               Style="{StaticResource HeaderTextStyle}"
                                               FontSize="13" />
                                    <TextBlock Text="Запуск в фоновом режиме при старте системы"
                                               Style="{StaticResource SubheaderTextStyle}"
                                               FontSize="11"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="RunOnStartupCheckBox"
                                          Grid.Column="1"
                                          Style="{StaticResource MacOsToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          Click="RunOnStartupCheckBox_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Floating macOS Toast HUD (Success & Error notifications) -->
                <Border x:Name="ToastHudBorder"
                        Grid.RowSpan="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,24"
                        Background="#161925"
                        BorderBrush="{StaticResource SuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="16,8"
                        Opacity="0"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.7" />
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ToastTransform" Y="16" />
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="ToastIcon"
                              Data="{StaticResource IconCheck}"
                              Stroke="{StaticResource SuccessBrush}"
                              StrokeThickness="2.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center" />
                        <TextBlock x:Name="ToastMessageTextBlock"
                                   Text="Настройки сохранены"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
