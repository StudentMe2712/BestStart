<Window x:Class="PersonalProvocateur.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Provocateur"
        Width="1180"
        Height="780"
        MinWidth="1024"
        MinHeight="680"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Inter, Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Icons.xaml" />
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Mode Selector Card Button Style -->
            <Style x:Key="ModeSelectorButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#141419" />
                <Setter Property="BorderBrush" Value="#23232B" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#32323E" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Preset Capsule Button Style -->
            <Style x:Key="PresetPillButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1A1A22" />
                <Setter Property="Foreground" Value="#F4F4F5" />
                <Setter Property="BorderBrush" Value="#282834" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="pillBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="pillBorder" Property="Background" Value="#282836" />
                                    <Setter TargetName="pillBorder" Property="BorderBrush" Value="#8B5CF6" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="pillBorder" Property="Background" Value="#1F1B30" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Avatar Skin Button Style -->
            <Style x:Key="SkinCardButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#181820" />
                <Setter Property="BorderBrush" Value="#23232B" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="skinBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="skinBorder" Property="BorderBrush" Value="#32323E" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sidebar Nav Button Style -->
            <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Height" Value="42" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#171720" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer margin creates space so DropShadowEffect is never clipped -->
    <Grid Margin="16">
        <!-- Root Frameless Window Container (Two-Column Zinc Obsidian Aesthetic) -->
        <Border Background="#09090B"
                BorderBrush="#23232B"
                BorderThickness="1"
                CornerRadius="16"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.65" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ========================================================= -->
                <!-- COLUMN 0: LEFT SIDEBAR (240px, #09090B)                   -->
                <!-- ========================================================= -->
                <Border Grid.Column="0"
                        Background="#09090B"
                        CornerRadius="16,0,0,16"
                        BorderBrush="#23232B"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Brand header -->
                            <RowDefinition Height="*" />    <!-- Navigation buttons -->
                            <RowDefinition Height="Auto" /> <!-- Status & quick actions -->
                        </Grid.RowDefinitions>

                        <!-- Brand Header -->
                        <Border Grid.Row="0" Padding="20,22,20,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconBrandPrism}"
                                      Fill="#8B5CF6"
                                      Width="22" Height="22"
                                      Stretch="Uniform"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Provocateur"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <Border Background="#1C182B"
                                        BorderBrush="#32284D"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="5,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="PRO"
                                               Foreground="#A78BFA"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Navigation buttons -->
                        <StackPanel Grid.Row="1" Margin="12,6,12,0">
                            <!-- Nav 1: Content -->
                            <Button x:Name="NavContentButton"
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Click="NavContentButton_Click">
                                <Grid Margin="6,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="NavContentAccent"
                                            Grid.Column="0"
                                            Width="3"
                                            Height="20"
                                            CornerRadius="1.5"
                                            Background="#8B5CF6"
                                            Margin="0,0,12,0" />
                                    <Path Grid.Column="1"
                                          Data="{StaticResource IconVideo}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="Контент"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Nav 2: Schedule & Mascot -->
                            <Button x:Name="NavScheduleButton"
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Click="NavScheduleButton_Click">
                                <Grid Margin="6,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="NavScheduleAccent"
                                            Grid.Column="0"
                                            Width="3"
                                            Height="20"
                                            CornerRadius="1.5"
                                            Background="#8B5CF6"
                                            Visibility="Collapsed"
                                            Margin="0,0,12,0" />
                                    <Path Grid.Column="1"
                                          Data="{StaticResource IconClock}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="Образ и таймер"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Nav 3: System -->
                            <Button x:Name="NavSystemButton"
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Click="NavSystemButton_Click">
                                <Grid Margin="6,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="NavSystemAccent"
                                            Grid.Column="0"
                                            Width="3"
                                            Height="20"
                                            CornerRadius="1.5"
                                            Background="#8B5CF6"
                                            Visibility="Collapsed"
                                            Margin="0,0,12,0" />
                                    <Path Grid.Column="1"
                                          Data="{StaticResource IconSettings}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeLineJoin="Round"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="Система"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- Sidebar Bottom: Status Widget & Quick Buttons -->
                        <Border Grid.Row="2"
                                Margin="14,0,14,18"
                                Background="#141419"
                                BorderBrush="#23232B"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,12">
                            <StackPanel>
                                <!-- Status Row -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border x:Name="StatusBadgeBorder"
                                            Style="{StaticResource SuccessBadgeStyle}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="StatusBadgeDot"
                                                     Width="6" Height="6"
                                                     Fill="{StaticResource SuccessBrush}"
                                                     Margin="0,0,5,0"
                                                     VerticalAlignment="Center" />
                                            <TextBlock x:Name="StatusBadgeText"
                                                       Text="Активен"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Next Trigger Text -->
                                <TextBlock x:Name="NextTriggerTextBlock"
                                           Text="Следующее появление: рассчитывается..."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,10" />

                                <!-- Action Buttons Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="QuickTestButton"
                                            Grid.Column="0"
                                            ToolTip="Мгновенно запустить оверлей с персонажем"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="0,7"
                                            FontSize="12"
                                            Click="QuickTestButton_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconBolt}"
                                                  Fill="#FFFFFF"
                                                  Stroke="#FFFFFF"
                                                  StrokeThickness="1"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Margin="0,0,5,0"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="Тест" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="QuickPauseButton"
                                            Grid.Column="2"
                                            ToolTip="Приостановить или возобновить случайные напоминания"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="0,7"
                                            FontSize="12"
                                            Click="QuickPauseButton_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path x:Name="QuickPauseIcon"
                                                  Data="{StaticResource IconPause}"
                                                  Fill="{StaticResource TextPrimaryBrush}"
                                                  Stroke="{StaticResource TextPrimaryBrush}"
                                                  StrokeThickness="1"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Margin="0,0,5,0"
                                                  VerticalAlignment="Center" />
                                            <TextBlock x:Name="QuickPauseText"
                                                       Text="Пауза"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ========================================================= -->
                <!-- COLUMN 1: RIGHT WORK AREA (#0E0E11)                       -->
                <!-- ========================================================= -->
                <Border Grid.Column="1"
                        Background="#0E0E11"
                        CornerRadius="0,16,16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" /> <!-- Top Title Bar -->
                            <RowDefinition Height="*" />  <!-- Main Content Area -->
                            <RowDefinition Height="64" /> <!-- Bottom Footer Bar -->
                        </Grid.RowDefinitions>

                        <!-- Top Title Bar (Draggable) -->
                        <Border Grid.Row="0"
                                Background="Transparent"
                                Padding="28,0,16,0"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Auto-Save Badge (ADR-013) -->
                                <Border x:Name="AutoSaveBadge"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,14,0"
                                        CornerRadius="10"
                                        Background="#1A10B981"
                                        BorderBrush="#10B981"
                                        BorderThickness="1"
                                        Padding="10,4"
                                        Opacity="0"
                                        SnapsToDevicePixels="True">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCheck}"
                                              Stroke="#10B981"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Width="11" Height="11"
                                              Stretch="Uniform"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="Сохранено"
                                                   Foreground="#10B981"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Window Controls (Minimize & Close) -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="TitleBarMinimizeButton"
                                            Width="32" Height="28"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="0,0,4,0"
                                            Click="WindowMinimizeButton_Click"
                                            ToolTip="Свернуть">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <Path Data="{StaticResource IconMinimize}"
                                                          Stroke="{StaticResource TextSecondaryBrush}"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Width="12" Height="12"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#23232B" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#141419" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button x:Name="TitleBarCloseButton"
                                            Width="32" Height="28"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="WindowCloseButton_Click"
                                            ToolTip="Закрыть">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <Path x:Name="btnIcon"
                                                          Data="{StaticResource IconClose}"
                                                          Stroke="{StaticResource TextSecondaryBrush}"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Width="12" Height="12"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#EF4444" />
                                                        <Setter TargetName="btnIcon" Property="Stroke" Value="#FFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#DC2626" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Main Content Area -->
                        <Border Grid.Row="1" Padding="28,8,28,12">
                            <Grid>
                                <!-- ================================================= -->
                                <!-- TAB 0: CONTENT (YOUTUBE STUDIO CARDS & SINGLE +) -->
                                <!-- ================================================= -->
                                <Border x:Name="TabVideosContent" Visibility="Visible">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Header Row: Title, Count + STRICTLY SINGLE SQUARE PLUS BUTTON -->
                                        <Grid Grid.Row="0" Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Контент ротации"
                                                           Style="{StaticResource HeaderTextStyle}"
                                                           FontSize="20"
                                                           FontWeight="Bold" />
                                                <TextBlock x:Name="VideoCountTextBlock"
                                                           Text="Всего элементов: 0 (активно: 0)"
                                                           Style="{StaticResource SubheaderTextStyle}"
                                                           FontSize="12"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>

                                            <!-- STRICTLY SINGLE SQUARE PLUS BUTTON (ADR-025, 42x42px, CornerRadius=10, NO TEXT) -->
                                            <Button x:Name="OpenAddModalButton"
                                                    Grid.Column="1"
                                                    Width="42"
                                                    Height="42"
                                                    ToolTip="Добавить видео или напоминание"
                                                    Click="OpenAddModalButton_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="btnBorder"
                                                                Background="{StaticResource AccentGradientBrush}"
                                                                CornerRadius="10"
                                                                Cursor="Hand"
                                                                SnapsToDevicePixels="True">
                                                            <Path Data="{StaticResource IconPlus}"
                                                                  StrokeThickness="2.5"
                                                                  Width="18"
                                                                  Height="18"
                                                                  Stroke="#FFFFFF"
                                                                  Stretch="Uniform"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>

                                        <!-- YouTube Studio Content Items List -->
                                        <ListBox x:Name="VideosListBox"
                                                 Grid.Row="1"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Rich YouTube Studio Content Card -->
                                                    <Border Background="#141419"
                                                            BorderBrush="#23232B"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="10"
                                                            Margin="0,0,0,8"
                                                            SnapsToDevicePixels="True">
                                                        <Grid Height="99">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="176" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Column 0: 16:9 Preview Block (176 x 99) -->
                                                            <Border Grid.Column="0"
                                                                    Width="176"
                                                                    Height="99"
                                                                    CornerRadius="10"
                                                                    ClipToBounds="True"
                                                                    BorderBrush="#23232B"
                                                                    BorderThickness="1"
                                                                    Background="#0E0E11">
                                                                <Grid>
                                                                    <!-- VIDEO: Thumbnail Image -->
                                                                    <Image Source="{Binding ThumbnailPath}"
                                                                           Stretch="UniformToFill"
                                                                           Visibility="{Binding ThumbnailVisibility}" />

                                                                    <!-- VIDEO: Fallback Gradient if No Thumbnail -->
                                                                    <Grid Visibility="{Binding FallbackVideoVisibility}">
                                                                        <Border>
                                                                            <Border.Background>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                                    <GradientStop Color="#1A1A26" Offset="0" />
                                                                                    <GradientStop Color="#101018" Offset="1" />
                                                                                </LinearGradientBrush>
                                                                            </Border.Background>
                                                                            <Path Data="{StaticResource IconVideo}"
                                                                                  Stroke="#38384E"
                                                                                  StrokeThickness="2"
                                                                                  StrokeStartLineCap="Round"
                                                                                  StrokeEndLineCap="Round"
                                                                                  StrokeLineJoin="Round"
                                                                                  Width="32" Height="32"
                                                                                  Stretch="Uniform"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </Grid>

                                                                    <!-- VIDEO: Duration Badge (Bottom-Right) -->
                                                                    <Border Background="#D0000000"
                                                                            CornerRadius="4"
                                                                            Padding="6,2"
                                                                            Margin="0,0,6,6"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Bottom"
                                                                            Visibility="{Binding VideoPreviewVisibility}">
                                                                        <TextBlock Text="{Binding DurationText}"
                                                                                   Foreground="#F4F4F5"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold" />
                                                                    </Border>

                                                                    <!-- VIDEO: Quick Play Button (Hover/Center) -->
                                                                    <Button Width="36"
                                                                            Height="36"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Cursor="Hand"
                                                                            ToolTip="Быстрый предпросмотр"
                                                                            Visibility="{Binding VideoPreviewVisibility}"
                                                                            Click="TestSingleVideo_Click">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="playBg"
                                                                                        Width="36" Height="36"
                                                                                        CornerRadius="18"
                                                                                        Background="#B009090B"
                                                                                        BorderBrush="#38384A"
                                                                                        BorderThickness="1">
                                                                                    <Path Data="{DynamicResource IconPlay}"
                                                                                          Fill="#FFFFFF"
                                                                                          Width="12" Height="12"
                                                                                          Margin="2,0,0,0"
                                                                                          Stretch="Uniform"
                                                                                          HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center" />
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="playBg" Property="Background" Value="#E08B5CF6" />
                                                                                        <Setter TargetName="playBg" Property="BorderBrush" Value="#A78BFA" />
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>

                                                                    <!-- TEXT CARD: 16:9 Gradient Block with Quote & Short Preview -->
                                                                    <Grid Visibility="{Binding TextPreviewVisibility}">
                                                                        <Border>
                                                                            <Border.Background>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                                    <GradientStop Color="#1E1B33" Offset="0" />
                                                                                    <GradientStop Color="#11121C" Offset="1" />
                                                                                </LinearGradientBrush>
                                                                            </Border.Background>
                                                                            <Grid Margin="12,10">
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="*" />
                                                                                </Grid.RowDefinitions>
                                                                                <Border Width="24" Height="24" CornerRadius="12" Background="#2506B6D4" HorizontalAlignment="Left">
                                                                                    <Path Data="{StaticResource IconBolt}"
                                                                                          Fill="#06B6D4"
                                                                                          Width="12" Height="12"
                                                                                          Stretch="Uniform"
                                                                                          HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center" />
                                                                                </Border>
                                                                                <TextBlock Grid.Row="1"
                                                                                           Text="{Binding SecondaryText}"
                                                                                           Foreground="#A1A1AA"
                                                                                           FontSize="11"
                                                                                           FontStyle="Italic"
                                                                                           TextWrapping="Wrap"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           MaxHeight="50"
                                                                                           Margin="0,6,0,0" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Column 1: Middle Details -->
                                                            <Grid Grid.Column="1" Margin="16,4,16,4" VerticalAlignment="Center">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <!-- Row 0: Type Badge + Availability -->
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                    <Border CornerRadius="6"
                                                                            Padding="6,2"
                                                                            Margin="0,0,8,0"
                                                                            Background="{Binding ContentTypeBadgeBackground}">
                                                                        <TextBlock Text="{Binding ContentTypeBadgeText}"
                                                                                   Foreground="{Binding ContentTypeBadgeForeground}"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold" />
                                                                    </Border>

                                                                    <Border CornerRadius="6"
                                                                            Padding="6,2"
                                                                            Background="{Binding AvailabilityBackground}">
                                                                        <TextBlock Text="{Binding AvailabilityText}"
                                                                                   Foreground="{Binding AvailabilityForeground}"
                                                                                   FontSize="10"
                                                                                   FontWeight="SemiBold" />
                                                                    </Border>
                                                                </StackPanel>

                                                                <!-- Row 1: Title (15px SemiBold) -->
                                                                <TextBlock Grid.Row="1"
                                                                           Text="{Binding Title}"
                                                                           Foreground="#F4F4F5"
                                                                           FontSize="15"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,0,0,4" />

                                                                <!-- Row 2: Secondary Text / Path (12px, #A1A1AA) -->
                                                                <TextBlock Grid.Row="2"
                                                                           Text="{Binding SecondaryText}"
                                                                           Foreground="#A1A1AA"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding SecondaryText}" />
                                                            </Grid>

                                                            <!-- Column 2: Right Action Controls -->
                                                            <StackPanel Grid.Column="2"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,8,0">
                                                                <!-- macOS Toggle Switch -->
                                                                <CheckBox IsChecked="{Binding IsEnabled}"
                                                                          Style="{StaticResource MacOsToggleSwitchStyle}"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,14,0"
                                                                          ToolTip="Включить / исключить из ротации"
                                                                          Click="VideoCheckBox_Click" />

                                                                <!-- Test Button -->
                                                                <Button ToolTip="Проверить показ прямо сейчас"
                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                        Padding="12,6"
                                                                        FontSize="12"
                                                                        Margin="0,0,8,0"
                                                                        VerticalAlignment="Center"
                                                                        Click="TestSingleVideo_Click">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Path Data="{DynamicResource IconPlay}"
                                                                              Fill="#F4F4F5"
                                                                              Stroke="#F4F4F5"
                                                                              StrokeThickness="1"
                                                                              Width="10" Height="10"
                                                                              Stretch="Uniform"
                                                                              Margin="0,0,6,0"
                                                                              VerticalAlignment="Center" />
                                                                        <TextBlock Text="Тест" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Button>

                                                                <!-- Delete Button (Trash) -->
                                                                <Button ToolTip="Удалить из библиотеки"
                                                                        Padding="8"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        VerticalAlignment="Center"
                                                                        Click="RemoveVideoButton_Click">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="delBorder"
                                                                                    Background="Transparent"
                                                                                    CornerRadius="8"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <Path x:Name="delIcon"
                                                                                      Data="{DynamicResource IconTrash}"
                                                                                      Stroke="#A1A1AA"
                                                                                      StrokeThickness="1.8"
                                                                                      StrokeStartLineCap="Round"
                                                                                      StrokeEndLineCap="Round"
                                                                                      StrokeLineJoin="Round"
                                                                                      Width="14" Height="14"
                                                                                      Stretch="Uniform"
                                                                                      VerticalAlignment="Center" />
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="delBorder" Property="Background" Value="#22EF4444" />
                                                                                    <Setter TargetName="delIcon" Property="Stroke" Value="#EF4444" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsPressed" Value="True">
                                                                                    <Setter TargetName="delBorder" Property="Background" Value="#33EF4444" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Empty State Notice (shown when 0 items, strictly NO bottom duplicate button) -->
                                        <Border x:Name="EmptyVideosBorder"
                                                Grid.Row="1"
                                                Background="#141419"
                                                BorderBrush="#23232B"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="32,28"
                                                Visibility="Collapsed">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="56" Height="56" CornerRadius="28" Background="#1C1C24" Margin="0,0,0,14" HorizontalAlignment="Center">
                                                    <Path Data="{StaticResource IconVideo}"
                                                          Stroke="#71717A"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Width="24" Height="24"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="В библиотеке пока нет контента"
                                                           Foreground="#F4F4F5"
                                                           FontWeight="SemiBold"
                                                           FontSize="15"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,6" />
                                                <TextBlock Text="Нажмите кнопку «+» в правом верхнем углу, чтобы добавить видеоролик MP4 или текстовую задачу для ротации."
                                                           Foreground="#A1A1AA"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           MaxWidth="440"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ================================================= -->
                                <!-- TAB 1: APPEARANCE & SCHEDULE (4 STUDIO CARDS)     -->
                                <!-- ================================================= -->
                                <Border x:Name="TabAppearanceContent" Visibility="Collapsed">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="0,0,4,0">
                                            <!-- ============================================= -->
                                            <!-- КАРТОЧКА 1: РЕЖИМ РАБОТЫ ПРОВОКАТОРА           -->
                                            <!-- ============================================= -->
                                            <Border Background="#141419"
                                                    BorderBrush="#23232B"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="20"
                                                    Margin="0,0,0,16">
                                                <StackPanel>
                                                    <TextBlock Text="РЕЖИМ РАБОТЫ ПРОВОКАТОРА"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,4" />
                                                    <TextBlock Text="Выберите сценарий и алгоритм появления напоминаний"
                                                               Foreground="#71717A"
                                                               FontSize="11"
                                                               Margin="0,0,0,14" />

                                                    <!-- 3 Mode Selector Cards in a Row -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="10" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="10" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Mode 1: Smart Hybrid -->
                                                        <Button x:Name="TriggerModeSmartHybridButton"
                                                                Grid.Column="0"
                                                                Style="{StaticResource ModeSelectorButtonStyle}"
                                                                Click="TriggerModeSmartHybridButton_Click">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="*" />
                                                                </Grid.RowDefinitions>
                                                                <!-- Header + Active Badge -->
                                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                    <TextBlock Text="Умный гибрид"
                                                                               Foreground="#F4F4F5"
                                                                               FontSize="14"
                                                                               FontWeight="SemiBold"
                                                                               VerticalAlignment="Center" />
                                                                    <Border x:Name="ModeHybridActiveBadge"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Center"
                                                                            Background="#228B5CF6"
                                                                            BorderBrush="#8B5CF6"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            Padding="6,1"
                                                                            Visibility="Visible">
                                                                        <TextBlock Text="✓ Активен"
                                                                                   Foreground="#A78BFA"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold" />
                                                                    </Border>
                                                                </Grid>
                                                                <TextBlock Grid.Row="1"
                                                                           Text="YouTube/соцсети + простой > 12 мин + фоновый коридор"
                                                                           Foreground="#A1A1AA"
                                                                           FontSize="11"
                                                                           TextWrapping="Wrap" />
                                                            </Grid>
                                                        </Button>

                                                        <!-- Mode 2: Smart Only -->
                                                        <Button x:Name="TriggerModeSmartOnlyButton"
                                                                Grid.Column="2"
                                                                Style="{StaticResource ModeSelectorButtonStyle}"
                                                                Click="TriggerModeSmartOnlyButton_Click">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="*" />
                                                                </Grid.RowDefinitions>
                                                                <!-- Header + Active Badge -->
                                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                    <TextBlock Text="Только Анти-Прокрастинация"
                                                                               Foreground="#F4F4F5"
                                                                               FontSize="14"
                                                                               FontWeight="SemiBold"
                                                                               VerticalAlignment="Center" />
                                                                    <Border x:Name="ModeSmartOnlyActiveBadge"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Center"
                                                                            Background="#228B5CF6"
                                                                            BorderBrush="#8B5CF6"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            Padding="6,1"
                                                                            Visibility="Collapsed">
                                                                        <TextBlock Text="✓ Активен"
                                                                                   Foreground="#A78BFA"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold" />
                                                                    </Border>
                                                                </Grid>
                                                                <TextBlock Grid.Row="1"
                                                                           Text="Только при открытии развлечений или долгом простое"
                                                                           Foreground="#A1A1AA"
                                                                           FontSize="11"
                                                                           TextWrapping="Wrap" />
                                                            </Grid>
                                                        </Button>

                                                        <!-- Mode 3: Random Timer -->
                                                        <Button x:Name="TriggerModeRandomTimerButton"
                                                                Grid.Column="4"
                                                                Style="{StaticResource ModeSelectorButtonStyle}"
                                                                Click="TriggerModeRandomTimerButton_Click">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="*" />
                                                                </Grid.RowDefinitions>
                                                                <!-- Header + Active Badge -->
                                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                    <TextBlock Text="Классический интервал"
                                                                               Foreground="#F4F4F5"
                                                                               FontSize="14"
                                                                               FontWeight="SemiBold"
                                                                               VerticalAlignment="Center" />
                                                                    <Border x:Name="ModeRandomTimerActiveBadge"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Center"
                                                                            Background="#228B5CF6"
                                                                            BorderBrush="#8B5CF6"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            Padding="6,1"
                                                                            Visibility="Collapsed">
                                                                        <TextBlock Text="✓ Активен"
                                                                                   Foreground="#A78BFA"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold" />
                                                                    </Border>
                                                                </Grid>
                                                                <TextBlock Grid.Row="1"
                                                                           Text="Строго по случайному таймеру в коридоре минут"
                                                                           Foreground="#A1A1AA"
                                                                           FontSize="11"
                                                                           TextWrapping="Wrap" />
                                                            </Grid>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- ============================================= -->
                                            <!-- КАРТОЧКА 2: ДИАПАЗОН ВРЕМЕНИ ПОЯВЛЕНИЯ        -->
                                            <!-- ============================================= -->
                                            <Border Background="#141419"
                                                    BorderBrush="#23232B"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="20"
                                                    Margin="0,0,0,16">
                                                <StackPanel>
                                                    <TextBlock Text="ДИАПАЗОН ВРЕМЕНИ ПОЯВЛЕНИЯ (КОРИДОР РОТАЦИИ)"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,4" />
                                                    <TextBlock Text="Случайный временной интервал между срабатываниями провокатора"
                                                               Foreground="#71717A"
                                                               FontSize="11"
                                                               Margin="0,0,0,14" />

                                                    <!-- Quick Presets Row -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                        <TextBlock Text="Быстрые пресеты:"
                                                                   Foreground="#A1A1AA"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0" />
                                                        <Button x:Name="Preset5_15Button"
                                                                Content="5–15 мин"
                                                                Style="{StaticResource PresetPillButtonStyle}"
                                                                Margin="0,0,8,0"
                                                                Click="Preset5_15Button_Click" />
                                                        <Button x:Name="Preset15_35Button"
                                                                Content="15–35 мин"
                                                                Style="{StaticResource PresetPillButtonStyle}"
                                                                Margin="0,0,8,0"
                                                                Click="Preset15_35Button_Click" />
                                                        <Button x:Name="Preset30_60Button"
                                                                Content="30–60 мин"
                                                                Style="{StaticResource PresetPillButtonStyle}"
                                                                Margin="0,0,8,0"
                                                                Click="Preset30_60Button_Click" />
                                                        <Button x:Name="Preset60_120Button"
                                                                Content="60–120 мин"
                                                                Style="{StaticResource PresetPillButtonStyle}"
                                                                Click="Preset60_120Button_Click" />
                                                    </StackPanel>

                                                    <!-- Visual Graphic Corridor Bar -->
                                                    <Border Height="24"
                                                            CornerRadius="6"
                                                            Background="#0E0E11"
                                                            BorderBrush="#23232B"
                                                            BorderThickness="1"
                                                            Padding="2"
                                                            Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition x:Name="CorridorColBefore" Width="0.04*" />
                                                                <ColumnDefinition x:Name="CorridorColActive" Width="0.13*" />
                                                                <ColumnDefinition x:Name="CorridorColAfter" Width="0.83*" />
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Active Corridor Highlight -->
                                                            <Border x:Name="CorridorBarIndicator"
                                                                    Grid.Column="1"
                                                                    CornerRadius="4">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <GradientStop Color="#8B5CF6" Offset="0" />
                                                                        <GradientStop Color="#06B6D4" Offset="1" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Scale Markers -->
                                                    <Grid Margin="2,0,2,16">
                                                        <TextBlock Text="0 мин" Foreground="#71717A" FontSize="10" HorizontalAlignment="Left" />
                                                        <TextBlock Text="30 мин" Foreground="#71717A" FontSize="10" HorizontalAlignment="Center" Margin="-60,0,0,0" />
                                                        <TextBlock Text="60 мин" Foreground="#71717A" FontSize="10" HorizontalAlignment="Center" Margin="60,0,0,0" />
                                                        <TextBlock Text="120 мин" Foreground="#71717A" FontSize="10" HorizontalAlignment="Right" />
                                                    </Grid>

                                                    <!-- Numeric Input Slots -->
                                                    <Border Background="#181820"
                                                            BorderBrush="#23232B"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="20,12">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="ОТ" Foreground="#A1A1AA" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                            <TextBox x:Name="MinIntervalTextBox"
                                                                     Width="90"
                                                                     Height="38"
                                                                     VerticalContentAlignment="Center"
                                                                     HorizontalContentAlignment="Center"
                                                                     FontSize="15"
                                                                     FontWeight="SemiBold"
                                                                     Text="5"
                                                                     TextChanged="IntervalTextBox_TextChanged"
                                                                     LostFocus="IntervalTextBox_LostFocus"
                                                                     PreviewKeyDown="NumericTextBox_PreviewKeyDown" />
                                                            <TextBlock Text="МИН" Foreground="#A1A1AA" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,28,0" />

                                                            <Border Width="20" Height="2" Background="#32323E" VerticalAlignment="Center" Margin="0,0,28,0" />

                                                            <TextBlock Text="ДО" Foreground="#A1A1AA" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                            <TextBox x:Name="MaxIntervalTextBox"
                                                                     Width="90"
                                                                     Height="38"
                                                                     VerticalContentAlignment="Center"
                                                                     HorizontalContentAlignment="Center"
                                                                     FontSize="15"
                                                                     FontWeight="SemiBold"
                                                                     Text="20"
                                                                     TextChanged="IntervalTextBox_TextChanged"
                                                                     LostFocus="IntervalTextBox_LostFocus"
                                                                     PreviewKeyDown="NumericTextBox_PreviewKeyDown" />
                                                            <TextBlock Text="МИН" Foreground="#A1A1AA" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- ============================================= -->
                                            <!-- КАРТОЧКА 3: УМНЫЕ ТРИГГЕРЫ                     -->
                                            <!-- ============================================= -->
                                            <Border Background="#141419"
                                                    BorderBrush="#23232B"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="20"
                                                    Margin="0,0,0,16">
                                                <StackPanel>
                                                    <TextBlock Text="УМНЫЕ ТРИГГЕРЫ (YOUTUBE, РАЗВЛЕЧЕНИЯ И БЕЗДЕЙСТВИЕ)"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Margin="0,0,4,0" />
                                                    <TextBlock Text="Автоматический перехват прокрастинации и мотивационный толчок"
                                                               Foreground="#71717A"
                                                               FontSize="11"
                                                               Margin="0,0,0,14" />

                                                    <!-- Entertainment Trigger Row -->
                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Перехватывать при открытии развлекательных сайтов/приложений"
                                                                       Foreground="#F4F4F5" FontSize="13" FontWeight="Medium" />
                                                            <TextBlock Text="Детектирует вкладки браузера и окна с YouTube, соцсетями и играми"
                                                                       Foreground="#71717A" FontSize="11" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox x:Name="TriggerOnEntertainmentCheckBox"
                                                                  Grid.Column="1"
                                                                  Style="{StaticResource MacOsToggleSwitchStyle}"
                                                                  VerticalAlignment="Center"
                                                                  Click="TriggerOnEntertainmentCheckBox_Click" />
                                                    </Grid>

                                                    <!-- Entertainment Grace Row -->
                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Задержка перед перехватом (Grace period)"
                                                                       Foreground="#F4F4F5" FontSize="13" FontWeight="Medium" />
                                                            <TextBlock Text="Время непрерывного нахождения на сайте до запуска провокатора"
                                                                       Foreground="#71717A" FontSize="11" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Срабатывать через" Foreground="#A1A1AA" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <TextBox x:Name="EntertainmentGraceTextBox"
                                                                     Width="64" Height="36"
                                                                     VerticalContentAlignment="Center"
                                                                     HorizontalContentAlignment="Center"
                                                                     FontSize="13" FontWeight="SemiBold"
                                                                     Text="60"
                                                                     TextChanged="SmartTriggerInputs_TextChanged"
                                                                     PreviewKeyDown="NumericTextBox_PreviewKeyDown" />
                                                            <TextBlock Text="сек" Foreground="#A1A1AA" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Tags List -->
                                                    <TextBlock Text="Отслеживаемые развлекательные сайты и приложения:"
                                                               Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,8" />

                                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <ItemsControl x:Name="EntertainmentTagsItemsControl">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#1C1C26"
                                                                            BorderBrush="#2A2A3A"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8"
                                                                            Padding="10,4"
                                                                            Margin="0,0,8,8">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding}"
                                                                                       Foreground="#F4F4F5"
                                                                                       FontSize="12"
                                                                                       FontWeight="Medium"
                                                                                       VerticalAlignment="Center"
                                                                                       Margin="0,0,6,0" />
                                                                            <Button Style="{x:Null}"
                                                                                    Cursor="Hand"
                                                                                    Click="RemoveTagButton_Click"
                                                                                    ToolTip="Удалить тег"
                                                                                    Tag="{Binding}">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="Transparent" Padding="2">
                                                                                            <Path Data="{StaticResource IconClose}"
                                                                                                  Stroke="#71717A"
                                                                                                  StrokeThickness="1.8"
                                                                                                  Width="9" Height="9"
                                                                                                  Stretch="Uniform" />
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter Property="Opacity" Value="0.6" />
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Add Tag Inline Box -->
                                                        <Border Background="#181822"
                                                                BorderBrush="#2A2A3A"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="6,2"
                                                                Margin="0,0,8,8"
                                                                VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBox x:Name="NewTagTextBox"
                                                                         Width="120"
                                                                         Height="28"
                                                                         BorderThickness="0"
                                                                         Background="Transparent"
                                                                         Padding="4,0"
                                                                         FontSize="12"
                                                                         VerticalContentAlignment="Center"
                                                                         KeyDown="NewTagTextBox_KeyDown" />
                                                                <Button x:Name="AddTagButton"
                                                                        Width="24" Height="24"
                                                                        Cursor="Hand"
                                                                        ToolTip="Добавить сайт/тег"
                                                                        Click="AddTagButton_Click">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="addTagBdr" Background="#8B5CF6" CornerRadius="6">
                                                                                <Path Data="{StaticResource IconPlus}"
                                                                                      Stroke="#FFFFFF"
                                                                                      StrokeThickness="2"
                                                                                      Width="10" Height="10"
                                                                                      Stretch="Uniform"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center" />
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="addTagBdr" Property="Background" Value="#A78BFA" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </WrapPanel>

                                                    <!-- Separator -->
                                                    <Border Height="1" Background="#1E1E26" Margin="0,4,0,14" />

                                                    <!-- Idle Trigger Row -->
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Срабатывать при бездействии за компьютером"
                                                                       Foreground="#F4F4F5" FontSize="13" FontWeight="Medium" />
                                                            <TextBlock Text="Провоцирует возврат к работе при долгом отсутствии ввода мыши/клавиатуры"
                                                                       Foreground="#71717A" FontSize="11" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox x:Name="TriggerOnIdleCheckBox"
                                                                  Grid.Column="1"
                                                                  Style="{StaticResource MacOsToggleSwitchStyle}"
                                                                  VerticalAlignment="Center"
                                                                  Click="TriggerOnIdleCheckBox_Click" />
                                                    </Grid>

                                                    <!-- Idle Threshold Row -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Порог времени бездействия"
                                                                       Foreground="#F4F4F5" FontSize="13" FontWeight="Medium" />
                                                            <TextBlock Text="Количество минут неактивности до появления провокатора"
                                                                       Foreground="#71717A" FontSize="11" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Если нет активности больше" Foreground="#A1A1AA" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <TextBox x:Name="IdleThresholdTextBox"
                                                                     Width="64" Height="36"
                                                                     VerticalContentAlignment="Center"
                                                                     HorizontalContentAlignment="Center"
                                                                     FontSize="13" FontWeight="SemiBold"
                                                                     Text="12"
                                                                     TextChanged="SmartTriggerInputs_TextChanged"
                                                                     PreviewKeyDown="NumericTextBox_PreviewKeyDown" />
                                                            <TextBlock Text="мин" Foreground="#A1A1AA" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- ============================================= -->
                                            <!-- КАРТОЧКА 4: ЭКРАН, ОБРАЗ И ЗВУК               -->
                                            <!-- ============================================= -->
                                            <Border Background="#141419"
                                                    BorderBrush="#23232B"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="20"
                                                    Margin="0,0,0,16">
                                                <StackPanel>
                                                    <TextBlock Text="ЭКРАН, ОБРАЗ И ЗВУК"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Margin="0,0,4,0" />
                                                    <TextBlock Text="Внешний вид персонажа, целевой экран и аудио-визуальные параметры"
                                                               Foreground="#71717A"
                                                               FontSize="11"
                                                               Margin="0,0,0,14" />

                                                    <!-- Provocateur Mascot Skins -->
                                                    <Grid Margin="0,0,0,18">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="10" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="10" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Card 1: Dynamic Orb -->
                                                        <Button x:Name="SkinDynamicOrbButton"
                                                                Grid.Column="0"
                                                                Style="{StaticResource SkinCardButtonStyle}"
                                                                BorderBrush="#8B5CF6"
                                                                Click="SkinDynamicOrbButton_Click">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,0,6"
                                                                        BorderBrush="#A78BFA" BorderThickness="1">
                                                                    <Border.Background>
                                                                        <RadialGradientBrush GradientOrigin="0.4,0.4">
                                                                            <GradientStop Color="#C4B5FD" Offset="0.0"/>
                                                                            <GradientStop Color="#8B5CF6" Offset="0.5"/>
                                                                            <GradientStop Color="#1E1B4B" Offset="1.0"/>
                                                                        </RadialGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <TextBlock Text="AI Ядро"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12"
                                                                           HorizontalAlignment="Center" />
                                                                <TextBlock Text="Dynamic Island"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="10"
                                                                           HorizontalAlignment="Center"
                                                                           Margin="0,1,0,0" />
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Card 2: Cyber Visor -->
                                                        <Button x:Name="SkinCyberVisorButton"
                                                                Grid.Column="2"
                                                                Style="{StaticResource SkinCardButtonStyle}"
                                                                Click="SkinCyberVisorButton_Click">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <Border Width="32" Height="22" CornerRadius="5" Background="#050508" BorderBrush="#00F0FF" BorderThickness="1" Margin="0,3,0,6">
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Rectangle Width="7" Height="2" Fill="#00F0FF" RadiusX="1" RadiusY="1" Margin="0,0,3,0"/>
                                                                        <Rectangle Width="7" Height="2" Fill="#00F0FF" RadiusX="1" RadiusY="1"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <TextBlock Text="Кибер-Визор"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12"
                                                                           HorizontalAlignment="Center" />
                                                                <TextBlock Text="Светящиеся глаза"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="10"
                                                                           HorizontalAlignment="Center"
                                                                           Margin="0,1,0,0" />
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Card 3: Custom PNG -->
                                                        <Button x:Name="SkinCustomImageButton"
                                                                Grid.Column="4"
                                                                Style="{StaticResource SkinCardButtonStyle}"
                                                                Click="SkinCustomImageButton_Click">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <Border Width="28" Height="28" CornerRadius="6" Background="#1C1F2E" BorderBrush="#374151" BorderThickness="1" Margin="0,0,0,6">
                                                                    <Path Data="{StaticResource IconPlus}"
                                                                          Stroke="{StaticResource TextSecondaryBrush}"
                                                                          StrokeThickness="1.8"
                                                                          Width="12" Height="12"
                                                                          Stretch="Uniform"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="Свой PNG..."
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12"
                                                                           HorizontalAlignment="Center" />
                                                                <TextBlock x:Name="CustomSkinSubtitleText"
                                                                           Text="Выбрать файл"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="10"
                                                                           HorizontalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="100"
                                                                           Margin="0,1,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Separator -->
                                                    <Border Height="1" Background="#1E1E26" Margin="0,0,0,14" />

                                                    <!-- Target Monitor -->
                                                    <Grid Height="48">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Целевой монитор отображения"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="Medium" />
                                                            <TextBlock Text="Экран для воспроизведения видеороликов и персонажа"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <ComboBox x:Name="TargetMonitorComboBox"
                                                                  Grid.Column="1"
                                                                  Width="300"
                                                                  Height="38"
                                                                  VerticalAlignment="Center"
                                                                  SelectionChanged="TargetMonitorComboBox_SelectionChanged" />
                                                    </Grid>

                                                    <!-- Separator -->
                                                    <Border Height="1" Background="#1E1E26" Margin="0,0,0,14" />

                                                    <!-- Dimming Opacity Slider -->
                                                    <Grid Height="48">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="200" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="50" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Затемнение экранов"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="Medium" />
                                                            <TextBlock Text="Прозрачность затемнения оверлея"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Slider x:Name="OpacitySlider"
                                                                Grid.Column="1"
                                                                Minimum="10"
                                                                Maximum="95"
                                                                SmallChange="1"
                                                                LargeChange="5"
                                                                TickFrequency="5"
                                                                IsSnapToTickEnabled="True"
                                                                VerticalAlignment="Center"
                                                                Margin="16,0"
                                                                ValueChanged="Slider_ValueChanged" />
                                                        <TextBlock x:Name="OpacityText"
                                                                   Grid.Column="2"
                                                                   Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat='{}{0:0}%'}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>

                                                    <!-- Separator -->
                                                    <Border Height="1" Background="#1E1E26" Margin="0,0,0,14" />

                                                    <!-- Volume Slider -->
                                                    <Grid Height="48">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="200" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="50" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Громкость видеоплеера"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="Medium" />
                                                            <TextBlock Text="Уровень звука при показе роликов"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Slider x:Name="VolumeSlider"
                                                                Grid.Column="1"
                                                                Minimum="0"
                                                                Maximum="100"
                                                                SmallChange="1"
                                                                LargeChange="5"
                                                                TickFrequency="5"
                                                                IsSnapToTickEnabled="True"
                                                                VerticalAlignment="Center"
                                                                Margin="16,0"
                                                                ValueChanged="Slider_ValueChanged" />
                                                        <TextBlock x:Name="VolumeText"
                                                                   Grid.Column="2"
                                                                   Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat='{}{0:0}%'}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <!-- ================================================= -->
                                <!-- TAB 2: SYSTEM                                     -->
                                <!-- ================================================= -->
                                <Border x:Name="TabSystemContent" Visibility="Collapsed">
                                    <StackPanel>
                                        <!-- Hotkeys Card -->
                                        <Border Background="#141419"
                                                BorderBrush="#23232B"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="20"
                                                Margin="0,0,0,16">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                                                    <Path Data="{StaticResource IconSettings}"
                                                          Stroke="{StaticResource AccentBrush}"
                                                          StrokeThickness="2"
                                                          StrokeLineJoin="Round"
                                                          Width="16" Height="16"
                                                          Stretch="Uniform"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock Text="Горячие клавиши"
                                                               Style="{StaticResource HeaderTextStyle}"
                                                               FontSize="15"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Trigger Hotkey -->
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Хоткей вызова:"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBox x:Name="TriggerHotkeyTextBox"
                                                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                                                 TextChanged="HotkeyTextBox_TextChanged"
                                                                 FontSize="13"
                                                                 Height="38" />
                                                        <TextBlock x:Name="TriggerHotkeyStatusText"
                                                                   Text="Сочетание доступно"
                                                                   Foreground="{StaticResource SuccessBrush}"
                                                                   FontSize="11"
                                                                   Margin="2,4,0,0" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Panic Hotkey -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Хоткей паники (сброс):"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBox x:Name="PanicHotkeyTextBox"
                                                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                                                 TextChanged="HotkeyTextBox_TextChanged"
                                                                 FontSize="13"
                                                                 Height="38" />
                                                        <TextBlock x:Name="PanicHotkeyStatusText"
                                                                   Text="Сочетание доступно"
                                                                   Foreground="{StaticResource SuccessBrush}"
                                                                   FontSize="11"
                                                                   Margin="2,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Windows Startup Card -->
                                        <Border Background="#141419"
                                                BorderBrush="#23232B"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="20">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="Запускать вместе с Windows"
                                                               Style="{StaticResource HeaderTextStyle}"
                                                               FontSize="14" />
                                                    <TextBlock Text="Запуск в фоновом режиме в системном трее при старте системы"
                                                               Style="{StaticResource SubheaderTextStyle}"
                                                               FontSize="12"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                                <CheckBox x:Name="RunOnStartupCheckBox"
                                                          Grid.Column="1"
                                                          Style="{StaticResource MacOsToggleSwitchStyle}"
                                                          VerticalAlignment="Center"
                                                          Click="RunOnStartupCheckBox_Click" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Bottom Footer Bar -->
                        <Border Grid.Row="2"
                                Height="64"
                                BorderBrush="#23232B"
                                BorderThickness="0,1,0,0"
                                Padding="28,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Настройки сохраняются автоматически или по кнопке"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />

                                <Button x:Name="SaveButton"
                                        Grid.Column="1"
                                        Content="✓ Сохранить"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="22,9"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        Click="SaveButton_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ========================================================= -->
                <!-- MODAL OVERLAY: ADD CONTENT (VIDEOS / TEXT REMINDERS)      -->
                <!-- ========================================================= -->
                <Grid x:Name="AddContentModalOverlay"
                      Grid.ColumnSpan="2"
                      Background="#B007080C"
                      Visibility="Collapsed">
                    <Border Width="500"
                            Background="#141419"
                            BorderBrush="#23232B"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.8" />
                        </Border.Effect>
                        <StackPanel>
                            <!-- Modal Header -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Добавить в ротацию"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <Button x:Name="CloseAddModalButton"
                                        Grid.Column="1"
                                        Width="28" Height="28"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="CloseAddModalButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBdr" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <Path Data="{StaticResource IconClose}"
                                                      Stroke="{StaticResource TextSecondaryBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Width="11" Height="11"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBdr" Property="Background" Value="#23232B" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- 1. Selection View -->
                            <StackPanel x:Name="ModalSelectionView" Visibility="Visible">
                                <TextBlock Text="Выберите формат контента для библиотеки провокатора:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,16" />

                                <!-- Card 1: Video File -->
                                <Button x:Name="AddVideoModalCardButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="16,14"
                                        Margin="0,0,0,10"
                                        Click="AddVideoModalCardButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40"
                                                CornerRadius="8"
                                                Background="#228B5CF6"
                                                Margin="0,0,14,0"
                                                VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconVideo}"
                                                  Stroke="#8B5CF6"
                                                  StrokeThickness="1.8"
                                                  Width="18" Height="18"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="🎬 Видеофайл (MP4)"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Локальный видеоролик формата MP4, WMV или AVI"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Card 2: Text Prompt -->
                                <Button x:Name="AddTextModalCardButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="16,14"
                                        Click="AddTextModalCardButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40"
                                                CornerRadius="8"
                                                Background="#2206B6D4"
                                                Margin="0,0,14,0"
                                                VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconPlus}"
                                                  Stroke="#06B6D4"
                                                  StrokeThickness="2"
                                                  Width="18" Height="18"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="✦ Текст / Задача"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Мотивирующая цитата, вызов или напоминание о разминке"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <!-- 2. Text Input View -->
                            <StackPanel x:Name="ModalTextInputView" Visibility="Collapsed">
                                <TextBlock Text="Новое текстовое напоминание:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,8" />
                                <TextBox x:Name="InlineAddTextBox"
                                         Height="84"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"
                                         Padding="12,8"
                                         FontSize="13"
                                         Margin="0,0,0,16" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="CancelAddTextButton"
                                            Content="Назад"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="16,7"
                                            FontSize="12"
                                            Margin="0,0,8,0"
                                            Click="CancelAddTextButton_Click" />
                                    <Button x:Name="ConfirmAddTextButton"
                                            Content="✓ Добавить в список"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="18,7"
                                            FontSize="12"
                                            Click="ConfirmAddTextButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ========================================================= -->
                <!-- FLOATING TOAST HUD (SUCCESS & WARNING NOTIFICATIONS)      -->
                <!-- ========================================================= -->
                <Border x:Name="ToastHudBorder"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,24"
                        Background="#141419"
                        BorderBrush="{StaticResource SuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="16,8"
                        Opacity="0"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.7" />
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ToastTransform" Y="16" />
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="ToastIcon"
                              Data="{StaticResource IconCheck}"
                              Stroke="{StaticResource SuccessBrush}"
                              StrokeThickness="2.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center" />
                        <TextBlock x:Name="ToastMessageTextBlock"
                                   Text="Настройки сохранены"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>