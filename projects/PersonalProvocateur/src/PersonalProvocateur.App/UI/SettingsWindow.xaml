<Window x:Class="PersonalProvocateur.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — Personal Provocateur"
        Width="680"
        Height="620"
        MinWidth="540"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#12131A">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Window Header -->
        <Border Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Настройки Personal Provocateur"
                           Style="{StaticResource HeaderTextStyle}"
                           FontSize="22" />
                <TextBlock Text="Управление расписанием, прозрачностью экрана, горячими клавишами и видеотекой"
                           Style="{StaticResource SubheaderTextStyle}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Settings Content Tabs/Sections -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- Section 1: Schedule & Dimming -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="⏱ Расписание и затемнение"
                                   Style="{StaticResource HeaderTextStyle}"
                                   FontSize="15"
                                   Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Мин. интервал (мин):"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="MinIntervalSlider"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Maximum="120"
                                    SmallChange="1"
                                    LargeChange="5"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="12,0"
                                    ValueChanged="IntervalSliders_ValueChanged" />
                            <TextBlock x:Name="MinIntervalValueText"
                                       Grid.Column="2"
                                       Text="{Binding ElementName=MinIntervalSlider, Path=Value, StringFormat='{}{0:0} м'}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Макс. интервал (мин):"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="MaxIntervalSlider"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Maximum="240"
                                    SmallChange="1"
                                    LargeChange="5"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="12,0"
                                    ValueChanged="IntervalSliders_ValueChanged" />
                            <TextBlock x:Name="MaxIntervalValueText"
                                       Grid.Column="2"
                                       Text="{Binding ElementName=MaxIntervalSlider, Path=Value, StringFormat='{}{0:0} м'}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Затемнение экрана:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="OpacitySlider"
                                    Grid.Column="1"
                                    Minimum="10"
                                    Maximum="95"
                                    SmallChange="1"
                                    LargeChange="5"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="12,0" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat='{}{0:0}%'}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Громкость видео:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="VolumeSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100"
                                    SmallChange="1"
                                    LargeChange="5"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="12,0" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat='{}{0:0}%'}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 2: Hotkeys & System -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="⌨ Горячие клавиши и система"
                                   Style="{StaticResource HeaderTextStyle}"
                                   FontSize="15"
                                   Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Хоткей вызова:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="TriggerHotkeyTextBox" Grid.Column="1" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Хоткей сброса (паника):"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="PanicHotkeyTextBox" Grid.Column="1" />
                        </Grid>

                        <CheckBox x:Name="RunOnStartupCheckBox"
                                  Content="Запускать приложение вместе с Windows"
                                  Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Section 3: Video Library -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🎬 Библиотека видеофайлов"
                                       Style="{StaticResource HeaderTextStyle}"
                                       FontSize="15"
                                       VerticalAlignment="Center" />
                            <Button x:Name="AddVideoButton"
                                    Grid.Column="1"
                                    Content="+ Добавить видео (.mp4)"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="10,6"
                                    FontSize="12"
                                    Click="AddVideoButton_Click" />
                        </Grid>

                        <ListBox x:Name="VideosListBox"
                                 MinHeight="120"
                                 MaxHeight="200"
                                 Background="#12131A"
                                 BorderBrush="{StaticResource CardBorderBrush}"
                                 BorderThickness="1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsEnabled}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  Click="VideoCheckBox_Click" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="Medium"
                                                       FontSize="13" />
                                            <TextBlock Text="{Binding FilePath}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="🗑"
                                                ToolTip="Удалить из библиотеки"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="6,2"
                                                FontSize="12"
                                                Margin="6,0,0,0"
                                                Click="RemoveVideoButton_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="VideoCountTextBlock"
                                   Text="Всего роликов: 0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="TestOverlayButton"
                        Grid.Column="0"
                        Content="⚡ Тест оверлея сейчас"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="TestOverlayButton_Click" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="SaveButton"
                            Content="Сохранить настройки"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveButton_Click" />
                    <Button x:Name="CloseButton"
                            Content="Закрыть"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="10,0,0,0"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
