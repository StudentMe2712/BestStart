<Window x:Class="PersonalProvocateur.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — Personal Provocateur"
        Width="740"
        Height="700"
        MinWidth="600"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#12131A">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Window Header & Quick Status / Actions Bar -->
        <Border Grid.Row="0" Margin="0,0,0,16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Status -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Personal Provocateur"
                                   Style="{StaticResource HeaderTextStyle}"
                                   FontSize="20"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center" />

                        <!-- Status Badge -->
                        <Border x:Name="StatusBadgeBorder"
                                Style="{StaticResource SuccessBadgeStyle}"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StatusBadgeText"
                                       Text="● Активен"
                                       Foreground="{StaticResource SuccessBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <!-- Next Trigger Info -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="⏱ " FontSize="13" VerticalAlignment="Center" />
                        <TextBlock x:Name="NextTriggerTextBlock"
                                   Text="Следующее появление: рассчитывается..."
                                   Style="{StaticResource SubheaderTextStyle}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Quick Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="QuickTestButton"
                            Content="⚡ Проверить сейчас"
                            ToolTip="Мгновенно запустить оверлей с персонажем"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="12,7"
                            FontSize="12"
                            Margin="0,0,8,0"
                            Click="QuickTestButton_Click" />

                    <Button x:Name="QuickPauseButton"
                            Content="⏸ Пауза"
                            ToolTip="Приостановить или возобновить случайные напоминания"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,7"
                            FontSize="12"
                            Click="QuickPauseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Scrollable Settings Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,0,16">
            <StackPanel Margin="0,0,4,0">

                <!-- SECTION 1: Video Library (FR-02) -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="🎬 Библиотека видео (FR-02)"
                                           Style="{StaticResource HeaderTextStyle}"
                                           FontSize="15" />
                                <TextBlock Text="Случайные ролики воспроизводятся после клика по персонажу"
                                           Style="{StaticResource SubheaderTextStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <Button x:Name="AddVideoButton"
                                    Grid.Column="1"
                                    Content="+ Добавить MP4..."
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="14,7"
                                    FontSize="12"
                                    Click="AddVideoButton_Click" />
                        </Grid>

                        <!-- Empty State Notice (shown when 0 videos) -->
                        <Border x:Name="EmptyVideosBorder"
                                Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24,20"
                                Margin="0,0,0,10"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🎬"
                                           FontSize="32"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="В библиотеке пока нет видео"
                                           Style="{StaticResource HeaderTextStyle}"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Добавьте .mp4 файлы, чтобы провокатор воспроизводил их после клика!"
                                           Style="{StaticResource SubheaderTextStyle}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,0,0,12" />
                                <Button Content="+ Выбрать .mp4 файлы"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Padding="14,7"
                                        FontSize="12"
                                        Click="AddVideoButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Video Items List -->
                        <ListBox x:Name="VideosListBox"
                                 MinHeight="120"
                                 MaxHeight="240"
                                 Background="{StaticResource BackgroundBrush}"
                                 BorderBrush="{StaticResource CardBorderBrush}"
                                 BorderThickness="1"
                                 Padding="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="2,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- CheckBox IsEnabled -->
                                            <CheckBox IsChecked="{Binding IsEnabled}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      ToolTip="Включить / исключить ролик из ротации"
                                                      Click="VideoCheckBox_Click" />

                                            <!-- Title, Path & Status Badge -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               VerticalAlignment="Center" />

                                                    <!-- Availability Badge Tag -->
                                                    <Border x:Name="AvailabilityBadge"
                                                            CornerRadius="10"
                                                            Padding="8,2"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock x:Name="AvailabilityText"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding FilePath}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FilePath}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>

                                            <!-- Test Single Video Button -->
                                            <Button Grid.Column="2"
                                                    Content="▶ Тест"
                                                    ToolTip="Воспроизвести этот ролик прямо сейчас"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="10,4"
                                                    FontSize="12"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Click="TestSingleVideo_Click" />

                                            <!-- Remove Video Button -->
                                            <Button Grid.Column="3"
                                                    Content="🗑"
                                                    ToolTip="Удалить из библиотеки"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Padding="8,4"
                                                    FontSize="12"
                                                    VerticalAlignment="Center"
                                                    Click="RemoveVideoButton_Click" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <!-- Note: Availability dynamically formatted in code-behind via ContainerLoaded or Binding -->
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="VideoCountTextBlock"
                                   Text="Всего роликов: 0 (активно: 0)"
                                   Style="{StaticResource SubheaderTextStyle}"
                                   FontSize="12"
                                   Margin="2,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- SECTION 2: Schedule & Dimming (FR-03, FR-04) -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="⏱ Расписание и оверлей (FR-03, FR-04)"
                                   Style="{StaticResource HeaderTextStyle}"
                                   FontSize="15"
                                   Margin="0,0,0,14" />

                        <!-- Min Interval Slider -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Мин. интервал появления:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="MinIntervalSlider"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Maximum="120"
                                    SmallChange="1"
                                    LargeChange="5"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="12,0"
                                    ValueChanged="IntervalSliders_ValueChanged" />
                            <TextBlock x:Name="MinIntervalValueText"
                                       Grid.Column="2"
                                       Text="{Binding ElementName=MinIntervalSlider, Path=Value, StringFormat='{}{0:0} мин'}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Max Interval Slider -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Макс. интервал появления:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="MaxIntervalSlider"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Maximum="480"
                                    SmallChange="1"
                                    LargeChange="5"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="12,0"
                                    ValueChanged="IntervalSliders_ValueChanged" />
                            <TextBlock x:Name="MaxIntervalValueText"
                                       Grid.Column="2"
                                       Text="{Binding ElementName=MaxIntervalSlider, Path=Value, StringFormat='{}{0:0} мин'}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Dimming Opacity Slider -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Затемнение экрана:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="OpacitySlider"
                                    Grid.Column="1"
                                    Minimum="10"
                                    Maximum="95"
                                    SmallChange="1"
                                    LargeChange="5"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="12,0" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat='{}{0:0}%'}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Video Volume Slider -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Громкость видеоплеера:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="VolumeSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100"
                                    SmallChange="1"
                                    LargeChange="5"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="12,0" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat='{}{0:0}%'}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: Hotkeys & System (FR-07, FR-08, FR-09) -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="⌨ Горячие клавиши и система (FR-07, FR-08, FR-09)"
                                   Style="{StaticResource HeaderTextStyle}"
                                   FontSize="15"
                                   Margin="0,0,0,14" />

                        <!-- Trigger Hotkey -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Хоткей вызова:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBox x:Name="TriggerHotkeyTextBox"
                                         TextChanged="HotkeyTextBox_TextChanged" />
                                <TextBlock x:Name="TriggerHotkeyStatusText"
                                           Text="✓ Сочетание доступно"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontSize="11"
                                           Margin="2,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Panic Hotkey -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Хоткей сброса (паника):"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBox x:Name="PanicHotkeyTextBox"
                                         TextChanged="HotkeyTextBox_TextChanged" />
                                <TextBlock x:Name="PanicHotkeyStatusText"
                                           Text="✓ Сочетание доступно"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontSize="11"
                                           Margin="2,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Startup with Windows CheckBox -->
                        <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <CheckBox x:Name="RunOnStartupCheckBox"
                                      Content="Запускать приложение вместе с Windows (FR-09)" />
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 3. Bottom Action Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BottomTestButton"
                        Grid.Column="0"
                        Content="⚡ Проверить оверлей"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="QuickTestButton_Click" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="SaveButton"
                            Content="Сохранить настройки"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveButton_Click" />
                    <Button x:Name="CloseButton"
                            Content="Закрыть"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="10,0,0,0"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
