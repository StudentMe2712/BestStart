<Window x:Class="PersonalProvocateur.App.UI.VideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Provocateur Video"
        WindowStyle="None"
        AllowsTransparency="False"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#12131A"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Icons.xaml" />
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="WindowBorder"
            Background="#12131A"
            BorderThickness="1.5"
            CornerRadius="16"
            SnapsToDevicePixels="True">
        <Border.BorderBrush>
            <SolidColorBrush x:Name="WindowBorderBrush" Color="#34384E" />
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect x:Name="WindowBorderShadow" Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.60" />
        </Border.Effect>

        <Grid Background="#12131A" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar with Floating Close Button -->
            <Grid Grid.Row="0" Background="#181A24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Ellipse Width="10" Height="10" Fill="#8B5CF6" Margin="0,0,8,0" />
                    <TextBlock Text="Мотивационная провокация"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#8B5CF6"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="VideoTitleTextBlock"
                           Grid.Column="1"
                           Text="Воспроизведение..."
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="#F8FAFC"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="16,0" />

                <!-- Floating Close Button (Visible only during manual test mode) -->
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Margin="0,0,12,0"
                        Foreground="#94A3B8"
                        Background="#26293A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        Click="CloseButton_Click"
                        ToolTip="Закрыть видео (Esc)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="16"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="closeIcon"
                                      Data="{StaticResource IconClose}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      Width="11" Height="11"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#EF4444" />
                                    <Setter TargetName="closeIcon" Property="Stroke" Value="#FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Video Player -->
            <Grid Grid.Row="1" Background="#000000">
                <MediaElement x:Name="Player"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Stop"
                              Stretch="Uniform"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              MediaOpened="Player_MediaOpened"
                              MediaEnded="Player_MediaEnded"
                              MediaFailed="Player_MediaFailed" />
            </Grid>

            <!-- Bottom Playback Footer Bar (Progress bar and remaining time) -->
            <Grid Grid.Row="2" Background="#181A24" Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="PlaybackProgressBar"
                             Grid.Column="0"
                             Height="4"
                             VerticalAlignment="Center"
                             Margin="16,0,12,0"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Background="#26293A"
                             Foreground="#8B5CF6"
                             BorderThickness="0"
                             Focusable="False"
                             IsHitTestVisible="False">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="0,2,2,0" />
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <TextBlock x:Name="RemainingTimeTextBlock"
                           Grid.Column="1"
                           Text="--:--"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           Focusable="False" />
            </Grid>

            <!-- Mandatory Watch Notice Overlay (Strict Mandatory Watch Lock, ADR-010) -->
            <Border x:Name="MandatoryWatchNotice"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,20,0,0"
                    Background="#E6181A24"
                    BorderBrush="#EF4444"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Padding="22,12"
                    Opacity="0"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#EF4444" BlurRadius="24" ShadowDepth="0" Opacity="0.55" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconWarning}"
                          Stroke="#EF4444"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="18" Height="18"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center" />
                    <TextBlock Text="Досмотри видео до конца"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
