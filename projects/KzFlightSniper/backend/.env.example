# =====================================================================
# KzFlightSniper Environment Configuration Template
# =====================================================================

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Groq LLM API Configuration (for Natural Language flight parsing)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Timezone Configuration (Standard Kazakhstan Timezone)
TZ=Asia/Atyrau

# SQLite Database Path
DATABASE_PATH=data/sniper.db

# FastAPI Application Server Port
APP_PORT=8000

# Periodic Flight Check Scheduler Tick in Seconds (default: 60 = 1 minute)
CHECK_INTERVAL_SECONDS=60
TICK_INTERVAL_SECONDS=60

# Playwright Headless Browser Mode (true / false)
HEADLESS=true

# Environment & Logging
ENVIRONMENT=production
LOG_LEVEL=INFO
