# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Groq LLM API Key (optional - falls back to resilient local heuristic parser if omitted)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Timezone
TZ=Asia/Almaty

# Application server port
APP_PORT=8000

# SQLite Database location (relative to project or absolute)
DATABASE_PATH=data/sniper.db

# Periodic flight check scheduler tick in seconds (default: 60)
CHECK_INTERVAL_SECONDS=60
TICK_INTERVAL_SECONDS=60

# Travelpayouts / Aviasales Flight Data API Configuration
TRAVELPAYOUTS_TOKEN=321d6a221f8926b5ec41ae89a3b2ae7b
AVIASALES_API_URL=https://api.travelpayouts.com/aviasales/v3/prices_for_dates
AVIASALES_BASE_URL=https://www.aviasales.kz

# Environment (development, testing, production)
ENVIRONMENT=production

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
