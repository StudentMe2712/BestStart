<Window
    x:Class="SecondSelf.UI.Views.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SecondSelf.Core.ViewModels"
    xmlns:conv="using:SecondSelf.UI.Converters"
    mc:Ignorable="d"
    Title="Second Self — Виджет">

    <!-- Корневой контейнер с прозрачным фоном для эффекта Rainmeter Glassmorphism -->
    <Grid x:Name="RootGrid" Background="Transparent" >
        <Grid.Resources>
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Display, Segoe UI Variable Text, Inter, sans-serif</FontFamily>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI Variable Text, Inter, sans-serif" />
            </Style>
            <!-- 1. Световая кромка стеклянных карточек (Specular Rim) -->
            <LinearGradientBrush x:Key="SpecularRimBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#99FFD7B4" Offset="0.0" />
                <GradientStop Color="#20FFFFFF" Offset="1.0" />
            </LinearGradientBrush>

            <!-- 2. Теплое стекло для карточки Today's Focus -->
            <LinearGradientBrush x:Key="WarmGlassCardBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#60D27A38" Offset="0.0" />
                <GradientStop Color="#354A2411" Offset="1.0" />
            </LinearGradientBrush>

            <!-- 3. Атмосферное стекло для Daily Reset -->
            <LinearGradientBrush x:Key="DailyResetPreviewBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#65DE824C" Offset="0.0" />
                <GradientStop Color="#454A2111" Offset="1.0" />
            </LinearGradientBrush>

            <!-- 4. Темное теплое стекло для Quick Hub и детальных представлений -->
            <LinearGradientBrush x:Key="QuickHubGlassBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#553A261C" Offset="0.0" />
                <GradientStop Color="#401E120B" Offset="1.0" />
            </LinearGradientBrush>

            <!-- 5. Стекло для капсулы-триггера / нижнего шеврона -->
            <LinearGradientBrush x:Key="CapsuleBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#663A2218" Offset="0.0" />
                <GradientStop Color="#4420140E" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Анимация перехода: Сворачивание наверх в шеврон-триггер (240 мс, TranslateY: 0 -> -244) -->
            <Storyboard x:Key="CollapseStoryboard" x:Name="CollapseStoryboard" Completed="OnCollapseStoryboardCompleted">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CanvasTranslate" Storyboard.TargetProperty="Y">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.240" Value="-244" KeySpline="0.1, 0.9, 0.2, 1.0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- Анимация перехода: Раскрытие вниз (260 мс, TranslateY: -244 -> 0) -->
            <Storyboard x:Key="ExpandStoryboard" x:Name="ExpandStoryboard" Completed="OnExpandStoryboardCompleted">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CanvasTranslate" Storyboard.TargetProperty="Y">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="-244" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.260" Value="0.0" KeySpline="0.1, 0.9, 0.2, 1.0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- Анимация перехода: Открытие детального списка задач (240 мс) -->
            <Storyboard x:Key="OpenTasksStoryboard" x:Name="OpenTasksStoryboard" Completed="OnOpenTasksStoryboardCompleted">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CompactView" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.160" Value="0.0" KeySpline="0.1, 0.9, 0.2, 1.0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExpandedRoot" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.240" Value="1.0" KeySpline="0.1, 0.9, 0.2, 1.0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- Анимация перехода: Закрытие списка задач обратно в Home (240 мс) -->
            <Storyboard x:Key="CloseTasksStoryboard" x:Name="CloseTasksStoryboard" Completed="OnCloseTasksStoryboardCompleted">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExpandedRoot" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.160" Value="0.0" KeySpline="0.1, 0.9, 0.2, 1.0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CompactView" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.240" Value="1.0" KeySpline="0.1, 0.9, 0.2, 1.0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- Анимация восстановления при выходе из полноэкранного режима (300 мс) -->
            <Storyboard x:Key="FullscreenRestoreStoryboard" x:Name="FullscreenRestoreStoryboard">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WidgetCanvas" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="1.0" KeySpline="0.1, 0.9, 0.2, 1.0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- Анимация перехода: Открытие плеера (220 мс) -->
            <Storyboard x:Key="OpenPlayerStoryboard" x:Name="OpenPlayerStoryboard" Completed="OnOpenPlayerStoryboardCompleted">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CompactView" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.180" Value="0.0" KeySpline="0.1, 0.9, 0.2, 1.0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayerRoot" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.220" Value="1.0" KeySpline="0.1, 0.9, 0.2, 1.0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- Анимация перехода: Закрытие плеера (150 мс) -->
            <Storyboard x:Key="ClosePlayerStoryboard" x:Name="ClosePlayerStoryboard" Completed="OnClosePlayerStoryboardCompleted">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayerRoot" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.100" Value="0.0" KeySpline="0.1, 0.9, 0.2, 1.0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CompactView" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1.0" KeySpline="0.1, 0.9, 0.2, 1.0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </Grid.Resources>

        <!-- Контейнер виджета (Top-Center Rainmeter Panel) -->
        <Grid x:Name="WidgetCanvas"
              HorizontalAlignment="Center"
              VerticalAlignment="Top">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="CanvasTranslate" Y="0" />
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <!-- Строка 0: Контейнер карточек / плеер / настройки -->
                <RowDefinition Height="Auto" />
                <!-- Строка 1: Шеврон/язычок для сворачивания / разворачивания (высота 42px) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- СТРОКА 0: ОБЛАСТЬ КАРТОЧЕК И ЭКРАНОВ -->
            <Grid x:Name="CardsContainer" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <!-- ============================================================== -->
                <!-- ЭТАП 2: КОМПАКТНЫЙ РЕЖИМ (400×244px, Сетка из 3 стеклянных карточек) -->
                <!-- ============================================================== -->
                <Grid x:Name="CompactView"
                      Width="400"
                      Height="244"
                      Opacity="1.0"
                      Visibility="Visible"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="192" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="196" />
                    </Grid.ColumnDefinitions>

                    <!-- КАРТОЧКА 1: Фокус дня (Левая колонка: 192×244px, CornerRadius = 24px) -->
                    <Grid Grid.Column="0">
                        <Border x:Name="TodaysFocusShadowHost"
                                Width="192"
                                Height="244"
                                CornerRadius="24" />
                        <Border x:Name="TodaysFocusCard"
                                Width="192"
                                Height="244"
                                CornerRadius="24"
                                Background="{StaticResource WarmGlassCardBrush}"
                                BorderBrush="{StaticResource SpecularRimBrush}"
                                BorderThickness="1.5"
                                Padding="12,10,12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Верхняя строка карточки: Двустрочный заголовок + кнопка (+) -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Инлайн-ввод новой задачи -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Список задач дня -->
                                    <RowDefinition Height="*" />
                                    <!-- Всплывающий UndoToast -->
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Верхняя строка: Заголовок + кнопка (+) -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="Фокус дня"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               CharacterSpacing="20"
                                               LineHeight="24"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Center" />

                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Width="26"
                                            Height="26"
                                            CornerRadius="13"
                                            Padding="0"
                                            Background="#20FFFFFF"
                                            BorderThickness="0"
                                            PointerPressed="OnInteractivePointerPressed"
                                            Click="OnCompactAddButtonClick"
                                            ToolTipService.ToolTip="Добавить задачу дня (+)">
                                        <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="#FFFFFF" />
                                    </Button>
                                </Grid>

                                <!-- Инлайн-поле ввода новой задачи (активируется по кнопке +) -->
                                <Grid Grid.Row="1"
                                      x:Name="CompactInlineInputGrid"
                                      Visibility="{x:Bind conv:XamlConverters.ToVisibility(ViewModel.IsAddingTask), Mode=OneWay}"
                                      Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="CompactInlineTaskBox"
                                             Grid.Column="0"
                                             PlaceholderText="Что важно сделать сегодня?"
                                             Text="{x:Bind ViewModel.NewTaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="11"
                                             Height="28"
                                             Padding="6,2,6,2"
                                             Foreground="#FFFFFF"
                                             Background="#26FFFFFF"
                                             BorderThickness="1"
                                             BorderBrush="{StaticResource SpecularRimBrush}"
                                             CornerRadius="6"
                                             KeyDown="OnCompactInlineTaskKeyDown" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <Button Width="24"
                                                Height="24"
                                                CornerRadius="12"
                                                Padding="0"
                                                Background="#CE824C"
                                                BorderThickness="0"
                                                PointerPressed="OnInteractivePointerPressed"
                                                Click="OnCompactSubmitTaskClick"
                                                ToolTipService.ToolTip="Добавить">
                                            <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#FFFFFF" />
                                        </Button>
                                        <Button Width="24"
                                                Height="24"
                                                CornerRadius="12"
                                                Padding="0"
                                                Background="#20FFFFFF"
                                                BorderThickness="0"
                                                PointerPressed="OnInteractivePointerPressed"
                                                Click="OnCompactCancelTaskClick"
                                                ToolTipService.ToolTip="Отмена">
                                            <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="#D9FFFFFF" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Список до 3 задач дня (Высота строки 34px, тактильные капсулы, CornerRadius = 14) -->
                                <ItemsControl Grid.Row="2" ItemsSource="{x:Bind ViewModel.CompactTasks, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TaskItemViewModel">
                                            <Border Height="{x:Bind RowHeight, Mode=OneWay}"
                                                    Opacity="{x:Bind RowOpacity, Mode=OneWay}"
                                                    CornerRadius="14"
                                                    Background="#14FFFFFF"
                                                    Margin="0,0,0,6"
                                                    Padding="6,0,6,0"
                                                    PointerEntered="OnCompactTaskRowPointerEntered"
                                                    PointerExited="OnCompactTaskRowPointerExited"
                                                    PointerPressed="OnCompactCapsulePointerPressed">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <!-- Круглый чекбокс 16x16px -->
                                                        <ColumnDefinition Width="Auto" />
                                                        <!-- Текст задачи или поле инлайн-редактирования -->
                                                        <ColumnDefinition Width="*" />
                                                        <!-- Действия при наведении (карандаш + корзина) -->
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Чекбокс 16x16px, CornerRadius = 8px -->
                                                    <Button Grid.Column="0"
                                                            Width="16"
                                                            Height="16"
                                                            CornerRadius="8"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderBrush="#80FFFFFF"
                                                            BorderThickness="1.5"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center"
                                                            PointerPressed="OnInteractivePointerPressed"
                                                            Click="OnCompactTaskCheckboxClick"
                                                            Tag="{x:Bind}"
                                                            ToolTipService.ToolTip="Завершить задачу">
                                                        <FontIcon Glyph="&#xE73E;"
                                                                  FontSize="9"
                                                                  Foreground="#36D399"
                                                                  Visibility="{x:Bind conv:XamlConverters.ToVisibility(IsCheckboxChecked), Mode=OneWay}" />
                                                    </Button>

                                                    <!-- Текст задачи или инлайн TextBox -->
                                                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                   TextDecorations="{x:Bind conv:XamlConverters.ToStrikethrough(IsStrikethrough), Mode=OneWay}"
                                                                   Visibility="{x:Bind conv:XamlConverters.ToInverseVisibility(IsEditing), Mode=OneWay}"
                                                                   FontSize="11"
                                                                   Foreground="#FFFFFF"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   PointerPressed="OnCompactTaskTextPointerPressed"
                                                                   Tag="{x:Bind}" />

                                                        <TextBox Text="{x:Bind EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Visibility="{x:Bind conv:XamlConverters.ToVisibility(IsEditing), Mode=OneWay}"
                                                                 FontSize="11"
                                                                 Foreground="#FFFFFF"
                                                                 Background="#26FFFFFF"
                                                                 BorderThickness="1"
                                                                 BorderBrush="{StaticResource SpecularRimBrush}"
                                                                 CornerRadius="4"
                                                                 Padding="4,1,4,1"
                                                                 KeyDown="OnTaskInlineEditKeyDown"
                                                                 Tag="{x:Bind}" />
                                                    </Grid>

                                                    <!-- Иконки действий при наведении курсора: Карандаш (Edit) и Корзина (Trash) -->
                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                Spacing="2"
                                                                VerticalAlignment="Center"
                                                                Visibility="{x:Bind conv:XamlConverters.ToVisibility(IsHovered), Mode=OneWay}">
                                                        <!-- Карандаш: Редактировать инлайн -->
                                                        <Button Width="20"
                                                                Height="20"
                                                                CornerRadius="10"
                                                                Padding="0"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                PointerPressed="OnInteractivePointerPressed"
                                                                Click="OnCompactTaskEditClick"
                                                                Tag="{x:Bind}"
                                                                ToolTipService.ToolTip="Редактировать">
                                                            <FontIcon Glyph="&#xE70F;" FontSize="9" Foreground="#E6FFFFFF" />
                                                        </Button>

                                                        <!-- Корзина: Удалить с Undo -->
                                                        <Button Width="20"
                                                                Height="20"
                                                                CornerRadius="10"
                                                                Padding="0"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                PointerPressed="OnInteractivePointerPressed"
                                                                Click="OnCompactTaskDeleteClick"
                                                                Tag="{x:Bind}"
                                                                ToolTipService.ToolTip="Удалить">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="9" Foreground="#F87171" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Компонент UndoToast (окно отмены на 5 секунд) -->
                                <Border Grid.Row="3"
                                        x:Name="CompactUndoToast"
                                        Visibility="{x:Bind conv:XamlConverters.ToVisibility(ViewModel.IsUndoToastVisible), Mode=OneWay}"
                                        Margin="0,4,0,0"
                                        Padding="8,4,8,4"
                                        CornerRadius="12"
                                        Background="{StaticResource CapsuleBrush}"
                                        BorderBrush="{StaticResource SpecularRimBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.UndoToastMessage, Mode=OneWay}"
                                                   FontSize="10"
                                                   Foreground="#E6FFFFFF"
                                                   VerticalAlignment="Center" />
                                        <Button Content="Отмена"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="#FFDE824C"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="2,0,2,0"
                                                PointerPressed="OnInteractivePointerPressed"
                                                Click="OnUndoToastClick" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ПРАВАЯ КОЛОНКА (196px): Карточки 2 и 3 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="136" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="96" />
                        </Grid.RowDefinitions>

                        <!-- КАРТОЧКА 2: Daily Reset (196×136px, CornerRadius = 24px) -->
                        <Grid Grid.Row="0">
                            <Border x:Name="DailyResetShadowHost"
                                    Width="196"
                                    Height="136"
                                    CornerRadius="24" />
                            <Border x:Name="DailyResetCard"
                                    Width="196"
                                    Height="136"
                                    CornerRadius="24"
                                    Background="{StaticResource DailyResetPreviewBrush}"
                                    BorderBrush="{StaticResource SpecularRimBrush}"
                                    BorderThickness="1.5"
                                    Padding="14"
                                    PointerPressed="OnDailyResetCardPointerPressed">
                                <Grid>
                                    <!-- Кнопки Настройки (⚙) и Play в правом верхнем углу (26x26px) -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="6">
                                        <Button x:Name="DailyResetSettingsButton"
                                                Width="26"
                                                Height="26"
                                                CornerRadius="13"
                                                Padding="0"
                                                Background="#26FFFFFF"
                                                BorderThickness="0"
                                                PointerPressed="OnInteractivePointerPressed"
                                                Click="OnOpenSettingsClick"
                                                ToolTipService.ToolTip="Настройки видео (⚙)">
                                            <FontIcon Glyph="&#xE713;" FontSize="11" Foreground="#FFFFFF" />
                                        </Button>
                                        <Button Width="26"
                                                Height="26"
                                                CornerRadius="13"
                                                Padding="0"
                                                Background="#26FFFFFF"
                                                BorderThickness="0"
                                                PointerPressed="OnInteractivePointerPressed"
                                                Click="OnOpenPlayerClicked"
                                                ToolTipService.ToolTip="Запустить ритуал дня">
                                            <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="#FFFFFF" Margin="1,0,0,0" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Нижний левый блок: Название и статус готовности -->
                                    <StackPanel VerticalAlignment="Bottom" Spacing="2">
                                        <TextBlock Text="Перезагрузка"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF" />
                                        <TextBlock Text="{x:Bind ViewModel.ResetSubtitle, Mode=OneWay}"
                                                   FontSize="12"
                                                   FontWeight="Normal"
                                                   Opacity="0.75"
                                                   Foreground="#FFFFFF"
                                                   Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- КАРТОЧКА 3: Quick Hub / Progress (196×96px, CornerRadius = 24px) -->
                        <Grid Grid.Row="2">
                            <Border x:Name="QuickHubShadowHost"
                                    Width="196"
                                    Height="96"
                                    CornerRadius="24" />
                            <Border x:Name="QuickHubCard"
                                    Width="196"
                                    Height="96"
                                    CornerRadius="24"
                                    Background="{StaticResource QuickHubGlassBrush}"
                                    BorderBrush="{StaticResource SpecularRimBrush}"
                                    BorderThickness="1.5"
                                    Padding="14,10"
                                    PointerPressed="OnCardPointerPressed">
                                <Grid VerticalAlignment="Center">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{x:Bind ViewModel.DisplayScorePercent, Mode=OneWay}"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   Foreground="#36D399"
                                                   Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Text="{x:Bind ViewModel.MonthlySummarySubtitle, Mode=OneWay}"
                                                   FontSize="12"
                                                   FontWeight="Normal"
                                                   Opacity="0.75"
                                                   Foreground="#FFFFFF"
                                                   TextTrimming="CharacterEllipsis" />
                                        <!-- Прогресс-бар строго пропорциональный DisplayScore -->
                                        <Grid Width="168" Height="4" HorizontalAlignment="Left" Margin="0,3,0,0">
                                            <Border Width="168" Height="4" CornerRadius="2" Background="#26FFFFFF" />
                                            <Border Height="4" CornerRadius="2" Background="#36D399" HorizontalAlignment="Left"
                                                    Width="{x:Bind ViewModel.ProgressBarWidth, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ============================================================== -->
                <!-- ЭТАП 4: ЭКРАН ВИДЕОПЛЕЕРА (800×600px, Теплое темное стекло) -->
                <!-- ============================================================== -->
                <Grid x:Name="PlayerRoot"
                      Width="800"
                      Height="600"
                      Opacity="0.0"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
                    <Border x:Name="PlayerShadowHost" Width="800" Height="600" CornerRadius="24" />
                    <Border x:Name="PlayerView"
                            Width="800"
                            Height="600"
                            CornerRadius="24"
                            Background="{StaticResource QuickHubGlassBrush}"
                            BorderBrush="{StaticResource SpecularRimBrush}"
                            BorderThickness="1.5"
                            Padding="18,14,18,14"
                            PointerPressed="OnCardPointerPressed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Строка 0: Верхняя строка состояния (Заголовок, статус-бейдж) -->
                                <RowDefinition Height="Auto" />
                                <!-- Строка 1: Видеоконтейнер (Height="420", Stretch="UniformToFill", CornerRadius="16") -->
                                <RowDefinition Height="420" />
                                <!-- Строка 2: Строка таймкода и громкости (Time & Audio Bar) -->
                                <RowDefinition Height="Auto" />
                                <!-- Строка 3: Неперематываемая полоса прогресса (IsHitTestVisible = false) -->
                                <RowDefinition Height="Auto" />
                                <!-- Строка 4: Кнопка «Засчитать выполнение» -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- СТРОКА 0: ВЕРХНЯЯ СТРОКА СОСТОЯНИЯ -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button x:Name="PlayerBackButton"
                                            Width="28"
                                            Height="28"
                                            CornerRadius="14"
                                            Background="#26FFFFFF"
                                            BorderThickness="0"
                                            Padding="0"
                                            PointerPressed="OnInteractivePointerPressed"
                                            Click="OnPlayerCloseClick"
                                            ToolTipService.ToolTip="Назад к карточкам (Esc)">
                                        <FontIcon Glyph="&#xE72B;" FontSize="12" Foreground="#FFFFFF" />
                                    </Button>
                                    <TextBlock Text="Перезагрузка"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Height="24"
                                            CornerRadius="12"
                                            Background="{x:Bind GetStatusBackground(ViewModel.Player.StatusText), Mode=OneWay}"
                                            Padding="10,0,10,0">
                                        <TextBlock Text="{x:Bind ViewModel.Player.StatusText, Mode=OneWay}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="{x:Bind GetStatusForeground(ViewModel.Player.StatusText), Mode=OneWay}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- СТРОКА 1: ВИДЕОКОНТЕЙНЕР (CornerRadius="16", Height="420", Stretch="UniformToFill") -->
                            <Grid Grid.Row="1" CornerRadius="16" Margin="0,0,0,10">
                                <MediaPlayerElement x:Name="DailyResetMediaPlayerElement"
                                                    Height="420"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Stretch="UniformToFill"
                                                    Visibility="Collapsed"
                                                    AreTransportControlsEnabled="False"
                                                    AutoPlay="True"
                                                    PointerPressed="OnVideoViewportPointerPressed" />

                                <Border x:Name="FallbackAtmosphereBorder"
                                        Height="420"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        CornerRadius="16"
                                        Background="{StaticResource DailyResetPreviewBrush}"
                                        BorderBrush="{StaticResource SpecularRimBrush}"
                                        BorderThickness="1"
                                        Visibility="Visible"
                                        PointerPressed="OnVideoViewportPointerPressed">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                            <Border Width="48"
                                                    Height="48"
                                                    CornerRadius="24"
                                                    Background="#33FFFFFF"
                                                    BorderBrush="{StaticResource SpecularRimBrush}"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="#FFFFFF" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Ежедневный ритуал"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="24"
                                        Background="#4D000000"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind InvertBoolToVisibility(ViewModel.Player.IsPlaying), Mode=OneWay}"
                                        IsHitTestVisible="False">
                                    <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="#FFFFFF" Margin="2,0,0,0" />
                                </Border>
                            </Grid>

                            <!-- СТРОКА 2: СТРОКА ТАЙМКОДА И ЯНТАРНОЙ ГРОМКОСТИ -->
                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <TextBlock HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.Player.FormattedTimecode, Mode=OneWay}"
                                           FontSize="12"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="#B3FFFFFF" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                                    <Button Width="26"
                                            Height="26"
                                            CornerRadius="13"
                                            Padding="0"
                                            Background="#14FFFFFF"
                                            BorderThickness="0"
                                            PointerPressed="OnInteractivePointerPressed"
                                            Click="OnPlayerMuteClick"
                                            ToolTipService.ToolTip="Вкл/выкл звук">
                                        <FontIcon Glyph="{x:Bind GetMuteGlyph(ViewModel.Player.IsMuted), Mode=OneWay}"
                                                  FontSize="11"
                                                  Foreground="#FFFFFF" />
                                    </Button>

                                    <!-- Янтарный ползунок громкости (#D27A38) -->
                                    <Slider Width="90"
                                            Minimum="0.0"
                                            Maximum="1.0"
                                            StepFrequency="0.05"
                                            Value="{x:Bind ViewModel.Player.Volume, Mode=OneWay}"
                                            ValueChanged="OnPlayerVolumeChanged"
                                            VerticalAlignment="Center"
                                            Foreground="#D27A38"
                                            ToolTipService.ToolTip="Громкость">
                                        <Slider.Resources>
                                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#D27A38" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#E58B49" />
                                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#BA6828" />
                                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#D27A38" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#E58B49" />
                                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#BA6828" />
                                        </Slider.Resources>
                                    </Slider>
                                </StackPanel>
                            </Grid>

                            <!-- СТРОКА 3: БЛОКИРОВКА ПЕРЕМОТКИ (Non-seekable Progress Bar, IsHitTestVisible = false) -->
                            <Grid Grid.Row="3" Width="760" Height="4" HorizontalAlignment="Left" Margin="0,0,0,8" IsHitTestVisible="False">
                                <Border Width="760"
                                        Height="4"
                                        CornerRadius="2"
                                        Background="#26FFFFFF"
                                        IsHitTestVisible="False" />
                                <Border Height="4"
                                        CornerRadius="2"
                                        Background="#D27A38"
                                        HorizontalAlignment="Left"
                                        Width="{x:Bind ViewModel.Player.ProgressBarWidth, Mode=OneWay}"
                                        IsHitTestVisible="False" />
                            </Grid>

                            <!-- СТРОКА 4: ФИНАЛЬНАЯ КНОПКА «ЗАСЧИТАТЬ ВЫПОЛНЕНИЕ» -->
                            <Grid Grid.Row="4">
                                <Button x:Name="CountRitualButton"
                                        Height="44"
                                        CornerRadius="10"
                                        Background="#D27A38"
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch"
                                        FontWeight="SemiBold"
                                        Visibility="{x:Bind BoolToVisibility(ViewModel.Player.IsCountButtonVisible), Mode=OneWay}"
                                        Click="OnCountRitualButtonClick"
                                        PointerPressed="OnInteractivePointerPressed"
                                        ToolTipService.ToolTip="Засчитать выполнение ежедневного ритуала">
                                    <Button.RenderTransform>
                                        <TranslateTransform x:Name="CountButtonTransform" Y="0" />
                                    </Button.RenderTransform>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#FFFFFF" />
                                        <TextBlock Text="Засчитать выполнение"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Плавающее янтарное Toast-уведомление поверх экрана -->
                    <Border x:Name="RitualCompletedToast"
                            Visibility="Collapsed"
                            CornerRadius="12"
                            Background="#E6D27A38"
                            BorderBrush="#FFD7B4"
                            BorderThickness="1.5"
                            Padding="24, 16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" Spacing="6">
                            <TextBlock Text="✨ Ежедневный ритуал выполнен!"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="+1 к итогу месяца зафиксирован"
                                       FontSize="12"
                                       Foreground="#FFF0E6"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============================================================== -->
                <!-- ЭТАП 3: РАСКРЫТЫЙ РЕЖИМ (400×244px, сохранен для тестов/деталей) -->
                <!-- ============================================================== -->
                <Grid x:Name="ExpandedRoot"
                      Width="400"
                      Height="244"
                      Opacity="0.0"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
                    <Border x:Name="ExpandedShadowHost" CornerRadius="24" />
                    <Border x:Name="ExpandedView"
                            Width="400"
                            Height="244"
                            CornerRadius="24"
                            Background="{StaticResource QuickHubGlassBrush}"
                            BorderBrush="{StaticResource SpecularRimBrush}"
                            BorderThickness="1.5"
                            Padding="14,10,14,10"
                            PointerPressed="OnCardPointerPressed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Width="26"
                                            Height="26"
                                            CornerRadius="13"
                                            Padding="0"
                                            Background="#26FFFFFF"
                                            BorderThickness="0"
                                            PointerPressed="OnInteractivePointerPressed"
                                            Click="OnBackToHomeClick"
                                            ToolTipService.ToolTip="← Назад к карточкам">
                                        <FontIcon Glyph="&#xE72B;" FontSize="11" Foreground="#FFFFFF" />
                                    </Button>
                                    <TextBlock Text="Фокус дня"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Button HorizontalAlignment="Right"
                                        Width="26"
                                        Height="26"
                                        CornerRadius="13"
                                        Padding="0"
                                        Background="#14FFFFFF"
                                        BorderThickness="0"
                                        PointerPressed="OnInteractivePointerPressed"
                                        Click="OnOpenDashboardClick"
                                        ToolTipService.ToolTip="Открыть личное пространство">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="11" Foreground="#FFFFFF" />
                                </Button>
                            </Grid>

                            <ScrollViewer x:Name="TasksScrollViewer"
                                          Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TaskItemViewModel">
                                            <Border Height="{x:Bind RowHeight, Mode=OneWay}"
                                                    Opacity="{x:Bind RowOpacity, Mode=OneWay}"
                                                    CornerRadius="8"
                                                    Background="#0AFFFFFF"
                                                    Margin="0,0,0,4"
                                                    Padding="8,0,8,0">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Width="16"
                                                            Height="16"
                                                            CornerRadius="8"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderBrush="#59FFFFFF"
                                                            BorderThickness="1.5"
                                                            Margin="0,0,8,0"
                                                            PointerPressed="OnInteractivePointerPressed"
                                                            Click="OnTaskCheckboxClick"
                                                            Tag="{x:Bind}">
                                                        <FontIcon Glyph="&#xE73E;"
                                                                  FontSize="9"
                                                                  Foreground="#36D399"
                                                                  Visibility="{x:Bind conv:XamlConverters.ToVisibility(IsCheckboxChecked), Mode=OneWay}" />
                                                    </Button>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind Title, Mode=OneWay}"
                                                               TextDecorations="{x:Bind conv:XamlConverters.ToStrikethrough(IsStrikethrough), Mode=OneWay}"
                                                               FontSize="12"
                                                               Foreground="#FFFFFF"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Grid.Row="2"
                                    Visibility="{x:Bind conv:XamlConverters.ToVisibility(ViewModel.IsUndoToastVisible), Mode=OneWay}"
                                    Margin="0,4,0,0"
                                    Padding="8,4,8,4"
                                    CornerRadius="12"
                                    Background="{StaticResource CapsuleBrush}"
                                    BorderBrush="{StaticResource SpecularRimBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.UndoToastMessage, Mode=OneWay}"
                                               FontSize="11"
                                               Foreground="#E6FFFFFF"
                                               VerticalAlignment="Center" />
                                    <Button Content="Отменить"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="#FFDE824C"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="2,0,2,0"
                                            PointerPressed="OnInteractivePointerPressed"
                                            Click="OnUndoToastClick" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================================================== -->
                <!-- ЭТАП 5: ЭКРАН НАСТРОЕК ВИДЕО (840×620px, Теплое темное стекло) -->
                <!-- ============================================================== -->
                <Grid x:Name="SettingsRoot"
                      Width="840"
                      Height="620"
                      Opacity="0.0"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
                    <Border x:Name="SettingsShadowHost" Width="840" Height="620" CornerRadius="24" />
                    <Border x:Name="SettingsView"
                            Width="840"
                            Height="620"
                            CornerRadius="24"
                            Background="{StaticResource QuickHubGlassBrush}"
                            BorderBrush="{StaticResource SpecularRimBrush}"
                            BorderThickness="1.5"
                            Padding="20,16,20,16"
                            PointerPressed="OnCardPointerPressed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Строка 0: Верхняя строка (Назад, заголовок, кнопки добавления) -->
                                <RowDefinition Height="Auto" />
                                <!-- Строка 1: Список видеофайлов -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button x:Name="SettingsBackButton"
                                            Width="30"
                                            Height="30"
                                            CornerRadius="15"
                                            Padding="0"
                                            Background="#26FFFFFF"
                                            BorderThickness="0"
                                            PointerPressed="OnInteractivePointerPressed"
                                            Click="OnSettingsBackClick"
                                            ToolTipService.ToolTip="Назад к карточкам (Esc)">
                                        <FontIcon Glyph="&#xE72B;" FontSize="12" Foreground="#FFFFFF" />
                                    </Button>
                                    <TextBlock Text="Видеотека"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
                                    <Button x:Name="SelectVideoFolderButton"
                                            Height="36"
                                            CornerRadius="8"
                                            Padding="14,0,14,0"
                                            Background="#26FFFFFF"
                                            BorderThickness="0"
                                            PointerPressed="OnInteractivePointerPressed"
                                            Click="OnSelectVideoFolderClick"
                                            ToolTipService.ToolTip="Выбрать папку с видеофайлами">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xED25;" FontSize="14" Foreground="#FFDE824C" />
                                            <TextBlock Text="📁 Выбрать папку с видео" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="AddVideoFilesButton"
                                            Height="36"
                                            CornerRadius="8"
                                            Padding="14,0,14,0"
                                            Background="#D27A38"
                                            BorderThickness="0"
                                            PointerPressed="OnInteractivePointerPressed"
                                            Click="OnAddVideoFilesClick"
                                            ToolTipService.ToolTip="Добавить видеофайлы (MP4, MKV, WebM, MOV)">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="#FFFFFF" />
                                            <TextBlock Text="+ Добавить видеофайлы" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="8">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.VideoItems, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:VideoLibraryItemViewModel">
                                                <Border CornerRadius="12"
                                                        Background="#14FFFFFF"
                                                        Margin="0,0,0,8"
                                                        Padding="10">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <!-- Превью 160x90 -->
                                                            <ColumnDefinition Width="Auto" />
                                                            <!-- Инфо о файле -->
                                                            <ColumnDefinition Width="*" />
                                                            <!-- Кнопка удаления -->
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Превью 160x90 -->
                                                        <Grid Grid.Column="0" Width="160" Height="90" CornerRadius="8" Margin="0,0,16,0">
                                                            <Border CornerRadius="8" Background="{StaticResource DailyResetPreviewBrush}">
                                                                <FontIcon Glyph="&#xE714;" FontSize="28" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <Image Source="{x:Bind ThumbnailCachePath, Mode=OneWay}"
                                                                   Stretch="UniformToFill"
                                                                   Visibility="{x:Bind conv:XamlConverters.StringNotEmptyToVisibility(ThumbnailCachePath), Mode=OneWay}" />
                                                        </Grid>

                                                        <!-- Название, длительность, статус -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                                            <TextBlock Text="{x:Bind FileName, Mode=OneWay}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#FFFFFF"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                    <FontIcon Glyph="&#xE916;" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{x:Bind FormattedDuration, Mode=OneWay}"
                                                                               FontSize="12"
                                                                               Foreground="#B3FFFFFF"
                                                                               Typography.NumeralAlignment="Tabular"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>

                                                                <Border CornerRadius="4"
                                                                        Background="{x:Bind conv:XamlConverters.ToStatusBackgroundBrush(StatusText), Mode=OneWay}"
                                                                        Padding="8,3"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                                               FontSize="11"
                                                                               FontWeight="Medium"
                                                                               Foreground="{x:Bind conv:XamlConverters.ToStatusForegroundBrush(StatusText), Mode=OneWay}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Кнопка удаления -->
                                                        <Button Grid.Column="2"
                                                                Width="32"
                                                                Height="32"
                                                                CornerRadius="16"
                                                                Padding="0"
                                                                Background="#1FFFFFFF"
                                                                BorderThickness="0"
                                                                PointerPressed="OnInteractivePointerPressed"
                                                                Click="OnDeleteVideoItemClick"
                                                                Tag="{x:Bind}"
                                                                ToolTipService.ToolTip="Удалить видео">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#F87171" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Пустое состояние -->
                                    <TextBlock Text="Видеофайлы отсутствуют. Добавьте файлы MP4/MKV или выберите папку."
                                               FontSize="12"
                                               Foreground="#80FFFFFF"
                                               HorizontalAlignment="Center"
                                               Margin="0,30,0,0"
                                               Visibility="{x:Bind GetEmptyVideosVisibility(ViewModel.VideoItems.Count), Mode=OneWay}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- СТРОКА 1: НИЖНИЙ ШЕВРОН/ЯЗЫЧОК СВОРАЧИВАНИЯ (42px) -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Border x:Name="BottomTabTrigger"
                        Width="260"
                        Height="42"
                        CornerRadius="0,0,21,21"
                        Background="{StaticResource CapsuleBrush}"
                        BorderBrush="{StaticResource SpecularRimBrush}"
                        BorderThickness="1,0,1,1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        PointerPressed="OnBottomTabPointerPressed"
                        PointerEntered="OnBottomTabPointerEntered"
                        PointerExited="OnBottomTabPointerExited"
                        ToolTipService.ToolTip="{x:Bind GetChevronToolTip(ViewModel.IsExpanded), Mode=OneWay}">
                    <Grid Padding="10,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Шестерёнка настроек слева -->
                        <Button x:Name="OpenSettingsButton"
                                Grid.Column="0"
                                Width="26"
                                Height="26"
                                CornerRadius="13"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                PointerPressed="OnInteractivePointerPressed"
                                Click="OnOpenSettingsClick"
                                ToolTipService.ToolTip="Настройки видео (⚙)">
                            <FontIcon Glyph="&#xE713;" FontSize="11" Foreground="#FFDE824C" />
                        </Button>

                        <!-- Центр: Second Self и шеврон -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                            <Image Source="ms-appx:///Assets/secondself-tray-16.png" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="Second Self" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <FontIcon Glyph="{x:Bind GetChevronGlyph(ViewModel.IsExpanded), Mode=OneWay}" FontSize="10" Foreground="#FFDE824C" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Кнопка перехода в Личное пространство (Dashboard) ↗ справа -->
                        <Button x:Name="OpenDashboardButton"
                                Grid.Column="2"
                                Width="26"
                                Height="26"
                                CornerRadius="13"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                PointerPressed="OnInteractivePointerPressed"
                                Click="OnOpenDashboardClick"
                                ToolTipService.ToolTip="Личное пространство (↗)">
                            <FontIcon Glyph="&#xE8A7;" FontSize="11" Foreground="#FFDE824C" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
