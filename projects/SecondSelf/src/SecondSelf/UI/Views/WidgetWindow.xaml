<Window
    x:Class="SecondSelf.UI.Views.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SecondSelf.Core.ViewModels"
    xmlns:conv="using:SecondSelf.UI.Converters"
    mc:Ignorable="d"
    Title="Second Self Widget">

    <!-- Корневой контейнер с прозрачным фоном -->
    <Grid x:Name="RootGrid" Background="Transparent" PointerPressed="OnWindowPointerPressed">
        <Grid.Resources>
            <!-- Световая кромка стеклянных карточек (Specular Rim) -->
            <LinearGradientBrush x:Key="SpecularRimBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#61FFCDA0" Offset="0.0" />
                <GradientStop Color="#0FFFFFFF" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Атмосферный градиент для превью Daily Reset -->
            <LinearGradientBrush x:Key="DailyResetPreviewBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFDE824C" Offset="0.0" />
                <GradientStop Color="#FF91461D" Offset="0.55" />
                <GradientStop Color="#FF3D1807" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Анимация перехода: Сворачивание в Компактный режим (240 мс, CubicBezier 0.16, 1.0, 0.3, 1.0) -->
            <Storyboard x:Key="CollapseStoryboard" x:Name="CollapseStoryboard" Completed="OnCollapseStoryboardCompleted">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WidgetCanvas" Storyboard.TargetProperty="Width">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.240" Value="360" KeySpline="0.16, 1.0, 0.3, 1.0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WidgetCanvas" Storyboard.TargetProperty="Height">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.240" Value="240" KeySpline="0.16, 1.0, 0.3, 1.0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExpandedView" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.180" Value="0.0" KeySpline="0.16, 1.0, 0.3, 1.0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CompactView" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.240" Value="1.0" KeySpline="0.16, 1.0, 0.3, 1.0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- Анимация перехода: Раскрытие вниз (280 мс, Spring Out CubicBezier 0.16, 1.0, 0.3, 1.0) -->
            <Storyboard x:Key="ExpandStoryboard" x:Name="ExpandStoryboard" Completed="OnExpandStoryboardCompleted">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WidgetCanvas" Storyboard.TargetProperty="Width">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.280" Value="380" KeySpline="0.16, 1.0, 0.3, 1.0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WidgetCanvas" Storyboard.TargetProperty="Height">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.280" Value="680" KeySpline="0.16, 1.0, 0.3, 1.0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CompactView" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.160" Value="0.0" KeySpline="0.16, 1.0, 0.3, 1.0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExpandedView" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.280" Value="1.0" KeySpline="0.16, 1.0, 0.3, 1.0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- Анимация восстановления при выходе из полноэкранного режима (300 мс) -->
            <Storyboard x:Key="FullscreenRestoreStoryboard" x:Name="FullscreenRestoreStoryboard">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WidgetCanvas" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="1.0" KeySpline="0.16, 1.0, 0.3, 1.0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </Grid.Resources>
        
        <!-- Контейнер виджета с привязкой к правому верхнему углу (Top-Right Anchor) -->
        <Grid x:Name="WidgetCanvas"
              Width="360"
              Height="240"
              HorizontalAlignment="Right"
              VerticalAlignment="Top">

            <!-- ============================================================== -->
            <!-- ЭТАП 2: КОМПАКТНЫЙ РЕЖИМ (360×240px, Сетка из 3 стеклянных карточек) -->
            <!-- ============================================================== -->
            <Grid x:Name="CompactView"
                  Width="360"
                  Height="240"
                  Opacity="1.0"
                  Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="178" />
                </Grid.ColumnDefinitions>

                <!-- КАРТОЧКА 1: Today's Focus (Левая колонка: 170×240px, CornerRadius = 24px) -->
                <Border Grid.Column="0"
                        Width="170"
                        Height="240"
                        CornerRadius="24"
                        Background="#709C522B"
                        BorderBrush="{StaticResource SpecularRimBrush}"
                        BorderThickness="1"
                        Padding="16"
                        PointerPressed="OnCardPointerPressed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Верхняя строка карточки: Двустрочный заголовок + круглая кнопка добавления -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Today's"
                                           FontSize="22"
                                           FontWeight="Medium"
                                           Foreground="#FFFFFF"
                                           LineHeight="26" />
                                <TextBlock Text="Focus"
                                           FontSize="22"
                                           FontWeight="Medium"
                                           Foreground="#FFFFFF"
                                           LineHeight="26" />
                            </StackPanel>

                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Width="28"
                                    Height="28"
                                    CornerRadius="14"
                                    Padding="0"
                                    Background="#14FFFFFF"
                                    BorderThickness="0"
                                    Click="OnCompactAddButtonClick"
                                    ToolTipService.ToolTip="Добавить задачу дня">
                                <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="#FFFFFF" />
                            </Button>
                        </Grid>

                        <!-- Список до 3 задач дня в виде тактильных капсул (Height = 34px, CornerRadius = 17px) -->
                        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.CompactTasks, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskItemViewModel">
                                    <Border Height="34"
                                            CornerRadius="17"
                                            Background="#14FFFFFF"
                                            Margin="0,0,0,8"
                                            Padding="10,0,10,0"
                                            PointerEntered="OnCapsulePointerEntered"
                                            PointerExited="OnCapsulePointerExited">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Чекбокс 14x14px -->
                                            <Border Grid.Column="0"
                                                    Width="14"
                                                    Height="14"
                                                    CornerRadius="7"
                                                    BorderBrush="#59FFFFFF"
                                                    BorderThickness="1.5"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center" />

                                            <!-- Усечённый текст задачи -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Title, Mode=OneWay}"
                                                       FontSize="12"
                                                       Foreground="#FFFFFF"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- ПРАВАЯ КОЛОНКА (178px): Карточки 2 и 3 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="140" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="88" />
                    </Grid.RowDefinitions>

                    <!-- КАРТОЧКА 2: Daily Reset (Правая верхняя: 178×140px, CornerRadius = 24px) -->
                    <Border Grid.Row="0"
                            Width="178"
                            Height="140"
                            CornerRadius="24"
                            Background="{StaticResource DailyResetPreviewBrush}"
                            BorderBrush="{StaticResource SpecularRimBrush}"
                            BorderThickness="1"
                            Padding="14"
                            PointerPressed="OnCardPointerPressed">
                        <Grid>
                            <!-- Круглая кнопка Play / Open в правом верхнем углу (26x26px) -->
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Width="26"
                                    Height="26"
                                    CornerRadius="13"
                                    Padding="0"
                                    Background="#26FFFFFF"
                                    BorderThickness="0"
                                    Click="OnCardClicked">
                                <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="#FFFFFF" Margin="1,0,0,0" />
                            </Button>

                            <!-- Нижний левый блок: Название и статус готовности -->
                            <StackPanel VerticalAlignment="Bottom" Spacing="2">
                                <TextBlock Text="Daily Reset"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF" />
                                <TextBlock Text="{x:Bind ViewModel.ResetSubtitle, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="#B3FFFFFF" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- КАРТОЧКА 3: Quick Hub / Progress (Правая нижняя: 178×88px, CornerRadius = 24px) -->
                    <Border Grid.Row="2"
                            Width="178"
                            Height="88"
                            CornerRadius="24"
                            Background="#9E30221C"
                            BorderBrush="{StaticResource SpecularRimBrush}"
                            BorderThickness="1"
                            Padding="14,12"
                            PointerPressed="OnCardPointerPressed">
                        <Grid VerticalAlignment="Center">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{x:Bind ViewModel.CompactProgressText, Mode=OneWay}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#36D399" />
                                <TextBlock Text="Focus score"
                                           FontSize="11"
                                           Foreground="#ADFFFFFF" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============================================================== -->
            <!-- ЭТАП 3: РАСКРЫТЫЙ РЕЖИМ (380×680px, Глубокий обсидиановый графит) -->
            <!-- ============================================================== -->
            <Border x:Name="ExpandedView"
                    Width="380"
                    Height="680"
                    Opacity="0.0"
                    Visibility="Collapsed"
                    CornerRadius="20"
                    Background="#F20B0B0D"
                    BorderBrush="#1EFFFFFF"
                    BorderThickness="1"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Блок 1: Today's Focus -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!-- Блок 2: Daily Reset -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!-- Блок 3: This Month -->
                        <RowDefinition Height="*" />
                        <!-- Нижняя стрелка сворачивания -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- БЛОК 1: TODAY'S FOCUS (Список задач дня) -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Заголовочная строка Блока 1 -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Today's Focus"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF" />
                                <TextBlock Text="Your daily direction"
                                           FontSize="12"
                                           Foreground="#ADFFFFFF" />
                            </StackPanel>

                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="24"
                                    Height="24"
                                    CornerRadius="12"
                                    Padding="0"
                                    Background="#14FFFFFF"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1"
                                    Click="OnExpandedAddButtonClick"
                                    ToolTipService.ToolTip="Добавить задачу">
                                <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="#FFFFFF" />
                            </Button>
                        </Grid>

                        <!-- Инлайн-поле ввода новой задачи (активируется по кнопке +) -->
                        <Grid Grid.Row="1"
                              x:Name="InlineInputGrid"
                              Visibility="{x:Bind BoolToVisibility(ViewModel.IsAddingTask), Mode=OneWay}"
                              Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="InlineTaskTextBox"
                                     Grid.Column="0"
                                     PlaceholderText="Введите задачу дня..."
                                     Text="{x:Bind ViewModel.NewTaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13"
                                     Foreground="#FFFFFF"
                                     Background="#1EFFFFFF"
                                     BorderThickness="1"
                                     BorderBrush="#33FFFFFF"
                                     CornerRadius="6"
                                     KeyDown="OnInlineTaskTextBoxKeyDown" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="6,0,0,0">
                                <Button Width="28"
                                        Height="28"
                                        CornerRadius="14"
                                        Padding="0"
                                        Background="#CE824C"
                                        BorderThickness="0"
                                        Click="OnSubmitNewTaskClick">
                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#FFFFFF" />
                                </Button>
                                <Button Width="28"
                                        Height="28"
                                        CornerRadius="14"
                                        Padding="0"
                                        Background="#14FFFFFF"
                                        BorderThickness="0"
                                        Click="OnCancelNewTaskClick">
                                    <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#ADFFFFFF" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Список задач дня (Высота строки 44px, круглый чекбокс 18x18px, текст 14px) -->
                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskItemViewModel">
                                    <Border Height="{x:Bind RowHeight, Mode=OneWay}"
                                            Opacity="{x:Bind RowOpacity, Mode=OneWay}"
                                            CornerRadius="8"
                                            Background="#0AFFFFFF"
                                            Margin="0,0,0,6"
                                            Padding="10,0,10,0"
                                            PointerEntered="OnTaskRowPointerEntered"
                                            PointerExited="OnTaskRowPointerExited">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Круглый чекбокс выполнения (18x18px, CornerRadius = 9px) -->
                                            <Button Grid.Column="0"
                                                    Width="18"
                                                    Height="18"
                                                    CornerRadius="9"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderBrush="#59FFFFFF"
                                                    BorderThickness="1.5"
                                                    Margin="0,0,10,0"
                                                    Click="OnTaskCheckboxClick"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Завершить задачу">
                                                <FontIcon Glyph="&#xE73E;"
                                                          FontSize="10"
                                                          Foreground="#36D399"
                                                          Visibility="{x:Bind conv:XamlConverters.ToVisibility(IsCheckboxChecked), Mode=OneWay}" />
                                            </Button>

                                            <!-- Текст задачи или инлайн-поле редактирования -->
                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                           TextDecorations="{x:Bind conv:XamlConverters.ToStrikethrough(IsStrikethrough), Mode=OneWay}"
                                                           Visibility="{x:Bind conv:XamlConverters.ToInverseVisibility(IsEditing), Mode=OneWay}"
                                                           FontSize="14"
                                                           Foreground="#FFFFFF"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           PointerPressed="OnTaskRowTextPointerPressed"
                                                           Tag="{x:Bind}" />

                                                <TextBox Text="{x:Bind EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{x:Bind conv:XamlConverters.ToVisibility(IsEditing), Mode=OneWay}"
                                                         FontSize="13"
                                                         Foreground="#FFFFFF"
                                                         Background="#1EFFFFFF"
                                                         BorderThickness="1"
                                                         BorderBrush="#33FFFFFF"
                                                         CornerRadius="4"
                                                         Padding="6,2,6,2"
                                                         KeyDown="OnTaskInlineEditKeyDown"
                                                         Tag="{x:Bind}" />
                                            </Grid>

                                            <!-- Меню действий: кнопка «...» или панель из 3 действий -->
                                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                                <!-- Кнопка «...» (видна, когда панель действий не раскрыта) -->
                                                <Button Width="24"
                                                        Height="24"
                                                        CornerRadius="12"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="OnTaskMoreClick"
                                                        Tag="{x:Bind}"
                                                        Visibility="{x:Bind conv:XamlConverters.ToInverseVisibility(IsActionPanelOpen), Mode=OneWay}"
                                                        ToolTipService.ToolTip="Действия">
                                                    <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="#66FFFFFF" />
                                                </Button>

                                                <!-- Панель действий: 3 иконки (Check, Edit, Trash) -->
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="4"
                                                            Visibility="{x:Bind conv:XamlConverters.ToVisibility(IsActionPanelOpen), Mode=OneWay}">
                                                    <!-- 1. Check (Выполнить) -->
                                                    <Button Width="24"
                                                            Height="24"
                                                            CornerRadius="12"
                                                            Padding="0"
                                                            Background="#2636D399"
                                                            BorderThickness="0"
                                                            Click="OnTaskActionCheckClick"
                                                            Tag="{x:Bind}"
                                                            ToolTipService.ToolTip="Выполнить">
                                                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#36D399" />
                                                    </Button>

                                                    <!-- 2. Edit (Редактировать) -->
                                                    <Button Width="24"
                                                            Height="24"
                                                            CornerRadius="12"
                                                            Padding="0"
                                                            Background="#1EFFFFFF"
                                                            BorderThickness="0"
                                                            Click="OnTaskActionEditClick"
                                                            Tag="{x:Bind}"
                                                            ToolTipService.ToolTip="Редактировать">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="#FFFFFF" />
                                                    </Button>

                                                    <!-- 3. Trash (Удалить) -->
                                                    <Button Width="24"
                                                            Height="24"
                                                            CornerRadius="12"
                                                            Padding="0"
                                                            Background="#1EFFFFFF"
                                                            BorderThickness="0"
                                                            Click="OnTaskActionTrashClick"
                                                            Tag="{x:Bind}"
                                                            ToolTipService.ToolTip="Удалить"
                                                            PointerEntered="OnTrashPointerEntered"
                                                            PointerExited="OnTrashPointerExited">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#F87171" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Компонент UndoToast (окно отмены на 5 секунд) -->
                        <Border Grid.Row="3"
                                x:Name="UndoToastBorder"
                                Visibility="{x:Bind conv:XamlConverters.ToVisibility(ViewModel.IsUndoToastVisible), Mode=OneWay}"
                                Margin="0,8,0,0"
                                Padding="12,6,10,6"
                                CornerRadius="16"
                                Background="#E61E1E24"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.UndoToastMessage, Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="#E6FFFFFF"
                                           VerticalAlignment="Center" />
                                <Button Content="Отменить"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FFCE824C"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4,1,4,1"
                                        Click="OnUndoToastClick" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Разделитель 1 (1px solid rgba(255, 255, 255, 0.07)) -->
                    <Border Grid.Row="1" Height="1" Background="#12FFFFFF" Margin="0,12,0,12" />

                    <!-- БЛОК 2: DAILY RESET (Карточка видео дня) -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Заголовочная строка Блока 2: Daily reset + изумрудный статус-бейдж Ready -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Daily reset"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center" />

                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Height="22"
                                    CornerRadius="11"
                                    Background="#2E26A65B"
                                    Padding="10,0,10,0">
                                <TextBlock Text="{x:Bind ViewModel.ResetStatus, Mode=OneWay}"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="#36D399"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- Широкоформатное видео-превью 16:9 (340×191px, CornerRadius = 14px) -->
                        <Border Grid.Row="1"
                                Width="340"
                                Height="191"
                                CornerRadius="14"
                                Background="{StaticResource DailyResetPreviewBrush}"
                                BorderBrush="#1EFFFFFF"
                                BorderThickness="1"
                                Padding="12"
                                PointerPressed="OnCardPointerPressed">
                            <Grid>
                                <!-- Плашка источника в левом нижнем углу -->
                                <Border HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Height="20"
                                        CornerRadius="4"
                                        Background="#80000000"
                                        Padding="6,0,6,0">
                                    <TextBlock Text="{x:Bind ViewModel.VideoSourceTag, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="#CCFFFFFF"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Нижняя строка карточки видео: Заголовок + круглая кнопка Play (28x28px) -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.VideoTitle, Mode=OneWay}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF" />
                                <TextBlock Text="{x:Bind ViewModel.VideoSubtitle, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="#ADFFFFFF" />
                            </StackPanel>

                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="28"
                                    Height="28"
                                    CornerRadius="14"
                                    Padding="0"
                                    Background="#26FFFFFF"
                                    BorderThickness="0"
                                    Click="OnPlayButtonClick"
                                    ToolTipService.ToolTip="Воспроизвести видео дня">
                                <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="#FFFFFF" Margin="1,0,0,0" />
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- Разделитель 2 (1px solid rgba(255, 255, 255, 0.07)) -->
                    <Border Grid.Row="3" Height="1" Background="#12FFFFFF" Margin="0,12,0,12" />

                    <!-- БЛОК 3: THIS MONTH (Прогресс месяца: 78%, трек 340×6px, янтарное заполнение) -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Заголовочная строка Блока 3: This month + процент 78% -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="This month"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center" />

                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind FormatPercent(ViewModel.DisplayScore), Mode=OneWay}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#36D399" />
                        </Grid>

                        <!-- Прогресс-бар месяца: Трек 340×6px, скругление 3px -->
                        <Grid Grid.Row="1" Width="340" Height="6" HorizontalAlignment="Left">
                            <!-- Фоновый серый трек -->
                            <Border Width="340"
                                    Height="6"
                                    CornerRadius="3"
                                    Background="#1EFFFFFF" />

                            <!-- Заполняющая янтарная полоса #CE824C -->
                            <Border x:Name="ProgressBarFill"
                                    Height="6"
                                    CornerRadius="3"
                                    Background="#CE824C"
                                    HorizontalAlignment="Left"
                                    Width="{x:Bind ViewModel.ProgressBarWidth, Mode=OneWay}" />
                        </Grid>

                        <!-- Подписи метрик под прогресс-баром: Daily 26/31 и Weekly 3/4 -->
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <TextBlock HorizontalAlignment="Left"
                                       Text="{x:Bind ViewModel.DailyRatio, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="#ADFFFFFF" />

                            <TextBlock HorizontalAlignment="Right"
                                       Text="{x:Bind ViewModel.WeeklyRatio, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="#ADFFFFFF" />
                        </Grid>
                    </Grid>

                    <!-- Нижний триггер ручного сворачивания: стрелка ChevronUp -->
                    <Grid Grid.Row="5" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Width="36"
                                Height="24"
                                CornerRadius="12"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnCollapseChevronClick"
                                ToolTipService.ToolTip="Свернуть виджет">
                            <FontIcon Glyph="&#xE70E;" FontSize="14" Foreground="#66FFFFFF" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
