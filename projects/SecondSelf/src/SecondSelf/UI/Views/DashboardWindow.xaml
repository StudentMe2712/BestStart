<Window
    x:Class="SecondSelf.UI.Views.DashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SecondSelf.Core.ViewModels"
    xmlns:conv="using:SecondSelf.UI.Converters"
    xmlns:models="using:SecondSelf.Core.Models"
    xmlns:entities="using:SecondSelf.Data.Entities"
    mc:Ignorable="d"
    Title="Second Self — Personal Space">

    <!-- Корневая сетка окна (1120x780px, MinWidth 960, MinHeight 640, background #09090B) -->
    <Grid Background="#09090B">
        <Grid.Resources>
            <LinearGradientBrush x:Key="VideoThumbnailBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFB86532" Offset="0.0" />
                <GradientStop Color="#FF64280E" Offset="0.6" />
                <GradientStop Color="#FF240C04" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <!-- Левая колонка навигации (Sidebar: Width="220") -->
            <ColumnDefinition Width="220" />
            <!-- Правая колонка основного контента (Main Viewport) -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================== -->
        <!-- БЛОК 1: НАВИГАЦИОННЫЙ САЙДБАР (SIDEBAR: 220px)                   -->
        <!-- ============================================================== -->
        <Border Grid.Column="0" Background="#0C0C0E" BorderBrush="#1C1C20" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовок приложения -->
                <StackPanel Grid.Row="0" Margin="22, 24, 20, 24" Spacing="4">
                    <TextBlock Text="SECOND SELF"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#A1A1AA"
                               CharacterSpacing="120" />
                    <TextBlock Text="Personal Space"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#F4F4F5" />
                </StackPanel>

                <!-- 5 Табов навигации -->
                <StackPanel Grid.Row="1" Spacing="4" Margin="10,0">
                    <!-- Tab 0: Today -->
                    <Button Click="OnNavTabClick" Tag="Today"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Padding="0" Height="42"
                            Background="{x:Bind GetTabBackground(ViewModel.CurrentTab, 'Today'), Mode=OneWay}"
                            BorderThickness="0" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" Height="22" CornerRadius="1.5" Background="#CE824C"
                                    Visibility="{x:Bind GetTabMarkerVisibility(ViewModel.CurrentTab, 'Today'), Mode=OneWay}" />
                            <FontIcon Grid.Column="1" Glyph="&#xE706;" FontSize="15" Margin="14,0,12,0"
                                      Foreground="{x:Bind GetTabForeground(ViewModel.CurrentTab, 'Today'), Mode=OneWay}" />
                            <TextBlock Grid.Column="2" Text="Today" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{x:Bind GetTabForeground(ViewModel.CurrentTab, 'Today'), Mode=OneWay}"
                                       FontWeight="{x:Bind GetTabFontWeight(ViewModel.CurrentTab, 'Today'), Mode=OneWay}" />
                        </Grid>
                    </Button>

                    <!-- Tab 1: Goals -->
                    <Button Click="OnNavTabClick" Tag="Goals"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Padding="0" Height="42"
                            Background="{x:Bind GetTabBackground(ViewModel.CurrentTab, 'Goals'), Mode=OneWay}"
                            BorderThickness="0" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" Height="22" CornerRadius="1.5" Background="#CE824C"
                                    Visibility="{x:Bind GetTabMarkerVisibility(ViewModel.CurrentTab, 'Goals'), Mode=OneWay}" />
                            <FontIcon Grid.Column="1" Glyph="&#xE707;" FontSize="15" Margin="14,0,12,0"
                                      Foreground="{x:Bind GetTabForeground(ViewModel.CurrentTab, 'Goals'), Mode=OneWay}" />
                            <TextBlock Grid.Column="2" Text="Goals" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{x:Bind GetTabForeground(ViewModel.CurrentTab, 'Goals'), Mode=OneWay}"
                                       FontWeight="{x:Bind GetTabFontWeight(ViewModel.CurrentTab, 'Goals'), Mode=OneWay}" />
                        </Grid>
                    </Button>

                    <!-- Tab 2: Progress -->
                    <Button Click="OnNavTabClick" Tag="Progress"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Padding="0" Height="42"
                            Background="{x:Bind GetTabBackground(ViewModel.CurrentTab, 'Progress'), Mode=OneWay}"
                            BorderThickness="0" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" Height="22" CornerRadius="1.5" Background="#CE824C"
                                    Visibility="{x:Bind GetTabMarkerVisibility(ViewModel.CurrentTab, 'Progress'), Mode=OneWay}" />
                            <FontIcon Grid.Column="1" Glyph="&#xE9D9;" FontSize="15" Margin="14,0,12,0"
                                      Foreground="{x:Bind GetTabForeground(ViewModel.CurrentTab, 'Progress'), Mode=OneWay}" />
                            <TextBlock Grid.Column="2" Text="Progress" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{x:Bind GetTabForeground(ViewModel.CurrentTab, 'Progress'), Mode=OneWay}"
                                       FontWeight="{x:Bind GetTabFontWeight(ViewModel.CurrentTab, 'Progress'), Mode=OneWay}" />
                        </Grid>
                    </Button>

                    <!-- Tab 3: Archive -->
                    <Button Click="OnNavTabClick" Tag="Archive"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Padding="0" Height="42"
                            Background="{x:Bind GetTabBackground(ViewModel.CurrentTab, 'Archive'), Mode=OneWay}"
                            BorderThickness="0" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" Height="22" CornerRadius="1.5" Background="#CE824C"
                                    Visibility="{x:Bind GetTabMarkerVisibility(ViewModel.CurrentTab, 'Archive'), Mode=OneWay}" />
                            <FontIcon Grid.Column="1" Glyph="&#xE7B8;" FontSize="15" Margin="14,0,12,0"
                                      Foreground="{x:Bind GetTabForeground(ViewModel.CurrentTab, 'Archive'), Mode=OneWay}" />
                            <TextBlock Grid.Column="2" Text="Archive" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{x:Bind GetTabForeground(ViewModel.CurrentTab, 'Archive'), Mode=OneWay}"
                                       FontWeight="{x:Bind GetTabFontWeight(ViewModel.CurrentTab, 'Archive'), Mode=OneWay}" />
                        </Grid>
                    </Button>

                    <!-- Tab 4: Settings -->
                    <Button Click="OnNavTabClick" Tag="Settings"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Padding="0" Height="42"
                            Background="{x:Bind GetTabBackground(ViewModel.CurrentTab, 'Settings'), Mode=OneWay}"
                            BorderThickness="0" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" Height="22" CornerRadius="1.5" Background="#CE824C"
                                    Visibility="{x:Bind GetTabMarkerVisibility(ViewModel.CurrentTab, 'Settings'), Mode=OneWay}" />
                            <FontIcon Grid.Column="1" Glyph="&#xE713;" FontSize="15" Margin="14,0,12,0"
                                      Foreground="{x:Bind GetTabForeground(ViewModel.CurrentTab, 'Settings'), Mode=OneWay}" />
                            <TextBlock Grid.Column="2" Text="Settings" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{x:Bind GetTabForeground(ViewModel.CurrentTab, 'Settings'), Mode=OneWay}"
                                       FontWeight="{x:Bind GetTabFontWeight(ViewModel.CurrentTab, 'Settings'), Mode=OneWay}" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Сервисная зона внизу сайдбара -->
                <StackPanel Grid.Row="2" Margin="14, 0, 14, 20" Spacing="10">
                    <Button Click="OnToggleWidgetClick"
                            HorizontalAlignment="Stretch"
                            Background="#18181B"
                            BorderBrush="#27272A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="36"
                            Padding="10, 0"
                            ToolTipService.ToolTip="Показать / скрыть плавающий виджет на рабочем столе">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A9;" FontSize="13" Foreground="#CE824C" />
                            <TextBlock Text="Виджет рабочего стола" FontSize="12" Foreground="#D4D4D8" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Background="#121214" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="6" Padding="8, 6">
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#36D399" />
                                <TextBlock Text="SQLite WAL: Активна" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SettingsViewModel.LastBackupDisplayText, Mode=OneWay}"
                                       FontSize="10" Foreground="#71717A" TextTrimming="CharacterEllipsis"
                                       Typography.NumeralAlignment="Tabular"
                                       ToolTipService.ToolTip="Время последней резервной копии" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- БЛОК 2: ОСНОВНОЙ ВЬЮПОРТ (MAIN VIEWPORT)                        -->
        <!-- ============================================================== -->
        <Grid Grid.Column="1" Padding="32, 28, 40, 32">

            <!-- ========================================================== -->
            <!-- TAB 0: TODAY (СЕГОДНЯШНИЙ ФОКУС И ДНЕВНОЙ РИТУАЛ)           -->
            <!-- ========================================================== -->
            <Grid Visibility="{x:Bind TabToVisibility(ViewModel.CurrentTab, 'Today'), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: Weekly Goal + Today's Focus (60-65%) -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="22">
                        <!-- Карточка Weekly Goal -->
                        <Border Background="#141110" BorderBrush="#CE824C" BorderThickness="1" CornerRadius="8" Padding="18, 16">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="WEEKLY GOAL" FontSize="11" FontWeight="Bold" Foreground="#CE824C" CharacterSpacing="100" />
                                        <TextBlock Text="{x:Bind ViewModel.TodayViewModel.WeeklyGoalTag, Mode=OneWay}"
                                                   FontSize="11" Foreground="#A1A1AA"
                                                   Visibility="{x:Bind conv:XamlConverters.StringNotEmptyToVisibility(ViewModel.TodayViewModel.WeeklyGoalTag), Mode=OneWay}" />
                                    </StackPanel>
                                    <Button Click="OnEditWeeklyGoalClick" HorizontalAlignment="Right" Padding="8, 4" Background="#261E16" BorderBrush="#CE824C" BorderThickness="1" CornerRadius="5">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="#CE824C" />
                                            <TextBlock Text="План / Изменить" FontSize="11" Foreground="#F4F4F5" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Если цель задана -->
                                <TextBlock Text="{x:Bind ViewModel.TodayViewModel.WeeklyGoalText, Mode=OneWay}"
                                           FontSize="15" FontWeight="SemiBold" Foreground="#F4F4F5" TextWrapping="Wrap"
                                           Visibility="{x:Bind conv:XamlConverters.ToVisibility(ViewModel.TodayViewModel.HasWeeklyGoal), Mode=OneWay}" />

                                <!-- Если цель не задана -->
                                <TextBlock Text="Цель на текущую неделю еще не определена. Нажмите «План / Изменить», чтобы зафиксировать фокус."
                                           FontSize="13" Foreground="#71717A" TextWrapping="Wrap"
                                           Visibility="{x:Bind conv:XamlConverters.ToInverseVisibility(ViewModel.TodayViewModel.HasWeeklyGoal), Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Список Today's Focus -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="TODAY'S FOCUS" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" CharacterSpacing="120" />

                            <!-- Инлайн-поле ввода задачи дня -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         x:Name="TodayInlineTaskTextBox"
                                         Text="{x:Bind ViewModel.TodayViewModel.NewTaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="OnTodayInlineTaskKeyDown"
                                         PlaceholderText="Что важно сделать сегодня? (Нажмите Enter)"
                                         Background="#121214" BorderBrush="#27272A" Height="40" CornerRadius="6, 0, 0, 6" />
                                <Button Grid.Column="1" Click="OnAddTodayTaskClick"
                                        Background="#CE824C" Foreground="#FFFFFF"
                                        Height="40" Width="44" CornerRadius="0, 6, 6, 0"
                                        ToolTipService.ToolTip="Добавить задачу">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                </Button>
                            </Grid>

                            <!-- Плашка Undo Toast -->
                            <Border Background="#1C1C20" BorderBrush="#CE824C" BorderThickness="1" CornerRadius="6" Padding="12, 8"
                                    Visibility="{x:Bind conv:XamlConverters.ToVisibility(ViewModel.TodayViewModel.IsUndoToastVisible), Mode=OneWay}">
                                <Grid>
                                    <TextBlock Text="{x:Bind ViewModel.TodayViewModel.UndoToastMessage, Mode=OneWay}"
                                               FontSize="12" Foreground="#F4F4F5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Click="OnUndoToastClick" HorizontalAlignment="Right" Padding="8, 2"
                                            Background="Transparent" BorderThickness="0" Foreground="#CE824C" FontWeight="SemiBold" FontSize="12"
                                            Content="Отменить" />
                                </Grid>
                            </Border>

                            <!-- Список задач дня -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.TodayViewModel.Tasks, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TaskItemViewModel">
                                        <Border Height="{x:Bind RowHeight, Mode=OneWay}"
                                                Opacity="{x:Bind RowOpacity, Mode=OneWay}"
                                                Background="#121214" BorderBrush="#1C1C20" BorderThickness="1"
                                                CornerRadius="6" Margin="0, 0, 0, 6" Padding="12, 0">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{x:Bind IsCheckboxChecked, Mode=OneWay}"
                                                          Click="OnTaskCheckboxClick"
                                                          Tag="{x:Bind}"
                                                          MinWidth="24" Margin="0,0,8,0" />

                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Title, Mode=OneWay}"
                                                           TextDecorations="{x:Bind conv:XamlConverters.ToStrikethrough(IsStrikethrough), Mode=OneWay}"
                                                           Foreground="#F4F4F5" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <Border Grid.Column="2" Background="#261E16" CornerRadius="4" Padding="6, 2" Margin="8, 0"
                                                        Visibility="{x:Bind conv:XamlConverters.ToVisibility(HasPostponedDays), Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind PostponedBadgeText, Mode=OneWay}"
                                                               FontSize="10" Foreground="#CE824C" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                                </Border>

                                                <Button Grid.Column="3" Click="OnTaskDeleteClick" Tag="{x:Bind}"
                                                        Background="Transparent" BorderThickness="0" Padding="6"
                                                        ToolTipService.ToolTip="Удалить задачу">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#71717A" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Правая колонка: Daily Reset Widget + Day Mini-Summary (35-40%) -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="18">
                        <!-- Карточка Daily Reset -->
                        <Border Background="#121214" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock Text="DAILY RESET" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" CharacterSpacing="120" VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" Background="{x:Bind conv:XamlConverters.ToStatusBackgroundBrush(ViewModel.TodayViewModel.RitualStatus), Mode=OneWay}"
                                            CornerRadius="4" Padding="8, 3">
                                        <TextBlock Text="{x:Bind ViewModel.TodayViewModel.RitualStatus, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{x:Bind conv:XamlConverters.ToStatusForegroundBrush(ViewModel.TodayViewModel.RitualStatus), Mode=OneWay}" />
                                    </Border>
                                </Grid>

                                <!-- Видео-превью -->
                                <Border Height="130" CornerRadius="6" Background="{StaticResource VideoThumbnailBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE768;" FontSize="32" Foreground="#CE824C" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8" />
                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8" Background="#CC000000" CornerRadius="4" Padding="6, 2">
                                            <TextBlock Text="{x:Bind ViewModel.TodayViewModel.TodayVideoDuration, Mode=OneWay}"
                                                       FontSize="11" Foreground="#F4F4F5" Typography.NumeralAlignment="Tabular" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{x:Bind ViewModel.TodayViewModel.TodayVideoTitle, Mode=OneWay}"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" />

                                <Button Click="OnPlayDailyResetClick"
                                        HorizontalAlignment="Stretch" Height="38"
                                        Background="#CE824C" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                                        <TextBlock Text="Смотреть ритуал" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Карточка Day Mini-Summary -->
                        <Border Background="#121214" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="14">
                                <TextBlock Text="СВОДКА ПРОГРЕССА" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" CharacterSpacing="120" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.TodayViewModel.CompletedTodayCount, Mode=OneWay}"
                                                   FontSize="26" FontWeight="Bold" Foreground="#F4F4F5" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Text="задач закрыто сегодня" FontSize="11" Foreground="#71717A" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind conv:XamlConverters.ToPercentString(ViewModel.TodayViewModel.CurrentMonthScore), Mode=OneWay}"
                                                   FontSize="26" FontWeight="Bold" Foreground="#CE824C" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Text="счёт за месяц" FontSize="11" Foreground="#71717A" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="#1C1C20" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Daily Ratio" FontSize="10" Foreground="#71717A" />
                                        <TextBlock Text="{x:Bind ViewModel.TodayViewModel.CurrentMonthDailyRatio, Mode=OneWay}"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#36D399" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Weekly Ratio" FontSize="10" Foreground="#71717A" />
                                        <TextBlock Text="{x:Bind ViewModel.TodayViewModel.CurrentMonthWeeklyRatio, Mode=OneWay}"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#CE824C" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ========================================================== -->
            <!-- TAB 1: GOALS (THE BIG PICTURE · 2026—2028)                 -->
            <!-- ========================================================== -->
            <Grid Visibility="{x:Bind TabToVisibility(ViewModel.CurrentTab, 'Goals'), Mode=OneWay}">
                <!-- Вид списка всех целей (когда не открыт детальный просмотр) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind conv:XamlConverters.ToInverseVisibility(ViewModel.GoalsViewModel.IsGoalDetailOpen), Mode=OneWay}">
                    <StackPanel Spacing="20">
                        <!-- Hero Header -->
                        <Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.GoalsViewModel.HeaderCategory, Mode=OneWay}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#CE824C" CharacterSpacing="120" />
                                <TextBlock Text="{x:Bind ViewModel.GoalsViewModel.HeaderTitle, Mode=OneWay}"
                                           FontSize="28" FontWeight="Bold" Foreground="#F4F4F5" />
                                <TextBlock Text="{x:Bind ViewModel.GoalsViewModel.HeaderSubtitle, Mode=OneWay}"
                                           FontSize="13" Foreground="#A1A1AA" />
                            </StackPanel>
                            <Button Click="OnAddBigGoalClick" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    IsEnabled="{x:Bind ViewModel.GoalsViewModel.CanAddGoal, Mode=OneWay}"
                                    Background="#CE824C" Foreground="#FFFFFF" FontWeight="SemiBold" Height="38" Padding="16, 0" CornerRadius="6"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.GoalsViewModel.LimitWarningMessage, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                                    <TextBlock Text="Добавить цель" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Баннер Next Milestone -->
                        <Border Background="#181512" BorderBrush="#CE824C" BorderThickness="1" CornerRadius="8" Padding="18, 14"
                                Visibility="{x:Bind conv:XamlConverters.ToVisibility(ViewModel.GoalsViewModel.HasNextMilestone), Mode=OneWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE707;" FontSize="20" Foreground="#CE824C" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.GoalsViewModel.NextMilestoneLabel, Mode=OneWay}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="#CE824C" />
                                    <TextBlock Text="{x:Bind ViewModel.GoalsViewModel.NextMilestoneTitle, Mode=OneWay}"
                                               FontSize="15" FontWeight="SemiBold" Foreground="#F4F4F5" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Предупреждение о лимите в 4 цели -->
                        <Border Background="#261E16" BorderBrush="#E5A158" BorderThickness="1" CornerRadius="6" Padding="14, 10"
                                Visibility="{x:Bind conv:XamlConverters.ToVisibility(ViewModel.GoalsViewModel.IsLimitWarningVisible), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="#E5A158" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.GoalsViewModel.LimitWarningMessage, Mode=OneWay}"
                                           FontSize="12" Foreground="#F4F4F5" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Сетка 2x2 Больших целей -->
                        <GridView ItemsSource="{x:Bind ViewModel.GoalsViewModel.ActiveGoals, Mode=OneWay}" SelectionMode="None">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:BigGoalViewModel">
                                    <Border Tag="{x:Bind}" PointerPressed="OnGoalCardPointerPressed"
                                            Width="380" Height="175" Background="#121214" BorderBrush="#1C1C20" BorderThickness="1"
                                            CornerRadius="10" Padding="18" Margin="0, 0, 16, 16">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Заголовок карточки с иконкой -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="{x:Bind conv:XamlConverters.ToGoalIconGlyph(IconKey), Mode=OneWay}"
                                                          FontSize="20" Foreground="#CE824C" Margin="0, 0, 10, 0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}"
                                                           FontSize="15" FontWeight="SemiBold" Foreground="#F4F4F5"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind TargetPeriod, Mode=OneWay}"
                                                           FontSize="11" Foreground="#71717A" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Мотивация -->
                                            <TextBlock Grid.Row="1" Text="{x:Bind Motivation, Mode=OneWay}"
                                                       FontSize="12" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis" MaxLines="2"
                                                       Margin="0, 8, 0, 0" />

                                            <!-- Прогресс этапов -->
                                            <StackPanel Grid.Row="2" Spacing="6">
                                                <Grid>
                                                    <TextBlock Text="{x:Bind MilestonesProgressText, Mode=OneWay}"
                                                               FontSize="12" Foreground="#D4D4D8" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                                    <TextBlock HorizontalAlignment="Right"
                                                               Text="{x:Bind conv:XamlConverters.ToPercentStringFromDouble(ProgressPercentage), Mode=OneWay}"
                                                               FontSize="12" Foreground="#CE824C" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                                </Grid>
                                                <ProgressBar Value="{x:Bind ProgressPercentage, Mode=OneWay}"
                                                             Foreground="#CE824C" Background="#27272A" Height="4" CornerRadius="2" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                </ScrollViewer>

                <!-- Детальный просмотр выбранной цели -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind conv:XamlConverters.ToVisibility(ViewModel.GoalsViewModel.IsGoalDetailOpen), Mode=OneWay}">
                    <StackPanel Spacing="20">
                        <Button Click="OnBackToGoalsClick" Background="Transparent" BorderThickness="0" Padding="0, 4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="#CE824C" />
                                <TextBlock Text="← Все цели" FontSize="13" Foreground="#CE824C" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Grid>
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.GoalsViewModel.SelectedGoal.Title, Mode=OneWay}"
                                           FontSize="26" FontWeight="Bold" Foreground="#F4F4F5" />
                                <TextBlock Text="{x:Bind ViewModel.GoalsViewModel.SelectedGoal.Motivation, Mode=OneWay}"
                                           FontSize="14" Foreground="#A1A1AA" />
                                <TextBlock Text="{x:Bind ViewModel.GoalsViewModel.SelectedGoal.TargetResult, Mode=OneWay}"
                                           FontSize="13" Foreground="#71717A" />
                            </StackPanel>
                            <Button Click="OnArchiveSelectedGoalClick" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="#1C1C20" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12, 6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7B8;" FontSize="12" Foreground="#A1A1AA" />
                                    <TextBlock Text="Архивировать цель" FontSize="12" Foreground="#A1A1AA" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="ДОРОЖНАЯ КАРТА ЭТАПОВ (MILESTONES)" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" CharacterSpacing="120" />

                        <!-- Список этапов цели -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.GoalsViewModel.SelectedGoal.Milestones, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MilestoneItemViewModel">
                                    <Border Background="#141416" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="16, 14" Margin="0, 0, 0, 8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="{x:Bind conv:XamlConverters.ToMilestoneGlyph(Status), Mode=OneWay}"
                                                      FontSize="18" Foreground="{x:Bind conv:XamlConverters.ToMilestoneFgBrush(Status), Mode=OneWay}"
                                                      Margin="0, 0, 14, 0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                                           FontSize="14" FontWeight="SemiBold" Foreground="#F4F4F5" />
                                                <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                                                           FontSize="11" Foreground="{x:Bind conv:XamlConverters.ToMilestoneFgBrush(Status), Mode=OneWay}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Click="OnCompleteMilestoneClick" Tag="{x:Bind Id}"
                                                    Visibility="{x:Bind conv:XamlConverters.ToVisibility(IsInProgress), Mode=OneWay}"
                                                    Background="#CE824C" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"
                                                    Padding="14, 6" CornerRadius="6" Content="Завершить этап" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ========================================================== -->
            <!-- TAB 2: PROGRESS (АНАЛИТИКА, КАЛЕНДАРЬ И ИСТОРИЯ)          -->
            <!-- ========================================================== -->
            <ScrollViewer Visibility="{x:Bind TabToVisibility(ViewModel.CurrentTab, 'Progress'), Mode=OneWay}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="22">
                    <!-- Верхняя сводка месяца (Month Deep Dive) -->
                    <Border Background="#121214" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="10" Padding="22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Процент результативности -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.ProgressViewModel.MonthName, Mode=OneWay}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#A1A1AA" CharacterSpacing="100" />
                                <TextBlock Text="{x:Bind conv:XamlConverters.ToPercentString(ViewModel.ProgressViewModel.ScorePercentage), Mode=OneWay}"
                                           FontSize="46" FontWeight="Bold" Foreground="#CE824C" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="Индекс результативности" FontSize="11" Foreground="#71717A" />
                            </StackPanel>

                            <!-- Разделитель -->
                            <Border Grid.Column="1" Width="1" Background="#1C1C20" HorizontalAlignment="Center" />

                            <!-- Дроби формулы прогресса -->
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="DAILY RITUALS (30%)" FontSize="11" FontWeight="SemiBold" Foreground="#36D399" CharacterSpacing="100" />
                                    <TextBlock Text="{x:Bind ViewModel.ProgressViewModel.DailyFraction, Mode=OneWay}"
                                               FontSize="24" FontWeight="Bold" Foreground="#F4F4F5" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Text="дней выполнения ритуала" FontSize="11" Foreground="#71717A" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="WEEKLY GOALS (70%)" FontSize="11" FontWeight="SemiBold" Foreground="#CE824C" CharacterSpacing="100" />
                                    <TextBlock Text="{x:Bind ViewModel.ProgressViewModel.WeeklyFraction, Mode=OneWay}"
                                               FontSize="24" FontWeight="Bold" Foreground="#F4F4F5" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Text="недель выполнения цели" FontSize="11" Foreground="#71717A" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Календарная сетка месяца (Daily Rituals) -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="КАЛЕНДАРЬ РИТУАЛОВ МЕСЯЦА" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" CharacterSpacing="120" />
                        <GridView ItemsSource="{x:Bind ViewModel.ProgressViewModel.CalendarDays, Mode=OneWay}" SelectionMode="None">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:CalendarDayViewModel">
                                    <Border Width="42" Height="42" Margin="0, 0, 6, 6" CornerRadius="6"
                                            Background="{x:Bind conv:XamlConverters.ToCalendarDayBgBrush(IsCompleted), Mode=OneWay}"
                                            BorderBrush="{x:Bind conv:XamlConverters.ToCalendarDayBorderBrush(IsToday, IsCompleted), Mode=OneWay}"
                                            BorderThickness="1">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{x:Bind DayNumber, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{x:Bind conv:XamlConverters.ToCalendarDayFgBrush(IsCompleted, IsToday), Mode=OneWay}"
                                                       HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Text="{x:Bind DayOfWeekShort, Mode=OneWay}" FontSize="8" Foreground="#71717A" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>

                    <!-- Недельные цели месяца (ISO-8601 Weeks) -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="НЕДЕЛЬНЫЕ ЦЕЛИ МЕСЯЦА (ISO-8601)" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" CharacterSpacing="120" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ProgressViewModel.WeekCards, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WeekCardViewModel">
                                    <Border Background="#121214" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="8" Padding="14, 10" Margin="0, 0, 0, 6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind WeekDisplayNumber, Mode=OneWay}"
                                                       FontSize="13" FontWeight="Bold" Foreground="#CE824C" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind DateRange, Mode=OneWay}"
                                                       FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind GoalTitle, Mode=OneWay}"
                                                           FontSize="13" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind MilestoneTag, Mode=OneWay}"
                                                           FontSize="10" Foreground="#CE824C"
                                                           Visibility="{x:Bind conv:XamlConverters.StringNotEmptyToVisibility(MilestoneTag), Mode=OneWay}" />
                                            </StackPanel>
                                            <Border Grid.Column="3" Background="#1C1C20" CornerRadius="4" Padding="8, 3" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind StatusBadgeText, Mode=OneWay}" FontSize="11"
                                                           Foreground="{x:Bind conv:XamlConverters.ToStatusForegroundBrush(Status), Mode=OneWay}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Галерея архивных месяцев -->
                    <StackPanel Spacing="10" Visibility="{x:Bind HasHistoricalRecapsVisibility(ViewModel.ProgressViewModel.HistoricalRecaps.Count), Mode=OneWay}">
                        <TextBlock Text="АРХИВ МЕСЯЦЕВ" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" CharacterSpacing="120" />
                        <GridView ItemsSource="{x:Bind ViewModel.ProgressViewModel.HistoricalRecaps, Mode=OneWay}" SelectionMode="None">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="entities:MonthlyRecap">
                                    <Border Tag="{x:Bind}" PointerPressed="OnRecapCardPointerPressed"
                                            Width="170" Background="#121214" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0, 0, 12, 12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind YearMonth, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                            <TextBlock Text="{x:Bind conv:XamlConverters.ToPercentStringFromDouble(FinalScore), Mode=OneWay}"
                                                       FontSize="22" FontWeight="Bold" Foreground="#CE824C" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Text="{x:Bind DailyRatio, Mode=OneWay}" FontSize="11" Foreground="#71717A" Typography.NumeralAlignment="Tabular" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ========================================================== -->
            <!-- TAB 3: ARCHIVE (ХРОНИКА ПОБЕД И АРХИВ ДЕЛ)                  -->
            <!-- ========================================================== -->
            <Grid Visibility="{x:Bind TabToVisibility(ViewModel.CurrentTab, 'Archive'), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 3 Метрические карточки вверху -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#121214" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="8" Padding="16, 12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.ArchiveViewModel.TodayCompletedCount, Mode=OneWay}"
                                       FontSize="22" FontWeight="Bold" Foreground="#F4F4F5" Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="Закрыто сегодня" FontSize="11" Foreground="#A1A1AA" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#121214" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="8" Padding="16, 12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.ArchiveViewModel.WeekCompletedCount, Mode=OneWay}"
                                       FontSize="22" FontWeight="Bold" Foreground="#F4F4F5" Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="На этой неделе" FontSize="11" Foreground="#A1A1AA" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="#121214" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="8" Padding="16, 12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.ArchiveViewModel.MonthCompletedCount, Mode=OneWay}"
                                       FontSize="22" FontWeight="Bold" Foreground="#F4F4F5" Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="В этом месяце" FontSize="11" Foreground="#A1A1AA" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Поле живого поиска -->
                <TextBox Grid.Row="1" Margin="0, 16, 0, 12" Height="38"
                         Text="{x:Bind ViewModel.ArchiveViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Поиск по закрытым задачам..."
                         Background="#121214" BorderBrush="#27272A" CornerRadius="6" />

                <!-- Хронологическая лента закрытых дел -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ArchiveViewModel.FilteredTasks, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ArchivedTaskItemViewModel">
                                <Border Background="#121214" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="6" Padding="14, 10" Margin="0, 0, 0, 6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="14" Foreground="#36D399" Margin="0, 0, 12, 0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}"
                                                   TextDecorations="Strikethrough" FontSize="13" Foreground="#A1A1AA"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind FormattedCompletedTime, Mode=OneWay}"
                                                   FontSize="11" Foreground="#71717A" Margin="10, 0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                        <Border Grid.Column="3" Background="#261E16" CornerRadius="4" Padding="6, 2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind TaskSource, Mode=OneWay}" FontSize="10" Foreground="#CE824C" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ========================================================== -->
            <!-- TAB 4: SETTINGS (ВИДЕОТЕКА, ВЕСА И РЕЗЕРВНОЕ КОПИРОВАНИЕ)   -->
            <!-- ========================================================== -->
            <ScrollViewer Visibility="{x:Bind TabToVisibility(ViewModel.CurrentTab, 'Settings'), Mode=OneWay}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="24">
                    <!-- Видеотека Daily Reset -->
                    <Border Background="#121214" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="14">
                            <Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="ВИДЕОТЕКА DAILY RESET" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" CharacterSpacing="120" />
                                    <TextBlock Text="{x:Bind ViewModel.SettingsViewModel.TotalVideosText, Mode=OneWay}" FontSize="13" Foreground="#F4F4F5" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button Click="OnRescanLibraryClick" Background="#1C1C20" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="10, 6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="#A1A1AA" />
                                            <TextBlock Text="Сканировать" FontSize="11" Foreground="#F4F4F5" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnShuffleQueueClick" Background="#1C1C20" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="10, 6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8B1;" FontSize="11" Foreground="#A1A1AA" />
                                            <TextBlock Text="Перетасовать" FontSize="11" Foreground="#F4F4F5" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnAddVideoFileClick" Background="#CE824C" Foreground="#FFFFFF" CornerRadius="6" Padding="12, 6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                                            <TextBlock Text="Добавить файл" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Таблица видеофайлов -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SettingsViewModel.Videos, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VideoLibraryItemViewModel">
                                        <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12, 8" Margin="0, 0, 0, 6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind FileName, Mode=OneWay}"
                                                           FontSize="13" Foreground="#F4F4F5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind FormattedDuration, Mode=OneWay}"
                                                           FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind PlaybackCountText, Mode=OneWay}"
                                                           FontSize="11" Foreground="#71717A" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind StatusText, Mode=OneWay}"
                                                           FontSize="11" Foreground="{x:Bind conv:XamlConverters.ToStatusForegroundBrush(StatusText), Mode=OneWay}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Формула прогресса: слайдер весов -->
                    <Border Background="#121214" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="БАЛАНС ВЕСОВ ФОРМУЛЫ ПРОГРЕССА" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" CharacterSpacing="120" />
                            <Grid>
                                <TextBlock Text="{x:Bind ViewModel.SettingsViewModel.DailyWeightText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#36D399" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="{x:Bind ViewModel.SettingsViewModel.WeeklyWeightText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#CE824C" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                            </Grid>
                            <Slider Minimum="10" Maximum="50" StepFrequency="5"
                                    Value="{x:Bind ViewModel.SettingsViewModel.DailyWeight, Mode=TwoWay}"
                                    Foreground="#CE824C" />
                            <Button Click="OnSaveWeightsClick" Background="#261E16" BorderBrush="#CE824C" BorderThickness="1" CornerRadius="6" Padding="12, 6" HorizontalAlignment="Right">
                                <TextBlock Text="Сохранить веса" FontSize="12" Foreground="#F4F4F5" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Настройки виджета и автозапуска -->
                    <Border Background="#121214" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="14">
                            <TextBlock Text="ПАРАМЕТРЫ ВИДЖЕТА И СИСТЕМЫ" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" CharacterSpacing="120" />

                            <CheckBox Content="Всегда поверх всех окон (Always on top)"
                                      IsChecked="{x:Bind ViewModel.SettingsViewModel.AlwaysOnTop, Mode=TwoWay}" />
                            <CheckBox Content="Автоматически сворачивать виджет при бездействии"
                                      IsChecked="{x:Bind ViewModel.SettingsViewModel.AutoCollapse, Mode=TwoWay}" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.SettingsViewModel.GlassOpacityText, Mode=OneWay}" FontSize="12" Foreground="#A1A1AA" Typography.NumeralAlignment="Tabular" />
                                <Slider Minimum="30" Maximum="80" StepFrequency="5"
                                        Value="{x:Bind ViewModel.SettingsViewModel.GlassOpacity, Mode=TwoWay}"
                                        Foreground="#CE824C" />
                            </StackPanel>

                            <Button Click="OnSaveWidgetSettingsClick" Background="#261E16" BorderBrush="#CE824C" BorderThickness="1" CornerRadius="6" Padding="12, 6" HorizontalAlignment="Right">
                                <TextBlock Text="Сохранить настройки виджета" FontSize="12" Foreground="#F4F4F5" FontWeight="SemiBold" />
                            </Button>

                            <Border Height="1" Background="#1C1C20" Margin="0, 6" />

                            <ToggleSwitch Header="Запуск Second Self вместе с Windows"
                                          IsOn="{x:Bind ViewModel.SettingsViewModel.IsAutostartEnabled, Mode=OneWay}"
                                          Toggled="OnAutostartToggled" />
                        </StackPanel>
                    </Border>

                    <!-- Резервное копирование SQLite -->
                    <Border Background="#121214" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="14">
                            <Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="РЕЗЕРВНОЕ КОПИРОВАНИЕ БАЗЫ ДАННЫХ (SQLITE WAL)" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" CharacterSpacing="120" />
                                    <TextBlock Text="{x:Bind ViewModel.SettingsViewModel.LastBackupDisplayText, Mode=OneWay}" FontSize="12" Foreground="#71717A" Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                                <Button Click="OnCreateBackupClick" HorizontalAlignment="Right" Background="#CE824C" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="6" Padding="14, 6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE753;" FontSize="12" />
                                        <TextBlock Text="Создать резервную копию" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Список резервных копий -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SettingsViewModel.Backups, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:BackupFileInfo">
                                        <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12, 8" Margin="0, 0, 0, 6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind FileName}"
                                                           FontSize="12" Foreground="#F4F4F5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind conv:XamlConverters.ToFileSizeString(FileSizeBytes)}"
                                                           FontSize="11" Foreground="#71717A" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                                <Button Grid.Column="2" Click="OnRestoreBackupClick" Tag="{x:Bind FilePath}"
                                                        Background="#1C1C20" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="10, 4">
                                                    <TextBlock Text="Восстановить" FontSize="11" Foreground="#A1A1AA" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============================================================== -->
        <!-- БЛОК 3: МОДАЛЬНЫЕ ОКНА И ОВЕРЛЕИ (MODALS & OVERLAYS)            -->
        <!-- ============================================================== -->

        <!-- 1. Модальное окно Weekly Goal (Commitment Lock) -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="#E6000000"
              Visibility="{x:Bind conv:XamlConverters.ToVisibility(ViewModel.IsWeeklyGoalModalOpen), Mode=OneWay}">
            <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#121214" BorderBrush="#CE824C" BorderThickness="1" CornerRadius="12" Padding="28">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="ПЛАНИРОВАНИЕ ЦЕЛИ НА НЕДЕЛЮ" FontSize="11" FontWeight="Bold" Foreground="#CE824C" CharacterSpacing="120" />
                            <TextBlock Text="{x:Bind ViewModel.WeeklyGoalModalViewModel.WeekAndMonthHeader, Mode=OneWay}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="#F4F4F5" />
                        </StackPanel>
                        <Button Click="OnCloseWeeklyGoalModalClick" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0" Padding="6">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#A1A1AA" />
                        </Button>
                    </Grid>

                    <TextBox Header="Формулировка цели на неделю"
                             Text="{x:Bind ViewModel.WeeklyGoalModalViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{x:Bind ViewModel.WeeklyGoalModalViewModel.IsLocked, Mode=OneWay}"
                             PlaceholderText="Что является главным фокусом недели?"
                             Background="#18181B" BorderBrush="#27272A" CornerRadius="6" />

                    <ComboBox Header="Привязка к этапу Большой цели (опционально)"
                              ItemsSource="{x:Bind ViewModel.WeeklyGoalModalViewModel.AvailableMilestones, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.WeeklyGoalModalViewModel.SelectedMilestone, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.WeeklyGoalModalViewModel.CanEdit, Mode=OneWay}"
                              HorizontalAlignment="Stretch" CornerRadius="6" />

                    <!-- Состояние: Заблокировано (Commitment Lock) -->
                    <StackPanel Spacing="12" Visibility="{x:Bind conv:XamlConverters.ToVisibility(ViewModel.WeeklyGoalModalViewModel.IsLocked), Mode=OneWay}">
                        <Border Background="#261E16" BorderBrush="#CE824C" BorderThickness="1" CornerRadius="6" Padding="12, 8">
                            <TextBlock Text="Цель зафиксирована (Commitment Lock). Редактирование текста недоступно. Доступны только явные действия с указанием причины."
                                       FontSize="11" Foreground="#E5A158" TextWrapping="Wrap" />
                        </Border>

                        <TextBox Header="Причина изменения / переноса"
                                 Text="{x:Bind ViewModel.WeeklyGoalModalViewModel.ActionReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Укажите честную причину..."
                                 Background="#18181B" BorderBrush="#27272A" CornerRadius="6" />

                        <Grid Margin="0, 8, 0, 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="OnWeeklyGoalPostponeClick" HorizontalAlignment="Stretch"
                                    Background="#27272A" Foreground="#F4F4F5" CornerRadius="6" Height="36" Content="Перенести на след. неделю" />
                            <Button Grid.Column="2" Click="OnWeeklyGoalCancelActionClick" HorizontalAlignment="Stretch"
                                    Background="#3F1D1D" Foreground="#F87171" CornerRadius="6" Height="36" Content="Отменить цель" />
                        </Grid>
                    </StackPanel>

                    <!-- Состояние: Доступно редактирование -->
                    <StackPanel Spacing="12" Visibility="{x:Bind conv:XamlConverters.ToInverseVisibility(ViewModel.WeeklyGoalModalViewModel.IsLocked), Mode=OneWay}">
                        <Border Background="#18181B" CornerRadius="6" Padding="12, 8">
                            <TextBlock Text="После фиксации или через 2 часа цель будет заблокирована от случайных правок."
                                       FontSize="11" Foreground="#71717A" TextWrapping="Wrap" />
                        </Border>

                        <Grid Margin="0, 8, 0, 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="OnWeeklyGoalSaveDraftClick" HorizontalAlignment="Stretch"
                                    Background="#27272A" Foreground="#F4F4F5" CornerRadius="6" Height="38" Content="Сохранить черновик" />
                            <Button Grid.Column="2" Click="OnWeeklyGoalLockClick" HorizontalAlignment="Stretch"
                                    Background="#CE824C" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="6" Height="38" Content="Зафиксировать на неделю" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Модальное окно Add Big Goal -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="#E6000000"
              Visibility="{x:Bind conv:XamlConverters.ToVisibility(ViewModel.IsAddGoalModalOpen), Mode=OneWay}">
            <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#121214" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="28">
                <StackPanel Spacing="14">
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="НОВАЯ БОЛЬШАЯ ЦЕЛЬ" FontSize="11" FontWeight="Bold" Foreground="#CE824C" CharacterSpacing="120" />
                            <TextBlock Text="Горизонт 1–3 года (максимум 4 цели)" FontSize="15" FontWeight="SemiBold" Foreground="#F4F4F5" />
                        </StackPanel>
                        <Button Click="OnCloseAddBigGoalModalClick" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0" Padding="6">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#A1A1AA" />
                        </Button>
                    </Grid>

                    <TextBox Header="Название цели"
                             Text="{x:Bind ViewModel.GoalsViewModel.NewGoalTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Чего вы хотите достичь?"
                             Background="#18181B" BorderBrush="#27272A" CornerRadius="6" />

                    <TextBox Header="Глубинная мотивация (Зачем это нужно?)"
                             Text="{x:Bind ViewModel.GoalsViewModel.NewGoalMotivation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Почему это важно для вашей жизни?"
                             Background="#18181B" BorderBrush="#27272A" CornerRadius="6" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Header="Измеримый результат"
                                 Text="{x:Bind ViewModel.GoalsViewModel.NewGoalTargetResult, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Конкретный образ результата"
                                 Background="#18181B" BorderBrush="#27272A" CornerRadius="6" />
                        <TextBox Grid.Column="2" Header="Срок достижения"
                                 Text="{x:Bind ViewModel.GoalsViewModel.NewGoalTargetPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Например: 2026—2027"
                                 Background="#18181B" BorderBrush="#27272A" CornerRadius="6" />
                    </Grid>

                    <ComboBox Header="Иконка направления" SelectionChanged="OnGoalIconSelectionChanged" SelectedIndex="0" HorizontalAlignment="Stretch" CornerRadius="6">
                        <ComboBoxItem Content="Compass" />
                        <ComboBoxItem Content="Wallet" />
                        <ComboBoxItem Content="Briefcase" />
                        <ComboBoxItem Content="Brain" />
                    </ComboBox>

                    <!-- Добавление этапов (Milestones) -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Начальные этапы (Milestones):" FontSize="12" Foreground="#A1A1AA" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.GoalsViewModel.NewGoalInitialMilestones, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#18181B" CornerRadius="4" Padding="10, 6" Margin="0, 0, 0, 4">
                                        <Grid>
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#F4F4F5" VerticalAlignment="Center" />
                                            <Button Click="OnRemoveMilestoneFromNewGoalClick" Tag="{Binding}" HorizontalAlignment="Right"
                                                    Background="Transparent" BorderThickness="0" Padding="4">
                                                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#71717A" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{x:Bind ViewModel.GoalsViewModel.NewMilestoneTitleInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Название нового промежуточного этапа"
                                     Background="#18181B" BorderBrush="#27272A" Height="36" CornerRadius="6, 0, 0, 6" />
                            <Button Grid.Column="1" Click="OnAddMilestoneToNewGoalClick"
                                    Background="#27272A" Height="36" Padding="12, 0" CornerRadius="0, 6, 6, 0" Content="Добавить этап" />
                        </Grid>
                    </StackPanel>

                    <Grid Margin="0, 8, 0, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Click="OnCloseAddBigGoalModalClick" HorizontalAlignment="Stretch"
                                Background="#27272A" Foreground="#F4F4F5" CornerRadius="6" Height="38" Content="Отмена" />
                        <Button Grid.Column="2" Click="OnSaveNewBigGoalClick" HorizontalAlignment="Stretch"
                                Background="#CE824C" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="6" Height="38" Content="Создать цель" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Полноэкранный оверлей Monthly Recap -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="#FA09090B" Padding="60, 40"
              Visibility="{x:Bind conv:XamlConverters.ToVisibility(ViewModel.IsMonthlyRecapOpen), Mode=OneWay}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="24" MaxWidth="720" HorizontalAlignment="Center">
                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.MonthlyRecapViewModel.HeaderMonthYear, Mode=OneWay}"
                                       FontSize="28" FontWeight="Bold" Foreground="#CE824C" CharacterSpacing="120" />
                            <TextBlock Text="{x:Bind ViewModel.MonthlyRecapViewModel.HeaderSubtitle, Mode=OneWay}"
                                       FontSize="14" Foreground="#A1A1AA" />
                        </StackPanel>
                        <Button Click="OnCloseMonthlyRecapClick" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0" Padding="8">
                            <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="#A1A1AA" />
                        </Button>
                    </Grid>

                    <!-- 3 Метрические карточки итогов -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#121214" BorderBrush="#CE824C" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind conv:XamlConverters.ToPercentString(ViewModel.MonthlyRecapViewModel.MonthlyScore), Mode=OneWay}"
                                           FontSize="38" FontWeight="Bold" Foreground="#CE824C" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="Итоговый счёт" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#121214" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.MonthlyRecapViewModel.DailyFraction, Mode=OneWay}"
                                           FontSize="26" FontWeight="Bold" Foreground="#36D399" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="Daily Rituals" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#121214" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.MonthlyRecapViewModel.WeeklyFraction, Mode=OneWay}"
                                           FontSize="26" FontWeight="Bold" Foreground="#CE824C" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="Weekly Goals" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Блок рефлексии -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.MonthlyRecapViewModel.ReflectionPrompt, Mode=OneWay}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#F4F4F5" />
                        <TextBox Text="{x:Bind ViewModel.MonthlyRecapViewModel.ReflectionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="140" TextWrapping="Wrap"
                                 IsReadOnly="{x:Bind ViewModel.MonthlyRecapViewModel.IsFinalized, Mode=OneWay}"
                                 PlaceholderText="Запишите свои наблюдения, выводы и то, что планируете изменить..."
                                 Background="#121214" BorderBrush="#27272A" CornerRadius="8" Padding="12" />
                    </StackPanel>

                    <!-- Кнопки завершения -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button Click="OnCloseMonthlyRecapClick" Background="#27272A" Foreground="#F4F4F5" CornerRadius="6" Height="40" Padding="18, 0" Content="Закрыть" />
                        <Button Click="OnFinalizeMonthClick"
                                Visibility="{x:Bind conv:XamlConverters.ToVisibility(ViewModel.MonthlyRecapViewModel.CanFinalize), Mode=OneWay}"
                                Background="#CE824C" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="6" Height="40" Padding="22, 0"
                                Content="Завершить месяц и начать новый цикл" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>