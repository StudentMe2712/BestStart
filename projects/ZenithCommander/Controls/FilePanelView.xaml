<UserControl x:Class="ZenithCommander.Controls.FilePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZenithCommander.Controls"
             xmlns:models="clr-namespace:ZenithCommander.Models"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="500"
             GotFocus="UserControl_GotFocus"
             PreviewMouseDown="UserControl_PreviewMouseDown">
    
    <Border Background="{StaticResource BrushBackground}"
            BorderBrush="{Binding IsActive, Converter={StaticResource ActiveBorderBrushConv}}"
            BorderThickness="1"
            CornerRadius="6"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Top Header & Drive Bar -->
                <RowDefinition Height="Auto" /> <!-- Breadcrumb / Path Bar -->
                <RowDefinition Height="Auto" /> <!-- Loading / Error Bar -->
                <RowDefinition Height="*" />    <!-- File List -->
                <RowDefinition Height="Auto" /> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Top Header & Drive Bar -->
            <Border Grid.Row="0"
                    Background="{Binding IsActive, Converter={StaticResource ActiveHeaderBgConv}}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Active Indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#55555C" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource BrushAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding PanelTitle}"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Drive Chips -->
                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding Drives}"
                                  HorizontalAlignment="Right">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Style="{StaticResource DriveChipButton}"
                                        Command="{Binding DataContext.ChangeDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- 2. Path & Navigation Toolbar -->
            <Border Grid.Row="1"
                    Background="{StaticResource BrushSecondary}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Up Button -->
                    <Button Grid.Column="0"
                            Content=" ⬆ Up "
                            ToolTip="Go Up (Backspace / Alt+Left)"
                            Command="{Binding NavigateUpCommand}"
                            Margin="0,0,4,0" />

                    <!-- Refresh Button -->
                    <Button Grid.Column="1"
                            Content=" 🔄 Refresh "
                            ToolTip="Refresh (F5 / Ctrl+R)"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,6,0" />

                    <!-- Path Input -->
                    <TextBox x:Name="PathTextBox"
                             Grid.Column="2"
                             Text="{Binding CurrentPath, UpdateSourceTrigger=LostFocus}"
                             KeyDown="PathTextBox_KeyDown"
                             VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 3. Loading & Error Banners -->
            <StackPanel Grid.Row="2">
                <!-- Loading Progress Bar -->
                <ProgressBar Height="2"
                             IsIndeterminate="True"
                             BorderThickness="0"
                             Foreground="{StaticResource BrushAccent}"
                             Background="Transparent"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                <!-- Error Notification Banner -->
                <Border Background="#4A1E24"
                        BorderBrush="{StaticResource BrushError}"
                        BorderThickness="0,0,0,1"
                        Padding="8,4"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource BrushError}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 4. Virtualized File ListView -->
            <ListView x:Name="FileListView"
                      Grid.Row="3"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      MouseDoubleClick="FileListView_MouseDoubleClick"
                      KeyDown="FileListView_KeyDown"
                      SelectionChanged="FileListView_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="38">
                            <GridViewColumn.Header>
                                <TextBlock Text="" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IconGlyph}"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="230">
                            <GridViewColumn.Header>
                                <TextBlock Text="Name" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{Binding IsDirectory, Converter={StaticResource ItemTypeToBrush}}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="55">
                            <GridViewColumn.Header>
                                <TextBlock Text="Ext" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Extension}"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="90">
                            <GridViewColumn.Header>
                                <TextBlock Text="Size" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedSize}"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="135">
                            <GridViewColumn.Header>
                                <TextBlock Text="Date Modified" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedDate}"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 5. Bottom Panel Status Bar -->
            <Border Grid.Row="4"
                    Background="{StaticResource BrushSecondary}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText}"
                               FontSize="11"
                               Foreground="{StaticResource BrushTextSecondary}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding SelectedItem.Name}"
                               FontSize="11"
                               Foreground="{StaticResource BrushAccent}"
                               FontWeight="Medium"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="160"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>