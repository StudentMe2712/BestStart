<Window x:Class="NexusCommander.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NexusCommander"
        xmlns:vm="clr-namespace:NexusCommander.ViewModels"
        xmlns:models="clr-namespace:NexusCommander.Models"
        mc:Ignorable="d"
        Title="Проводник"
        Height="800" Width="1300"
        MinHeight="500" MinWidth="850"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CaptionHeight="42"
                      CornerRadius="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- Root Window Container for Windows 11 Mica Backdrop & Glassmorphism -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />  <!-- 0: Windows 11 Title Bar with Tabs -->
            <RowDefinition Height="46" />  <!-- 1: Navigation & Address Bar & Search -->
            <RowDefinition Height="44" />  <!-- 2: Windows 11 Command Bar (~44px) -->
            <RowDefinition Height="*" />   <!-- 3: Sidebar + Main File View -->
            <RowDefinition Height="30" />  <!-- 4: Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ================= 0: TOP TITLE BAR WITH TABS ================= -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushMica}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Tabs Area -->
                    <ColumnDefinition Width="*" />    <!-- Draggable Center -->
                    <ColumnDefinition Width="Auto" /> <!-- Window Controls (Min, Max, Close) -->
                </Grid.ColumnDefinitions>

                <!-- Windows 11 Tab Strip -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Active Tab Card -->
                    <Border Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorderLight}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Height="32"
                            Margin="0,0,4,0"
                            Padding="10,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{Binding FolderIcon}"
                                   Width="16" Height="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <TextBlock Text="{Binding CurrentFolderName}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center"
                                       MaxWidth="180"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Close Tab Button -->
                            <Button Width="20" Height="20"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource NavIconButton}"
                                    Command="{Binding CloseTabCommand}"
                                    ToolTip="Закрыть вкладку">
                                <TextBlock Text="✕" FontSize="9" Foreground="{StaticResource BrushTextSecondary}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- New Tab Button -->
                    <Button Width="28" Height="28"
                            Style="{StaticResource NavIconButton}"
                            Command="{Binding NewTabCommand}"
                            ToolTip="Новая вкладка (Ctrl+T)">
                        <TextBlock Text="➕" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" />
                    </Button>
                </StackPanel>

                <!-- Window Controls (Minimize, Maximize/Restore, Close) -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Minimize Button -->
                    <Button Width="44"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Click="BtnMinimize_Click"
                            ToolTip="Свернуть">
                        <TextBlock Text="—" FontSize="11" FontWeight="Bold" />
                    </Button>

                    <!-- Maximize/Restore Button -->
                    <Button Width="44"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Click="BtnMaximize_Click"
                            ToolTip="Развернуть / Восстановить">
                        <TextBlock x:Name="MaximizeIconText" Text="🗖" FontSize="11" />
                    </Button>

                    <!-- Close Button -->
                    <Button x:Name="BtnClose"
                            Width="46"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Click="BtnClose_Click"
                            ToolTip="Закрыть">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBorder"
                                        Background="{TemplateBinding Background}"
                                        SnapsToDevicePixels="True">
                                    <TextBlock Text="✕"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                     <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBorder" Property="Background" Value="#C42B1C" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

                <!-- ================= 1: TOP NAVIGATION & ADDRESS BAR & SEARCH ================= -->
                <Border Grid.Row="1"
                        Background="{StaticResource BrushMica}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /> <!-- Navigation Buttons (Back, Forward, Up, Refresh) -->
                            <ColumnDefinition Width="*" />    <!-- Breadcrumb / Address Bar -->
                            <ColumnDefinition Width="280" />  <!-- Windows 11 Search Box -->
                        </Grid.ColumnDefinitions>

                        <!-- Navigation Buttons in Rounded Frames -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                            <Button Style="{StaticResource NavIconButton}"
                                    Command="{Binding GoBackCommand}"
                                    ToolTip="Назад (Alt+Left)">
                                <TextBlock Text="◀" FontSize="11" />
                            </Button>

                            <Button Style="{StaticResource NavIconButton}"
                                    Command="{Binding GoForwardCommand}"
                                    ToolTip="Вперед (Alt+Right)">
                                <TextBlock Text="▶" FontSize="11" />
                            </Button>

                            <Button Style="{StaticResource NavIconButton}"
                                    Command="{Binding NavigateUpCommand}"
                                    ToolTip="Вверх (Alt+Up)">
                                <TextBlock Text="⬆" FontSize="12" />
                            </Button>

                            <Button Style="{StaticResource NavIconButton}"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="Обновить (F5)">
                                <TextBlock Text="🔄" FontSize="11" />
                            </Button>
                        </StackPanel>

                        <!-- Windows 11 Breadcrumb Address Bar -->
                        <Border Grid.Column="1"
                                Style="{StaticResource Win11InputContainerStyle}"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <Grid>
                                <!-- Mode A: Clickable Breadcrumb Segments -->
                                <Grid Visibility="{Binding IsEditingPath, Converter={StaticResource InverseBoolToVis}}"
                                      Background="Transparent"
                                      MouseDown="AddressBar_MouseDown"
                                      Cursor="Hand">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0"
                                           Source="{Binding FolderIcon}"
                                           Width="16" Height="16"
                                           VerticalAlignment="Center"
                                           Margin="4,0,6,0"
                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                    <!-- Breadcrumb Segments ItemsControl -->
                                    <ItemsControl Grid.Column="1"
                                                  ItemsSource="{Binding Breadcrumbs}"
                                                  VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{Binding Name}"
                                                            Style="{StaticResource BreadcrumbButton}"
                                                            Command="{Binding DataContext.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{Binding FullPath}" />

                                                    <!-- Segment Chevron Separator -->
                                                    <TextBlock Text="›"
                                                               Foreground="{StaticResource BrushTextMuted}"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"
                                                               Margin="2,0,2,0"
                                                               Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVis}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Switch to Edit Mode Icon Button -->
                                    <Button Grid.Column="2"
                                            Width="24" Height="24"
                                            Style="{StaticResource NavIconButton}"
                                            Command="{Binding StartEditPathCommand}"
                                            ToolTip="Редактировать адрес (Ctrl+L / Alt+D)"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,2,0">
                                        <TextBlock Text="✏️" FontSize="10" />
                                    </Button>
                                </Grid>

                                <!-- Mode B: Editable Address TextBox -->
                                <Grid Visibility="{Binding IsEditingPath, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="AddressTextBox"
                                             Grid.Column="0"
                                             Text="{Binding PathInputText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="{StaticResource BrushTextPrimary}"
                                             CaretBrush="{StaticResource BrushAccentLight}"
                                             VerticalAlignment="Center"
                                             FontSize="12"
                                             Padding="4,0"
                                             KeyDown="AddressTextBox_KeyDown"
                                             LostFocus="AddressTextBox_LostFocus" />

                                    <Button Grid.Column="1"
                                            Width="24" Height="24"
                                            Style="{StaticResource NavIconButton}"
                                            Command="{Binding CommitEditPathCommand}"
                                            ToolTip="Перейти"
                                            Margin="0,0,2,0">
                                        <TextBlock Text="➔" FontSize="11" Foreground="{StaticResource BrushAccentLight}" />
                                    </Button>

                                    <Button Grid.Column="2"
                                            Width="24" Height="24"
                                            Style="{StaticResource NavIconButton}"
                                            Command="{Binding CancelEditPathCommand}"
                                            ToolTip="Отмена"
                                            Margin="0,0,2,0">
                                        <TextBlock Text="✕" FontSize="10" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Windows 11 Search Box -->
                        <Border Grid.Column="2"
                                Style="{StaticResource Win11InputContainerStyle}"
                                VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="🔍"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           VerticalAlignment="Center"
                                           Margin="4,0,4,0" />

                                <TextBox x:Name="SearchTextBox"
                                         Grid.Column="1"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{StaticResource BrushTextPrimary}"
                                         CaretBrush="{StaticResource BrushAccentLight}"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         Padding="2,0" />

                                <!-- Dynamic Placeholder Text -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SearchPlaceholder}"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Margin="4,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding SearchQuery, Converter={StaticResource StringNullOrEmptyToVis}, ConverterParameter=invert}" />

                                <!-- Clear search button -->
                                <Button Grid.Column="2"
                                        Width="20" Height="20"
                                        Style="{StaticResource NavIconButton}"
                                        Click="BtnClearSearch_Click"
                                        ToolTip="Очистить поиск"
                                        Visibility="{Binding SearchQuery, Converter={StaticResource StringNullOrEmptyToVis}}">
                                    <TextBlock Text="✕" FontSize="9" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= 2: WINDOWS 11 COMMAND BAR (~44px) ================= -->
                <Border Grid.Row="2"
                        Background="{StaticResource BrushMicaSecondary}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="8,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- [ ➕ Создать ▾ ] Button with ContextMenu -->
                            <Button x:Name="BtnCreateDropdown"
                                    Style="{StaticResource CommandBarButton}"
                                    Click="BtnCreate_Click"
                                    ToolTip="Создать новый элемент (Ctrl+Shift+N)">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="📁 Папка"
                                                  InputGestureText="Ctrl+Shift+N"
                                                  Command="{Binding NewFolderCommand}" />
                                        <MenuItem Header="📄 Текстовый документ"
                                                  Command="{Binding NewTextFileCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="➕ " FontSize="11" Foreground="{StaticResource BrushAccentLight}" />
                                    <TextBlock Text="Создать " FontWeight="Medium" />
                                    <TextBlock Text="▾" FontSize="9" Foreground="{StaticResource BrushTextMuted}" />
                                </StackPanel>
                            </Button>

                            <!-- Thin Vertical Separator -->
                            <Border Width="1" Height="18" Background="{StaticResource BrushBorderLight}" Margin="6,0" />

                            <!-- Compact Icon Action Group (Width=32, Height=32, CornerRadius=4) -->
                            <!-- ✂ Cut -->
                            <Button Style="{StaticResource CommandBarActionButton}"
                                    Command="{Binding CutCommand}"
                                    ToolTip="Вырезать (Ctrl+X)">
                                <TextBlock Text="✂" FontSize="13" />
                            </Button>

                            <!-- 📋 Copy -->
                            <Button Style="{StaticResource CommandBarActionButton}"
                                    Command="{Binding CopyCommand}"
                                    ToolTip="Копировать (Ctrl+C)">
                                <TextBlock Text="📋" FontSize="12" />
                            </Button>

                            <!-- 📥 Paste -->
                            <Button Style="{StaticResource CommandBarActionButton}"
                                    Command="{Binding PasteCommand}"
                                    ToolTip="Вставить (Ctrl+V)">
                                <TextBlock Text="📥" FontSize="12" />
                            </Button>

                            <!-- ✏️ Rename -->
                            <Button Style="{StaticResource CommandBarActionButton}"
                                    Command="{Binding RenameCommand}"
                                    ToolTip="Переименовать (F2)">
                                <TextBlock Text="✏️" FontSize="12" />
                            </Button>

                            <!-- 🔗 Share / Copy Path -->
                            <Button Style="{StaticResource CommandBarActionButton}"
                                    Command="{Binding CopyPathCommand}"
                                    ToolTip="Поделиться / Копировать путь">
                                <TextBlock Text="🔗" FontSize="12" />
                            </Button>

                            <!-- 🗑️ Delete -->
                            <Button Style="{StaticResource CommandBarActionButton}"
                                    Command="{Binding DeleteCommand}"
                                    ToolTip="Удалить (Delete)">
                                <TextBlock Text="🗑️" FontSize="12" Foreground="{StaticResource BrushError}" />
                            </Button>

                            <!-- Thin Vertical Separator -->
                            <Border Width="1" Height="18" Background="{StaticResource BrushBorderLight}" Margin="6,0" />

                            <!-- ⇅ Сортировка ▾ Dropdown -->
                            <Button x:Name="BtnSortDropdown"
                                    Style="{StaticResource CommandBarButton}"
                                    Click="BtnSort_Click"
                                    ToolTip="Параметры сортировки">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Имя"
                                                  Command="{Binding SortByNameCommand}" />
                                        <MenuItem Header="Дата изменения"
                                                  Command="{Binding SortByDateCommand}" />
                                        <MenuItem Header="Тип"
                                                  Command="{Binding SortByTypeCommand}" />
                                        <MenuItem Header="Размер"
                                                  Command="{Binding SortBySizeCommand}" />
                                        <Separator />
                                        <MenuItem Header="По возрастанию / убыванию"
                                                  Command="{Binding ToggleSortDirectionCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⇅ " FontSize="12" />
                                    <TextBlock Text="Сортировка " />
                                    <TextBlock Text="▾" FontSize="9" Foreground="{StaticResource BrushTextMuted}" />
                                </StackPanel>
                            </Button>

                            <!-- ☷ Вид ▾ Dropdown -->
                            <Button x:Name="BtnViewDropdown"
                                    Style="{StaticResource CommandBarButton}"
                                    Click="BtnView_Click"
                                    ToolTip="Параметры отображения">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Таблица (подробный)" IsChecked="True" />
                                        <Separator />
                                        <MenuItem Header="Скрытые элементы"
                                                  IsCheckable="True"
                                                  IsChecked="{Binding ShowHiddenFiles}"
                                                  Command="{Binding ToggleShowHiddenFilesCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="☷ " FontSize="12" />
                                    <TextBlock Text="Вид " />
                                    <TextBlock Text="▾" FontSize="9" Foreground="{StaticResource BrushTextMuted}" />
                                </StackPanel>
                            </Button>

                            <!-- 💻 Открыть в терминале -->
                            <Button Style="{StaticResource CommandBarButton}"
                                    Command="{Binding OpenInTerminalCommand}"
                                    ToolTip="Открыть в терминале PowerShell">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💻 " FontSize="12" />
                                    <TextBlock Text="Терминал" />
                                </StackPanel>
                            </Button>

                            <!-- ℹ️ Свойства -->
                            <Button Style="{StaticResource CommandBarButton}"
                                    Command="{Binding PropertiesCommand}"
                                    ToolTip="Свойства (Alt+Enter)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="ℹ️ " FontSize="12" Foreground="{StaticResource BrushAccentLight}" />
                                    <TextBlock Text="Свойства" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= 3: SIDEBAR + MAIN FILE VIEW ================= -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" MinWidth="180" MaxWidth="360" /> <!-- Windows 11 Navigation Pane -->
                        <ColumnDefinition Width="4" />                                   <!-- Grid Splitter -->
                        <ColumnDefinition Width="*" MinWidth="300" />                   <!-- Fluent File List View -->
                    </Grid.ColumnDefinitions>

                    <!-- SIDEBAR (Windows 11 Navigation Pane: #1C1C1C, rounded items, no blue strip) -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BrushSidebar}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4,6">
                                <!-- Section 1: Главная (Pinned standard folders) -->
                                <TextBlock Text="Главная"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           Margin="12,8,0,4" />

                                <ItemsControl ItemsSource="{Binding QuickAccessItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SidebarItemButton}"
                                                    Command="{Binding DataContext.SelectSidebarItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding Path}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="{Binding Icon}"
                                                           Width="16" Height="16"
                                                           Margin="0,0,10,0"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource BrushTextPrimary}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Separator Style="{StaticResource {x:Type Separator}}" Margin="10,8" />

                                <!-- Section 2: Этот компьютер (Drives & Storage) -->
                                <TextBlock Text="Этот компьютер"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           Margin="12,4,0,4" />

                                <ItemsControl ItemsSource="{Binding DriveItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SidebarItemButton}"
                                                    Command="{Binding DataContext.SelectSidebarItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding Path}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Image Grid.Column="0"
                                                           Source="{Binding Icon}"
                                                           Width="16" Height="16"
                                                           Margin="0,0,10,0"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="12"
                                                                   FontWeight="Medium"
                                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource BrushTextMuted}"
                                                                   Margin="0,1,0,2"
                                                                   TextTrimming="CharacterEllipsis" />

                                                        <!-- Mini Storage Usage Bar -->
                                                        <ProgressBar Height="3"
                                                                     Value="{Binding UsagePercent}"
                                                                     Maximum="100"
                                                                     Foreground="{StaticResource BrushAccentLight}"
                                                                     Background="#33FFFFFF"
                                                                     BorderThickness="0"
                                                                     Margin="0,1,6,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Splitter between Sidebar & Main List -->
                    <GridSplitter Grid.Column="1"
                                  Width="4"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Columns">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="{x:Type GridSplitter}">
                                <Border Background="Transparent">
                                    <Border x:Name="SplitterBar"
                                            Width="1"
                                            Background="{StaticResource BrushBorder}"
                                            HorizontalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SplitterBar" Property="Background" Value="{StaticResource BrushAccentLight}" />
                                        <Setter TargetName="SplitterBar" Property="Width" Value="2" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <!-- MAIN VIEW (File & Folder List) -->
                    <Grid Grid.Column="2" Background="{StaticResource BrushBackground}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Loading / Error Bar -->
                            <RowDefinition Height="*" />    <!-- Virtualized ListView -->
                        </Grid.RowDefinitions>

                        <!-- Loading & Error Banners -->
                        <StackPanel Grid.Row="0">
                            <!-- Progress Bar on Loading -->
                            <ProgressBar Height="2"
                                         IsIndeterminate="True"
                                         BorderThickness="0"
                                         Foreground="{StaticResource BrushAccentLight}"
                                         Background="Transparent"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                            <!-- Error Notification Banner -->
                            <Border Background="{StaticResource BrushErrorBg}"
                                    BorderBrush="{StaticResource BrushError}"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,6"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚠️ " Foreground="{StaticResource BrushError}" FontSize="12" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ErrorMessage}"
                                               Foreground="{StaticResource BrushError}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Spacious Virtualized Windows 11 Fluent File List -->
                        <ListView x:Name="FileListView"
                                  Grid.Row="1"
                                  ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                  SelectionMode="Extended"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.IsDeferredScrollingEnabled="False"
                                  MouseDoubleClick="FileListView_MouseDoubleClick"
                                  SelectionChanged="FileListView_SelectionChanged"
                                  KeyDown="FileListView_KeyDown"
                                  Padding="4,2"
                                  Tag="{Binding}">

                            <!-- Empty Area Context Menu (Right Click on Background) -->
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="☷ Вид">
                                        <MenuItem Header="Таблица (подробный)" IsChecked="True" />
                                    </MenuItem>
                                    <MenuItem Header="⇅ Сортировка">
                                        <MenuItem Header="По имени" Command="{Binding PlacementTarget.Tag.SortByNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="По дате изменения" Command="{Binding PlacementTarget.Tag.SortByDateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="По типу" Command="{Binding PlacementTarget.Tag.SortByTypeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="По размеру" Command="{Binding PlacementTarget.Tag.SortBySizeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </MenuItem>
                                    <MenuItem Header="🔄 Обновить"
                                              InputGestureText="F5"
                                              Command="{Binding PlacementTarget.Tag.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="📥 Вставить"
                                              InputGestureText="Ctrl+V"
                                              Command="{Binding PlacementTarget.Tag.PasteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="➕ Создать">
                                        <MenuItem Header="📁 Папка"
                                                  InputGestureText="Ctrl+Shift+N"
                                                  Command="{Binding PlacementTarget.Tag.NewFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="📄 Текстовый документ"
                                                  Command="{Binding PlacementTarget.Tag.NewTextFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="💻 Открыть в терминале"
                                              Command="{Binding PlacementTarget.Tag.OpenInTerminalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="ℹ️ Свойства"
                                              Command="{Binding PlacementTarget.Tag.PropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </ListView.ContextMenu>

                            <!-- Item Container Style with Windows 11 Signature Context Menu -->
                            <ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <!-- Windows 11 Signature Top Horizontal Quick Action Bar -->
                                                <Grid Margin="2,2,2,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- ✂ Cut -->
                                                    <Button Grid.Column="0"
                                                            Style="{StaticResource ContextMenuTopActionButton}"
                                                            Command="{Binding PlacementTarget.Tag.CutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            ToolTip="Вырезать (Ctrl+X)">
                                                        <TextBlock Text="✂" FontSize="13" />
                                                    </Button>

                                                    <!-- 📋 Copy -->
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource ContextMenuTopActionButton}"
                                                            Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            ToolTip="Копировать (Ctrl+C)">
                                                        <TextBlock Text="📋" FontSize="12" />
                                                    </Button>

                                                    <!-- ✏️ Rename -->
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource ContextMenuTopActionButton}"
                                                            Command="{Binding PlacementTarget.Tag.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            ToolTip="Переименовать (F2)">
                                                        <TextBlock Text="✏️" FontSize="12" />
                                                    </Button>

                                                    <!-- 🔗 Share / Copy Path -->
                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource ContextMenuTopActionButton}"
                                                            Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            ToolTip="Поделиться / Копировать путь">
                                                        <TextBlock Text="🔗" FontSize="12" />
                                                    </Button>

                                                    <!-- 🗑️ Delete -->
                                                    <Button Grid.Column="4"
                                                            Style="{StaticResource ContextMenuTopActionButton}"
                                                            Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            ToolTip="Удалить (Delete)">
                                                        <TextBlock Text="🗑️" FontSize="12" Foreground="{StaticResource BrushError}" />
                                                    </Button>
                                                </Grid>

                                                <Separator />

                                                <!-- Vertical Context Menu Items -->
                                                <MenuItem Header="⚡ Открыть"
                                                          FontWeight="SemiBold"
                                                          Command="{Binding PlacementTarget.Tag.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="📋 Копировать как путь"
                                                          Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="💻 Открыть в терминале"
                                                          Command="{Binding PlacementTarget.Tag.OpenInTerminalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="📥 Вставить"
                                                          InputGestureText="Ctrl+V"
                                                          Command="{Binding PlacementTarget.Tag.PasteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <MenuItem Header="➕ Создать папку"
                                                          InputGestureText="Ctrl+Shift+N"
                                                          Command="{Binding PlacementTarget.Tag.NewFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="🔄 Обновить"
                                                          InputGestureText="F5"
                                                          Command="{Binding PlacementTarget.Tag.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <MenuItem Header="ℹ️ Свойства"
                                                          InputGestureText="Alt+Enter"
                                                          Command="{Binding PlacementTarget.Tag.PropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <!-- Modern Windows 11 Column Headers and Cells -->
                            <ListView.View>
                                <GridView>
                                    <!-- 1. Name Column (with semantic category glyph) -->
                                    <GridViewColumn Width="380">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Click="GridViewColumnHeader_Click" Tag="Name">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Имя" />
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource SortColumnToGlyph}">
                                                                <Binding Path="DataContext.SortColumn" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="DataContext.SortAscending" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Source="Name" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </GridViewColumnHeader>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Native Shell Icon -->
                                                    <Image Source="{Binding Icon}"
                                                           Width="16" Height="16"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                                    <!-- File / Folder Name (FIX ORANGE TEXT: Pure Crisp White) -->
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{StaticResource BrushTextPrimary}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- 2. Date Modified Column -->
                                    <GridViewColumn Width="160">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Click="GridViewColumnHeader_Click" Tag="Date">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Дата изменения" />
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource SortColumnToGlyph}">
                                                                <Binding Path="DataContext.SortColumn" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="DataContext.SortAscending" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Source="Date" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </GridViewColumnHeader>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FormattedDate}"
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- 3. Type / Category Column -->
                                    <GridViewColumn Width="180">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Click="GridViewColumnHeader_Click" Tag="Type">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Тип" />
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource SortColumnToGlyph}">
                                                                <Binding Path="DataContext.SortColumn" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="DataContext.SortAscending" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Source="Type" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </GridViewColumnHeader>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ItemType}"
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- 4. Size Column (Formatted KB / MB / GB, blank for folders) -->
                                    <GridViewColumn Width="110">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Click="GridViewColumnHeader_Click" Tag="Size">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Размер" />
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource SortColumnToGlyph}">
                                                                <Binding Path="DataContext.SortColumn" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="DataContext.SortAscending" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Source="Size" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </GridViewColumnHeader>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FormattedSize}"
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Grid>

        <!-- ================= 4: BOTTOM STATUS BAR ================= -->
        <Border Grid.Row="4"
                Background="{StaticResource BrushMica}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />     <!-- Total Item Count -->
                    <ColumnDefinition Width="Auto" />  <!-- Selection Info -->
                    <ColumnDefinition Width="*" />     <!-- Drive Telemetry -->
                </Grid.ColumnDefinitions>

                <!-- Left: Item Count -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           FontSize="11"
                           Foreground="{StaticResource BrushTextSecondary}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <!-- Middle: Selection Info -->
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectedStatusText}"
                           FontSize="11"
                           Foreground="{StaticResource BrushAccentLight}"
                           FontWeight="Medium"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="16,0" />

                <!-- Right: Drive Storage Telemetry -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DriveSpaceText}"
                               FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <TextBlock Text="☷"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center"
                               ToolTip="Таблица" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>