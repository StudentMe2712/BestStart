<Window x:Class="NexusCommander.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NexusCommander"
        xmlns:vm="clr-namespace:NexusCommander.ViewModels"
        xmlns:models="clr-namespace:NexusCommander.Models"
        mc:Ignorable="d"
        Title="Проводник"
        Height="800" Width="1300"
        MinHeight="500" MinWidth="850"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CaptionHeight="42"
                      CornerRadius="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- Root Window Container for Windows 11 Mica Backdrop & Glassmorphism -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />  <!-- 0: Windows 11 Title Bar with Tabs -->
            <RowDefinition Height="48" />  <!-- 1: Navigation & Address Bar & Search (48px) -->
            <RowDefinition Height="48" />  <!-- 2: Windows 11 Command Bar (48px) -->
            <RowDefinition Height="*" />   <!-- 3: Sidebar + Main File View -->
            <RowDefinition Height="30" />  <!-- 4: Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ================= 0: TOP TITLE BAR WITH TABS ================= -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushMica}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Tabs Area -->
                    <ColumnDefinition Width="*" />    <!-- Draggable Center -->
                    <ColumnDefinition Width="Auto" /> <!-- Window Controls (Min, Max, Close) -->
                </Grid.ColumnDefinitions>

                <!-- Windows 11 Tab Strip -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Active Tab Card -->
                    <Border Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorderLight}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Height="32"
                            Margin="0,0,4,0"
                            Padding="10,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{Binding FolderIcon}"
                                   Width="16" Height="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <TextBlock Text="{Binding CurrentFolderName}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center"
                                       MaxWidth="180"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Close Tab Button -->
                            <Button Width="20" Height="20"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource NavIconButton}"
                                    Command="{Binding CloseTabCommand}"
                                    ToolTip="Закрыть вкладку">
                                <Path Data="{StaticResource GeoDismiss}"
                                      Fill="{StaticResource BrushTextSecondary}"
                                      Stretch="Uniform"
                                      Width="10" Height="10" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- New Tab Button -->
                    <Button Width="28" Height="28"
                            Style="{StaticResource NavIconButton}"
                            Command="{Binding NewTabCommand}"
                            ToolTip="Новая вкладка (Ctrl+T)">
                        <Path Data="{StaticResource GeoAdd}"
                              Fill="{StaticResource BrushTextSecondary}"
                              Stretch="Uniform"
                              Width="12" Height="12" />
                    </Button>
                </StackPanel>

                <!-- Window Controls (Minimize, Maximize/Restore, Close) -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Minimize Button -->
                    <Button Width="44"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Click="BtnMinimize_Click"
                            ToolTip="Свернуть">
                        <TextBlock Text="—" FontSize="11" FontWeight="Bold" />
                    </Button>

                    <!-- Maximize/Restore Button -->
                    <Button Width="44"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Click="BtnMaximize_Click"
                            ToolTip="Развернуть / Восстановить">
                        <TextBlock x:Name="MaximizeIconText" Text="🗖" FontSize="11" />
                    </Button>

                    <!-- Close Button -->
                    <Button x:Name="BtnClose"
                            Width="46"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Click="BtnClose_Click"
                            ToolTip="Закрыть">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBorder"
                                        Background="{TemplateBinding Background}"
                                        SnapsToDevicePixels="True">
                                    <TextBlock Text="✕"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                     <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBorder" Property="Background" Value="#C42B1C" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 1: TOP NAVIGATION & ADDRESS BAR & SEARCH ================= -->
        <Border Grid.Row="1"
                Background="{StaticResource BrushMica}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />                        <!-- 0: Navigation Buttons (Back, Forward, Up, Refresh) -->
                    <ColumnDefinition Width="3*" />                          <!-- 1: Breadcrumb / Address Bar (~75%) -->
                    <ColumnDefinition Width="1*" MinWidth="240" />           <!-- 2: Windows 11 Search Box (~25%, MinWidth=240) -->
                </Grid.ColumnDefinitions>

                <!-- Navigation Buttons in Rounded Frames (Width=32, Height=32, 16x16 icon) -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Style="{StaticResource NavIconButton}"
                            Command="{Binding GoBackCommand}"
                            ToolTip="Назад (Alt+Left)">
                        <Path Data="{StaticResource GeoArrowLeft}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Uniform"
                              Width="16" Height="16" />
                    </Button>

                    <Button Style="{StaticResource NavIconButton}"
                            Command="{Binding GoForwardCommand}"
                            ToolTip="Вперед (Alt+Right)">
                        <Path Data="{StaticResource GeoArrowRight}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Uniform"
                              Width="16" Height="16" />
                    </Button>

                    <Button Style="{StaticResource NavIconButton}"
                            Command="{Binding NavigateUpCommand}"
                            ToolTip="Вверх (Alt+Up)">
                        <Path Data="{StaticResource GeoArrowUp}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Uniform"
                              Width="16" Height="16" />
                    </Button>

                    <Button Style="{StaticResource NavIconButton}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Обновить (F5)">
                        <Path Data="{StaticResource GeoRefresh}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Uniform"
                              Width="16" Height="16" />
                    </Button>
                </StackPanel>

                <!-- Windows 11 Breadcrumb Address Bar (Width=3*) -->
                <Border Grid.Column="1"
                        Style="{StaticResource Win11InputContainerStyle}"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <!-- Mode A: Clickable Breadcrumb Segments -->
                        <Grid Visibility="{Binding IsEditingPath, Converter={StaticResource InverseBoolToVis}}"
                              Background="Transparent"
                              MouseDown="AddressBar_MouseDown"
                              Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                                   Source="{Binding FolderIcon}"
                                   Width="16" Height="16"
                                   VerticalAlignment="Center"
                                   Margin="6,0,6,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <!-- Breadcrumb Segments ItemsControl -->
                            <ItemsControl Grid.Column="1"
                                          ItemsSource="{Binding Breadcrumbs}"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{Binding Name}"
                                                    Style="{StaticResource BreadcrumbButton}"
                                                    Command="{Binding DataContext.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding FullPath}" />

                                            <!-- Segment Chevron Separator -->
                                            <TextBlock Text="›"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="2,0,2,0"
                                                       Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Switch to Edit Mode Icon Button -->
                            <Button Grid.Column="2"
                                    Width="24" Height="24"
                                    Padding="0"
                                    Style="{StaticResource NavIconButton}"
                                    Command="{Binding StartEditPathCommand}"
                                    ToolTip="Редактировать адрес (Ctrl+L / Alt+D)"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,4,0">
                                <Path Data="{StaticResource GeoRename}"
                                      Fill="{StaticResource BrushTextMuted}"
                                      Stretch="Uniform"
                                      Width="12" Height="12" />
                            </Button>
                        </Grid>

                        <!-- Mode B: Editable Address TextBox -->
                        <Grid Visibility="{Binding IsEditingPath, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="AddressTextBox"
                                     Grid.Column="0"
                                     Text="{Binding PathInputText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{StaticResource BrushTextPrimary}"
                                     CaretBrush="{StaticResource BrushAccentLight}"
                                     VerticalAlignment="Center"
                                     FontSize="12"
                                     Padding="6,0"
                                     KeyDown="AddressTextBox_KeyDown"
                                     LostFocus="AddressTextBox_LostFocus" />

                            <Button Grid.Column="1"
                                    Width="24" Height="24"
                                    Padding="0"
                                    Style="{StaticResource NavIconButton}"
                                    Command="{Binding CommitEditPathCommand}"
                                    ToolTip="Перейти"
                                    Margin="0,0,2,0">
                                <Path Data="{StaticResource GeoArrowRight}"
                                      Fill="{StaticResource BrushAccentLight}"
                                      Stretch="Uniform"
                                      Width="12" Height="12" />
                            </Button>

                            <Button Grid.Column="2"
                                    Width="24" Height="24"
                                    Padding="0"
                                    Style="{StaticResource NavIconButton}"
                                    Command="{Binding CancelEditPathCommand}"
                                    ToolTip="Отмена"
                                    Margin="0,0,4,0">
                                <Path Data="{StaticResource GeoDismiss}"
                                      Fill="{StaticResource BrushTextSecondary}"
                                      Stretch="Uniform"
                                      Width="11" Height="11" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Windows 11 Search Box (Width=1*, MinWidth=240, Magnifying glass inside left Margin="10,0,0,0", clear button on right) -->
                <Border Grid.Column="2"
                        Style="{StaticResource Win11InputContainerStyle}"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Data="{StaticResource GeoSearch}"
                              Fill="{StaticResource BrushTextMuted}"
                              Stretch="Uniform"
                              Width="14" Height="14"
                              VerticalAlignment="Center"
                              Margin="10,0,6,0" />

                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="1"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 CaretBrush="{StaticResource BrushAccentLight}"
                                 VerticalAlignment="Center"
                                 FontSize="12"
                                 Padding="2,0" />

                        <!-- Dynamic Placeholder Text -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SearchPlaceholder}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Margin="4,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding SearchQuery, Converter={StaticResource StringNullOrEmptyToVis}, ConverterParameter=invert}" />

                        <!-- Clear search button -->
                        <Button Grid.Column="2"
                                Width="24" Height="24"
                                Padding="0"
                                Style="{StaticResource NavIconButton}"
                                Click="BtnClearSearch_Click"
                                ToolTip="Очистить поиск"
                                Margin="0,0,4,0"
                                Visibility="{Binding SearchQuery, Converter={StaticResource StringNullOrEmptyToVis}}">
                            <Path Data="{StaticResource GeoDismiss}"
                                  Fill="{StaticResource BrushTextSecondary}"
                                  Stretch="Uniform"
                                  Width="12" Height="12" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= 2: WINDOWS 11 COMMAND BAR (48px) ================= -->
        <Border Grid.Row="2"
                Height="48"
                Background="{StaticResource BrushMicaSecondary}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="8,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- [ ➕ Создать ▾ ] Button with ContextMenu (Height=36, Padding=10,6, Margin=2,0, CornerRadius=4) -->
                    <Button x:Name="BtnCreateDropdown"
                            Style="{StaticResource CommandBarButton}"
                            Height="36"
                            Padding="10,6"
                            Margin="2,0"
                            Click="BtnCreate_Click"
                            ToolTip="Создать новый элемент (Ctrl+Shift+N)">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📁 Папка"
                                          InputGestureText="Ctrl+Shift+N"
                                          Command="{Binding NewFolderCommand}" />
                                <MenuItem Header="📄 Текстовый документ"
                                          Command="{Binding NewTextFileCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoAdd}"
                                  Fill="{StaticResource BrushAccentLight}"
                                  Stretch="Uniform"
                                  Width="14" Height="14"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Создать" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="▾" FontSize="9" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Separator -->
                    <Rectangle Width="1" Height="20" Fill="#26FFFFFF" Margin="6,0" VerticalAlignment="Center" />

                    <!-- Signature Icon Action Group (Width=36, Height=36, Padding=0, Margin=1,0, CornerRadius=4, Icon 16x16) -->
                    <!-- ✂ Cut -->
                    <Button Style="{StaticResource CommandBarActionButton}"
                            Width="36" Height="36"
                            Padding="0"
                            Margin="1,0"
                            Command="{Binding CutCommand}"
                            ToolTip="Вырезать (Ctrl+X)">
                        <Path Data="{StaticResource GeoCut}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                    </Button>

                    <!-- 📋 Copy -->
                    <Button Style="{StaticResource CommandBarActionButton}"
                            Width="36" Height="36"
                            Padding="0"
                            Margin="1,0"
                            Command="{Binding CopyCommand}"
                            ToolTip="Копировать (Ctrl+C)">
                        <Path Data="{StaticResource GeoCopy}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                    </Button>

                    <!-- 📥 Paste -->
                    <Button Style="{StaticResource CommandBarActionButton}"
                            Width="36" Height="36"
                            Padding="0"
                            Margin="1,0"
                            Command="{Binding PasteCommand}"
                            ToolTip="Вставить (Ctrl+V)">
                        <Path Data="{StaticResource GeoPaste}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                    </Button>

                    <!-- ✏️ Rename -->
                    <Button Style="{StaticResource CommandBarActionButton}"
                            Width="36" Height="36"
                            Padding="0"
                            Margin="1,0"
                            Command="{Binding RenameCommand}"
                            ToolTip="Переименовать (F2)">
                        <Path Data="{StaticResource GeoRename}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                    </Button>

                    <!-- 🔗 Share / Copy Path -->
                    <Button Style="{StaticResource CommandBarActionButton}"
                            Width="36" Height="36"
                            Padding="0"
                            Margin="1,0"
                            Command="{Binding CopyPathCommand}"
                            ToolTip="Поделиться / Копировать путь">
                        <Path Data="{StaticResource GeoShare}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                    </Button>

                    <!-- 🗑️ Delete -->
                    <Button Style="{StaticResource CommandBarActionButton}"
                            Width="36" Height="36"
                            Padding="0"
                            Margin="1,0"
                            Command="{Binding DeleteCommand}"
                            ToolTip="Удалить (Delete)">
                        <Path Data="{StaticResource GeoDelete}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                    </Button>

                    <!-- Separator -->
                    <Rectangle Width="1" Height="20" Fill="#26FFFFFF" Margin="6,0" VerticalAlignment="Center" />

                    <!-- ⇅ Сортировка ▾ Dropdown -->
                    <Button x:Name="BtnSortDropdown"
                            Style="{StaticResource CommandBarButton}"
                            Height="36"
                            Padding="10,6"
                            Click="BtnSort_Click"
                            ToolTip="Параметры сортировки">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Имя"
                                          Command="{Binding SortByNameCommand}" />
                                <MenuItem Header="Дата изменения"
                                          Command="{Binding SortByDateCommand}" />
                                <MenuItem Header="Тип"
                                          Command="{Binding SortByTypeCommand}" />
                                <MenuItem Header="Размер"
                                          Command="{Binding SortBySizeCommand}" />
                                <Separator />
                                <MenuItem Header="По возрастанию / убыванию"
                                          Command="{Binding ToggleSortDirectionCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoSort}"
                                  Fill="{StaticResource BrushTextPrimary}"
                                  Stretch="Uniform"
                                  Width="14" Height="14"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Сортировка" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="▾" FontSize="9" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- ☷ Вид ▾ Dropdown -->
                    <Button x:Name="BtnViewDropdown"
                            Style="{StaticResource CommandBarButton}"
                            Height="36"
                            Padding="10,6"
                            Click="BtnView_Click"
                            ToolTip="Параметры отображения">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Таблица (подробный)" IsChecked="True" />
                                <Separator />
                                <MenuItem Header="Скрытые элементы"
                                          IsCheckable="True"
                                          IsChecked="{Binding ShowHiddenFiles}"
                                          Command="{Binding ToggleShowHiddenFilesCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoView}"
                                  Fill="{StaticResource BrushTextPrimary}"
                                  Stretch="Uniform"
                                  Width="14" Height="14"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Вид" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="▾" FontSize="9" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 💻 Открыть в терминале -->
                    <Button Style="{StaticResource CommandBarButton}"
                            Height="36"
                            Padding="10,6"
                            Command="{Binding OpenInTerminalCommand}"
                            ToolTip="Открыть в терминале PowerShell">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoTerminal}"
                                  Fill="{StaticResource BrushTextPrimary}"
                                  Stretch="Uniform"
                                  Width="14" Height="14"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Терминал" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- ℹ️ Свойства -->
                    <Button Style="{StaticResource CommandBarButton}"
                            Height="36"
                            Padding="10,6"
                            Command="{Binding PropertiesCommand}"
                            ToolTip="Свойства (Alt+Enter)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoMore}"
                                  Fill="{StaticResource BrushTextPrimary}"
                                  Stretch="Uniform"
                                  Width="14" Height="14"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Свойства" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

                <!-- ================= 3: SIDEBAR + MAIN FILE VIEW ================= -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" MinWidth="180" MaxWidth="360" /> <!-- Windows 11 Navigation Pane -->
                        <ColumnDefinition Width="4" />                                   <!-- Grid Splitter -->
                        <ColumnDefinition Width="*" MinWidth="300" />                   <!-- Fluent File List View -->
                    </Grid.ColumnDefinitions>

                    <!-- SIDEBAR (Windows 11 Navigation Pane: #1C1C1C, hierarchical TreeView) -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BrushSidebar}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,0,1,0">
                        <TreeView x:Name="SidebarTreeView"
                                  ItemsSource="{Binding SidebarNodes}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="6,6"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ItemContainerStyle="{StaticResource Win11TreeViewItemStyle}"
                                  SelectedItemChanged="SidebarTreeView_SelectedItemChanged"
                                  PreviewMouseLeftButtonUp="SidebarTreeView_PreviewMouseLeftButtonUp">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type models:SidebarItem}"
                                                          ItemsSource="{Binding Children}">
                                    <Grid HorizontalAlignment="Stretch" ToolTip="{Binding Path}">
                                        <!-- Separator -->
                                        <Rectangle Height="1"
                                                   Fill="#20FFFFFF"
                                                   Margin="8,6,8,6"
                                                   HorizontalAlignment="Stretch"
                                                   Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVis}}" />

                                        <!-- Regular Sidebar Item View -->
                                        <Grid Visibility="{Binding IsSeparator, Converter={StaticResource InverseBoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 16x16 Icon -->
                                            <Image Grid.Column="0"
                                                   Source="{Binding Icon}"
                                                   Width="16" Height="16"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />

                                            <!-- Item Content (Title, optional Subtitle & Mini Storage Bar) -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource BrushTextPrimary}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />

                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource BrushTextMuted}"
                                                           Margin="0,1,0,2"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Subtitle, Converter={StaticResource StringNullOrEmptyToVis}}" />

                                                <!-- Mini Storage Usage Bar (for logical drives) -->
                                                <ProgressBar Height="3"
                                                             Value="{Binding UsagePercent}"
                                                             Maximum="100"
                                                             Foreground="{StaticResource BrushAccentLight}"
                                                             Background="#33FFFFFF"
                                                             BorderThickness="0"
                                                             Margin="0,1,6,0"
                                                             Visibility="{Binding IsDrive, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Border>

                    <!-- Splitter between Sidebar & Main List -->
                    <GridSplitter Grid.Column="1"
                                  Width="4"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Columns">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="{x:Type GridSplitter}">
                                <Border Background="Transparent">
                                    <Border x:Name="SplitterBar"
                                            Width="1"
                                            Background="{StaticResource BrushBorder}"
                                            HorizontalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SplitterBar" Property="Background" Value="{StaticResource BrushAccentLight}" />
                                        <Setter TargetName="SplitterBar" Property="Width" Value="2" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <!-- MAIN VIEW (File & Folder List) -->
                    <Grid Grid.Column="2" Background="{StaticResource BrushBackground}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Loading / Error Bar -->
                            <RowDefinition Height="*" />    <!-- Virtualized ListView -->
                        </Grid.RowDefinitions>

                        <!-- Loading & Error Banners -->
                        <StackPanel Grid.Row="0">
                            <!-- Progress Bar on Loading -->
                            <ProgressBar Height="2"
                                         IsIndeterminate="True"
                                         BorderThickness="0"
                                         Foreground="{StaticResource BrushAccentLight}"
                                         Background="Transparent"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                            <!-- Error Notification Banner -->
                            <Border Background="{StaticResource BrushErrorBg}"
                                    BorderBrush="{StaticResource BrushError}"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,6"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚠️ " Foreground="{StaticResource BrushError}" FontSize="12" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ErrorMessage}"
                                               Foreground="{StaticResource BrushError}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Spacious Virtualized Windows 11 Fluent File List -->
                        <ListView x:Name="FileListView"
                                  Grid.Row="1"
                                  ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                  SelectionMode="Extended"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.IsDeferredScrollingEnabled="False"
                                  MouseDoubleClick="FileListView_MouseDoubleClick"
                                  SelectionChanged="FileListView_SelectionChanged"
                                  KeyDown="FileListView_KeyDown"
                                  Padding="4,2"
                                  Tag="{Binding}">

                            <!-- Empty Area Context Menu (Right Click on Background) -->
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="☷ Вид">
                                        <MenuItem Header="Таблица (подробный)" IsChecked="True" />
                                    </MenuItem>
                                    <MenuItem Header="⇅ Сортировка">
                                        <MenuItem Header="По имени" Command="{Binding PlacementTarget.Tag.SortByNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="По дате изменения" Command="{Binding PlacementTarget.Tag.SortByDateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="По типу" Command="{Binding PlacementTarget.Tag.SortByTypeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="По размеру" Command="{Binding PlacementTarget.Tag.SortBySizeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </MenuItem>
                                    <MenuItem Header="🔄 Обновить"
                                              InputGestureText="F5"
                                              Command="{Binding PlacementTarget.Tag.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="📥 Вставить"
                                              InputGestureText="Ctrl+V"
                                              Command="{Binding PlacementTarget.Tag.PasteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="➕ Создать">
                                        <MenuItem Header="📁 Папка"
                                                  InputGestureText="Ctrl+Shift+N"
                                                  Command="{Binding PlacementTarget.Tag.NewFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="📄 Текстовый документ"
                                                  Command="{Binding PlacementTarget.Tag.NewTextFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="💻 Открыть в терминале"
                                              Command="{Binding PlacementTarget.Tag.OpenInTerminalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="ℹ️ Свойства"
                                              Command="{Binding PlacementTarget.Tag.PropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </ListView.ContextMenu>

                            <!-- Item Container Style with Windows 11 Signature Context Menu -->
                            <ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <!-- Windows 11 Signature Top Horizontal Quick Action Bar -->
                                                <Grid Margin="2,2,2,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- ✂ Cut -->
                                                    <Button Grid.Column="0"
                                                            Style="{StaticResource ContextMenuTopActionButton}"
                                                            Command="{Binding PlacementTarget.Tag.CutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            ToolTip="Вырезать (Ctrl+X)">
                                                        <Path Data="{StaticResource GeoCut}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                                    </Button>

                                                    <!-- 📋 Copy -->
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource ContextMenuTopActionButton}"
                                                            Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            ToolTip="Копировать (Ctrl+C)">
                                                        <Path Data="{StaticResource GeoCopy}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                                    </Button>

                                                    <!-- ✏️ Rename -->
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource ContextMenuTopActionButton}"
                                                            Command="{Binding PlacementTarget.Tag.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            ToolTip="Переименовать (F2)">
                                                        <Path Data="{StaticResource GeoRename}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                                    </Button>

                                                    <!-- 🔗 Share / Copy Path -->
                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource ContextMenuTopActionButton}"
                                                            Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            ToolTip="Поделиться / Копировать путь">
                                                        <Path Data="{StaticResource GeoShare}" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Width="16" Height="16" />
                                                    </Button>

                                                    <!-- 🗑️ Delete -->
                                                    <Button Grid.Column="4"
                                                            Style="{StaticResource ContextMenuTopActionButton}"
                                                            Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            ToolTip="Удалить (Delete)">
                                                        <Path Data="{StaticResource GeoDelete}" Fill="{StaticResource BrushError}" Stretch="Uniform" Width="16" Height="16" />
                                                    </Button>
                                                </Grid>

                                                <Separator />

                                                <!-- Vertical Context Menu Items -->
                                                <MenuItem Header="⚡ Открыть"
                                                          FontWeight="SemiBold"
                                                          Command="{Binding PlacementTarget.Tag.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="📋 Копировать как путь"
                                                          Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="💻 Открыть в терминале"
                                                          Command="{Binding PlacementTarget.Tag.OpenInTerminalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="📥 Вставить"
                                                          InputGestureText="Ctrl+V"
                                                          Command="{Binding PlacementTarget.Tag.PasteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <MenuItem Header="➕ Создать папку"
                                                          InputGestureText="Ctrl+Shift+N"
                                                          Command="{Binding PlacementTarget.Tag.NewFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="🔄 Обновить"
                                                          InputGestureText="F5"
                                                          Command="{Binding PlacementTarget.Tag.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <MenuItem Header="ℹ️ Свойства"
                                                          InputGestureText="Alt+Enter"
                                                          Command="{Binding PlacementTarget.Tag.PropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <!-- Modern Windows 11 Column Headers and Cells -->
                            <ListView.View>
                                <GridView>
                                    <!-- 1. Name Column (with semantic category glyph) -->
                                    <GridViewColumn Width="380">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Click="GridViewColumnHeader_Click" Tag="Name">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Имя" />
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource SortColumnToGlyph}">
                                                                <Binding Path="DataContext.SortColumn" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="DataContext.SortAscending" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Source="Name" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </GridViewColumnHeader>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Native Shell Icon -->
                                                    <Image Source="{Binding Icon}"
                                                           Width="16" Height="16"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                                    <!-- File / Folder Name (FIX ORANGE TEXT: Pure Crisp White) -->
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{StaticResource BrushTextPrimary}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- 2. Date Modified Column -->
                                    <GridViewColumn Width="160">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Click="GridViewColumnHeader_Click" Tag="Date">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Дата изменения" />
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource SortColumnToGlyph}">
                                                                <Binding Path="DataContext.SortColumn" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="DataContext.SortAscending" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Source="Date" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </GridViewColumnHeader>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FormattedDate}"
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- 3. Type / Category Column -->
                                    <GridViewColumn Width="180">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Click="GridViewColumnHeader_Click" Tag="Type">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Тип" />
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource SortColumnToGlyph}">
                                                                <Binding Path="DataContext.SortColumn" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="DataContext.SortAscending" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Source="Type" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </GridViewColumnHeader>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ItemType}"
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- 4. Size Column (Formatted KB / MB / GB, blank for folders) -->
                                    <GridViewColumn Width="110">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Click="GridViewColumnHeader_Click" Tag="Size">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Размер" />
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource SortColumnToGlyph}">
                                                                <Binding Path="DataContext.SortColumn" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="DataContext.SortAscending" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Source="Size" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </GridViewColumnHeader>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FormattedSize}"
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Grid>

        <!-- ================= 4: BOTTOM STATUS BAR ================= -->
        <Border Grid.Row="4"
                Background="{StaticResource BrushMica}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />     <!-- Total Item Count -->
                    <ColumnDefinition Width="Auto" />  <!-- Selection Info -->
                    <ColumnDefinition Width="*" />     <!-- Drive Telemetry -->
                </Grid.ColumnDefinitions>

                <!-- Left: Item Count -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           FontSize="11"
                           Foreground="{StaticResource BrushTextSecondary}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <!-- Middle: Selection Info -->
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectedStatusText}"
                           FontSize="11"
                           Foreground="{StaticResource BrushAccentLight}"
                           FontWeight="Medium"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="16,0" />

                <!-- Right: Drive Storage Telemetry -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DriveSpaceText}"
                               FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <TextBlock Text="☷"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center"
                               ToolTip="Таблица" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>