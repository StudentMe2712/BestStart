# TrendScanner Environment Configuration

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# SQLite Database path (inside Docker: /app/data/trendscanner.db, local: data/trendscanner.db)
DATABASE_PATH=/app/data/trendscanner.db

# Groq LLM API Key (Required for AI trend scoring and extraction)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Periodic Background Scanner Interval (in minutes)
SCAN_INTERVAL_MINUTES=60

# Debug mode
DEBUG=true
