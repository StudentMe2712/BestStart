<!DOCTYPE html>
<html lang="ru" id="htmlRoot">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="ИТС-Ком — Корпоративный портал управления серверами и Wiki-документацией">
    <title>Вход — ИТС-Ком</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/login.css">
    <link rel="icon" type="image/png" href="/favicon.png">
    <script>
        (function() {
            var theme = localStorage.getItem('ui_theme') || localStorage.getItem('ui_theme_admin');
            if (theme) {
                document.documentElement.setAttribute('data-theme', theme);
            }
        })();
    </script>
</head>
<body class="auth-body">
    <!-- Верхняя панель навигации -->
    <header class="home-topbar home-topbar--public">
        <div class="home-topbar__brand">
            <a href="/" class="home-brand-link" title="ИТС-Ком">
                <span class="home-brand-name">ИТС-Ком</span>
            </a>
        </div>
        <nav class="home-topbar__nav" aria-label="Основная навигация">
            <a href="/" class="home-topbar__nav-link" data-i18n="nav.home">Главная</a>
            <a href="/wiki" class="home-topbar__nav-link">Wiki</a>
        </nav>
        <div class="home-topbar__public-actions">
            <button class="theme-toggle-btn" id="themeToggle" type="button" aria-label="Переключить тему" title="Переключить тему">
                <svg class="theme-icon theme-icon--sun" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M10 2V4M10 16V18M2 10H4M16 10H18M4.22 4.22L5.64 5.64M14.36 14.36L15.78 15.78M15.78 4.22L14.36 5.64M5.64 14.36L4.22 15.78" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                <svg class="theme-icon theme-icon--moon" viewBox="0 0 20 20" fill="none"><path d="M17 11C16.4 15 12.8 18 8.5 17.5C4.2 17 1 13.3 1.5 9C2 4.7 5.8 1.8 10 2.5C8.5 4.5 8.5 8 11 10C13.5 12 16.5 11.5 17 11Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
        </div>
    </header>

    <!-- Основной контейнер экрана с атмосферным свечением -->
    <main class="login-container">
        <div class="auth-ambient-glow" aria-hidden="true"></div>

        <!-- Премиальная карточка 420px -->
        <div class="login-box" role="region" aria-labelledby="loginTitle">
            <!-- Минималистичный текстовый заголовок -->
            <div class="login-card__header">
                <h1 id="loginTitle" class="auth-title login-card__title">ИТС-Ком</h1>
                <p class="auth-subtitle login-card__subtitle" data-i18n="login.subtitle">База знаний</p>
            </div>

            <!-- Блок отображения ошибки -->
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert-banner alert-banner--error" role="alert" aria-live="assertive">
                    <svg class="alert-banner__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="10" cy="10" r="8.5"/>
                        <line x1="10" y1="6.5" x2="10" y2="10.5"/>
                        <circle cx="10" cy="14" r="0.75" fill="currentColor"/>
                    </svg>
                    <div class="alert-banner__message"><%= error %></div>
                </div>
            <% } %>

            <!-- Форма авторизации -->
            <form id="loginForm" action="/login" method="POST" class="login-form" novalidate>
                <!-- Поле логина с встроенной SVG-иконкой -->
                <div class="form-group">
                    <label for="username" class="form-label" data-i18n="login.username.label">Логин</label>
                    <div class="input-wrapper">
                        <span class="input-icon" aria-hidden="true">
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M10 10a4 4 0 100-8 4 4 0 000 8z" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M3.5 17.5a6.5 6.5 0 0113 0" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        <input
                            type="text"
                            id="username"
                            name="username"
                            class="form-input with-left-icon"
                            placeholder="логин"
                            data-i18n-placeholder="login.username.ph"
                            autocomplete="username"
                            required
                        >
                    </div>
                </div>

                <!-- Поле пароля с встроенной SVG-иконкой и кнопкой-глазком -->
                <div class="form-group">
                    <div class="form-label-row">
                        <label for="password" class="form-label" data-i18n="login.password">Пароль</label>
                        <a href="#" id="forgotPasswordLink" class="forgot-password" data-i18n="login.forgot">Восстановление пароля</a>
                    </div>
                    <div class="input-wrapper">
                        <span class="input-icon" aria-hidden="true">
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                                <rect x="4" y="9" width="12" height="9" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-input with-left-icon with-right-btn"
                            placeholder="••••••••"
                            autocomplete="current-password"
                            required
                        >
                        <button
                            type="button"
                            id="passwordToggleBtn"
                            class="password-toggle-btn"
                            aria-label="Показать пароль"
                            title="Показать или скрыть пароль"
                        >
                            <svg class="eye-show" viewBox="0 0 20 20" fill="none" stroke="currentColor">
                                <path d="M1.5 10s3-5.5 8.5-5.5 8.5 5.5 8.5 5.5-3 5.5-8.5 5.5S1.5 10 1.5 10z" stroke-linecap="round" stroke-linejoin="round"/>
                                <circle cx="10" cy="10" r="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <svg class="eye-hide" viewBox="0 0 20 20" fill="none" stroke="currentColor" style="display:none;">
                                <path d="M2.5 2.5l15 15" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M8.5 8.5a2.5 2.5 0 003.5 3.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M5.5 5.5C3.5 7 2 10 2 10s3 5.5 8 5.5c2 0 3.7-.6 5-1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M9.5 4.5c.2 0 .3 0 .5 0 5 0 8 5.5 8 5.5s-.8 1.4-2.2 2.8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Чекбокс "Оставаться в системе" -->
                <div class="form-group checkbox-group">
                    <label class="checkbox-label" for="remember">
                        <input type="checkbox" name="remember" id="remember">
                        <span class="checkbox-text" data-i18n="login.remember">Оставаться в системе</span>
                    </label>
                </div>

                <!-- Кнопка отправки формы -->
                <button type="submit" id="submitBtn" class="btn-login" data-i18n="login.btn">Войти</button>


            </form>

            <!-- Контейнер двухшагового восстановления пароля -->
            <div id="resetContainer" class="reset-container" style="display: none;">
                <div class="reset-header">
                    <h2 class="reset-title" id="resetCardTitle">Восстановление пароля</h2>
                    <p class="reset-subtitle" id="resetCardSubtitle">Шаг 1 из 2: Проверка учетной записи</p>
                </div>

                <!-- Баннер глобального статуса/успеха сброса -->
                <div id="resetSuccessBanner" class="alert-banner alert-banner--success" style="display: none;" role="status">
                    <svg class="alert-banner__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="10" cy="10" r="8.5"/>
                        <path d="M6 10l3 3 5-5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <div class="alert-banner__message" id="resetSuccessMessage">✓ Пароль успешно изменен! Переход ко входу...</div>
                </div>

                <!-- Шаг 1: Проверка логина -->
                <div id="resetStep1" class="reset-step">
                    <!-- Блок ошибок Шага 1 -->
                    <div id="resetStep1Alert" class="alert-banner alert-banner--error" style="display: none;" role="alert" aria-live="assertive">
                        <svg class="alert-banner__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="10" cy="10" r="8.5"/>
                            <line x1="10" y1="6.5" x2="10" y2="10.5"/>
                            <circle cx="10" cy="14" r="0.75" fill="currentColor"/>
                        </svg>
                        <div class="alert-banner__message" id="resetStep1ErrorMsg"></div>
                    </div>

                    <div class="form-group">
                        <label for="resetUsername" class="form-label">Логин</label>
                        <div class="input-wrapper">
                            <span class="input-icon" aria-hidden="true">
                                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M10 10a4 4 0 100-8 4 4 0 000 8z" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M3.5 17.5a6.5 6.5 0 0113 0" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                            <input
                                type="text"
                                id="resetUsername"
                                class="form-input with-left-icon"
                                placeholder="логин"
                                autocomplete="username"
                                required
                            >
                        </div>
                    </div>

                    <button type="button" id="btnVerifyLogin" class="btn-login">Проверить</button>

                    <div class="reset-back-row">
                        <button type="button" id="backToLoginBtn1" class="btn-link-back">
                            <span aria-hidden="true">←</span>
                            <span>Вернуться ко входу</span>
                        </button>
                    </div>
                </div>

                <!-- Шаг 2: Новый пароль -->
                <div id="resetStep2" class="reset-step" style="display: none;">
                    <div class="verified-user-badge">
                        <span class="verified-user-badge__icon" aria-hidden="true">
                            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6">
                                <circle cx="8" cy="8" r="6.5"/>
                                <path d="M5.5 8.5l2 2 3.5-4" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        <span class="verified-user-badge__label">Пользователь:</span>
                        <strong id="verifiedUsernameDisplay" class="verified-user-badge__name"></strong>
                    </div>

                    <!-- Блок ошибок Шага 2 -->
                    <div id="resetStep2Alert" class="alert-banner alert-banner--error" style="display: none;" role="alert" aria-live="assertive">
                        <svg class="alert-banner__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="10" cy="10" r="8.5"/>
                            <line x1="10" y1="6.5" x2="10" y2="10.5"/>
                            <circle cx="10" cy="14" r="0.75" fill="currentColor"/>
                        </svg>
                        <div class="alert-banner__message" id="resetStep2ErrorMsg"></div>
                    </div>

                    <!-- Поле нового пароля с глазком -->
                    <div class="form-group">
                        <label for="newPassword" class="form-label">Новый пароль (мин. 8 символов)</label>
                        <div class="input-wrapper">
                            <span class="input-icon" aria-hidden="true">
                                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <rect x="4" y="9" width="12" height="9" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                            <input
                                type="password"
                                id="newPassword"
                                class="form-input with-left-icon with-right-btn"
                                placeholder="••••••••"
                                minlength="8"
                                autocomplete="new-password"
                                required
                            >
                            <button
                                type="button"
                                id="newPasswordToggleBtn"
                                class="password-toggle-btn"
                                aria-label="Показать пароль"
                                title="Показать или скрыть пароль"
                            >
                                <svg class="eye-show" viewBox="0 0 20 20" fill="none" stroke="currentColor">
                                    <path d="M1.5 10s3-5.5 8.5-5.5 8.5 5.5 8.5 5.5-3 5.5-8.5 5.5S1.5 10 1.5 10z" stroke-linecap="round" stroke-linejoin="round"/>
                                    <circle cx="10" cy="10" r="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                <svg class="eye-hide" viewBox="0 0 20 20" fill="none" stroke="currentColor" style="display:none;">
                                    <path d="M2.5 2.5l15 15" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M8.5 8.5a2.5 2.5 0 003.5 3.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M5.5 5.5C3.5 7 2 10 2 10s3 5.5 8 5.5c2 0 3.7-.6 5-1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M9.5 4.5c.2 0 .3 0 .5 0 5 0 8 5.5 8 5.5s-.8 1.4-2.2 2.8" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- Поле подтверждения пароля с глазком -->
                    <div class="form-group">
                        <label for="confirmNewPassword" class="form-label">Повторите новый пароль</label>
                        <div class="input-wrapper">
                            <span class="input-icon" aria-hidden="true">
                                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <rect x="4" y="9" width="12" height="9" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                            <input
                                type="password"
                                id="confirmNewPassword"
                                class="form-input with-left-icon with-right-btn"
                                placeholder="••••••••"
                                minlength="8"
                                autocomplete="new-password"
                                required
                            >
                            <button
                                type="button"
                                id="confirmNewPasswordToggleBtn"
                                class="password-toggle-btn"
                                aria-label="Показать пароль"
                                title="Показать или скрыть пароль"
                            >
                                <svg class="eye-show" viewBox="0 0 20 20" fill="none" stroke="currentColor">
                                    <path d="M1.5 10s3-5.5 8.5-5.5 8.5 5.5 8.5 5.5-3 5.5-8.5 5.5S1.5 10 1.5 10z" stroke-linecap="round" stroke-linejoin="round"/>
                                    <circle cx="10" cy="10" r="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                <svg class="eye-hide" viewBox="0 0 20 20" fill="none" stroke="currentColor" style="display:none;">
                                    <path d="M2.5 2.5l15 15" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M8.5 8.5a2.5 2.5 0 003.5 3.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M5.5 5.5C3.5 7 2 10 2 10s3 5.5 8 5.5c2 0 3.7-.6 5-1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M9.5 4.5c.2 0 .3 0 .5 0 5 0 8 5.5 8 5.5s-.8 1.4-2.2 2.8" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <button type="button" id="btnSaveNewPassword" class="btn-login">Сохранить новый пароль</button>

                    <div class="reset-back-row">
                        <button type="button" id="backToLoginBtn2" class="btn-link-back">
                            <span aria-hidden="true">←</span>
                            <span>Вернуться ко входу</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Корпоративная отметка безопасности -->
            <div class="login-security-note">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M8 1.5L3 3.5v4.5c0 3.2 2.1 6.1 5 6.8 2.9-.7 5-3.6 5-6.8V3.5L8 1.5z" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M6 8l1.5 1.5L10.5 6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Защищенный внутренний портал ИТС-Ком</span>
            </div>
        </div>
    </main>

    <!-- Скрипты интернационализации и логики формы -->
    <script src="/js/i18n.js"></script>
    <script>
        (function() {
            var usernameInput = document.getElementById('username');
            var passwordInput = document.getElementById('password');
            var toggleBtn = document.getElementById('passwordToggleBtn');
            var loginForm = document.getElementById('loginForm');

            // 1. Автофокус
            if (usernameInput) {
                if (!usernameInput.value) {
                    usernameInput.focus();
                } else if (passwordInput) {
                    passwordInput.focus();
                }
            }

            // 2. Интерактивная кнопка-глазок (show/hide password helper)
            function setupPasswordToggle(btnId, targetInput) {
                var btn = typeof btnId === 'string' ? document.getElementById(btnId) : btnId;
                var input = typeof targetInput === 'string' ? document.getElementById(targetInput) : targetInput;
                if (!btn || !input) return;

                var eyeShow = btn.querySelector('.eye-show');
                var eyeHide = btn.querySelector('.eye-hide');

                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    var isPassword = input.getAttribute('type') === 'password';
                    input.setAttribute('type', isPassword ? 'text' : 'password');

                    if (isPassword) {
                        if (eyeShow) eyeShow.style.display = 'none';
                        if (eyeHide) eyeHide.style.display = 'block';
                        btn.setAttribute('aria-label', 'Скрыть пароль');
                    } else {
                        if (eyeShow) eyeShow.style.display = 'block';
                        if (eyeHide) eyeHide.style.display = 'none';
                        btn.setAttribute('aria-label', 'Показать пароль');
                    }
                    input.focus();
                });
            }

            if (toggleBtn && passwordInput) {
                setupPasswordToggle(toggleBtn, passwordInput);
            }
            setupPasswordToggle('newPasswordToggleBtn', 'newPassword');
            setupPasswordToggle('confirmNewPasswordToggleBtn', 'confirmNewPassword');



            // 4. Валидация перед отправкой формы входа
            if (loginForm) {
                loginForm.addEventListener('submit', function(e) {
                    if (!usernameInput.value.trim()) {
                        e.preventDefault();
                        usernameInput.focus();
                        return;
                    }
                    if (!passwordInput.value) {
                        e.preventDefault();
                        passwordInput.focus();
                        return;
                    }
                });
            }

            // 5. Двухшаговое восстановление пароля (#resetContainer)
            var resetContainer = document.getElementById('resetContainer');
            var forgotPasswordLink = document.getElementById('forgotPasswordLink');
            var backToLoginBtn1 = document.getElementById('backToLoginBtn1');
            var backToLoginBtn2 = document.getElementById('backToLoginBtn2');
            var resetStep1 = document.getElementById('resetStep1');
            var resetStep2 = document.getElementById('resetStep2');
            var resetCardSubtitle = document.getElementById('resetCardSubtitle');
            var resetUsername = document.getElementById('resetUsername');
            var btnVerifyLogin = document.getElementById('btnVerifyLogin');
            var resetStep1Alert = document.getElementById('resetStep1Alert');
            var resetStep1ErrorMsg = document.getElementById('resetStep1ErrorMsg');

            var verifiedUsernameDisplay = document.getElementById('verifiedUsernameDisplay');
            var newPassword = document.getElementById('newPassword');
            var confirmNewPassword = document.getElementById('confirmNewPassword');
            var btnSaveNewPassword = document.getElementById('btnSaveNewPassword');
            var resetStep2Alert = document.getElementById('resetStep2Alert');
            var resetStep2ErrorMsg = document.getElementById('resetStep2ErrorMsg');
            var resetSuccessBanner = document.getElementById('resetSuccessBanner');

            var verifiedUsername = '';

            function showLoginForm() {
                if (resetContainer) resetContainer.style.display = 'none';
                if (loginForm) {
                    loginForm.style.display = 'block';
                    loginForm.classList.remove('auth-view-fade-in');
                    void loginForm.offsetWidth;
                    loginForm.classList.add('auth-view-fade-in');
                }
                if (verifiedUsername && usernameInput) {
                    usernameInput.value = verifiedUsername;
                    if (passwordInput) {
                        passwordInput.value = '';
                        passwordInput.focus();
                    }
                } else if (usernameInput) {
                    usernameInput.focus();
                }
            }

            function showResetContainer() {
                if (loginForm) loginForm.style.display = 'none';
                if (resetContainer) {
                    resetContainer.style.display = 'block';
                    resetContainer.classList.remove('auth-view-fade-in');
                    void resetContainer.offsetWidth;
                    resetContainer.classList.add('auth-view-fade-in');
                }

                // Сброс состояния на Шаг 1
                if (resetStep1) resetStep1.style.display = 'block';
                if (resetStep2) resetStep2.style.display = 'none';
                if (resetCardSubtitle) resetCardSubtitle.textContent = 'Шаг 1 из 2: Проверка учетной записи';
                if (resetStep1Alert) resetStep1Alert.style.display = 'none';
                if (resetStep2Alert) resetStep2Alert.style.display = 'none';
                if (resetSuccessBanner) resetSuccessBanner.style.display = 'none';

                if (newPassword) {
                    newPassword.value = '';
                    newPassword.disabled = false;
                }
                if (confirmNewPassword) {
                    confirmNewPassword.value = '';
                    confirmNewPassword.disabled = false;
                }
                if (btnVerifyLogin) {
                    btnVerifyLogin.disabled = false;
                    btnVerifyLogin.textContent = 'Проверить';
                }
                if (btnSaveNewPassword) {
                    btnSaveNewPassword.style.display = '';
                    btnSaveNewPassword.disabled = false;
                    btnSaveNewPassword.textContent = 'Сохранить новый пароль';
                }

                if (usernameInput && usernameInput.value.trim() && resetUsername) {
                    resetUsername.value = usernameInput.value.trim();
                }
                if (resetUsername) {
                    resetUsername.focus();
                    resetUsername.select();
                }
            }

            if (forgotPasswordLink) {
                forgotPasswordLink.addEventListener('click', function(e) {
                    e.preventDefault();
                    showResetContainer();
                });
            }

            if (backToLoginBtn1) {
                backToLoginBtn1.addEventListener('click', function(e) {
                    e.preventDefault();
                    showLoginForm();
                });
            }

            if (backToLoginBtn2) {
                backToLoginBtn2.addEventListener('click', function(e) {
                    e.preventDefault();
                    showLoginForm();
                });
            }

            // Шаг 1: Проверка логина
            async function handleVerifyLogin() {
                var val = resetUsername ? resetUsername.value.trim() : '';
                if (resetStep1Alert) resetStep1Alert.style.display = 'none';

                if (!val) {
                    if (resetStep1ErrorMsg) resetStep1ErrorMsg.textContent = 'Пожалуйста, введите логин';
                    if (resetStep1Alert) resetStep1Alert.style.display = 'flex';
                    if (resetUsername) resetUsername.focus();
                    return;
                }

                btnVerifyLogin.disabled = true;
                var origText = btnVerifyLogin.textContent;
                btnVerifyLogin.textContent = 'Проверка...';

                try {
                    var resp = await fetch('/api/auth/verify-login', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ username: val })
                    });
                    var data = {};
                    try {
                        data = await resp.json();
                    } catch (err) {}

                    if (resp.status === 429) {
                        if (resetStep1ErrorMsg) {
                            resetStep1ErrorMsg.textContent = data.error || 'Слишком много попыток. Пожалуйста, повторите позже (через 15 минут).';
                        }
                        if (resetStep1Alert) resetStep1Alert.style.display = 'flex';
                        btnVerifyLogin.disabled = false;
                        btnVerifyLogin.textContent = origText;
                        return;
                    }

                    if (!resp.ok || !data.exists) {
                        if (resetStep1ErrorMsg) {
                            resetStep1ErrorMsg.textContent = data.error || 'Пользователь с таким логином не найден';
                        }
                        if (resetStep1Alert) resetStep1Alert.style.display = 'flex';
                        btnVerifyLogin.disabled = false;
                        btnVerifyLogin.textContent = origText;
                        if (resetUsername) resetUsername.focus();
                        return;
                    }

                    // Переход к Шагу 2
                    verifiedUsername = val;
                    if (verifiedUsernameDisplay) verifiedUsernameDisplay.textContent = verifiedUsername;
                    if (resetStep1) resetStep1.style.display = 'none';
                    if (resetStep2) {
                        resetStep2.style.display = 'block';
                        resetStep2.classList.remove('auth-view-fade-in');
                        void resetStep2.offsetWidth;
                        resetStep2.classList.add('auth-view-fade-in');
                    }
                    if (resetCardSubtitle) resetCardSubtitle.textContent = 'Шаг 2 из 2: Задание нового пароля';
                    if (resetStep2Alert) resetStep2Alert.style.display = 'none';
                    if (newPassword) {
                        newPassword.value = '';
                        newPassword.focus();
                    }
                    if (confirmNewPassword) confirmNewPassword.value = '';

                } catch (err) {
                    if (resetStep1ErrorMsg) {
                        resetStep1ErrorMsg.textContent = 'Ошибка соединения с сервером. Повторите попытку.';
                    }
                    if (resetStep1Alert) resetStep1Alert.style.display = 'flex';
                } finally {
                    btnVerifyLogin.disabled = false;
                    btnVerifyLogin.textContent = origText;
                }
            }

            if (btnVerifyLogin) {
                btnVerifyLogin.addEventListener('click', handleVerifyLogin);
            }
            if (resetUsername) {
                resetUsername.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        handleVerifyLogin();
                    }
                });
            }

            // Шаг 2: Задание нового пароля
            async function handleResetPassword() {
                var pass = newPassword ? newPassword.value : '';
                var confirm = confirmNewPassword ? confirmNewPassword.value : '';
                if (resetStep2Alert) resetStep2Alert.style.display = 'none';

                if (!pass || pass.length < 8) {
                    if (resetStep2ErrorMsg) resetStep2ErrorMsg.textContent = 'Пароль должен содержать минимум 8 символов';
                    if (resetStep2Alert) resetStep2Alert.style.display = 'flex';
                    if (newPassword) newPassword.focus();
                    return;
                }

                if (pass !== confirm) {
                    if (resetStep2ErrorMsg) resetStep2ErrorMsg.textContent = 'Пароли не совпадают';
                    if (resetStep2Alert) resetStep2Alert.style.display = 'flex';
                    if (confirmNewPassword) confirmNewPassword.focus();
                    return;
                }

                btnSaveNewPassword.disabled = true;
                var origText = btnSaveNewPassword.textContent;
                btnSaveNewPassword.textContent = 'Сохранение...';

                try {
                    var resp = await fetch('/api/auth/reset-password', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            username: verifiedUsername,
                            password: pass,
                            confirmPassword: confirm
                        })
                    });

                    var data = {};
                    try {
                        data = await resp.json();
                    } catch (err) {}

                    if (resp.status === 429) {
                        if (resetStep2ErrorMsg) {
                            resetStep2ErrorMsg.textContent = data.error || 'Слишком много попыток. Пожалуйста, повторите позже (через 15 минут).';
                        }
                        if (resetStep2Alert) resetStep2Alert.style.display = 'flex';
                        btnSaveNewPassword.disabled = false;
                        btnSaveNewPassword.textContent = origText;
                        return;
                    }

                    if (!resp.ok || !data.success) {
                        if (resetStep2ErrorMsg) {
                            resetStep2ErrorMsg.textContent = data.error || 'Не удалось сбросить пароль. Попробуйте снова.';
                        }
                        if (resetStep2Alert) resetStep2Alert.style.display = 'flex';
                        btnSaveNewPassword.disabled = false;
                        btnSaveNewPassword.textContent = origText;
                        return;
                    }

                    // Успех сброса пароля
                    if (resetStep2Alert) resetStep2Alert.style.display = 'none';
                    if (resetSuccessBanner) resetSuccessBanner.style.display = 'flex';
                    btnSaveNewPassword.style.display = 'none';
                    if (newPassword) newPassword.disabled = true;
                    if (confirmNewPassword) confirmNewPassword.disabled = true;

                    setTimeout(function() {
                        showLoginForm();
                        if (newPassword) newPassword.disabled = false;
                        if (confirmNewPassword) confirmNewPassword.disabled = false;
                        btnSaveNewPassword.style.display = '';
                        btnSaveNewPassword.disabled = false;
                        btnSaveNewPassword.textContent = origText;
                    }, 1500);

                } catch (err) {
                    if (resetStep2ErrorMsg) {
                        resetStep2ErrorMsg.textContent = 'Ошибка соединения с сервером. Повторите попытку.';
                    }
                    if (resetStep2Alert) resetStep2Alert.style.display = 'flex';
                    btnSaveNewPassword.disabled = false;
                    btnSaveNewPassword.textContent = origText;
                }
            }

            if (btnSaveNewPassword) {
                btnSaveNewPassword.addEventListener('click', handleResetPassword);
            }
            if (confirmNewPassword) {
                confirmNewPassword.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        handleResetPassword();
                    }
                });
            }
        })();
    </script>
</body>
</html>
