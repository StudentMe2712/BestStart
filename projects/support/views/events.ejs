<!DOCTYPE html>
<html lang="ru" id="htmlRoot">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Журнал релизов 1С — ИТС-Ком</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/wiki-page.css">
    <link rel="icon" type="image/png" href="/favicon.png">
    <meta name="app-user" content="<%= user ? user.username : 'admin' %>">
    <script>(function(){var m=document.querySelector('meta[name="app-user"]');var u=m&&m.getAttribute('content');var k=u?'ui_theme_'+u:'ui_theme';var t=localStorage.getItem(k);if(t)document.documentElement.setAttribute('data-theme',t);})()</script>
</head>
<body class="home-body events-page-body">
    <% 
        const username = user ? user.username : 'admin';
        const displayName = username === 'admin' ? 'Администратор' : username;
        const avatarLetter = displayName.charAt(0).toUpperCase();

        function getBasesCountStr(count) {
            const abs = Math.abs(count) % 100;
            const rem = abs % 10;
            if (abs > 10 && abs < 20) return `${count} баз`;
            if (rem > 1 && rem < 5) return `${count} базы`;
            if (rem === 1) return `${count} база`;
            return `${count} баз`;
        }

        const groups = (typeof groupedOrganizations !== 'undefined' && Array.isArray(groupedOrganizations)) ? groupedOrganizations : [];
        const orgsTotal = typeof totalOrgs !== 'undefined' ? totalOrgs : groups.length;
        const basesTotal = typeof totalBases !== 'undefined' ? totalBases : groups.reduce((acc, g) => acc + (g.count || 0), 0);
    %>

    <!-- Topbar Navigation -->
    <header class="home-topbar">
        <div class="home-topbar__brand">
            <a href="/" class="home-brand-link" title="ИТС-Ком">
                <span class="home-brand-name">ИТС-Ком</span>
            </a>
        </div>
        <nav class="home-topbar__nav" aria-label="Основная навигация">
            <a href="/" class="home-topbar__nav-link" data-i18n="nav.home">Главная</a>
            <a href="/wiki" class="home-topbar__nav-link">Wiki</a>
            <a href="/events" class="home-topbar__nav-link is-active">События</a>
        </nav>
        <div class="home-topbar__account">
            <button class="theme-toggle-btn" id="themeToggle" type="button" aria-label="Переключить тему" title="Переключить тему">
                <svg class="theme-icon theme-icon--sun" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M10 2V4M10 16V18M2 10H4M16 10H18M4.22 4.22L5.64 5.64M14.36 14.36L15.78 15.78M15.78 4.22L14.36 5.64M5.64 14.36L4.22 15.78" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                <svg class="theme-icon theme-icon--moon" viewBox="0 0 20 20" fill="none"><path d="M17 11C16.4 15 12.8 18 8.5 17.5C4.2 17 1 13.3 1.5 9C2 4.7 5.8 1.8 10 2.5C8.5 4.5 8.5 8 11 10C13.5 12 16.5 11.5 17 11Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button class="home-account-button" type="button" id="homeAccountToggle" aria-expanded="false" aria-controls="homeAccountMenu">
                <span class="home-account-avatar"><%= avatarLetter %></span>
                <span class="home-account-name"><%= displayName %></span>
                <span class="home-account-caret" aria-hidden="true">
                    <svg viewBox="0 0 20 20" fill="none"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
            </button>
            <div class="home-account-menu" id="homeAccountMenu">
                <a href="/profile" class="home-account-menu__item is-highlighted">
                    <span class="home-account-menu__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 13C14.7614 13 17 10.7614 17 8C17 5.23858 14.7614 3 12 3C9.23858 3 7 5.23858 7 8C7 10.7614 9.23858 13 12 13Z" stroke="currentColor" stroke-width="2"/><path d="M4 21C4.8 17.8 7.5 16 12 16C16.5 16 19.2 17.8 20 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </span>
                    <span data-i18n="nav.profile">Профиль</span>
                </a>
                <a href="/logout" class="home-account-menu__item">
                    <span class="home-account-menu__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M10 17L15 12L10 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 12H4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M13 4H18C19.1046 4 20 4.89543 20 6V18C20 19.1046 19.1046 20 18 20H13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </span>
                    <span data-i18n="nav.logout.short">Выйти</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="events-main">
        <div class="events-container">
            <!-- Header section -->
            <div class="events-header">
                <div class="events-header__info">
                    <h1 class="events-title">Журнал релизов 1С</h1>
                    <p class="events-subtitle">Хронологический регистр обновлений конфигураций клиентов</p>
                </div>

                <!-- Upper Toolbar Controls -->
                <div class="events-toolbar">
                    <!-- Quick action buttons -->
                    <div class="events-tree-actions">
                        <button type="button" class="events-action-btn" id="btnExpandAll" title="Развернуть все группы">
                            <span class="btn-icon">▾</span> Развернуть все
                        </button>
                        <button type="button" class="events-action-btn" id="btnCollapseAll" title="Свернуть все группы">
                            <span class="btn-icon">▸</span> Свернуть все
                        </button>
                    </div>

                    <!-- Live Instant Search Field -->
                    <div class="events-search-box">
                        <span class="events-search-icon" aria-hidden="true">
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                                <circle cx="8.5" cy="8.5" r="5.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <line x1="12.5" y1="12.5" x2="16.5" y2="16.5" stroke-linecap="round"/>
                            </svg>
                        </span>
                        <input
                            type="text"
                            id="eventsSearchInput"
                            class="events-search-input"
                            placeholder="Поиск по компании, базе, описанию..."
                            autocomplete="off"
                            aria-label="Живой поиск по событиям"
                        >
                    </div>

                    <!-- Informational Badge -->
                    <div class="events-badge-pill" id="eventsStatsBadge">
                        Всего: <strong id="statsTotalOrgs"><%= orgsTotal %></strong> компаний, <strong id="statsTotalBases"><%= basesTotal %></strong> баз 1С
                    </div>

                    <!-- Company Filter Select (compatible with existing workflows) -->
                    <div class="events-select-wrap">
                        <select id="orgFilter" class="events-org-select" aria-label="Фильтр по организации">
                            <option value="">Все организации (<%= basesTotal %>)</option>
                            <% if (organizations && organizations.length > 0) { %>
                                <% organizations.forEach(function(org) { %>
                                    <option value="<%= org.id %>"><%= org.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Events Hierarchical Tree Card -->
            <div class="events-card">
                <div class="events-table-wrap" id="eventsTableWrap" style="<%= (groups && groups.length > 0) ? '' : 'display: none;' %>">
                    <table class="events-table events-tree-table" id="eventsTable">
                        <thead>
                            <tr>
                                <th class="col-org">Организация</th>
                                <th class="col-db">Информационная база</th>
                                <th class="col-desc col-release">Описание</th>
                                <th class="col-date">Дата</th>
                            </tr>
                        </thead>
                        <tbody id="eventsTableBody">
                            <% if (groups && groups.length > 0) { %>
                                <% groups.forEach(function(group) { %>
                                    <!-- Строка 1-го уровня (родительская группа) — Организация -->
                                    <tr class="events-group-row is-expanded" data-org-id="<%= group.id %>" data-name="<%= group.name %>" data-count="<%= group.count %>" tabindex="0" role="button" aria-expanded="true">
                                        <td class="col-org" colspan="4">
                                            <div class="events-group-cell">
                                                <span class="events-chevron" aria-hidden="true">▾</span>
                                                <span class="events-folder-icon" aria-hidden="true">🏢</span>
                                                <a href="/wiki/organization/<%= group.id %>" class="events-group-title events-org-link" onclick="event.stopPropagation();" title="Открыть Wiki компании">
                                                    <span class="events-org-name"><%= group.name %></span>
                                                    <span class="events-link-arrow">↗</span>
                                                </a>
                                                <span class="events-count-badge"><%= getBasesCountStr(group.count) %></span>
                                            </div>
                                        </td>
                                    </tr>

                                    <!-- Строки 2-го уровня (дочерние строки) — Информационные базы этой организации -->
                                    <% if (group.databases && group.databases.length > 0) { %>
                                        <% group.databases.forEach(function(db) { 
                                            const formattedDate = db.updated_at ? new Date(db.updated_at).toLocaleDateString('ru-RU') : '—';
                                            const dbDesc = db.description || db.release || '—';
                                        %>
                                            <tr class="events-child-row" data-parent-org-id="<%= group.id %>" data-db-id="<%= db.id %>" data-db-name="<%= db.name %>" data-desc="<%= dbDesc %>">
                                                <td class="col-org">
                                                    <span class="tree-indent" aria-hidden="true">
                                                        <span class="tree-branch">└─</span>
                                                    </span>
                                                </td>
                                                <td class="col-db">
                                                    <span class="events-db-name"><%= db.name %></span>
                                                </td>
                                                <td class="col-desc col-release">
                                                    <span class="events-db-desc db-release-badge"><%= dbDesc %></span>
                                                </td>
                                                <td class="col-date">
                                                    <span class="events-date-val"><%= formattedDate %></span>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr class="events-child-row events-child-row--empty" data-parent-org-id="<%= group.id %>">
                                            <td class="col-org">
                                                <span class="tree-indent" aria-hidden="true">
                                                    <span class="tree-branch">└─</span>
                                                </span>
                                            </td>
                                            <td class="col-db" colspan="3">
                                                <span class="events-db-empty-hint">Базы 1С еще не привязаны к этой организации</span>
                                            </td>
                                        </tr>
                                    <% } %>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Empty State -->
                <div class="events-empty-state" id="eventsEmptyState" style="<%= (groups && groups.length > 0) ? 'display: none;' : '' %>">
                    <div class="empty-state-icon">📋</div>
                    <div class="empty-state-text" id="emptyStateText">Записи об обновлениях конфигураций 1С отсутствуют</div>
                    <div class="empty-state-subtext" id="emptyStateSubtext">Обновления баз данных фиксируются автоматически при ведении Wiki клиентов</div>
                </div>
            </div>
        </div>
    </main>

    <footer class="wiki-footer">
        <div class="footer-content">
            Powered by <a href="#" class="footer-link">_thedaulet</a> © 2026 Astana
        </div>
    </footer>

    <!-- Theme & Account & Hierarchical Tree Scripts -->
    <script>
        // User account menu toggle
        (function () {
            const toggle = document.getElementById('homeAccountToggle');
            const menu = document.getElementById('homeAccountMenu');
            if (!toggle || !menu) return;
            toggle.addEventListener('click', function (e) {
                e.stopPropagation();
                const isOpen = menu.classList.toggle('is-open');
                toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            });
            document.addEventListener('click', function (e) {
                if (!menu.contains(e.target) && !toggle.contains(e.target)) {
                    menu.classList.remove('is-open');
                    toggle.setAttribute('aria-expanded', 'false');
                }
            });
        })();

        // Theme toggle
        (function () {
            const btn = document.getElementById('themeToggle');
            if (!btn) return;
            const meta = document.querySelector('meta[name="app-user"]');
            const user = meta ? meta.getAttribute('content') : 'admin';
            const storageKey = user ? ('ui_theme_' + user) : 'ui_theme';

            btn.addEventListener('click', function () {
                const current = document.documentElement.getAttribute('data-theme') || 'light';
                const next = current === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                localStorage.setItem(storageKey, next);
            });
        })();

        // Hierarchical Tree Engine (Accordion, Expand/Collapse All, Live Search, Org Filter)
        (function () {
            const tableWrap = document.getElementById('eventsTableWrap');
            const tableBody = document.getElementById('eventsTableBody');
            const emptyState = document.getElementById('eventsEmptyState');
            const emptyText = document.getElementById('emptyStateText');
            const emptySubtext = document.getElementById('emptyStateSubtext');
            const btnExpandAll = document.getElementById('btnExpandAll');
            const btnCollapseAll = document.getElementById('btnCollapseAll');
            const searchInput = document.getElementById('eventsSearchInput');
            const orgFilter = document.getElementById('orgFilter');

            if (!tableBody) return;

            // Helper to toggle a single group row
            function setGroupState(groupRow, shouldExpand) {
                const orgId = groupRow.getAttribute('data-org-id');
                const chevron = groupRow.querySelector('.events-chevron');
                
                if (shouldExpand) {
                    groupRow.classList.add('is-expanded');
                    groupRow.classList.remove('is-collapsed');
                    groupRow.setAttribute('aria-expanded', 'true');
                    if (chevron) chevron.textContent = '▾';
                } else {
                    groupRow.classList.remove('is-expanded');
                    groupRow.classList.add('is-collapsed');
                    groupRow.setAttribute('aria-expanded', 'false');
                    if (chevron) chevron.textContent = '▸';
                }

                const childRows = document.querySelectorAll(`.events-child-row[data-parent-org-id="${orgId}"]`);
                childRows.forEach(row => {
                    row.style.display = shouldExpand ? '' : 'none';
                });
            }

            function toggleGroup(groupRow) {
                const isExpanded = groupRow.classList.contains('is-expanded');
                setGroupState(groupRow, !isExpanded);
            }

            // Group Row Click Handler
            const groupRows = document.querySelectorAll('.events-group-row');
            groupRows.forEach(row => {
                row.addEventListener('click', function (e) {
                    if (e.target.closest('a')) return;
                    toggleGroup(row);
                });
                row.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        if (e.target.closest('a')) return;
                        e.preventDefault();
                        toggleGroup(row);
                    }
                });
            });

            // Expand All
            if (btnExpandAll) {
                btnExpandAll.addEventListener('click', function () {
                    groupRows.forEach(row => setGroupState(row, true));
                });
            }

            // Collapse All
            if (btnCollapseAll) {
                btnCollapseAll.addEventListener('click', function () {
                    groupRows.forEach(row => setGroupState(row, false));
                });
            }

            // Live Search & Filter Coordinator
            function applyFilters() {
                const query = (searchInput ? searchInput.value : '').trim().toLowerCase();
                const selectedOrgId = orgFilter ? orgFilter.value : '';
                let visibleGroupsCount = 0;
                let visibleBasesCount = 0;

                groupRows.forEach(gRow => {
                    const orgId = gRow.getAttribute('data-org-id');
                    const orgName = (gRow.getAttribute('data-name') || '').toLowerCase();
                    const childRows = document.querySelectorAll(`.events-child-row[data-parent-org-id="${orgId}"]`);

                    // Check company filter
                    if (selectedOrgId && orgId !== selectedOrgId) {
                        gRow.style.display = 'none';
                        childRows.forEach(c => c.style.display = 'none');
                        return;
                    }

                    // If no search query
                    if (!query) {
                        gRow.style.display = '';
                        visibleGroupsCount++;
                        const isExp = gRow.classList.contains('is-expanded');
                        childRows.forEach(c => {
                            c.style.display = isExp ? '' : 'none';
                            if (isExp && !c.classList.contains('events-child-row--empty')) {
                                visibleBasesCount++;
                            }
                        });
                        return;
                    }

                    // Searching
                    const groupMatches = orgName.includes(query);
                    let matchingChildren = 0;

                    childRows.forEach(cRow => {
                        const dbName = (cRow.getAttribute('data-db-name') || '').toLowerCase();
                        const dbDesc = (cRow.getAttribute('data-desc') || '').toLowerCase();
                        const childMatches = dbName.includes(query) || dbDesc.includes(query);

                        if (groupMatches || childMatches) {
                            cRow.style.display = '';
                            if (!cRow.classList.contains('events-child-row--empty')) {
                                visibleBasesCount++;
                            }
                            matchingChildren++;
                        } else {
                            cRow.style.display = 'none';
                        }
                    });

                    if (groupMatches || matchingChildren > 0) {
                        gRow.style.display = '';
                        // Auto-expand matching groups
                        gRow.classList.add('is-expanded');
                        gRow.classList.remove('is-collapsed');
                        gRow.setAttribute('aria-expanded', 'true');
                        const chevron = gRow.querySelector('.events-chevron');
                        if (chevron) chevron.textContent = '▾';
                        visibleGroupsCount++;
                    } else {
                        gRow.style.display = 'none';
                    }
                });

                if (visibleGroupsCount > 0) {
                    if (tableWrap) tableWrap.style.display = '';
                    if (emptyState) emptyState.style.display = 'none';
                } else {
                    if (tableWrap) tableWrap.style.display = 'none';
                    if (emptyState) {
                        emptyState.style.display = '';
                        if (emptyText) {
                            emptyText.textContent = query
                                ? `По запросу «${query}» ничего не найдено`
                                : 'Для выбранной организации нет зафиксированных релизов 1С';
                        }
                        if (emptySubtext) {
                            emptySubtext.textContent = 'Попробуйте изменить параметры поиска или фильтрации';
                        }
                    }
                }
            }

            if (searchInput) {
                searchInput.addEventListener('input', applyFilters);
            }

            if (orgFilter) {
                orgFilter.addEventListener('change', applyFilters);
            }
        })();
    </script>
</body>
</html>
