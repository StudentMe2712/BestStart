<!DOCTYPE html>
<html lang="ru" id="htmlRoot">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wiki - ИТС-Ком</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/wiki-page.css">
	<link rel="icon" type="image/png" href="/favicon.png">
    <meta name="app-user" content="<%= user.username %>">
    <script>(function(){var m=document.querySelector('meta[name="app-user"]');var u=m&&m.getAttribute('content');var k=u?'ui_theme_'+u:'ui_theme';var t=localStorage.getItem(k);if(t)document.documentElement.setAttribute('data-theme',t);})()</script>
</head>
<body class="wiki-page-body">
    <% const displayName = user.username === 'admin' ? 'Администратор' : user.username; %>
    <% const avatarLetter = displayName.charAt(0).toUpperCase(); %>
    <%
    let prevOrg = null, nextOrg = null;
    if (currentOrg && organizations && organizations.length > 0) {
        const idx = organizations.findIndex(function(o) { return o.id === currentOrg.id; });
        if (idx > 0) prevOrg = organizations[idx - 1];
        if (idx >= 0 && idx < organizations.length - 1) nextOrg = organizations[idx + 1];
    }

    function computeOrgMonogram(name) {
        if (!name || typeof name !== 'string') return '';
        var clean = name.trim();
        if (!clean) return '';
        if (/^астанагенплан/i.test(clean)) return 'АП';

        var words = clean.split(/[\s\-_–—/\\()]+/).filter(function(w) { return /[a-zA-Zа-яА-ЯёЁ]/.test(w); });
        if (words.length >= 2) {
            var m1 = words[0].match(/[a-zA-Zа-яА-ЯёЁ]/);
            var m2 = words[1].match(/[a-zA-Zа-яА-ЯёЁ]/);
            if (m1 && m2) return (m1[0] + m2[0]).toUpperCase();
        }
        var letters = clean.replace(/[^a-zA-Zа-яА-ЯёЁ]/g, '');
        if (letters.length >= 2) {
            return letters.substring(0, 2).toUpperCase();
        }
        return letters.toUpperCase();
    }
    const orgMonogram = (typeof locals !== 'undefined' && locals.orgMonogram) ? locals.orgMonogram : (currentOrg ? computeOrgMonogram(currentOrg.name) : '');
    %>

    <header class="home-topbar">
        <div class="home-topbar__brand">
            <a href="/" class="home-brand-link" title="ИТС-Ком">
                <span class="home-brand-name">ИТС-Ком</span>
            </a>
        </div>
        <nav class="home-topbar__nav" aria-label="Основная навигация">
            <a href="/" class="home-topbar__nav-link" data-i18n="nav.home">Главная</a>
            <a href="/wiki" class="home-topbar__nav-link is-active">Wiki</a>
            <!-- <a href="/events" class="home-topbar__nav-link">События</a> -->
        </nav>
        <div class="home-topbar__account">
            <button class="theme-toggle-btn" id="themeToggle" type="button" aria-label="Переключить тему">
                <svg class="theme-icon theme-icon--sun" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M10 2V4M10 16V18M2 10H4M16 10H18M4.22 4.22L5.64 5.64M14.36 14.36L15.78 15.78M15.78 4.22L14.36 5.64M5.64 14.36L4.22 15.78" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                <svg class="theme-icon theme-icon--moon" viewBox="0 0 20 20" fill="none"><path d="M17 11C16.4 15 12.8 18 8.5 17.5C4.2 17 1 13.3 1.5 9C2 4.7 5.8 1.8 10 2.5C8.5 4.5 8.5 8 11 10C13.5 12 16.5 11.5 17 11Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button class="home-account-button" type="button" id="homeAccountToggle" aria-expanded="false" aria-controls="homeAccountMenu">
                <span class="home-account-avatar"><%= avatarLetter %></span>
                <span class="home-account-name"><%= displayName %></span>
                <span class="home-account-caret" aria-hidden="true">
                    <svg viewBox="0 0 20 20" fill="none"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
            </button>
            <div class="home-account-menu" id="homeAccountMenu">
                <a href="/profile" class="home-account-menu__item is-highlighted">
                    <span class="home-account-menu__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 13C14.7614 13 17 10.7614 17 8C17 5.23858 14.7614 3 12 3C9.23858 3 7 5.23858 7 8C7 10.7614 9.23858 13 12 13Z" stroke="currentColor" stroke-width="2"/><path d="M4 21C4.8 17.8 7.5 16 12 16C16.5 16 19.2 17.8 20 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </span>
                    <span data-i18n="nav.profile">Профиль</span>
                </a>
                <a href="/logout" class="home-account-menu__item">
                    <span class="home-account-menu__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M10 17L15 12L10 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 12H4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M13 4H18C19.1046 4 20 4.89543 20 6V18C20 19.1046 19.1046 20 18 20H13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </span>
                    <span data-i18n="nav.logout.short">Выйти</span>
                </a>
            </div>
        </div>
    </header>

    <div class="wiki-layout">

        <!-- ===== SIDEBAR ===== -->
        <aside class="wiki-sidebar" id="wikiSidebar">
            <div class="wiki-sidebar-top">
                <div class="wiki-sidebar-title-row">
                    <span class="wiki-sidebar-title" data-i18n="wiki.sidebar.title">Оглавление</span>
                    <span class="wiki-count-badge" id="wikiCountBadge" title="Количество серверов"><%= organizations ? organizations.length : 0 %></span>
                </div>
                <button class="wiki-new-btn" id="addOrgBtn"
                        data-i18n-title="wiki.sidebar.newBtn" title="Новая wiki-страница">+</button>
            </div>
            <div class="wiki-search-wrap">
                <svg class="wiki-search-icon" viewBox="0 0 16 16" fill="none">
                    <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.4"/>
                    <line x1="10.5" y1="10.5" x2="14" y2="14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
                <input type="text" class="wiki-search-input" id="wikiSearch"
                       placeholder="Поиск серверов..." data-i18n-placeholder="wiki.search.placeholder" autocomplete="off">
                <button type="button" class="wiki-search-clear" id="wikiSearchClear" aria-label="Очистить поиск" title="Очистить">&times;</button>
            </div>
            <div class="wiki-search-summary" id="wikiSearchSummary" style="display: none;"></div>
            <ul class="wiki-list" id="wikiOrgList">
                <% if (organizations && organizations.length > 0) { %>
                    <%
                        const pins = (typeof userPins !== 'undefined' && Array.isArray(userPins)) ? userPins : [];
                        const pinnedOrgs = [];
                        const otherOrgs = [];
                        organizations.forEach(function(org) {
                            if (pins.includes(org.id)) {
                                pinnedOrgs.push(org);
                            } else {
                                otherOrgs.push(org);
                            }
                        });
                    %>
                    <% if (pinnedOrgs.length > 0) { %>
                        <li class="wiki-list-section-header" id="pinnedSectionHeader"><span>ЗАКРЕПЛЕННЫЕ</span></li>
                        <% pinnedOrgs.forEach(function(org) { %>
                            <% const orgNameLower = (org.name || '').toLowerCase(); %>
                            <li class="wiki-list-item" data-name="<%= orgNameLower %>" data-org-id="<%= org.id %>">
                                <a href="/wiki/organization/<%= org.id %>"
                                   class="wiki-list-link<%= currentOrg && currentOrg.id === org.id ? ' is-active' : '' %>">
                                    <span class="wiki-active-bar" aria-hidden="true"></span>
                                    <svg class="wiki-list-chevron" viewBox="0 0 8 12" fill="none" width="7" height="11">
                                        <path d="M1.5 1.5L6 6L1.5 10.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                    <span class="wiki-list-name"><%= org.name %></span>
                                </a>
                                <button type="button" class="wiki-pin-btn<%= (pins.includes(org.id)) ? ' is-pinned' : '' %>" data-org-id="<%= org.id %>" title="<%= (pins.includes(org.id)) ? 'Открепить организацию' : 'Закрепить организацию' %>" aria-label="Булавка">
                                    <span class="wiki-pin-icon" aria-hidden="true">📌</span>
                                </button>
                            </li>
                        <% }); %>
                        <li class="wiki-list-section-header" id="allSectionHeader"><span>ВСЕ ОРГАНИЗАЦИИ</span></li>
                        <% otherOrgs.forEach(function(org) { %>
                            <% const orgNameLower = (org.name || '').toLowerCase(); %>
                            <li class="wiki-list-item" data-name="<%= orgNameLower %>" data-org-id="<%= org.id %>">
                                <a href="/wiki/organization/<%= org.id %>"
                                   class="wiki-list-link<%= currentOrg && currentOrg.id === org.id ? ' is-active' : '' %>">
                                    <span class="wiki-active-bar" aria-hidden="true"></span>
                                    <svg class="wiki-list-chevron" viewBox="0 0 8 12" fill="none" width="7" height="11">
                                        <path d="M1.5 1.5L6 6L1.5 10.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                    <span class="wiki-list-name"><%= org.name %></span>
                                </a>
                                <button type="button" class="wiki-pin-btn<%= (pins.includes(org.id)) ? ' is-pinned' : '' %>" data-org-id="<%= org.id %>" title="<%= (pins.includes(org.id)) ? 'Открепить организацию' : 'Закрепить организацию' %>" aria-label="Булавка">
                                    <span class="wiki-pin-icon" aria-hidden="true">📌</span>
                                </button>
                            </li>
                        <% }); %>
                    <% } else { %>
                        <% organizations.forEach(function(org) { %>
                            <% const orgNameLower = (org.name || '').toLowerCase(); %>
                            <li class="wiki-list-item" data-name="<%= orgNameLower %>" data-org-id="<%= org.id %>">
                                <a href="/wiki/organization/<%= org.id %>"
                                   class="wiki-list-link<%= currentOrg && currentOrg.id === org.id ? ' is-active' : '' %>">
                                    <span class="wiki-active-bar" aria-hidden="true"></span>
                                    <svg class="wiki-list-chevron" viewBox="0 0 8 12" fill="none" width="7" height="11">
                                        <path d="M1.5 1.5L6 6L1.5 10.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                    <span class="wiki-list-name"><%= org.name %></span>
                                </a>
                                <button type="button" class="wiki-pin-btn<%= (pins.includes(org.id)) ? ' is-pinned' : '' %>" data-org-id="<%= org.id %>" title="<%= (pins.includes(org.id)) ? 'Открепить организацию' : 'Закрепить организацию' %>" aria-label="Булавка">
                                    <span class="wiki-pin-icon" aria-hidden="true">📌</span>
                                </button>
                            </li>
                        <% }); %>
                    <% } %>
                    <li class="wiki-list-empty" id="wikiSearchNoResults" style="display: none;" data-i18n="wiki.sidebar.noResults">Ничего не найдено</li>
                <% } else { %>
                    <li class="wiki-list-empty" data-i18n="wiki.sidebar.empty">Нет организаций</li>
                <% } %>
            </ul>
        </aside>
        <div class="wiki-resize-handle" id="wikiResizeHandle"></div>

        <!-- ===== MAIN ===== -->
        <main class="wiki-main">
            <% if (!currentOrg) { %>
                <div class="wiki-welcome">
                    <p data-i18n-html="wiki.welcome">Выберите организацию из списка слева или нажмите <strong>+</strong> для создания новой.</p>
                </div>
            <% } else { %>

                <!-- ORG HEADER -->
                <div class="org-page-header">
                    <div class="org-header-left">
                        <div class="org-avatar org-avatar--monogram" title="<%= currentOrg.name %>">
                            <span class="org-monogram-text"><%= orgMonogram %></span>
                        </div>
                        <div class="org-header-info">
                            <h2 class="org-title" id="orgTitle"><%= currentOrg.name %></h2>
                            <%
                                const lastModifiedDate = currentOrg.updated_at 
                                    ? new Date(currentOrg.updated_at).toLocaleString('ru-RU', {day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit'}) 
                                    : 'Не указано';
                            %>
                            <div class="org-subtitle" id="orgSubtitle">Последнее изменение: <%= lastModifiedDate %><% if (displayName) { %> • <%= displayName %><% } %></div>
                        </div>
                    </div>
                    <div class="org-header-right">
                        <button class="org-action-btn" id="editBtnTop" data-i18n="wiki.edit.btn">Редактировать</button>
                        <div class="org-more-wrap">
                            <button class="org-action-btn" id="moreBtnTop"><span data-i18n="wiki.more.btn">Ещё</span> <span class="more-caret">▾</span></button>
                            <div class="org-more-dropdown" id="moreMenu">
                                <a href="/api/export/pdf/<%= currentOrg.id %>" target="_blank" class="more-item" data-i18n="wiki.more.pdf">
                                    <svg class="more-item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                        <polyline points="14 2 14 8 20 8"/>
                                        <path d="M10 12h2a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1h-2v-4z"/>
                                    </svg>
                                    <span>Экспорт PDF</span>
                                </a>
                                <a href="/api/export/txt/<%= currentOrg.id %>" class="more-item" data-i18n="wiki.more.txt">
                                    <svg class="more-item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                        <polyline points="14 2 14 8 20 8"/>
                                        <line x1="16" y1="13" x2="8" y2="13"/>
                                        <line x1="16" y1="17" x2="8" y2="17"/>
                                    </svg>
                                    <span>Экспорт TXT</span>
                                </a>
                                <button type="button" class="more-item more-item-danger" id="deleteBtnMore" data-i18n="wiki.more.delete">
                                    <svg class="more-item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"/>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                    </svg>
                                    <span>Удалить</span>
                                </button>
                            </div>
                        </div>
                        <div class="org-nav-arrows">
                            <% if (prevOrg) { %>
                                <a href="/wiki/organization/<%= prevOrg.id %>" class="org-nav-btn" title="Предыдущая">‹</a>
                            <% } else { %>
                                <span class="org-nav-btn org-nav-btn--disabled">‹</span>
                            <% } %>
                            <% if (nextOrg) { %>
                                <a href="/wiki/organization/<%= nextOrg.id %>" class="org-nav-btn" title="Следующая">›</a>
                            <% } else { %>
                                <span class="org-nav-btn org-nav-btn--disabled">›</span>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- ORG TABS NAVIGATION (Sprint 9) -->
                <div class="org-tabs-nav" id="companyTabsBar" role="tablist" aria-label="Вкладки организации">
                    <button type="button" class="org-tab-btn is-active" id="tabBtnData" data-tab-target="data" data-tab="data" role="tab" aria-selected="true" aria-controls="tabPanelData">
                        <svg class="org-tab-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                        </svg>
                        <span>Данные</span>
                    </button>
                    <button type="button" class="org-tab-btn" id="tabBtnFiles" data-tab-target="files" data-tab="files" role="tab" aria-selected="false" aria-controls="tabPanelFiles">
                        <svg class="org-tab-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
                        </svg>
                        <span>Файлы</span>
                        <span class="org-tab-badge tab-count-badge<%= (typeof files !== 'undefined' && files && files.length > 0) ? ' has-items has-files' : '' %>" id="filesTabCounter">
                            <%= (typeof files !== 'undefined' && files) ? files.length : 0 %>
                        </span>
                    </button>
                </div>

                <!-- Tab Panel 1: Данные -->
                <div class="org-tab-pane is-active" id="tabPanelData" data-tab-pane="data" data-tab="data" role="tabpanel" aria-labelledby="tabBtnData">
                    <div class="content-section">
                        <!-- Clean Content Sheet (Shown in view mode) -->
                        <div class="wiki-sheet wiki-content-sheet" id="wikiSheet"></div>

                        <!-- Editor outer (Shown in edit mode) -->
                        <div class="editor-outer" id="editorOuter" style="display: none;">

                            <!-- Toolbar (hidden in view mode) -->
                            <div class="editor-toolbar" id="editorToolbar">
                                <select class="editor-format-select" id="formatSelect">
                                    <option value="p"  data-i18n="toolbar.paragraph">Абзац</option>
                                    <option value="h1" data-i18n="toolbar.h1">Заголовок 1</option>
                                    <option value="h2" data-i18n="toolbar.h2">Заголовок 2</option>
                                    <option value="h3" data-i18n="toolbar.h3">Заголовок 3</option>
                                </select>
                                <div class="tb-sep"></div>
                                <button class="tb-btn" data-cmd="bold" title="Жирный"><b>B</b></button>
                                <button class="tb-btn" data-cmd="italic" title="Курсив"><i>I</i></button>
                                <button class="tb-btn" data-cmd="underline" title="Подчёркнутый"><u>U</u></button>
                                <button class="tb-btn" data-cmd="strikeThrough" title="Зачёркнутый"><s>S</s></button>
                                <div class="tb-sep"></div>
                                <button class="tb-btn" data-cmd="insertUnorderedList" title="Маркированный список">
                                    <svg width="15" height="13" viewBox="0 0 15 13"><circle cx="1.5" cy="2" r="1.5" fill="currentColor"/><rect x="4" y="1" width="11" height="2" fill="currentColor" rx="1"/><circle cx="1.5" cy="6.5" r="1.5" fill="currentColor"/><rect x="4" y="5.5" width="11" height="2" fill="currentColor" rx="1"/><circle cx="1.5" cy="11" r="1.5" fill="currentColor"/><rect x="4" y="10" width="11" height="2" fill="currentColor" rx="1"/></svg>
                                </button>
                                <button class="tb-btn" data-cmd="insertOrderedList" title="Нумерованный список">
                                    <svg width="15" height="13" viewBox="0 0 15 13"><text x="0" y="4" font-size="5" fill="currentColor" font-family="sans-serif">1.</text><rect x="6" y="1" width="9" height="2" fill="currentColor" rx="1"/><text x="0" y="8.5" font-size="5" fill="currentColor" font-family="sans-serif">2.</text><rect x="6" y="5.5" width="9" height="2" fill="currentColor" rx="1"/><text x="0" y="13" font-size="5" fill="currentColor" font-family="sans-serif">3.</text><rect x="6" y="10" width="9" height="2" fill="currentColor" rx="1"/></svg>
                                </button>
                                <button class="tb-btn" data-cmd="indent" title="Отступ">
                                    <svg width="15" height="13" viewBox="0 0 15 13"><rect x="0" y="0" width="15" height="2" fill="currentColor" rx="1"/><rect x="4" y="5.5" width="11" height="2" fill="currentColor" rx="1"/><rect x="0" y="11" width="15" height="2" fill="currentColor" rx="1"/><polygon points="0,5.5 0,9.5 3.5,7.5" fill="currentColor"/></svg>
                                </button>
                                <div class="tb-sep"></div>
                                <button class="tb-btn" data-cmd="justifyLeft" title="По левому краю">
                                    <svg width="15" height="12" viewBox="0 0 15 12"><rect x="0" y="0" width="15" height="2" fill="currentColor" rx="1"/><rect x="0" y="5" width="10" height="2" fill="currentColor" rx="1"/><rect x="0" y="10" width="15" height="2" fill="currentColor" rx="1"/></svg>
                                </button>
                                <button class="tb-btn" data-cmd="justifyCenter" title="По центру">
                                    <svg width="15" height="12" viewBox="0 0 15 12"><rect x="0" y="0" width="15" height="2" fill="currentColor" rx="1"/><rect x="2.5" y="5" width="10" height="2" fill="currentColor" rx="1"/><rect x="0" y="10" width="15" height="2" fill="currentColor" rx="1"/></svg>
                                </button>
                                <button class="tb-btn" data-cmd="justifyRight" title="По правому краю">
                                    <svg width="15" height="12" viewBox="0 0 15 12"><rect x="0" y="0" width="15" height="2" fill="currentColor" rx="1"/><rect x="5" y="5" width="10" height="2" fill="currentColor" rx="1"/><rect x="0" y="10" width="15" height="2" fill="currentColor" rx="1"/></svg>
                                </button>
                                <button class="tb-btn" data-cmd="justifyFull" title="По ширине">
                                    <svg width="15" height="12" viewBox="0 0 15 12"><rect x="0" y="0" width="15" height="2" fill="currentColor" rx="1"/><rect x="0" y="5" width="15" height="2" fill="currentColor" rx="1"/><rect x="0" y="10" width="15" height="2" fill="currentColor" rx="1"/></svg>
                                </button>
                                <div class="tb-sep"></div>
                                <button class="tb-btn" id="linkBtn" title="Вставить ссылку">
                                    <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M6 9L9 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M7.5 4L8.5 3C9.5 2 11 2 12 3C13 4 13 5.5 12 6.5L11 7.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M8 11L7 12C6 13 4.5 13 3.5 12C2.5 11 2.5 9.5 3.5 8.5L4.5 7.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                                </button>
                                <div class="tb-sep"></div>
                                <button class="tb-btn" data-cmd="undo" title="Отменить">
                                    <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M2.5 8.5C2.5 5.462 4.962 3 8 3C11.038 3 13.5 5.462 13.5 8.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M2.5 5.5V8.5H5.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                                <button class="tb-btn" data-cmd="redo" title="Повторить">
                                    <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M12.5 8.5C12.5 5.462 10.038 3 7 3C3.962 3 1.5 5.462 1.5 8.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M12.5 5.5V8.5H9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                            </div>

                            <!-- Editor body -->
                            <div class="editor-body" id="orgEditor" contenteditable="false" spellcheck="true"></div>
                        </div>
                    </div>

                    <!-- BOTTOM BAR (shown in edit mode) -->
                    <div class="editor-bottom-bar" id="editorBottomBar" style="display: none;">
                        <div class="editor-bottom-bar__left">
                            <button class="btn-save-main" id="saveBtn" data-i18n="wiki.save.btn">Сохранить</button>
                            <button class="btn-cancel-edit" id="cancelEditBtn" type="button" data-i18n="wiki.cancel.btn">Отмена</button>
                        </div>
                        <div class="editor-bar-status">
                            <span class="draft-status" id="draftStatus"></span>
                            <% if (currentOrg.updated_at) { %>
                                <span class="last-modified" id="lastModified"><span data-i18n="wiki.last.modified">Последнее изменение:</span> <%= displayName %> (<%= user.username %>) <%= new Date(currentOrg.updated_at).toLocaleString('ru-RU', {day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit'}) %></span>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Tab Panel 2: Файлы -->
                <div class="org-tab-pane" id="tabPanelFiles" data-tab-pane="files" data-tab="files" role="tabpanel" aria-labelledby="tabBtnFiles" style="display: none;">
                    <section class="wiki-attachments-section wiki-attachments-tab-section" id="wikiAttachmentsSection">
                        <div class="wiki-attachments-header">
                            <div class="wiki-attachments-title-wrap">
                                <svg class="wiki-attachments-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                                </svg>
                                <h3 class="wiki-attachments-title">Присоединенные файлы</h3>
                                <span class="wiki-attachments-badge" id="filesCountBadge"><%= (typeof files !== 'undefined' && files) ? files.length : 0 %></span>
                            </div>
                            <div class="wiki-attachments-actions">
                                <input type="file" id="fileInputUpload" multiple style="display: none;" accept=".xlsx,.xls,.csv,.pdf,.docx,.doc,.png,.jpg,.jpeg,.webp,.txt,.zip,.rdp,.xml">
                                <button type="button" class="btn-attach-file" id="btnAttachFile" title="Прикрепить файл" aria-label="Прикрепить файл">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="12" y1="5" x2="12" y2="19"/>
                                        <line x1="5" y1="12" x2="19" y2="12"/>
                                    </svg>
                                    <span>Добавить файл</span>
                                </button>
                            </div>
                        </div>

                        <!-- Плейсхолдер при отсутствии файлов -->
                        <div class="attachments-empty" id="attachmentsEmpty" style="<%= (typeof files !== 'undefined' && files && files.length > 0) ? 'display: none;' : '' %>">
                            <div class="attachments-empty-icon">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                                </svg>
                            </div>
                            <div class="attachments-empty-title">К этой организации еще не прикреплены файлы</div>
                            <div class="attachments-empty-subtitle">Поддерживаются форматы Excel (.xlsx, .xls), Word (.docx, .doc), PDF, изображения (.png, .jpg, .webp), XML, TXT, ZIP и RDP</div>
                            <button type="button" class="btn-attach-file attachments-empty-btn" id="uploadFileBtn">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"/>
                                    <line x1="5" y1="12" x2="19" y2="12"/>
                                </svg>
                                <span>Прикрепить файл</span>
                            </button>
                        </div>

                        <!-- Список файлов -->
                        <div class="attachments-list" id="attachmentsList">
                            <% if (typeof files !== 'undefined' && files && files.length > 0) { %>
                                <% files.forEach(function(file) { %>
                                    <%
                                        const ext = (file.original_name ? file.original_name.split('.').pop() : '').toLowerCase();
                                        let fileType = 'file';
                                        let iconColor = '#64748b';
                                        let isPreviewable = false;

                                        if (['xlsx', 'xls', 'csv'].includes(ext)) {
                                            fileType = 'excel';
                                            iconColor = '#10b981';
                                            isPreviewable = true;
                                        } else if (ext === 'xml') {
                                            fileType = 'xml';
                                            iconColor = '#06b6d4';
                                            isPreviewable = true;
                                        } else if (ext === 'pdf') {
                                            fileType = 'pdf';
                                            iconColor = '#ef4444';
                                            isPreviewable = true;
                                        } else if (['png', 'jpg', 'jpeg', 'webp'].includes(ext)) {
                                            fileType = 'image';
                                            iconColor = '#3b82f6';
                                            isPreviewable = true;
                                        } else if (ext === 'docx' || ext === 'doc') {
                                            fileType = 'doc';
                                            iconColor = '#2563eb';
                                            isPreviewable = true;
                                        } else if (ext === 'txt') {
                                            fileType = 'text';
                                            iconColor = '#6366f1';
                                            isPreviewable = true;
                                        } else if (['zip', 'rdp'].includes(ext)) {
                                            fileType = 'archive';
                                            iconColor = '#f59e0b';
                                        }

                                        const size = file.file_size || 0;
                                        let sizeFormatted = '';
                                        if (size < 1024) {
                                            sizeFormatted = size + ' Б';
                                        } else if (size < 1024 * 1024) {
                                            sizeFormatted = (size / 1024).toFixed(1) + ' КБ';
                                        } else {
                                            sizeFormatted = (size / (1024 * 1024)).toFixed(1) + ' МБ';
                                        }
                                    %>
                                    <div class="file-chip file-chip--<%= fileType %>" data-file-id="<%= file.id %>" data-file-name="<%= file.original_name %>" data-file-type="<%= fileType %>" data-previewable="<%= isPreviewable ? 'true' : 'false' %>">
                                        <div class="file-chip-main<%= isPreviewable ? ' is-clickable' : '' %>" <%= isPreviewable ? 'role="button" tabindex="0" title="Нажмите для предпросмотра"' : '' %>>
                                            <span class="file-chip-icon" style="color: <%= iconColor %>;">
                                                <% if (fileType === 'excel') { %>
                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="17"/><line x1="16" y1="13" x2="8" y2="17"/></svg>
                                                <% } else if (fileType === 'xml') { %>
                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                                                <% } else if (fileType === 'pdf') { %>
                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M10 12h2a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1h-2v-4z"/></svg>
                                                <% } else if (fileType === 'image') { %>
                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                                <% } else if (fileType === 'doc') { %>
                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
                                                <% } else if (fileType === 'text') { %>
                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                                                <% } else if (fileType === 'archive') { %>
                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/></svg>
                                                <% } else { %>
                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                                <% } %>
                                            </span>
                                            <div class="file-chip-info">
                                                <span class="file-chip-name" title="<%= file.original_name %>"><%= file.original_name %></span>
                                                <div class="file-chip-details">
                                                    <span class="file-chip-size"><%= sizeFormatted %></span>
                                                    <% if (file.created_at) { %>
                                                        <span class="file-chip-date">• <%= new Date(file.created_at).toLocaleDateString('ru-RU') %></span>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="file-chip-actions">
                                            <a href="/api/files/<%= file.id %>/download" class="file-chip-btn file-chip-btn--download" title="Скачать файл" download="<%= file.original_name %>">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                                    <polyline points="7 10 12 15 17 10"/>
                                                    <line x1="12" y1="15" x2="12" y2="3"/>
                                                </svg>
                                            </a>
                                            <button type="button" class="file-chip-btn file-chip-btn--delete" data-file-id="<%= file.id %>" data-file-name="<%= file.original_name %>" title="Удалить файл">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                            </button>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } %>
                        </div>
                    </section>
                </div>

                <input type="hidden" id="orgNameInput" value="<%= currentOrg.name %>">
                <input type="hidden" id="currentOrgId" value="<%= currentOrg.id %>">

            <% } %>
        </main>

    </div>

    <footer class="wiki-footer">
        <div class="footer-content">
            Powered by <a href="#" class="footer-link">_thedaulet</a> © 2026 Astana
        </div>
    </footer>

    <!-- Modal: create org -->
    <div class="modal" id="addOrgModal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h2 data-i18n="wiki.modal.create.title">Новая организация</h2>
                <button class="modal-close" id="closeModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="newOrgName" data-i18n="wiki.modal.create.name.label">Название организации:</label>
                    <input type="text" id="newOrgName" class="form-input"
                           placeholder="Введите название"
                           data-i18n-placeholder="wiki.modal.create.name.placeholder">
                </div>
                <div class="form-group">
                    <label for="newOrgContent" data-i18n="wiki.modal.create.content.label">Содержимое (опционально):</label>
                    <textarea id="newOrgContent" class="form-textarea" rows="6"
                              placeholder="Введите содержимое"
                              data-i18n-placeholder="wiki.modal.create.content.placeholder"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-success" id="createOrgBtn" data-i18n="wiki.modal.create.btn">Создать</button>
                <button class="btn btn-secondary" id="cancelModalBtn" data-i18n="wiki.modal.cancel.btn">Отмена</button>
            </div>
        </div>
    </div>

    <!-- Modal: delete org -->
    <div class="modal" id="deleteOrgModal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h2 data-i18n="wiki.modal.delete.title">Удалить организацию</h2>
                <button class="modal-close" id="closeDeleteModal">&times;</button>
            </div>
            <div class="modal-body" id="deleteModalBody">
                <% if (!currentOrg && organizations && organizations.length > 0) { %>
                    <p data-i18n="wiki.modal.delete.select">Выберите организацию для удаления:</p>
                    <select id="deleteOrgSelect" class="form-input" style="width: 100%; margin-top: 10px;">
                        <option value="">-- Выберите организацию --</option>
                        <% organizations.forEach(function(org) { %>
                            <option value="<%= org.id %>"><%= org.name %></option>
                        <% }); %>
                    </select>
                <% } else if (currentOrg) { %>
                    <p><span data-i18n="wiki.modal.delete.confirm">Вы уверены, что хотите удалить организацию</span> <strong id="deleteOrgName"><%= currentOrg.name %></strong>?</p>
                    <input type="hidden" id="deleteOrgId" value="<%= currentOrg.id %>">
                <% } else { %>
                    <p data-i18n="wiki.modal.delete.none">Нет организаций для удаления.</p>
                <% } %>
            </div>
            <div class="modal-footer">
                <button class="btn btn-danger" id="confirmDeleteBtn" data-i18n="wiki.modal.delete.btn">Удалить</button>
                <button class="btn btn-secondary" id="cancelDeleteBtn" data-i18n="wiki.modal.cancel.btn">Отмена</button>
            </div>
        </div>
    </div>

    <!-- Modal: Add/Edit 1C Database (Консервация в Спринте 7)
    <div class="modal" id="db1cModal" style="display: none;">
        <div class="modal-content db-modal-content">
            <div class="modal-header">
                <h2 id="db1cModalTitle">Добавить базу 1С</h2>
                <button type="button" class="modal-close" id="closeDb1cModal">&times;</button>
            </div>
            <form id="db1cForm" autocomplete="off">
                <input type="hidden" id="db1cId" value="">
                <input type="hidden" id="dbId" value="">
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label" for="dbNameInput">Информационная база:</label>
                        <input type="text" id="dbNameInput" name="name" class="form-input" autocomplete="off" required placeholder="Например: Бухгалтерия (ЦБ)">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="dbDescription">Описание</label>
                        <input type="text" id="dbDescription" name="description" class="form-input" 
                               autocomplete="off" placeholder="Например: 3.0.73.1 (БК), подсистема Строительство" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="dbDate">Дата:</label>
                        <input type="date" id="dbDate" name="dbDate" class="form-input" autocomplete="off" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary" id="saveDb1cBtn">Сохранить</button>
                    <button type="button" class="btn btn-secondary" id="cancelDb1cBtn">Отмена</button>
                </div>
            </form>
        </div>
    </div>
    -->

    <!-- Lightbox Modal (Спринт 7) -->
    <div class="file-lightbox-modal" id="fileLightboxModal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="lightboxFileName">
        <div class="lightbox-overlay" id="lightboxOverlay"></div>
        <div class="lightbox-window">
            <div class="lightbox-header">
                <div class="lightbox-title-wrap">
                    <svg class="lightbox-title-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                    </svg>
                    <span class="lightbox-filename" id="lightboxFileName">Файл</span>
                </div>
                <div class="lightbox-controls">
                    <button type="button" class="lightbox-btn lightbox-btn--zoom" id="lightboxZoomBtn" title="Переключить масштаб 1:1 (Исходный размер) / По размеру окна" aria-label="Масштаб 1:1" style="display: none;">
                        <span>1:1</span>
                    </button>
                    <a href="#" class="lightbox-btn lightbox-btn--download" id="lightboxDownloadBtn" title="Скачать файл" download>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                        <span>Скачать</span>
                    </a>
                    <button type="button" class="lightbox-btn lightbox-btn--close" id="lightboxCloseBtn" title="Закрыть (Esc)" aria-label="Закрыть">&times;</button>
                </div>
            </div>
            <div class="lightbox-body" id="lightboxBody">
                <!-- <img> or <iframe> inserted dynamically -->
            </div>
        </div>
    </div>

    <!-- Unified Confirmation Modal (Sprint 7) -->
    <div class="confirm-modal" id="unifiedConfirmModal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="confirmDialogTitle" aria-describedby="confirmDialogDesc">
        <div class="confirm-modal__overlay" id="confirmModalOverlay"></div>
        <div class="confirm-modal__window" role="document">
            <div class="confirm-modal__header">
                <div class="confirm-modal__icon-wrap">
                    <svg class="confirm-modal__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                </div>
                <h3 class="confirm-modal__title" id="confirmDialogTitle">Удалить вложение?</h3>
            </div>
            <div class="confirm-modal__body">
                <p class="confirm-modal__desc" id="confirmDialogDesc">Вы действительно хотите удалить этот объект?</p>
                <div class="confirm-modal__item-box" id="confirmDialogItemBox" style="display: none;">
                    <span class="confirm-modal__item-name" id="confirmDialogItemName"></span>
                </div>
                <div class="confirm-modal__warning">
                    <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                    </svg>
                    <span>Это действие необратимо. Восстановить данные будет невозможно.</span>
                </div>
            </div>
            <div class="confirm-modal__footer">
                <button type="button" class="btn-confirm-cancel" id="confirmDialogCancelBtn">Отмена</button>
                <button type="button" class="btn-confirm-danger" id="confirmDialogSubmitBtn">
                    <span class="btn-confirm-spinner" id="confirmDialogSpinner" style="display: none;"></span>
                    <span class="btn-confirm-text" id="confirmDialogBtnText">Удалить</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Floating Toast Container -->
    <div class="floating-toast-container" id="floatingToastContainer" aria-live="polite" aria-atomic="true"></div>

    <script>
        var initialContent = <%- currentOrg ? JSON.stringify(currentOrg.content || '').replace(/<\//g, '<\\/') : '""' %>;
        var initialDatabases = <%- (typeof databases !== 'undefined' && databases) ? JSON.stringify(databases).replace(/<\//g, '<\\/') : '[]' %>;
        var initialFiles = <%- (typeof files !== 'undefined' && files) ? JSON.stringify(files).replace(/<\//g, '<\\/') : '[]' %>;
    </script>
    <script src="/js/i18n.js"></script>
    <script src="/js/main.js"></script>
    <script>
        (function () {
            const toggle = document.getElementById('homeAccountToggle');
            const menu = document.getElementById('homeAccountMenu');
            if (!toggle || !menu) return;
            toggle.addEventListener('click', function (e) {
                e.stopPropagation();
                const isOpen = menu.classList.toggle('is-open');
                toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            });
            document.addEventListener('click', function (e) {
                if (!menu.contains(e.target) && !toggle.contains(e.target)) {
                    menu.classList.remove('is-open');
                    toggle.setAttribute('aria-expanded', 'false');
                }
            });
        })();

        /* ── Resizable sidebar ── */
        (function () {
            var sidebar = document.getElementById('wikiSidebar');
            var handle  = document.getElementById('wikiResizeHandle');
            if (!sidebar || !handle) return;

            var STORAGE_KEY = 'wiki_sidebar_width';
            var MIN_W = 160;
            var MAX_W = 520;

            function setW(w) {
                sidebar.style.width    = w + 'px';
                sidebar.style.minWidth = w + 'px';
            }

            var saved = parseInt(localStorage.getItem(STORAGE_KEY), 10);
            if (saved && saved >= MIN_W && saved <= MAX_W) setW(saved);

            var startX, startW;

            handle.addEventListener('mousedown', function (e) {
                e.preventDefault();
                startX = e.clientX;
                startW = sidebar.offsetWidth;
                handle.classList.add('is-dragging');
                document.body.style.cursor     = 'col-resize';
                document.body.style.userSelect = 'none';
                document.addEventListener('mousemove', onMove);
                document.addEventListener('mouseup',   onUp);
            });

            function onMove(e) {
                setW(Math.min(Math.max(startW + (e.clientX - startX), MIN_W), MAX_W));
            }

            function onUp() {
                handle.classList.remove('is-dragging');
                document.body.style.cursor     = '';
                document.body.style.userSelect = '';
                localStorage.setItem(STORAGE_KEY, sidebar.offsetWidth);
                document.removeEventListener('mousemove', onMove);
                document.removeEventListener('mouseup',   onUp);
            }
        })();
    </script>
</body>
</html>
