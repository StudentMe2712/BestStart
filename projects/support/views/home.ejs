<!DOCTYPE html>
<html lang="ru" id="htmlRoot">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>База знаний — ИТС-Ком</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/favicon.png">
    <meta name="app-user" content="<%= user.username %>">
    <script>(function(){var m=document.querySelector('meta[name="app-user"]');var u=m&&m.getAttribute('content');var k=u?'ui_theme_'+u:'ui_theme';var t=localStorage.getItem(k);if(t)document.documentElement.setAttribute('data-theme',t);})()</script>
</head>
<body class="home-body">
    <% const avatarLetter = (user.username || 'A').charAt(0).toUpperCase(); %>
    <% const totalServers = typeof serverCount !== 'undefined' ? serverCount : 25; %>
    <% const dateDisplay = typeof currentDateStr !== 'undefined' ? currentDateStr : 'Четверг, 22 октября 2026 г.'; %>

    <!-- Верхний бар (Top Navigation Bar) -->
    <header class="home-topbar">
        <div class="home-topbar__brand">
            <a href="/" class="home-brand-link" title="ИТС-Ком">
                <span class="home-brand-name">ИТС-Ком</span>
            </a>
        </div>

        <nav class="home-topbar__nav" aria-label="Основная навигация">
            <a href="/" class="home-topbar__nav-link is-active" data-i18n="nav.home">Главная</a>
            <a href="/wiki" class="home-topbar__nav-link">Wiki</a>
        </nav>

        <div class="home-topbar__account">
            <button class="theme-toggle-btn" id="themeToggle" type="button" aria-label="Переключить тему" title="Переключить тему">
                <svg class="theme-icon theme-icon--sun" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M10 2V4M10 16V18M2 10H4M16 10H18M4.22 4.22L5.64 5.64M14.36 14.36L15.78 15.78M15.78 4.22L14.36 5.64M5.64 14.36L4.22 15.78" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                <svg class="theme-icon theme-icon--moon" viewBox="0 0 20 20" fill="none"><path d="M17 11C16.4 15 12.8 18 8.5 17.5C4.2 17 1 13.3 1.5 9C2 4.7 5.8 1.8 10 2.5C8.5 4.5 8.5 8 11 10C13.5 12 16.5 11.5 17 11Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button class="home-account-button" type="button" id="homeAccountToggle" aria-expanded="false" aria-controls="homeAccountMenu">
                <span class="home-account-avatar"><%= avatarLetter %></span>
                <span class="home-account-name"><%= user.username %></span>
                <span class="home-account-caret" aria-hidden="true">
                    <svg viewBox="0 0 20 20" fill="none">
                        <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
            </button>

            <div class="home-account-menu" id="homeAccountMenu">
                <a href="/profile" class="home-account-menu__item is-highlighted">
                    <span class="home-account-menu__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M12 13C14.7614 13 17 10.7614 17 8C17 5.23858 14.7614 3 12 3C9.23858 3 7 5.23858 7 8C7 10.7614 9.23858 13 12 13Z" stroke="currentColor" stroke-width="2"/>
                            <path d="M4 21C4.8 17.8 7.5 16 12 16C16.5 16 19.2 17.8 20 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    </span>
                    <span data-i18n="nav.profile">Профиль</span>
                </a>
                <a href="/logout" class="home-account-menu__item">
                    <span class="home-account-menu__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M10 17L15 12L10 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M15 12H4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <path d="M13 4H18C19.1046 4 20 4.89543 20 6V18C20 19.1046 19.1046 20 18 20H13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    </span>
                    <span data-i18n="nav.logout.short">Выйти</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Главная рабочая область Command Hub -->
    <main class="command-hub" id="mainContent">
        <!-- 1. Верхняя статусная секция (Hero Bar) -->
        <section class="command-hero" aria-label="Приветственная панель">
            <div class="command-hero__content">
                <div class="command-hero__top-row">
                    <div class="command-hero__user-badge">
                        <span class="command-hero__greeting" data-i18n="home.hero.welcome">С возвращением,</span>
                        <strong class="command-hero__username user-highlight"><%= user.username %></strong>
                    </div>
                    <div class="command-hero__status-pill" title="Телеметрия инфраструктуры Zabbix">
                        <span class="status-pulse-dot" aria-hidden="true"></span>
                        <span class="command-hero__status-text" data-i18n="home.hero.status">Все узлы в штатном режиме</span>
                    </div>
                </div>

                <div class="command-hero__bottom-row">
                    <h1 class="command-hero__title" data-i18n="home.hero.title">База знаний ИТС-Ком</h1>
                    <div class="command-hero__date" id="heroCurrentDateWrap">
                        <svg class="command-hero__date-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                            <rect x="3" y="4" width="14" height="13" rx="2"/>
                            <line x1="3" y1="8" x2="17" y2="8"/>
                            <line x1="7" y1="2" x2="7" y2="5"/>
                            <line x1="13" y1="2" x2="13" y2="5"/>
                        </svg>
                        <span class="command-hero__date-val" id="heroCurrentDate"><%= dateDisplay %></span>
                    </div>
                </div>
            </div>
        </section>

        <!-- 2. Две крупные сбалансированные карточки по центру -->
        <section class="command-widgets-section" aria-label="Основные сервисы">
            <div class="command-widgets-grid">
                <!-- Карточка 1: Wiki (База знаний) -->
                <article class="command-widget command-widget--wiki">
                    <div class="command-widget__header">
                        <div class="command-widget__icon-wrap command-widget__icon-wrap--wiki" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                                <line x1="9" y1="7" x2="15" y2="7"/>
                                <line x1="9" y1="11" x2="15" y2="11"/>
                            </svg>
                        </div>
                        <div class="command-widget__badges">
                            <span class="widget-badge widget-badge--primary" id="wikiTotalBadge">
                                <%= totalServers %> организаций
                            </span>
                        </div>
                    </div>

                    <div class="command-widget__body">
                        <h2 class="command-widget__title" data-i18n="home.widget.wiki.title">Wiki</h2>
                        <p class="command-widget__desc" data-i18n="home.widget.wiki.desc">
                            Технические параметры серверов, доступы и конфигурации
                        </p>
                        <div class="command-widget__features">
                            <div class="feature-item">
                                <span class="feature-bullet" aria-hidden="true">●</span>
                                <span>Инфраструктура клиентов и доступы AnyDesk / RDP</span>
                            </div>
                            <div class="feature-item">
                                <span class="feature-bullet" aria-hidden="true">●</span>
                                <span>Учетные записи, базы данных MS SQL и 1C</span>
                            </div>
                            <div class="feature-item">
                                <span class="feature-bullet" aria-hidden="true">●</span>
                                <span>Параметры удаленного управления iLO / IPMI</span>
                            </div>
                        </div>
                    </div>

                    <div class="command-widget__footer">
                        <a href="/wiki" class="command-widget__btn command-widget__btn--primary" id="btnOpenWiki">
                            <span data-i18n="home.widget.wiki.btn">Перейти в базу</span>
                            <span class="btn-arrow" aria-hidden="true">→</span>
                        </a>
                    </div>
                </article>

                <!-- Карточка 2: События -->
                <article class="command-widget command-widget--events">
                    <div class="command-widget__header">
                        <div class="command-widget__icon-wrap command-widget__icon-wrap--events" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                                <path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/>
                            </svg>
                        </div>
                        <div class="command-widget__badges">
                            <span class="widget-badge widget-badge--warning" data-i18n="home.widget.events.badge">
                                В разработке
                            </span>
                        </div>
                    </div>

                    <div class="command-widget__body">
                        <h2 class="command-widget__title" data-i18n="home.widget.events.title">События</h2>
                        <p class="command-widget__desc" data-i18n="home.widget.events.desc">
                            Журнал изменений инфраструктуры и сроков лицензий
                        </p>
                        <div class="command-widget__features">
                            <div class="feature-item">
                                <span class="feature-bullet" aria-hidden="true">●</span>
                                <span>Мониторинг доступности и телеметрия Zabbix</span>
                            </div>
                            <div class="feature-item">
                                <span class="feature-bullet" aria-hidden="true">●</span>
                                <span>Сроки действия лицензий и SSL-сертификатов</span>
                            </div>
                            <div class="feature-item">
                                <span class="feature-bullet" aria-hidden="true">●</span>
                                <span>Журнал регламентных и технических работ</span>
                            </div>
                        </div>
                    </div>

                    <div class="command-widget__footer">
                        <button type="button" class="command-widget__btn command-widget__btn--disabled" disabled aria-disabled="true" data-i18n="home.widget.events.soon">
                            Скоро
                        </button>
                    </div>
                </article>
            </div>
        </section>
    </main>

    <!-- Toast контейнер для всплывающих уведомлений -->
    <div class="toast-container" id="toastContainer" aria-live="polite" aria-atomic="true"></div>

    <script src="/js/i18n.js"></script>
    <script>
        (function () {
            // ── Account Dropdown ──
            const toggle = document.getElementById('homeAccountToggle');
            const menu = document.getElementById('homeAccountMenu');
            if (toggle && menu) {
                toggle.addEventListener('click', function (event) {
                    event.stopPropagation();
                    const isOpen = menu.classList.toggle('is-open');
                    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                });
                document.addEventListener('click', function (event) {
                    if (!menu.contains(event.target) && !toggle.contains(event.target)) {
                        menu.classList.remove('is-open');
                        toggle.setAttribute('aria-expanded', 'false');
                    }
                });
            }

            // ── Dynamic Date formatting in Russian with capitalized weekday ──
            try {
                const dateEl = document.getElementById('heroCurrentDate');
                if (dateEl) {
                    const now = new Date();
                    const formatted = now.toLocaleDateString('ru-RU', {
                        weekday: 'long',
                        day: 'numeric',
                        month: 'long',
                        year: 'numeric'
                    });
                    dateEl.textContent = formatted.charAt(0).toUpperCase() + formatted.slice(1);
                }
            } catch (e) {
                console.warn('Date formatting fallback', e);
            }

            // ── Toast Notification System ──
            function showToast(message, type) {
                type = type || 'success';
                const container = document.getElementById('toastContainer');
                if (!container) return;

                const toast = document.createElement('div');
                toast.className = 'toast-item toast-item--' + type;
                toast.setAttribute('role', 'status');
                
                const iconSvg = type === 'success'
                    ? '<svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>'
                    : '<svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>';

                toast.innerHTML = '<span class="toast-icon">' + iconSvg + '</span><span class="toast-text">' + message + '</span>';
                container.appendChild(toast);

                requestAnimationFrame(function () {
                    toast.classList.add('is-visible');
                });

                setTimeout(function () {
                    toast.classList.remove('is-visible');
                    setTimeout(function () {
                        if (toast.parentNode) toast.parentNode.removeChild(toast);
                    }, 250);
                }, 2800);
            }
            window.showCommandToast = showToast;
        })();
    </script>
</body>
</html>
