# ParserTG config template. Copy to .env and fill in your own values.
# .env is git-ignored — real secrets never get committed.

# --- Control bot (python-telegram-bot) ---
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=123456:your-telegram-bot-token
# Your numeric Telegram user id — the ONLY person the bot answers. Ask @userinfobot.
ADMIN_USER_ID=000000000

# --- Parser account (Telethon, a USER account — NOT the bot) ---
# A bot can't read channel history, so parsing uses your own account.
# Get these at https://my.telegram.org → API development tools.
TELETHON_API_ID=
TELETHON_API_HASH=

# --- Channels to parse ---
# Comma-separated: public @username, a t.me link, or a numeric id (you must be a member
# of private ones). The parse cursor (last_message_id) is tracked per channel.
CHANNELS=@telegram

# --- Storage / behavior ---
DB_PATH=data/parsertg.db
# Telethon writes "<SESSION_PATH>.session"
SESSION_PATH=data/parsertg
# N used when /parse is called with no argument
PARSE_DEFAULT_N=20
# How many records /feed shows
FEED_LIMIT=10
LOG_LEVEL=INFO
