# Echo config template. Copy to .env and fill in your own values.
# .env is git-ignored — real secrets never get committed.

# --- Telegram ---
# Talk to @BotFather to create a bot and get the token.
TELEGRAM_BOT_TOKEN=123456:your-telegram-bot-token
# Your numeric Telegram user id (the only person the bot talks to). Ask @userinfobot.
OWNER_USER_ID=000000000
# IANA timezone used for activity windows / quiet hours.
TIMEZONE=Asia/Almaty

# --- Generation backends (tried in order: Groq -> OpenRouter -> templates) ---
# Leave a key blank to skip that backend. With both blank, Echo uses the template bank.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Cadence / anti-spam ---
MAX_PER_DAY=3
MIN_GAP_MINUTES=90
QUIET_START=23
QUIET_END=8
TICK_MINUTES=20
ENABLED_ROLES=mentor,provocateur,brainstorm,friend,inspirer,coach

# --- Misc ---
DB_PATH=data/echo.db
LOG_LEVEL=INFO
