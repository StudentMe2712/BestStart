<Window x:Class="SelectCast.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelectCast"
        Icon="Assets/selectcast.ico"
        Width="560" Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True">
    <Border Background="White" Padding="24">
        <StackPanel VerticalAlignment="Top">
            <TextBlock Text="SelectCast" FontSize="26" FontWeight="Bold" Foreground="#3A7BD5"/>
            <TextBlock x:Name="StatusLine" FontSize="13" Foreground="#666" Margin="0,2,0,10"/>
            <TextBox x:Name="InputBox" FontSize="16" Padding="8" MinHeight="38"
                     TextWrapping="Wrap" AcceptsReturn="False"
                     VerticalContentAlignment="Center"
                     KeyDown="InputBox_KeyDown"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Border x:Name="Swatch" Width="56" Height="56" CornerRadius="6"
                        BorderBrush="#DDDDDD" BorderThickness="1"
                        Visibility="Collapsed" Margin="0,0,14,0"/>
                <ItemsControl x:Name="ResultsList" VerticalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="{Binding Label}" Width="120" Foreground="#888888"/>
                                <TextBlock Text="{Binding Value}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="Enter — конвертировать введённое · Esc — скрыть"
                       FontSize="12" Foreground="#999999" Margin="0,18,0,0"/>
        </StackPanel>
    </Border>
</Window>
