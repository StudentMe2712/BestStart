<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only product (macOS/Linux out of scope per spec). Capture uses Win32 +
         the WPF clipboard API, so Core targets the Windows desktop TFM. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pure XML parsers (ParseNbk/ParseCbr) are internal but unit-tested directly. -->
    <InternalsVisibleTo Include="SelectCast.Core.Tests" />
  </ItemGroup>

</Project>
