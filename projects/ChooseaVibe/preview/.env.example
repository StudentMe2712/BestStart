# Пароль для входа в приложение (сбрасывается каждые 24 часа)
APP_MASTER_PASSWORD=Ваш_Сложный_Пароль_2026!

# Секрет для подписи 24-часовых токенов (любая случайная длинная строка)
AUTH_TOKEN_SECRET=choose-a-vibe-secret-key-2026

# Ключи Upstash Redis (заполняются автоматически при подключении Storage в Vercel)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
