# TgOrderSniper Environment Variables

# 1. Telegram MTProto Userbot Client (https://my.telegram.org)
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef
TG_SESSION_NAME=order_sniper
# Optional: Telethon StringSession for cloud / docker deployments
# TG_STRING_SESSION=

# 2. Telegram Bot API (Dispatcher)
TG_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
TARGET_CHAT_ID=-1001234567890

# 3. Channels and chats to monitor (comma-separated usernames or IDs)
CHANNELS_TO_WATCH=@freelance_chat, @python_jobs, -1009876543210

# 4. Deduplication Cache settings
DEDUP_CACHE_SIZE=5000
DEDUP_TTL_SECONDS=86400
