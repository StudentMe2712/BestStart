<UserControl
    x:Class="Stepwise.App.Views.PlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="PlayerRoot"
          AutomationProperties.AutomationId="PlayerRoot"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <!-- Header (Auto) -->
            <RowDefinition Height="Auto" />
            <!-- Dominant Visual Center (*) -->
            <RowDefinition Height="*" />
            <!-- Bottom Info & Control Bar (Auto) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: HEADER -->
        <Border Grid.Row="0"
                Padding="20,12"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Title & Subtitle -->
                    <ColumnDefinition Width="*" />
                    <!-- Center/Right: Status Badge & Controls -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE768;" FontSize="20" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" VerticalAlignment="Center" />
                    <StackPanel Spacing="2">
                        <TextBlock AutomationProperties.AutomationId="TxtGuideTitle"
                                   Text="{x:Bind ViewModel.GuideTitle, Mode=OneWay}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                        <TextBlock Text="{x:Bind ViewModel.GuideDescription, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind ViewModel.GuideDescriptionVisibility, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Overlay toggle button -->
                    <ToggleButton IsChecked="{x:Bind ViewModel.ShowHighlightOverlay, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="BtnToggleOverlay"
                                  ToolTipService.ToolTip="Переключить подсветку шага"
                                  Padding="8,5"
                                  CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE890;" FontSize="12" />
                            <TextBlock Text="Подсветка" FontSize="12" />
                        </StackPanel>
                    </ToggleButton>

                    <!-- Player Status Badge -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{x:Bind ViewModel.PlayerStateBrush, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock AutomationProperties.AutomationId="BadgePlayerStatus"
                                       Text="{x:Bind ViewModel.PlayerStateText, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Close Button -->
                    <Button AutomationProperties.AutomationId="BtnClosePlayer"
                            Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="Закрыть плеер (Esc)"
                            Padding="8,5"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: DOMINANT VISUAL CENTER (Screenshot, Overlays, States) -->
        <Grid Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}">
            <!-- Empty State Overlay -->
            <Border AutomationProperties.AutomationId="PanelEmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="32"
                    MaxWidth="480"
                    Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE8B9;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Руководство не содержит шагов"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Загрузите проект с записанными действиями для начала воспроизведения."
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Loading Indicator Overlay -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24"
                    Visibility="{x:Bind ViewModel.PreviewLoadingVisibility, Mode=OneWay}">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsPreviewLoading, Mode=OneWay}" Width="36" Height="36" HorizontalAlignment="Center" />
                    <TextBlock Text="Загрузка скриншота..." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Error State Overlay -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24"
                    MaxWidth="480"
                    Visibility="{x:Bind ViewModel.PreviewErrorVisibility, Mode=OneWay}">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xEB9F;" FontSize="40" Foreground="#EF4444" HorizontalAlignment="Center" />
                    <TextBlock Text="Скриншот недоступен" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.PreviewErrorMessage, Mode=OneWay}"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <Button AutomationProperties.AutomationId="BtnRetryScreenshot"
                            Content="Повторить"
                            Command="{x:Bind ViewModel.RetryImageLoadCommand, Mode=OneWay}"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Active Screenshot Preview with Highlight Overlay -->
            <Viewbox Stretch="Uniform"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Visibility="{x:Bind ViewModel.PreviewImageVisibility, Mode=OneWay}">
                <Grid Width="{x:Bind ViewModel.ScreenshotNaturalWidth, Mode=OneWay}"
                      Height="{x:Bind ViewModel.ScreenshotNaturalHeight, Mode=OneWay}">
                    <!-- Screenshot Image -->
                    <Image AutomationProperties.AutomationId="ImgStepScreenshot"
                           Source="{x:Bind ViewModel.PreviewImage, Mode=OneWay}" />

                    <!-- Vector Overlay Canvas -->
                    <Canvas>
                        <!-- Highlight Box around target element -->
                        <Rectangle
                            Canvas.Left="{x:Bind ViewModel.HighlightLeft, Mode=OneWay}"
                            Canvas.Top="{x:Bind ViewModel.HighlightTop, Mode=OneWay}"
                            Width="{x:Bind ViewModel.HighlightWidth, Mode=OneWay}"
                            Height="{x:Bind ViewModel.HighlightHeight, Mode=OneWay}"
                            Stroke="#EF4444"
                            StrokeThickness="3"
                            Fill="#25EF4444"
                            RadiusX="4"
                            RadiusY="4"
                            Visibility="{x:Bind ViewModel.HighlightVisibility, Mode=OneWay}" />

                        <!-- Click Pin Indicator -->
                        <Ellipse
                            Canvas.Left="{x:Bind ViewModel.ClickPinLeft, Mode=OneWay}"
                            Canvas.Top="{x:Bind ViewModel.ClickPinTop, Mode=OneWay}"
                            Width="18"
                            Height="18"
                            Fill="#EF4444"
                            Stroke="White"
                            StrokeThickness="2"
                            Visibility="{x:Bind ViewModel.ClickPinVisibility, Mode=OneWay}" />
                    </Canvas>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- ROW 2: BOTTOM INFO & CONTROL BAR -->
        <Border Grid.Row="2"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <!-- Info & Description -->
                    <RowDefinition Height="Auto" />
                    <!-- Navigation Toolbar & Position -->
                    <RowDefinition Height="Auto" />
                    <!-- Metadata Panel (Expander or Details) -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Step Information -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock AutomationProperties.AutomationId="TxtStepTitle"
                                       Text="{x:Bind ViewModel.CurrentStepTitle, Mode=OneWay}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                        </StackPanel>
                        <TextBlock AutomationProperties.AutomationId="TxtStepDescription"
                                   Text="{x:Bind ViewModel.CurrentStepDescription, Mode=OneWay}"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxLines="2" />
                    </StackPanel>

                    <!-- Step Position Chip -->
                    <Border Grid.Column="1"
                            VerticalAlignment="Top"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="6"
                            Padding="10,4">
                        <TextBlock AutomationProperties.AutomationId="TxtStepPosition"
                                   Text="{x:Bind ViewModel.StepPositionText, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="White" />
                    </Border>
                </Grid>

                <!-- Row 1: Navigation Toolbar -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Metadata Expander Toggle -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Center: Playback Navigation Toolbar -->
                        <ColumnDefinition Width="*" />
                        <!-- Right spacing balancer -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Toggle Metadata Button -->
                    <ToggleButton Grid.Column="0"
                                  IsChecked="{x:Bind ViewModel.IsMetadataExpanded, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="BtnToggleMetadata"
                                  ToolTipService.ToolTip="Показать/скрыть UIA-метаданные элемента"
                                  Padding="8,5"
                                  CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE946;" FontSize="12" />
                            <TextBlock Text="UIA Метаданные" FontSize="12" />
                        </StackPanel>
                    </ToggleButton>

                    <!-- Toolbar Buttons -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8">

                        <!-- First Step Button -->
                        <Button AutomationProperties.AutomationId="BtnFirst"
                                Command="{x:Bind ViewModel.FirstCommand, Mode=OneWay}"
                                ToolTipService.ToolTip="К первому шагу (Home)"
                                Padding="12,7"
                                CornerRadius="6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE892;" FontSize="14" />
                        </Button>

                        <!-- Previous Step Button -->
                        <Button AutomationProperties.AutomationId="BtnPrevious"
                                Command="{x:Bind ViewModel.PreviousCommand, Mode=OneWay}"
                                ToolTipService.ToolTip="Предыдущий шаг (Left Arrow)"
                                Padding="12,7"
                                CornerRadius="6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE76B;" FontSize="14" />
                        </Button>

                        <!-- Play / Pause Button -->
                        <Button AutomationProperties.AutomationId="BtnPlayPause"
                                Command="{x:Bind ViewModel.PlayPauseCommand, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.PlayPauseToolTip, Mode=OneWay}"
                                Padding="18,7"
                                CornerRadius="6"
                                Style="{ThemeResource AccentButtonStyle}">
                            <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" FontSize="15" />
                        </Button>

                        <!-- Restart Button -->
                        <Button AutomationProperties.AutomationId="BtnRestart"
                                Command="{x:Bind ViewModel.RestartCommand, Mode=OneWay}"
                                ToolTipService.ToolTip="Перезапустить с первого шага"
                                Padding="12,7"
                                CornerRadius="6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>

                        <!-- Next Step Button -->
                        <Button AutomationProperties.AutomationId="BtnNext"
                                Command="{x:Bind ViewModel.NextCommand, Mode=OneWay}"
                                ToolTipService.ToolTip="Следующий шаг (Right Arrow)"
                                Padding="12,7"
                                CornerRadius="6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE76C;" FontSize="14" />
                        </Button>

                        <!-- Last Step Button -->
                        <Button AutomationProperties.AutomationId="BtnLast"
                                Command="{x:Bind ViewModel.LastCommand, Mode=OneWay}"
                                ToolTipService.ToolTip="К последнему шагу (End)"
                                Padding="12,7"
                                CornerRadius="6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE893;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Target Metadata Panel -->
                <Border Grid.Row="2"
                        AutomationProperties.AutomationId="TargetMetadataPanel"
                        Visibility="{x:Bind ViewModel.MetadataPanelVisibility, Mode=OneWay}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10">
                    <Grid RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Element & Control Type -->
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Элемент" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TargetElementName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.TargetControlType, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <!-- AutomationId & ClassName -->
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="AutomationId / Class" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TargetAutomationId, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.TargetClassName, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Process & Window -->
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Процесс и Окно" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ProcessInfoText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.TargetWindowTitle, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Coordinates -->
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock Text="Координаты" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.BoundingBoxText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.ClickPointText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
