<Window
    x:Class="Stepwise.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Stepwise.App"
    mc:Ignorable="d"
    Title="Stepwise — Interactive Walkthrough Engine">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom TitleBar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0,16,0" VerticalAlignment="Top" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App Brand & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7C3;" FontSize="18" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                <TextBlock Text="Stepwise" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="Editor" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>

            <!-- Recording Controls Toolbar -->
            <StackPanel Grid.Column="1"
                        AutomationProperties.AutomationId="RecordingToolbar"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">

                <!-- Start Recording Button -->
                <Button Command="{x:Bind ViewModel.StartRecordingCommand, Mode=OneWay}"
                        AutomationProperties.AutomationId="BtnStartRecording"
                        AutomationProperties.Name="Start Recording"
                        ToolTipService.ToolTip="Начать запись действий"
                        Padding="12,5"
                        CornerRadius="6"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#EF4444" VerticalAlignment="Center" />
                        <TextBlock Text="Запись" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Pause Recording Button -->
                <Button Command="{x:Bind ViewModel.PauseRecordingCommand, Mode=OneWay}"
                        AutomationProperties.AutomationId="BtnPauseRecording"
                        AutomationProperties.Name="Pause Recording"
                        ToolTipService.ToolTip="Приостановить запись"
                        Padding="10,5"
                        CornerRadius="6"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE769;" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Пауза" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Resume Recording Button -->
                <Button Command="{x:Bind ViewModel.ResumeRecordingCommand, Mode=OneWay}"
                        AutomationProperties.AutomationId="BtnResumeRecording"
                        AutomationProperties.Name="Resume Recording"
                        ToolTipService.ToolTip="Продолжить запись"
                        Padding="10,5"
                        CornerRadius="6"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE768;" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Продолжить" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Stop Recording Button -->
                <Button Command="{x:Bind ViewModel.StopRecordingCommand, Mode=OneWay}"
                        AutomationProperties.AutomationId="BtnStopRecording"
                        AutomationProperties.Name="Stop Recording"
                        ToolTipService.ToolTip="Остановить и завершить запись"
                        Padding="10,5"
                        CornerRadius="6"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="#EF4444" VerticalAlignment="Center" />
                        <TextBlock Text="Стоп" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Status Badge -->
            <Border Grid.Column="2"
                    VerticalAlignment="Center"
                    Margin="0,0,140,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10,4">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{x:Bind ViewModel.RecordingStateBrush, Mode=OneWay}" VerticalAlignment="Center" />
                    <TextBlock AutomationProperties.AutomationId="BadgeRecordingStatus"
                               Text="{x:Bind ViewModel.RecordingStatusText, Mode=OneWay}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Shell Navigation View -->
        <NavigationView
            x:Name="NavView"
            AutomationProperties.AutomationId="ShellNavView"
            Grid.Row="1"
            PaneDisplayMode="LeftCompact"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Редактор" Tag="Editor" AutomationProperties.AutomationId="NavEditor">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Edit" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Запись" Tag="Record" AutomationProperties.AutomationId="NavRecord">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Video" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" AutomationProperties.AutomationId="MainContentFrame" />
        </NavigationView>
    </Grid>
</Window>
