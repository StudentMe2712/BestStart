{
  "manifest_version": 3,
  "name": "QuickTranslate",
  "version": "1.1.0",
  "description": "Мгновенный перевод выделенного текста во всплывающем окне прямо на веб-странице через безопасный фоновый сервис.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://clients5.google.com/*",
    "https://api.mymemory.translated.net/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "QuickTranslate"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
