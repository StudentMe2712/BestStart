## 3. High-Performance Asynchronous I/O: IOCP & io_uring

### 3.1 Windows I/O Completion Ports (IOCP) Event Loop
```c
#ifdef _WIN32
#include <windows.h>
#include <stdio.h>

typedef enum {
    OP_READ,
    OP_WRITE
} OperationType;

typedef struct {
    OVERLAPPED overlapped;
    WSABUF wsa_buf;
    char buffer[4096];
    OperationType type;
    SOCKET client_socket;
} IoContext;

DWORD WINAPI IocpWorkerThread(LPVOID completion_port_param) {
    HANDLE iocp = (HANDLE)completion_port_param;
    DWORD bytes_transferred = 0;
    ULONG_PTR completion_key = 0;
    LPOVERLAPPED overlapped = NULL;

    while (1) {
        BOOL ok = GetQueuedCompletionStatus(
            iocp,
            &bytes_transferred,
            &completion_key,
            &overlapped,
            INFINITE
        );

        if (!ok || !overlapped) {
            DWORD err = GetLastError();
            if (err == ERROR_ABANDONED_WAIT_0) break;
            continue;
        }

        IoContext *ctx = (IoContext*)overlapped;
        if (bytes_transferred == 0) {
            // Client disconnected
            closesocket(ctx->client_socket);
            free(ctx);
            continue;
        }

        // Process data in ctx->buffer...
    }
    return 0;
}
#endif
```

### 3.2 Linux `io_uring` Asynchronous Read Batching
```c
#ifdef __linux__
#include <liburing.h>
#include <fcntl.h>
#include <unistd.h>

#define QUEUE_DEPTH 64

void SubmitAsyncFileReads(int fd, char *buf, size_t file_size) {
    struct io_uring ring;
    io_uring_queue_init(QUEUE_DEPTH, &ring, 0);

    struct io_uring_sqe *sqe = io_uring_get_sqe(&ring);
    io_uring_prep_read(sqe, fd, buf, file_size, 0);
    sqe->user_data = 1;

    io_uring_submit(&ring);

    struct io_uring_cqe *cqe;
    int ret = io_uring_wait_cqe(&ring, &cqe);
    if (ret >= 0) {
        // cqe->res contains bytes read
        io_uring_cqe_seen(&ring, cqe);
    }
    io_uring_queue_exit(&ring);
}
#endif
```

