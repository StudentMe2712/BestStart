## 2. Struct Alignment, Packing & Wire Protocol Serialization

### 2.1 Cross-Platform Struct Packing and Endianness
```c
#include <stdint.h>

#if defined(_MSC_VER)
    #pragma pack(push, 1)
    #define PACKED_STRUCT
#elif defined(__GNUC__) || defined(__clang__)
    #define PACKED_STRUCT __attribute__((packed))
#else
    #error "Unsupported compiler"
#endif

// Network packet header (exact 16 bytes, no padding holes)
typedef struct PACKED_STRUCT {
    uint16_t magic_number;  // 0x55AA
    uint16_t version;       // Protocol version
    uint32_t payload_len;   // Big-endian payload size
    uint32_t sequence_id;   // Monotonic frame index
    uint32_t crc32_hash;    // Checksum
} NetworkFrameHeader;

#if defined(_MSC_VER)
    #pragma pack(pop)
#endif

// Cross-platform 32-bit endian swap
static inline uint32_t swap_uint32_endian(uint32_t val) {
#if defined(_MSC_VER)
    return _byteswap_ulong(val);
#elif defined(__GNUC__) || defined(__clang__)
    return __builtin_bswap32(val);
#else
    return ((val >> 24) & 0xFF) |
           ((val << 8)  & 0xFF0000) |
           ((val >> 8)  & 0xFF00) |
           ((val << 24) & 0xFF000000);
#endif
}
```

