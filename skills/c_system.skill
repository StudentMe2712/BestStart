## 4. Multi-Platform Thread Pool Architecture

```c
#include <stdbool.h>

typedef void (*task_func_t)(void *arg);

typedef struct task_node {
    task_func_t function;
    void *arg;
    struct task_node *next;
} task_node_t;

typedef struct {
#ifdef _WIN32
    CRITICAL_SECTION lock;
    CONDITION_VARIABLE cond;
    HANDLE *threads;
#else
    pthread_mutex_t lock;
    pthread_cond_t cond;
    pthread_t *threads;
#endif
    task_node_t *task_head;
    task_node_t *task_tail;
    size_t thread_count;
    bool is_shutdown;
} thread_pool_t;
```

