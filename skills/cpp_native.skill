## 5. SIMD / AVX2 Intrinsics Vectorization

Process 8 single-precision floats (256-bit) per CPU cycle:

```cpp
#include <immintrin.h>
#include <span>

void VectorizedFMA(
    std::span<const float> a, 
    std::span<const float> b, 
    std::span<const float> c, 
    std::span<float> out) noexcept 
{
    const size_t count = a.size();
    size_t i = 0;

    // Process in chunks of 8 floats with AVX2 FMA
    for (; i + 8 <= count; i += 8) {
        __m256 va = _mm256_loadu_ps(&a[i]);
        __m256 vb = _mm256_loadu_ps(&b[i]);
        __m256 vc = _mm256_loadu_ps(&c[i]);

        // Fused Multiply-Add: (va * vb) + vc
        __m256 vres = _mm256_fmadd_ps(va, vb, vc);
        _mm256_storeu_ps(&out[i], vres);
    }

    // Scalar fallback loop for remaining elements
    for (; i < count; ++i) {
        out[i] = (a[i] * b[i]) + c[i];
    }
}
```
