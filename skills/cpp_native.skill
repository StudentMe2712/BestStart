## 4. Concurrency, `std::jthread`, and Lock-Free Queues

### 4.1 Single-Producer Single-Consumer (SPSC) Lock-Free Ring Buffer
```cpp
#include <atomic>
#include <array>
#include <optional>
#include <thread>
#include <new>

template <typename T, size_t Capacity>
    requires (Capacity > 0 && (Capacity & (Capacity - 1)) == 0) // Must be power of 2
class LockFreeSPSCQueue {
private:
    static constexpr size_t IndexMask = Capacity - 1;
    std::array<T, Capacity> ringBuffer_;

    // Align indices to separate cache lines to eliminate false sharing
    alignas(std::hardware_destructive_interference_size) std::atomic<size_t> head_{0};
    alignas(std::hardware_destructive_interference_size) std::atomic<size_t> tail_{0};

public:
    template <typename... Args>
    bool Emplace(Args&&... args) noexcept {
        const size_t currentTail = tail_.load(std::memory_order_relaxed);
        const size_t currentHead = head_.load(std::memory_order_acquire);

        if ((currentTail - currentHead) >= Capacity) {
            return false; // Queue is full
        }

        ringBuffer_[currentTail & IndexMask] = T(std::forward<Args>(args)...);
        tail_.store(currentTail + 1, std::memory_order_release);
        return true;
    }

    std::optional<T> Pop() noexcept {
        const size_t currentHead = head_.load(std::memory_order_relaxed);
        const size_t currentTail = tail_.load(std::memory_order_acquire);

        if (currentHead == currentTail) {
            return std::nullopt; // Queue is empty
        }

        T val = std::move(ringBuffer_[currentHead & IndexMask]);
        head_.store(currentHead + 1, std::memory_order_release);
        return val;
    }
};
```

### 4.2 Cooperative Cancellation with `std::jthread` & `std::stop_token`
```cpp
void WorkerLoop(std::stop_token st, LockFreeSPSCQueue<int, 1024>& queue) {
    while (!st.stop_requested()) {
        if (auto item = queue.Pop()) {
            // Process item...
        } else {
            std::this_thread::yield();
        }
    }
}

// Spawning thread with automatic RAII join on destruction
void StartEngine() {
    LockFreeSPSCQueue<int, 1024> queue;
    std::jthread worker(WorkerLoop, std::ref(queue));
    // When worker goes out of scope, request_stop() and join() are invoked automatically
}
```

