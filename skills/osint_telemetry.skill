# OSINT Investigation & Telegram Telemetry Engineering Standards

This skill provides comprehensive operational guidelines, architectural patterns, and production code for building high-concurrency **OSINT (Open Source Intelligence)** investigation engines and **Telegram telemetry bots** using **aiogram 3.x**, **GHunt**, **Shodan / Censys**, rotating proxies, and **Prometheus metrics**.

---

## 1. High-Performance Telegram Bot Architecture (aiogram 3.x)

### 1.1 Middleware Pipeline: Throttling & Prometheus Telemetry
Implement non-blocking, asynchronous middleware for rate-limiting and latency observability:

```python
import time
from typing import Any, Awaitable, Callable, Dict
from aiogram import BaseMiddleware
from aiogram.types import TelegramObject, Message
from prometheus_client import Counter, Histogram

REQUEST_COUNT = Counter(
    "bot_requests_total", 
    "Total incoming Telegram bot events", 
    ["event_type", "status"]
)
REQUEST_LATENCY = Histogram(
    "bot_request_duration_seconds", 
    "Histogram of request processing duration in seconds", 
    ["handler_name"]
)

class TelemetryRateLimitMiddleware(BaseMiddleware):
    def __init__(self, rate_limit_sec: float = 1.0):
        self._rate_limit = rate_limit_sec
        self._user_last_action: Dict[int, float] = {}

    async def __call__(
        self,
        handler: Callable[[TelegramObject, Dict[str, Any]], Awaitable[Any]],
        event: TelegramObject,
        data: Dict[str, Any]
    ) -> Any:
        start_time = time.monotonic()
        
        if isinstance(event, Message) and event.from_user:
            user_id = event.from_user.id
            now = time.monotonic()
            last_action = self._user_last_action.get(user_id, 0.0)

            if now - last_action < self._rate_limit:
                REQUEST_COUNT.labels(event_type="message", status="throttled").inc()
                await event.answer("⚠️ Rate limit exceeded. Please wait a moment.")
                return None

            self._user_last_action[user_id] = now

        try:
            result = await handler(event, data)
            REQUEST_COUNT.labels(event_type="message", status="success").inc()
            return result
        except Exception as exc:
            REQUEST_COUNT.labels(event_type="message", status="error").inc()
            raise exc
        finally:
            duration = time.monotonic() - start_time
            REQUEST_LATENCY.labels(handler_name=data.get("handler_name", "unknown")).observe(duration)
```

