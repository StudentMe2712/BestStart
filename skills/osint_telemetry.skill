## 2. OSINT Investigation Modules

### 2.1 Shodan & Censys Network Reconnaissance
Correlate IP addresses, SSL fingerprints, open ports, and vulnerabilities:

```python
import aiohttp
from typing import Dict, Any, Optional

class ShodanReconEngine:
    def __init__(self, api_key: str):
        self._api_key = api_key
        self._base_url = "https://api.shodan.io"

    async def inspect_host(self, ip_address: str) -> Optional[Dict[str, Any]]:
        url = f"{self._base_url}/shodan/host/{ip_address}?key={self._api_key}"
        async with aiohttp.ClientSession() as session:
            async with session.get(url, timeout=aiohttp.ClientTimeout(total=10)) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    return {
                        "ip": data.get("ip_str"),
                        "org": data.get("org"),
                        "os": data.get("os"),
                        "ports": data.get("ports", []),
                        "vulns": list(data.get("vulns", {}).keys()),
                        "hostnames": data.get("hostnames", []),
                    }
                return None
```

### 2.2 Phone & Email Reconnaissance Pipeline
```python
import dns.asyncresolver
import re

class EmailReconService:
    @staticmethod
    async def verify_mx_records(email: str) -> Dict[str, Any]:
        domain = email.split("@")[-1]
        try:
            resolver = dns.asyncresolver.Resolver()
            resolver.timeout = 3.0
            answers = await resolver.resolve(domain, "MX")
            records = [str(r.exchange).rstrip(".") for r in answers]
            return {"valid_domain": True, "mx_records": records}
        except Exception:
            return {"valid_domain": False, "mx_records": []}
```

