## 4. WinAPI Interop (P/Invoke) & Window Modernization

### 4.1 Modern Windows 11 / 10 Dark Mode & Mica Backdrops
Modernize the Win32 window chrome using Desktop Window Manager (DWM) attributes via P/Invoke.

```csharp
using System.Runtime.InteropServices;
using System.Windows;
using System.Windows.Interop;

namespace BestStart.Wpf.Interop;

public static partial class Win32Dwm
{
    private const int DWMWA_USE_IMMERSIVE_DARK_MODE = 20;
    private const int DWMWA_WINDOW_CORNER_PREFERENCE = 33;
    private const int DWMWA_SYSTEMBACKDROP_TYPE = 38;

    public enum DWM_WINDOW_CORNER_PREFERENCE
    {
        DWMWCP_DEFAULT = 0,
        DWMWCP_DONOTROUND = 1,
        DWMWCP_ROUND = 2,
        DWMWCP_ROUNDSMALL = 3
    }

    public enum DWM_SYSTEMBACKDROP_TYPE
    {
        DWMSBT_AUTO = 0,
        DWMSBT_NONE = 1,
        DWMSBT_MAINWINDOW = 2, // Mica
        DWMSBT_TRANSIENTWINDOW = 3, // Acrylic
        DWMSBT_TABBEDWINDOW = 4 // Mica Alt
    }

    [LibraryImport("dwmapi.dll")]
    private static partial int DwmSetWindowAttribute(
        IntPtr hwnd, 
        int dwAttribute, 
        in int pvAttribute, 
        int cbAttribute);

    public static void EnableImmersiveDarkMode(Window window, bool enable = true)
    {
        var hwnd = new WindowInteropHelper(window).EnsureHandle();
        int value = enable ? 1 : 0;
        DwmSetWindowAttribute(hwnd, DWMWA_USE_IMMERSIVE_DARK_MODE, in value, sizeof(int));
    }

    public static void SetWindowBackdrop(Window window, DWM_SYSTEMBACKDROP_TYPE backdrop)
    {
        var hwnd = new WindowInteropHelper(window).EnsureHandle();
        int value = (int)backdrop;
        DwmSetWindowAttribute(hwnd, DWMWA_SYSTEMBACKDROP_TYPE, in value, sizeof(int));
    }

    public static void SetRoundedCorners(Window window, DWM_WINDOW_CORNER_PREFERENCE preference)
    {
        var hwnd = new WindowInteropHelper(window).EnsureHandle();
        int value = (int)preference;
        DwmSetWindowAttribute(hwnd, DWMWA_WINDOW_CORNER_PREFERENCE, in value, sizeof(int));
    }
}
```

### 4.2 Custom Window Message Hook (WndProc & WM_NCHITTEST)
Enables custom borderless titlebar dragging, maximize bounds snapping, and native resizing.

```csharp
public partial class MainWindow : Window
{
    private const int WM_NCHITTEST = 0x0084;
    private const int HTCLIENT = 1;
    private const int HTCAPTION = 2;

    public MainWindow()
    {
        InitializeComponent();
        Loaded += OnWindowLoaded;
    }

    private void OnWindowLoaded(object sender, RoutedEventArgs e)
    {
        Win32Dwm.EnableImmersiveDarkMode(this, true);
        Win32Dwm.SetRoundedCorners(this, Win32Dwm.DWM_WINDOW_CORNER_PREFERENCE.DWMWCP_ROUND);

        var hwndSource = HwndSource.FromHwnd(new WindowInteropHelper(this).Handle);
        hwndSource?.AddHook(WndProc);
    }

    private IntPtr WndProc(IntPtr hwnd, int msg, IntPtr wParam, IntPtr lParam, ref bool handled)
    {
        if (msg == WM_NCHITTEST)
        {
            // Custom hit-test logic for borderless title bar drag region
            // Return HTCAPTION when pointer is inside title bar area
        }
        return IntPtr.Zero;
    }
}
```

