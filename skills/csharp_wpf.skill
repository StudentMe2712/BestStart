# Modern .NET 8 WPF Architecture & Engineering Standards

This skill provides comprehensive architectural guidelines, production-grade patterns, and best practices for building high-performance, native Windows desktop applications using **C# 12 / .NET 8+**, **WPF**, **CommunityToolkit.Mvvm**, **WinAPI P/Invoke**, and **Microsoft.Extensions.DependencyInjection**.

---

## 1. Modern C# 12 & .NET 8 Core Features

### 1.1 Primary Constructors & Collection Expressions
```csharp
// Primary constructors in Services and ViewModels
public sealed class OrderProcessingService(
    ILogger<OrderProcessingService> logger,
    IOrderRepository repository,
    IMessenger messenger) : IOrderProcessingService
{
    public async Task<IReadOnlyList<OrderDto>> ProcessBatchAsync(
        IEnumerable<OrderId> orderIds, 
        CancellationToken ct = default)
    {
        // C# 12 Collection expressions & Frozen collections
        List<OrderDto> results = [];
        FrozenSet<OrderId> idSet = orderIds.ToFrozenSet();

        foreach (var id in idSet)
        {
            ct.ThrowIfCancellationRequested();
            var order = await repository.GetByIdAsync(id, ct).ConfigureAwait(false);
            if (order is not null)
            {
                results.Add(order.ToDto());
            }
        }
        return results;
    }
}
```

---

## 2. MVVM with CommunityToolkit.Mvvm & Prism

### 2.1 ViewModel Implementation with Source Generators
Use `CommunityToolkit.Mvvm.ComponentModel` and `Input` source generators to eliminate boilerplate and avoid runtime reflection.

```csharp
using CommunityToolkit.Mvvm.ComponentModel;
using CommunityToolkit.Mvvm.Input;
using CommunityToolkit.Mvvm.Messaging;

namespace BestStart.Wpf.ViewModels;

public sealed partial class DashboardViewModel : ObservableValidator
{
    private readonly ITelemetryService _telemetryService;
    private readonly IMessenger _messenger;

    [ObservableProperty]
    [NotifyPropertyChangedFor(nameof(CanExecuteActions))]
    [NotifyCanExecuteChangedFor(nameof(RefreshDataCommand))]
    private bool _isLoading;

    [ObservableProperty]
    private string _statusMessage = "Ready";

    [ObservableProperty]
    private ObservableCollection<TelemetryRecordViewModel> _records = [];

    public bool CanExecuteActions => !IsLoading;

    public DashboardViewModel(ITelemetryService telemetryService, IMessenger messenger)
    {
        _telemetryService = telemetryService;
        _messenger = messenger;

        // Register WeakReferenceMessenger for decoupled event aggregation
        _messenger.Register<DashboardViewModel, StatusUpdateMessage>(this, static (r, m) =>
        {
            r.StatusMessage = m.Value;
        });
    }

    [RelayCommand(CanExecute = nameof(CanExecuteActions))]
    private async Task RefreshDataAsync(CancellationToken ct)
    {
        IsLoading = true;
        StatusMessage = "Fetching latest metrics...";

        try
        {
            var data = await _telemetryService.FetchMetricsAsync(ct).ConfigureAwait(true);
            Records.Clear();
            foreach (var item in data)
            {
                Records.Add(new TelemetryRecordViewModel(item));
            }
            StatusMessage = $"Updated {Records.Count} metrics successfully.";
        }
        catch (OperationCanceledException)
        {
            StatusMessage = "Operation cancelled by user.";
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}
```

